@page
@model ArcaneVaultRP.Pages.SettingsModel
@Html.AntiForgeryToken()
@{
    ViewData["Title"] = "Settings";
    var user     = Model.CurrentUser;
    var flag     = ArcaneVaultRP.Helpers.CountryHelper.GetFlag(user.Country ?? "");
    var initial  = user.UserName.Length > 0 ? user.UserName[0].ToString().ToUpper() : "?";
}

<div class="container mt-4 animate-fade-in" style="max-width:600px;">

    <h2 class="fw-bold mb-1" style="font-size:26px; font-family: 'Outfit', sans-serif; letter-spacing: -0.5px;">Settings</h2>
    <div style="width:40px; height:4px; background: linear-gradient(90deg, var(--color-periwinkle), var(--color-lavender)); border-radius:2px; margin-bottom:24px;"></div>

    <div class="rounded-4 p-4 border border-color" style="background: var(--bg-card) !important; box-shadow: 0 8px 30px rgba(0, 0, 0, 0.25);">

        <!-- ── PROFILE ── -->
        <p style="font-size:11px; font-weight:700; letter-spacing:0.08em; color: var(--color-periwinkle); margin:0 0 16px; text-transform:uppercase;">
            Profile Settings
        </p>

        <div class="d-flex align-items-center gap-3 mb-4">
            <!-- Avatar -->
            <div style="position:relative; flex-shrink:0;">
                <div id="avatarCircle"
                     style="width:80px; height:80px; border-radius:50%; overflow:hidden;
                            background: linear-gradient(135deg, var(--color-indigo-dark), var(--color-periwinkle));
                            border: 2px solid rgba(244, 238, 255, 0.2);
                            display:flex; align-items:center; justify-content:center;
                            cursor:pointer; transition: all 0.2s ease;" onclick="openUploadModal()">
                    @if (!string.IsNullOrEmpty(user.AvatarUrl))
                    {
                        <img id="avatarImg" src="@user.AvatarUrl"
                             style="width:100%; height:100%; object-fit:cover;" />
                    }
                    else
                    {
                        <span id="avatarInitial"
                              style="font-size:28px; font-weight:700; color: var(--color-light);">@initial</span>
                    }
                </div>
                <button onclick="openUploadModal()"
                        style="position:absolute; bottom:0; right:0; width:26px; height:26px;
                               border-radius:50%; background: var(--color-periwinkle); border:2px solid var(--bg-card);
                               display:flex; align-items:center; justify-content:center;
                               cursor:pointer; padding:0; transition: all 0.2s ease;"
                        class="avatar-edit-btn">
                    <i class="bi bi-camera-fill" style="font-size:11px; color: var(--bg-darkest) !important;"></i>
                </button>
            </div>

            <!-- Hidden file input -->
            <input type="file" id="avatarFileInput" accept=".jpg,.jpeg,.png" style="display:none;" onchange="onFileSelected(this)" />

            <!-- Name + country -->
            <div style="flex:1;">
                <!-- Username display -->
                <div class="d-flex align-items-center gap-2 mb-1">
                    <span style="font-size:18px; font-weight:700; color: var(--text-primary);" id="usernameText">@user.UserName</span>
                    <button onclick="openUsernameModal()"
                            style="background:none; border:none; cursor:pointer; padding:0;
                                   display:flex; align-items:center;">
                        <i class="bi bi-pencil" style="font-size:14px; color: var(--text-muted);"></i>
                    </button>
                </div>

                <!-- Country display -->
                <div class="d-flex align-items-center gap-1" id="countryDisplay">
                    <span style="font-size:15px;" id="countryFlag">
                        @(string.IsNullOrEmpty(user.Country) ? "🌐" : ArcaneVaultRP.Helpers.CountryHelper.GetFlag(user.Country))
                    </span>
                    <span style="font-size:13px; color: var(--text-secondary);" id="countryText">
                        @(string.IsNullOrEmpty(user.Country) ? "Not set" : user.Country)
                    </span>
                    <button onclick="openCountryModal()"
                            style="background:none; border:none; cursor:pointer; padding:0;
                                   display:flex; align-items:center; margin-left:4px;">
                        <i class="bi bi-pencil" style="font-size:12px; color: var(--text-muted);"></i>
                    </button>
                </div>
            </div>
        </div>

        <hr style="border-color: var(--border-color); margin: 0 0 20px;" />

        <!-- ── ACCOUNT ── -->
        <p style="font-size:11px; font-weight:700; letter-spacing:0.08em; color: var(--color-periwinkle); margin:0 0 16px; text-transform:uppercase;">
            Account Credentials
        </p>

        <!-- Email -->
        <p class="fw-600 mb-2" style="font-size:15px; color: var(--text-primary);">Email Address</p>
        <div class="d-flex gap-2 align-items-center mb-4">
            <input type="email" value="@user.Email" disabled id="emailDisplay"
                   class="form-control text-muted" style="flex:1; cursor:not-allowed; background-color: var(--bg-darkest) !important; color: var(--text-muted) !important;" />
            <button class="btn btn-outline-primary d-flex align-items-center gap-2"
                    onclick="openEmailModal()"
                    style="white-space:nowrap;">
                <i class="bi bi-envelope"></i> Change email
            </button>
        </div>

        <!-- Password -->
        <p class="fw-600 mb-2" style="font-size:15px; color: var(--text-primary);">Security Password</p>
        <button class="btn btn-secondary w-100 mb-2 d-flex align-items-center justify-content-center gap-2"
                onclick="openPasswordModal()" style="height:48px;">
            <i class="bi bi-lock-fill"></i> Change Password
        </button>
        <button class="btn btn-outline-primary w-100 d-flex align-items-center justify-content-center gap-2"
                style="height:48px;" onclick="openResetPasswordModal()">
            <i class="bi bi-arrow-clockwise"></i> Reset Password
        </button>

        @if (HttpContext.Session.GetString(SessionKeys.UserRole) == "1")
        {
            <hr style="border-color: var(--border-color); margin: 0 0 20px;" />
            <p style="font-size:11px; font-weight:700; letter-spacing:0.08em; color: var(--color-periwinkle); margin:0 0 16px; text-transform:uppercase;">
                Staff Availability
            </p>
            <div class="d-flex align-items-center justify-content-between mb-2">
                <div>
                    <p class="fw-600 mb-0" style="font-size:15px; color: var(--text-primary);">Receiving assignments</p>
                    <p class="text-muted small mb-0">When inactive, you won't be assigned new reports or support tickets.</p>
                </div>
                <div class="form-check form-switch">
                    <input class="form-check-input" type="checkbox" id="staffActiveToggle"
                    @(user.IsActive ? "checked" : "") onchange="toggleStaffActive(this.checked)" style="width:42px;height:22px;cursor:pointer;" />
                </div>
            </div>
        }

        <hr style="border-color: var(--border-color); margin:20px 0;" />

        <!-- ── DANGER ZONE ── -->
        <p style="font-size:11px; font-weight:700; letter-spacing:0.08em; color: #ff8591; margin:0 0 16px; text-transform:uppercase;">
            Danger Zone
        </p>

        <button class="btn btn-outline-primary w-100 mb-2"
                style="height:48px;" onclick="openDisableModal()">
            Disable Account
        </button>
        <button class="btn w-100 btn-danger-action"
                style="height:48px; background: rgba(220, 53, 69, 0.2); color: #ff8591; border: 1px solid rgba(220, 53, 69, 0.4); font-weight:600; transition: all 0.2s ease;"
                onclick="openDeleteModal()"
                onmouseenter="this.style.background='rgba(220, 53, 69, 0.35)'; this.style.borderColor='rgba(220, 53, 69, 0.6)';"
                onmouseleave="this.style.background='rgba(220, 53, 69, 0.2)'; this.style.borderColor='rgba(220, 53, 69, 0.4)';">
            Delete Account
        </button>

    </div>
</div>

<!-- ── Email Modal ── -->
<div class="modal fade" id="emailModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow">
            <div class="modal-header border-0">
                <h5 class="fw-bold mb-0">Change Email</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body px-4">
                <div class="mb-3">
                    <label class="form-label" style="font-size:13px;">New email address</label>
                    <input type="email" id="newEmailInput" class="form-control"
                           placeholder="Enter new email" />
                </div>
                <div id="emailError" class="text-danger small" style="display:none;"></div>
                <div class="mb-3">
                    <label class="form-label" style="font-size:13px;">Password</label>
                    <div class="input-group">
                        <input type="password" id="emailPwdInput" class="form-control"
                               placeholder="Password" />
                        <button class="btn btn-outline-primary" type="button" id="emailTogglePassword" style="border-top-left-radius: 0; border-bottom-left-radius: 0;">
                            <i class="bi bi-eye" id="emailPwdEyeIcon"></i>
                        </button>
                    </div>
                </div>
                <div id="emailPasswordError" class="text-danger small" style="display:none;"></div>
            </div>
            <div id="emailChangeError" class="text-danger small" style="display:none;"></div>
            <div class="modal-footer border-0">
                <button type="button" class="btn btn-outline-secondary"
                        data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-primary"
                        onclick="saveEmail()">Save</button>
            </div>
        </div>
    </div>
</div>

<!-- ── Reset Password: Step 1 (Verify Code) ── -->
<div class="modal fade" id="resetStep1Modal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow">
            <div class="modal-header border-0">
                <h5 class="fw-bold mb-0">Reset Password</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body px-4">
                <p class="text-muted small mb-3">
                    We'll send a 6-digit verification code to <strong id="resetEmailDisplay"></strong>.
                </p>
                <button class="btn btn-primary w-100 mb-3" id="sendCodeBtn" onclick="sendResetCode()">
                    Send verification code
                </button>
                <div id="codeInputSection" style="display:none;">
                    <label class="form-label" style="font-size:13px;">Enter the 6-digit code</label>
                    <div class="d-flex gap-2 justify-content-center mb-2" id="codeCellsContainer">
                        <input type="text" maxlength="1" class="form-control text-center code-cell" style="width:44px;height:52px;font-size:20px;" inputmode="numeric" />
                        <input type="text" maxlength="1" class="form-control text-center code-cell" style="width:44px;height:52px;font-size:20px;" inputmode="numeric" />
                        <input type="text" maxlength="1" class="form-control text-center code-cell" style="width:44px;height:52px;font-size:20px;" inputmode="numeric" />
                        <input type="text" maxlength="1" class="form-control text-center code-cell" style="width:44px;height:52px;font-size:20px;" inputmode="numeric" />
                        <input type="text" maxlength="1" class="form-control text-center code-cell" style="width:44px;height:52px;font-size:20px;" inputmode="numeric" />
                        <input type="text" maxlength="1" class="form-control text-center code-cell" style="width:44px;height:52px;font-size:20px;" inputmode="numeric" />
                    </div>
                    <p class="text-muted small text-center mb-0" id="resendText" style="display:none;">
                        Didn't get it? <a href="#" onclick="sendResetCode(); return false;">Resend code</a>
                    </p>
                </div>
                <div id="resetStep1Error" class="text-danger small mt-2" style="display:none;"></div>
            </div>
            <div class="modal-footer border-0">
                <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-primary" id="verifyCodeBtn" style="display:none;" onclick="verifyResetCode()">Verify</button>
            </div>
        </div>
    </div>
</div>

<!-- ── Reset Password: Step 2 (New Password) ── -->
<div class="modal fade" id="resetStep2Modal" tabindex="-1" data-bs-backdrop="static">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow">
            <div class="modal-header border-0">
                <h5 class="fw-bold mb-0">Set New Password</h5>
            </div>
            <div class="modal-body px-4">
                <div class="mb-3">
                    <label class="form-label" style="font-size:13px;">New password</label>
                    <div class="input-group">
                        <input type="password" id="resetNewPwdInput" class="form-control settingsPassword" placeholder="New password (min 6 characters)" />
                        <button class="btn btn-outline-primary" type="button" id="resetNewTogglePassword" style="border-top-left-radius: 0; border-bottom-left-radius: 0;">
                            <i class="bi bi-eye" id="resetNewEyeIcon"></i>
                        </button>
                    </div>
                </div>
                <div class="mb-3">
                    <label class="form-label" style="font-size:13px;">Confirm new password</label>
                    <div class="input-group">
                        <input type="password" id="resetConfirmPwdInput" class="form-control settingsPassword" placeholder="Confirm new password" />
                        <button class="btn btn-outline-primary" type="button" id="resetConfirmTogglePassword" style="border-top-left-radius: 0; border-bottom-left-radius: 0;">
                            <i class="bi bi-eye" id="resetConfirmEyeIcon"></i>
                        </button>
                    </div>
                </div>
                <div id="resetStep2Error" class="text-danger small" style="display:none;"></div>
            </div>
            <div class="modal-footer border-0">
                <button type="button" class="btn btn-primary w-100" onclick="submitNewPassword()">Save new password</button>
            </div>
        </div>
    </div>
</div>

<!-- ── Password Modal ── -->
<div class="modal fade" id="passwordModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow">
            <div class="modal-header border-0">
                <h5 class="fw-bold mb-0">Change Password</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body px-4">
                <div class="mb-3">
                    <label class="form-label" style="font-size:13px;">Current password</label>
                    <div class="input-group">
                        <input type="password" id="currentPwdInput" class="form-control"
                               placeholder="Current password" />
                        <button class="btn btn-outline-primary" type="button" id="currentTogglePassword" style="border-top-left-radius: 0; border-bottom-left-radius: 0;">
                            <i class="bi bi-eye" id="currentEyeIcon"></i>
                        </button>
                    </div>
                </div>
                <div class="mb-3">
                    <label class="form-label" style="font-size:13px;">New password</label>
                    <div class="input-group">
                        <input type="password" id="newPwdInput" class="form-control"
                               placeholder="New password (min 6 characters)" />
                        <button class="btn btn-outline-primary" type="button" id="newTogglePassword" style="border-top-left-radius: 0; border-bottom-left-radius: 0;">
                            <i class="bi bi-eye" id="newEyeIcon"></i>
                        </button>
                    </div>
                </div>
                <div class="mb-3">
                    <label class="form-label" style="font-size:13px;">Confirm new password</label>
                    <div class="input-group">
                        <input type="password" id="confirmPwdInput" class="form-control"
                               placeholder="Confirm new password" />
                        <button class="btn btn-outline-primary" type="button" id="confirmTogglePassword" style="border-top-left-radius: 0; border-bottom-left-radius: 0;">
                            <i class="bi bi-eye" id="confirmEyeIcon"></i>
                        </button>
                    </div>
                </div>
                <div id="pwdError" class="text-danger small" style="display:none;"></div>
            </div>
            <div class="modal-footer border-0">
                <button type="button" class="btn btn-outline-secondary"
                        data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-primary"
                        onclick="savePassword()">Save</button>
            </div>
        </div>
    </div>
</div>

<!-- ── Disable Modal ── -->
<div class="modal fade" id="disableModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow">
            <div class="modal-body p-4 text-center">
                <i class="bi bi-slash-circle text-warning fs-1 mb-3 d-block"></i>
                <h5 class="fw-bold mb-2">Disable your account?</h5>
                <p class="text-muted mb-4" style="font-size:14px;">
                    Your account will be disabled. You can re-enable it by logging in again.
                </p>
                <div class="d-flex gap-2 justify-content-center">
                    <button class="btn btn-danger px-4"
                            onclick="disableAccount()">Yes, disable</button>
                    <button class="btn btn-outline-secondary px-4"
                            data-bs-dismiss="modal">Cancel</button>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- ── Delete Modal ── -->
<div class="modal fade" id="deleteModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow">
            <div class="modal-body p-4 text-center">
                <i class="bi bi-exclamation-triangle-fill text-danger fs-1 mb-3 d-block"></i>
                <h5 class="fw-bold mb-2">Delete your account?</h5>
                <p class="text-muted mb-2" style="font-size:14px;">
                    This will permanently delete your account, all collection items and showoffs.
                    <strong>This cannot be undone.</strong>
                </p>
                <div class="mb-3">
                    <input type="text" id="deleteConfirmInput" class="form-control text-center"
                           placeholder='Type "DELETE" to confirm' />
                </div>
                <div id="deleteError" class="text-danger small mb-2" style="display:none;"></div>
                <div class="d-flex gap-2 justify-content-center">
                    <button class="btn px-4"
                            style="background:#c0392b;color:#fff;border:none;"
                            onclick="deleteAccount()">Yes, delete everything</button>
                    <button class="btn btn-outline-secondary px-4"
                            data-bs-dismiss="modal">Cancel</button>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- ── Upload Modal ── -->
<div class="modal fade" id="uploadModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow">
            <div class="modal-header border-0 pb-0">
                <h5 class="fw-bold mb-0">Change Profile Photo</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body px-4 pt-3 pb-4">
                <!-- Drop zone -->
                <div id="dropZone"
                     onclick="document.getElementById('avatarFileInput').click()"
                     ondragover="event.preventDefault();this.style.borderColor='var(--color-periwinkle)';"
                     ondragleave="this.style.borderColor='var(--border-color)';"
                     ondrop="onFileDrop(event)"
                     style="border: 2px dashed var(--border-color); border-radius:12px;
                            padding:40px 20px; text-align:center; cursor:pointer;
                            transition: border-color 0.2s; background: rgba(11, 12, 20, 0.4);">
                    <i class="bi bi-cloud-arrow-up text-muted"
                       style="font-size:36px; display:block; margin-bottom:12px;"></i>
                    <p style="font-size:14px; font-weight:600; margin:0 0 4px; color: var(--text-primary);">
                        Drag and drop your photo here
                    </p>
                    <p style="font-size:12px; color: var(--text-muted); margin:0;">
                        or click to browse · JPG or PNG · max 5MB
                    </p>
                </div>
                <div id="uploadError" class="text-danger small mt-2"
                     style="display:none;"></div>
            </div>
        </div>
    </div>
</div>

<!-- ── Crop Modal ── -->
<div class="modal fade" id="cropModal" tabindex="-1" data-bs-backdrop="static">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content border-0 shadow">
            <div class="modal-header border-0 pb-0">
                <h5 class="fw-bold mb-0">Adjust Photo</h5>
            </div>
            <div class="modal-body px-4 pt-3 pb-2">
                <p class="text-muted mb-3" style="font-size:13px;">
                    Scroll to zoom · Drag to reposition
                </p>
                <!-- Crop container -->
                <div style="position:relative; width:100%; background: var(--bg-darkest);
                            border-radius:8px; overflow:hidden; max-height:420px; border: 1px solid var(--border-color);">
                    <img id="cropImage" src="" style="display:block; max-width:100%;" />
                </div>
                <!-- Preview -->
                <div class="d-flex align-items-center gap-3 mt-3">
                    <div id="cropPreview"
                         style="width:64px; height:64px; border-radius:50%;
                                overflow:hidden; flex-shrink:0; border:2px solid var(--border-color);"></div>
                    <p class="text-muted mb-0" style="font-size:12px;">Preview</p>
                </div>
            </div>
            <div class="modal-footer border-0 pt-0 pb-3">
                <button type="button" class="btn btn-secondary"
                        onclick="cancelCrop()">
                    Cancel
                </button>
                <button type="button" class="btn btn-primary"
                        id="cropSaveBtn" onclick="saveCrop()">
                    Save
                </button>
            </div>
        </div>
    </div>
</div>

<!-- ── Username Modal ── -->
<div class="modal fade" id="usernameModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow">
            <div class="modal-header border-0 pb-0">
                <h5 class="fw-bold mb-0">Change Username</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body px-4 pt-3">
                <div class="mb-1">
                    <label class="form-label" style="font-size:13px;">New username</label>
                    <input type="text" id="usernameModalInput" class="form-control"
                           placeholder="Enter new username" />
                </div>
                <div id="usernameModalError" class="text-danger small mt-1"
                     style="display:none;"></div>
            </div>
            <div class="modal-footer border-0 pt-0">
                <button type="button" class="btn btn-secondary"
                        data-bs-dismiss="modal">
                    Cancel
                </button>
                <button type="button" class="btn btn-primary"
                        id="usernameSaveBtn" onclick="saveUsername()">
                    Save
                </button>
            </div>
        </div>
    </div>
</div>

<!-- ── Country Modal ── -->
<div class="modal fade" id="countryModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow">
            <div class="modal-header border-0 pb-0">
                <h5 class="fw-bold mb-0">Change Country</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body px-4 pt-3">
                <div class="position-relative">
                    <input type="text" id="countrySearchInput" class="form-control"
                           placeholder="Search your country..."
                           autocomplete="off" />
                    <input type="hidden" id="selectedCountryValue" />
                    <div id="countryDropdown"
                         class="list-group position-absolute z-3"
                         style="width:100%; max-height:220px; overflow-y:auto; display:none;
                                box-shadow:0 10px 30px rgba(0,0,0,0.3);"></div>
                </div>
                <div id="countryModalError" class="text-danger small mt-1"
                     style="display:none;"></div>
            </div>
            <div class="modal-footer border-0 pt-0">
                <button type="button" class="btn btn-secondary"
                        data-bs-dismiss="modal">
                    Cancel
                </button>
                <button type="button" class="btn btn-primary"
                        id="countrySaveBtn" onclick="saveCountry()">
                    Save
                </button>
            </div>
        </div>
    </div>
</div>

<!-- ── Success Toast ── -->
<div class="position-fixed bottom-0 end-0 p-3" style="z-index:9999;">
    <div id="successToast" class="toast align-items-center text-bg-success border-0"
         role="alert" aria-live="assertive">
        <div class="d-flex">
            <div class="toast-body" id="toastMsg">Saved successfully.</div>
            <button type="button" class="btn-close btn-close-white me-2 m-auto"
                    data-bs-dismiss="toast"></button>
        </div>
    </div>
</div>

@section Scripts {
<script>
    // ── Constants ──
    const apiBase   = document.getElementById('apiBaseInput')?.value;
    if (!apiBase) console.error('apiBaseInput is missing its value — ApiSettings:BaseUrl may not be configured.');
    const userName  = '@user.UserName';
    const countries = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.AllCountries));
    const flagMap   = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(
        ArcaneVaultRP.Helpers.CountryHelper.FlagMap));

    // ── Toast ──
    function showToast(msg) {
        document.getElementById('toastMsg').textContent = msg;
        new bootstrap.Toast(document.getElementById('successToast'), { delay: 3000 }).show();
    }

    // ── Avatar upload with Cropper.js ──
    let cropperInstance = null;

    // Store existing public ID for deletion
    // Extract from Cloudinary URL pattern: .../arcanevault/showoffs/publicid
    const existingAvatarUrl = '@(user.AvatarUrl ?? "")';
    let existingAvatarPublicId = null;
    if (existingAvatarUrl) {
        const parts = existingAvatarUrl.split('/upload/');
        if (parts.length > 1) {
            // Remove version prefix (v1234567890/) if present
            existingAvatarPublicId = parts[1].replace(/^v\d+\//, '').replace(/\.[^.]+$/, '');
        }
    }

    function openUploadModal() {
        document.getElementById('uploadError').style.display = 'none';
        document.getElementById('dropZone').style.borderColor = '#dee2e6';
        new bootstrap.Modal(document.getElementById('uploadModal')).show();
    }

    function onFileDrop(e) {
        e.preventDefault();
        document.getElementById('dropZone').style.borderColor = '#dee2e6';
        const file = e.dataTransfer.files[0];
        if (file) processFile(file);
    }

    function onFileSelected(input) {
        const file = input.files[0];
        if (file) processFile(file);
        input.value = '';
    }

    function processFile(file) {
        const errEl = document.getElementById('uploadError');
        errEl.style.display = 'none';

        if (!['image/jpeg', 'image/png'].includes(file.type)) {
            errEl.textContent = 'Only JPG and PNG files are allowed.';
            errEl.style.display = 'block'; return;
        }
        if (file.size > 5 * 1024 * 1024) {
            errEl.textContent = 'File size must not exceed 5MB.';
            errEl.style.display = 'block'; return;
        }

        const reader = new FileReader();
        reader.onload = function (e) {
            // Close upload modal, open crop modal
            bootstrap.Modal.getInstance(document.getElementById('uploadModal'))?.hide();

            const cropImage = document.getElementById('cropImage');
            cropImage.src = e.target.result;

            // Destroy previous cropper if exists
            if (cropperInstance) { cropperInstance.destroy(); cropperInstance = null; }

            setTimeout(() => {
                const cropModal = new bootstrap.Modal(document.getElementById('cropModal'));
                cropModal.show();

                document.getElementById('cropModal').addEventListener('shown.bs.modal', function () {
                    cropperInstance = new Cropper(cropImage, {
                        aspectRatio: 1,           // square crop
                        viewMode: 1,              // restrict crop box to canvas
                        dragMode: 'move',         // drag to reposition
                        autoCropArea: 0.8,
                        cropBoxResizable: false,  // fixed circle size
                        cropBoxMovable: false,    // user moves image not box
                        guides: false,
                        center: false,
                        highlight: false,
                        background: false,
                        movable: true,
                        zoomable: true,
                        zoomOnTouch: true,
                        zoomOnWheel: true,
                        scalable: false,

                        // Live preview in circle
                        preview: '#cropPreview',

                        ready() {
                            // Style crop box as circle overlay
                            const cropBox = document.querySelector('.cropper-crop-box');
                            if (cropBox) {
                                cropBox.style.borderRadius = '50%';
                            }
                            // Darken outside crop area
                            const modal = document.querySelector('.cropper-modal');
                            if (modal) {
                                modal.style.opacity = '0.65';
                            }
                        }
                    });
                }, { once: true });
            }, 300);
        };
        reader.readAsDataURL(file);
    }

    function cancelCrop() {
        if (cropperInstance) { cropperInstance.destroy(); cropperInstance = null; }
        bootstrap.Modal.getInstance(document.getElementById('cropModal'))?.hide();
        // Reopen upload modal
        setTimeout(() => openUploadModal(), 300);
    }

    async function saveCrop() {
        if (!cropperInstance) return;

        const saveBtn = document.getElementById('cropSaveBtn');
        saveBtn.disabled = true;
        saveBtn.innerHTML = `<span class="spinner-border spinner-border-sm me-1"></span>Uploading...`;

        // Get cropped canvas — output as square 400×400
        const canvas = cropperInstance.getCroppedCanvas({
            width: 400,
            height: 400,
            imageSmoothingEnabled: true,
            imageSmoothingQuality: 'high'
        });

        // Convert canvas to blob
        canvas.toBlob(async (blob) => {
            const formData = new FormData();
            formData.append('file', blob, 'avatar.jpg');

            // Upload to Cloudinary
            const uploadRes = await fetch(`${apiBase}/ImageUpload`, {
                method: 'POST',
                body: formData
            });

            if (!uploadRes.ok) {
                saveBtn.disabled = false;
                saveBtn.innerHTML = 'Save';
                alert('Upload failed. Please try again.');
                return;
            }

            const uploadData = await uploadRes.json();
            const newUrl = uploadData.imagePath || uploadData.ImagePath;
            const newPublicId = uploadData.imagePublicId || uploadData.ImagePublicId;

            // Save avatar URL to API
            await fetch(`${apiBase}/ArcaneVaultUser/${userName}/avatar`, {
                method: 'PATCH',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ AvatarUrl: newUrl })
            });

            // Refresh session on the server to keep LoggedInUser in sync
            await fetch(`/Settings?handler=RefreshSession&newUsername=${encodeURIComponent(userName)}`, {
                method: 'POST',
                headers: {
                    'RequestVerificationToken':
                        document.querySelector('input[name="__RequestVerificationToken"]')?.value || ''
                }
            });

            // Delete old avatar from Cloudinary
            if (existingAvatarPublicId) {
                await fetch(`${apiBase}/ImageUpload`, {
                    method: 'DELETE',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify(existingAvatarPublicId)
                });
            }

            // Update existingAvatarPublicId for future changes in same session
            existingAvatarPublicId = newPublicId;

            // Update avatar display in UI
            const circle = document.getElementById('avatarCircle');
            circle.innerHTML = `
                <img id="avatarImg" src="${newUrl}"
                        style="width:100%;height:100%;object-fit:cover;" />`;

            // Update navigation bar avatar globally in header
            const navLink = document.querySelector('.avatar-link');
            if (navLink) {
                navLink.innerHTML = `
                    <img src="${newUrl}"
                         style="width:100%;height:100%;object-fit:cover;" />`;
            }

            // Destroy cropper
            cropperInstance.destroy();
            cropperInstance = null;

            // Close modal
            bootstrap.Modal.getInstance(document.getElementById('cropModal'))?.hide();

            saveBtn.disabled = false;
            saveBtn.innerHTML = 'Save';

            showToast('Profile photo updated.');
        }, 'image/jpeg', 0.92);
    }

    // ── Username modal ──
    function openUsernameModal() {
        document.getElementById('usernameModalInput').value =
            document.getElementById('usernameText').textContent.trim();
        document.getElementById('usernameModalError').style.display = 'none';
        new bootstrap.Modal(document.getElementById('usernameModal')).show();
        setTimeout(() => document.getElementById('usernameModalInput').focus(), 300);
    }

    async function saveUsername() {
        const newName = document.getElementById('usernameModalInput').value.trim();
        const errEl = document.getElementById('usernameModalError');
        const saveBtn = document.getElementById('usernameSaveBtn');
        errEl.style.display = 'none';

        if (!newName) {
            errEl.textContent = 'Username cannot be empty.';
            errEl.style.display = 'block'; return;
        }

        if (newName === userName) {
            bootstrap.Modal.getInstance(document.getElementById('usernameModal'))?.hide();
            return;
        }

        // Loading state
        saveBtn.disabled = true;
        saveBtn.innerHTML = `<span class="spinner-border spinner-border-sm me-1"></span>Saving...`;

        const res = await fetch(`${apiBase}/ArcaneVaultUser/${userName}/username`, {
            method: 'PATCH',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ NewUserName: newName })
        });

        saveBtn.disabled = false;
        saveBtn.innerHTML = 'Save';

        if (res.status === 409) {
            errEl.textContent = 'This username is already taken.';
            errEl.style.display = 'block'; return;
        }
        if (!res.ok) {
            errEl.textContent = 'Failed to update username.';
            errEl.style.display = 'block'; return;
        }

        // Refresh session
        const refreshRes = await fetch(`/Settings?handler=RefreshSession&newUsername=${encodeURIComponent(newName)}`, {
            method: 'POST',
            headers: {
                'RequestVerificationToken':
                    document.querySelector('input[name="__RequestVerificationToken"]')?.value || ''
            }
        });

        if (!refreshRes.ok) {
            errEl.textContent = 'Username changed, but session refresh failed. Please log in again.';
            errEl.style.display = 'block';
            return;
        }

        bootstrap.Modal.getInstance(document.getElementById('usernameModal'))?.hide();
        showToast('Username updated. Refreshing...');
        setTimeout(() => window.location.reload(), 1200);
    }

    // ── Country modal ──
    function openCountryModal() {
        document.getElementById('countrySearchInput').value = '';
        document.getElementById('selectedCountryValue').value = '';
        document.getElementById('countryModalError').style.display = 'none';
        document.getElementById('countryDropdown').style.display = 'none';
        new bootstrap.Modal(document.getElementById('countryModal')).show();
        setTimeout(() => {
            document.getElementById('countrySearchInput').focus();
            renderCountryDropdown('');
        }, 300);
    }

    function renderCountryDropdown(query) {
        const dropdown = document.getElementById('countryDropdown');
        const filtered = query
            ? countries.filter(c => c.toLowerCase().includes(query.toLowerCase()))
            : countries;

        if (filtered.length === 0) {
            dropdown.innerHTML = '<div class="list-group-item text-muted">No countries found.</div>';
            dropdown.style.display = 'block';
            return;
        }

        dropdown.innerHTML = filtered.map(c => {
            const flag = flagMap[c] || '🌐';
            return `
                <a href="#" onclick="selectCountry('${c.replace(/'/g, "\\'")}', '${flag}'); return false;"
                    class="list-group-item list-group-item-action d-flex align-items-center gap-2"
                    style="font-size:13px;">
                    <span style="font-size:16px;line-height:1;">${flag}</span>${c}
                </a>`;
        }).join('');
        dropdown.style.display = 'block';
    }

    function selectCountry(country, flag) {
        document.getElementById('countrySearchInput').value = `${flag} ${country}`;
        document.getElementById('selectedCountryValue').value = country;
        document.getElementById('countryDropdown').style.display = 'none';
    }

    document.getElementById('countrySearchInput')?.addEventListener('focus', function () {
        renderCountryDropdown(this.value.replace(/^[\S]+\s/, '').trim());
    });

    document.getElementById('countrySearchInput')?.addEventListener('input', function () {
        document.getElementById('selectedCountryValue').value = '';
        renderCountryDropdown(this.value.trim());
    });

    document.addEventListener('click', function (e) {
        const input = document.getElementById('countrySearchInput');
        const dropdown = document.getElementById('countryDropdown');
        if (input && dropdown &&
            !input.contains(e.target) && !dropdown.contains(e.target)) {
            dropdown.style.display = 'none';
        }
    });

    async function saveCountry() {
        const country = document.getElementById('selectedCountryValue').value;
        const errEl = document.getElementById('countryModalError');
        const saveBtn = document.getElementById('countrySaveBtn');
        errEl.style.display = 'none';

        if (!country) {
            errEl.textContent = 'Please select a country from the list.';
            errEl.style.display = 'block'; return;
        }

        saveBtn.disabled = true;
        saveBtn.innerHTML = `<span class="spinner-border spinner-border-sm me-1"></span>Saving...`;

        const res = await fetch(`${apiBase}/ArcaneVaultUser/${userName}/country`, {
            method: 'PATCH',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ Country: country })
        });

        saveBtn.disabled = false;
        saveBtn.innerHTML = 'Save';

        if (!res.ok) {
            errEl.textContent = 'Failed to update country.';
            errEl.style.display = 'block'; return;
        }

        // Refresh session on the server to keep LoggedInUser in sync
        await fetch(`/Settings?handler=RefreshSession&newUsername=${encodeURIComponent(userName)}`, {
            method: 'POST',
            headers: {
                'RequestVerificationToken':
                    document.querySelector('input[name="__RequestVerificationToken"]')?.value || ''
            }
        });

        // Update display
        const flag = flagMap[country] || '🌐';
        document.getElementById('countryFlag').textContent = flag;
        document.getElementById('countryText').textContent = country;

        bootstrap.Modal.getInstance(document.getElementById('countryModal'))?.hide();
        showToast('Country updated.');
    }

    // ── Email modal ──
    function openEmailModal() {
        document.getElementById('newEmailInput').value = '';
        document.getElementById('emailPwdInput').value = '';
        document.getElementById('emailError').style.display = 'none';
        document.getElementById('emailPasswordError').style.display = 'none';
        document.getElementById('emailChangeError').style.display = 'none';
        new bootstrap.Modal(document.getElementById('emailModal')).show();
    }

    async function saveEmail() {
        const newEmail = document.getElementById('newEmailInput').value.trim();
        const password = document.getElementById('emailPwdInput').value;
        const errEl = document.getElementById('emailError');
        const errEP = document.getElementById('emailPasswordError');
        const errEC = document.getElementById('emailChangeError');
        errEl.style.display = 'none';
        errEP.style.display = 'none';
            errEC.style.display = 'none';

        if (!newEmail || !newEmail.includes('@@')) {
            errEl.textContent = 'Please enter a valid email address.';
            errEl.style.display = 'block';
            return;
        }
        if (!password) {
            errEl.textContent = 'Please enter your password.';
            errEl.style.display = 'block';
            return;
        }

        const res = await fetch(`${apiBase}/ArcaneVaultUser/${userName}/email`, {
            method: 'PATCH',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ NewEmail: newEmail, Password: password })
        });

        if (res.status === 409) {
            errEl.textContent = 'This email is already in use.';
            errEl.style.display = 'block';
            return;
        }
        if (res.status === 400) {
            errEP.textContent = 'Incorrect password.';
            errEP.style.display = 'block';
            return;
        }
        if (!res.ok) {
            errEC.textContent = 'Failed to update email.';
            errEC.style.display = 'block';
            return;
        }

        // Refresh session on the server to keep LoggedInUser in sync
        await fetch(`/Settings?handler=RefreshSession&newUsername=${encodeURIComponent(userName)}`, {
            method: 'POST',
            headers: {
                'RequestVerificationToken':
                    document.querySelector('input[name="__RequestVerificationToken"]')?.value || ''
            }
        });

        document.getElementById('emailDisplay').value = newEmail;
        bootstrap.Modal.getInstance(document.getElementById('emailModal'))?.hide();
        showToast('Email updated.');
    }

    // ── Password modal ──
    function openPasswordModal() {
        ['currentPwdInput','newPwdInput','confirmPwdInput'].forEach(id => {
            document.getElementById(id).value = '';
        });
        document.getElementById('pwdError').style.display = 'none';
        new bootstrap.Modal(document.getElementById('passwordModal')).show();
    }

    // Email Password toggle
    document.getElementById("emailTogglePassword").addEventListener("click", function () {
        const input = document.getElementById("emailPwdInput");
        const icon = document.getElementById("emailPwdEyeIcon");
        if (input.type === "password") {
            input.type = "text";
            icon.classList.replace("bi-eye", "bi-eye-slash");
        } else {
            input.type = "password";
            icon.classList.replace("bi-eye-slash", "bi-eye");
        }
    });

    // Reset New Password toggle
    document.getElementById("resetNewTogglePassword").addEventListener("click", function () {
        const input = document.getElementById("resetNewPwdInput");
        const icon = document.getElementById("resetNewEyeIcon");
        if (input.type === "password") {
            input.type = "text";
            icon.classList.replace("bi-eye", "bi-eye-slash");
        } else {
            input.type = "password";
            icon.classList.replace("bi-eye-slash", "bi-eye");
        }
    });

    // Reset Confirm Password toggle
    document.getElementById("resetConfirmTogglePassword").addEventListener("click", function () {
        const input = document.getElementById("resetConfirmPwdInput");
        const icon = document.getElementById("resetConfirmEyeIcon");
        if (input.type === "password") {
            input.type = "text";
            icon.classList.replace("bi-eye", "bi-eye-slash");
        } else {
            input.type = "password";
            icon.classList.replace("bi-eye-slash", "bi-eye");
        }
    });

    // Current Password toggle
    document.getElementById("currentTogglePassword").addEventListener("click", function () {
        const input = document.getElementById("currentPwdInput");
        const icon = document.getElementById("currentEyeIcon");
        if (input.type === "password") {
            input.type = "text";
            icon.classList.replace("bi-eye", "bi-eye-slash");
        } else {
            input.type = "password";
            icon.classList.replace("bi-eye-slash", "bi-eye");
        }
    });

    // New Password toggle
    document.getElementById("newTogglePassword").addEventListener("click", function () {
        const input = document.getElementById("newPwdInput");
        const icon = document.getElementById("newEyeIcon");
        if (input.type === "password") {
            input.type = "text";
            icon.classList.replace("bi-eye", "bi-eye-slash");
        } else {
            input.type = "password";
            icon.classList.replace("bi-eye-slash", "bi-eye");
        }
    });

    // Confirm New Password toggle
    document.getElementById("confirmTogglePassword").addEventListener("click", function () {
        const input = document.getElementById("confirmPwdInput");
        const icon = document.getElementById("confirmEyeIcon");
        if (input.type === "password") {
            input.type = "text";
            icon.classList.replace("bi-eye", "bi-eye-slash");
        } else {
            input.type = "password";
            icon.classList.replace("bi-eye-slash", "bi-eye");
        }
    });

    async function savePassword() {
        const current  = document.getElementById('currentPwdInput').value;
        const newPwd   = document.getElementById('newPwdInput').value;
        const confirm  = document.getElementById('confirmPwdInput').value;
        const errEl    = document.getElementById('pwdError');
        errEl.style.display = 'none';

        if (!current || !newPwd || !confirm) {
            errEl.textContent   = 'Please fill in all fields.';
            errEl.style.display = 'block'; return;
        }
        if (newPwd.length < 6) {
            errEl.textContent   = 'New password must be at least 6 characters.';
            errEl.style.display = 'block'; return;
        }
        if (newPwd !== confirm) {
            errEl.textContent   = 'Passwords do not match.';
            errEl.style.display = 'block'; return;
        }

        const res = await fetch(`${apiBase}/ArcaneVaultUser/${userName}/password`, {
            method: 'PATCH',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ CurrentPassword: current, NewPassword: newPwd })
        });

        if (res.status === 400) {
            errEl.textContent   = 'Current password is incorrect.';
            errEl.style.display = 'block'; return;
        }
        if (!res.ok) {
            errEl.textContent   = 'Failed to update password.';
            errEl.style.display = 'block'; return;
        }

        bootstrap.Modal.getInstance(document.getElementById('passwordModal'))?.hide();
        showToast('Password updated.');
    }

    async function toggleStaffActive(isActive) {
        const jwtToken = document.getElementById('jwtTokenInput')?.value;
        const res = await fetch(`${apiBase}/ArcaneVaultUser/${userName}/active-status`, {
            method: 'PATCH',
            headers: { 'Content-Type': 'application/json', 'Authorization': `Bearer ${jwtToken}` },
            body: JSON.stringify({ IsActive: isActive })
        });
        if (!res.ok) {
            alert('Failed to update availability.');
            document.getElementById('staffActiveToggle').checked = !isActive;
            return;
        }
        showToast(isActive ? 'You are now receiving assignments.' : 'You will no longer receive new assignments.');
    }

    // ── Reset Password (forgot-password style, from within Settings) ──
    let resetCodeSent = false;
    let resetTimerInterval = null;
    let resetCooldownUntil = 0;

    function openResetPasswordModal() {
        resetCodeSent = false;
        document.getElementById('resetEmailDisplay').textContent = document.getElementById('emailDisplay').value;
        document.getElementById('codeInputSection').style.display = 'none';
        document.getElementById('sendCodeBtn').style.display = 'block';
        document.getElementById('verifyCodeBtn').style.display = 'none';
        document.getElementById('resendText').style.display = 'none';
        document.getElementById('resetStep1Error').style.display = 'none';
        document.querySelectorAll('.code-cell').forEach(c => c.value = '');
        new bootstrap.Modal(document.getElementById('resetStep1Modal')).show();
    }

    async function sendResetCode() {
        const errEl = document.getElementById('resetStep1Error');
        errEl.style.display = 'none';

        const sendBtn = document.getElementById('sendCodeBtn');
        sendBtn.disabled = true;
        sendBtn.textContent = 'Sending...';

        const res = await fetch(`${apiBase}/ArcaneVaultUser/request-reset-code`, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ UserName: userName })
        });

        if (res.status === 429) {
            const text = await res.text();
            errEl.textContent = text;
            errEl.style.display = 'block';
            sendBtn.disabled = false;
            sendBtn.textContent = 'Send verification code';
            return;
        }

        if (!res.ok) {
            errEl.textContent = 'Failed to send code. Please try again.';
            errEl.style.display = 'block';
            sendBtn.disabled = false;
            sendBtn.textContent = 'Send verification code';
            return;
        }

        resetCodeSent = true;
        resetCooldownUntil = Date.now() + 120000;
        sendBtn.style.display = 'none';
        document.getElementById('codeInputSection').style.display = 'block';
        document.getElementById('verifyCodeBtn').style.display = 'inline-block';
        document.getElementById('resendText').style.display = 'block';
        startResendCooldownDisplay();

        document.querySelectorAll('.code-cell').forEach(c => c.value = '');
        document.querySelector('.code-cell').focus();
    }

    function startResendCooldownDisplay() {
        const resendEl = document.getElementById('resendText');
        if (resetTimerInterval) clearInterval(resetTimerInterval);

        resetTimerInterval = setInterval(() => {
            const secondsLeft = Math.ceil((resetCooldownUntil - Date.now()) / 1000);
            if (secondsLeft <= 0) {
                resendEl.innerHTML = `Didn't get it? <a href="#" onclick="sendResetCode(); return false;">Resend code</a>`;
                clearInterval(resetTimerInterval);
            } else {
                resendEl.innerHTML = `Didn't get it? Resend available in ${secondsLeft}s`;
            }
        }, 1000);
    }

    // Wire up the 6 code cells: auto-advance, backspace navigation, digit-only
    document.querySelectorAll('.code-cell').forEach((cell, idx, cells) => {
        cell.addEventListener('input', () => {
            cell.value = cell.value.replace(/[^0-9]/g, '');
            if (cell.value && idx < cells.length - 1) cells[idx + 1].focus();
        });
        cell.addEventListener('keydown', (e) => {
            if (e.key === 'Backspace' && !cell.value && idx > 0) cells[idx - 1].focus();
        });
    });

    async function verifyResetCode() {
        const errEl = document.getElementById('resetStep1Error');
        errEl.style.display = 'none';

        const code = Array.from(document.querySelectorAll('.code-cell')).map(c => c.value).join('');
        if (code.length !== 6) {
            errEl.textContent = 'Please enter all 6 digits.';
            errEl.style.display = 'block';
            return;
        }

        const res = await fetch(`${apiBase}/ArcaneVaultUser/verify-reset-code`, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ UserName: userName, Code: code })
        });

        if (!res.ok) {
            const text = await res.text();
            errEl.textContent = text || 'Invalid or expired code.';
            errEl.style.display = 'block';
            return;
        }

        // Store verified code for the final reset call
        window._verifiedResetCode = code;

        bootstrap.Modal.getInstance(document.getElementById('resetStep1Modal'))?.hide();
        document.getElementById('resetNewPwdInput').value = '';
        document.getElementById('resetConfirmPwdInput').value = '';
        document.getElementById('resetStep2Error').style.display = 'none';
        setTimeout(() => new bootstrap.Modal(document.getElementById('resetStep2Modal')).show(), 300);
    }

    async function submitNewPassword() {
        const newPwd = document.getElementById('resetNewPwdInput').value;
        const confirmPwd = document.getElementById('resetConfirmPwdInput').value;
        const errEl = document.getElementById('resetStep2Error');
        errEl.style.display = 'none';

        if (!newPwd || !confirmPwd) {
            errEl.textContent = 'Please fill in both fields.';
            errEl.style.display = 'block'; return;
        }
        if (newPwd.length < 6) {
            errEl.textContent = 'Password must be at least 6 characters.';
            errEl.style.display = 'block'; return;
        }
        if (newPwd !== confirmPwd) {
            errEl.textContent = 'Passwords do not match.';
            errEl.style.display = 'block'; return;
        }

        const res = await fetch(`${apiBase}/ArcaneVaultUser/reset-password`, {
            method: 'PATCH',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ UserName: userName, Code: window._verifiedResetCode, NewPassword: newPwd })
        });

        if (!res.ok) {
            const text = await res.text();
            errEl.textContent = text || 'Failed to reset password.';
            errEl.style.display = 'block';
            return;
        }

        bootstrap.Modal.getInstance(document.getElementById('resetStep2Modal'))?.hide();
        showToast('Password successfully changed.');
    }

    // ── Disable modal ──
    function openDisableModal() {
        new bootstrap.Modal(document.getElementById('disableModal')).show();
    }

    async function disableAccount() {
        const res = await fetch(`${apiBase}/ArcaneVaultUser/${userName}/disable`, {
            method: 'PATCH'
        });
        if (!res.ok) { alert('Failed to disable account.'); return; }

        // Clear session + redirect to login
        window.location.href = '/Login?handler=Logout';
    }

    // ── Delete modal ──
    function openDeleteModal() {
        document.getElementById('deleteConfirmInput').value = '';
        document.getElementById('deleteError').style.display = 'none';
        new bootstrap.Modal(document.getElementById('deleteModal')).show();
    }

    async function deleteAccount() {
        const input = document.getElementById('deleteConfirmInput').value.trim();
        const errEl = document.getElementById('deleteError');
        errEl.style.display = 'none';

        if (input !== 'DELETE') {
            errEl.textContent   = 'Please type DELETE to confirm.';
            errEl.style.display = 'block'; return;
        }

        // Delete showoff images from Cloudinary first
        try {
            const showoffsRes = await fetch(`${apiBase}/Showoff/user/${userName}`);
            const showoffs    = await showoffsRes.json();
            for (const s of showoffs) {
                const items = s.items || s.Items || [];
                for (const item of items) {
                    const pid = item.imagePublicId || item.ImagePublicId;
                    if (pid) {
                        await fetch(`${apiBase}/ImageUpload`, {
                            method: 'DELETE',
                            headers: { 'Content-Type': 'application/json' },
                            body: JSON.stringify(pid)
                        });
                    }
                }
            }
        } catch (e) { /* continue even if Cloudinary cleanup fails */ }

        const res = await fetch(`${apiBase}/ArcaneVaultUser/${userName}/delete`, {
            method: 'DELETE'
        });

        if (!res.ok) { alert('Failed to delete account.'); return; }

        // Clear session + redirect
        window.location.href = '/Login?handler=Logout';
    }
</script>
}