@page
@model ArcaneVaultRP.Pages.Showoffs.IndexModel
@{
    ViewData["Title"] = "Showoffs";
    var userJson = HttpContext.Session.GetString(SessionKeys.LoggedInUser);
    var loggedInUser = userJson != null ? System.Text.Json.JsonSerializer.Deserialize<Models.ArcaneVaultUser>(userJson) : null;
}

<div class="container mt-4">

    <ul class="nav nav-tabs mb-4">
        <li class="nav-item">
            <a class="nav-link @(Model.ActiveTab == "feed" ? "active" : "")"
               asp-page="./Index" asp-route-tab="feed">
                Feed
            </a>
        </li>
        <li class="nav-item">
            <a class="nav-link @(Model.ActiveTab == "profile" ? "active" : "")"
               asp-page="./Index" asp-route-tab="profile">
                My Profile
            </a>
        </li>
    </ul>

    @if (Model.ActiveTab == "feed")
    {
        <div class="d-flex justify-content-between align-items-center mb-3">
            <h4 class="fw-bold mb-0">Community Showoffs</h4>
            <div class="d-flex gap-2">
                <select id="sortSelect" class="form-select form-select-sm" style="width:auto;">
                    <option value="popular" selected="@(Model.SortBy == "popular")">Most Popular</option>
                    <option value="newest" selected="@(Model.SortBy == "newest")">Newest</option>
                    <option value="least" selected="@(Model.SortBy == "least")">Least Popular</option>
                </select>
            </div>
        </div>

        <div class="row g-2 mb-4">
            <div class="col-md-4 position-relative">
                <input type="text" id="searchUsers" class="form-control"
                       placeholder="Search users..." autocomplete="off"
                       value="@Model.SearchUser"/>
                <div id="userSuggestions" class="list-group position-absolute z-3"
                     style="width:100%;max-height:200px;overflow-y:auto;display:none;">
                </div>
            </div>
            <div class="col-md-4 position-relative">
                <input type="text" id="searchItems" class="form-control"
                       placeholder="Search items..." autocomplete="off"
                       value="@Model.SearchItem"/>
                <div id="itemSuggestions" class="list-group position-absolute z-3"
                     style="width:100%;max-height:200px;overflow-y:auto;display:none;">
                </div>
            </div>
            <div class="col-md-4 position-relative">
                <input type="text" id="searchCategories" class="form-control"
                       placeholder="Search categories..." autocomplete="off"
                       value="@Model.SearchCategory"/>
                <div id="categorySuggestions" class="list-group position-absolute z-3"
                     style="width:100%;max-height:200px;overflow-y:auto;display:none;">
                </div>
            </div>
        </div>

        <!-- Recent category bubbles: only shown when there are recent searches -->
        <div class="d-flex flex-wrap gap-2 mb-3 align-items-center" id="recentCatBubbles" style="display:none;"></div>

        <div id="showoffGridContainer">

            <div class="row row-cols-1 row-cols-md-4 g-3 mb-4">
                @foreach (var showoff in Model.PagedShowoffs)
                {
                    <div class="col">
                        <div class="showoff-card card border-0 shadow-sm h-100 position-relative" style="@(string.IsNullOrEmpty(showoff.BackgroundImagePath) ? $"background-color: {showoff.BackgroundColor};" : $"background-image: url('{showoff.BackgroundImagePath}'); background-size: cover; background-position: center;") cursor:pointer; overflow:hidden; border-radius:14px;" onclick="viewShowoff(@showoff.ShowoffId, '@showoff.UserName')">
                            <div class="owner-overlay position-absolute top-0 start-0 p-2"
                                 data-username="@showoff.UserName"
                                 style="display:none; background:rgba(0,0,0,0.5); color:white; border-radius:6px; font-size:12px;">
                                <div class="d-flex align-items-center gap-2">
                                    <div class="owner-overlay-avatar" style="width:20px;height:20px;border-radius:50%;overflow:hidden;background:rgba(255,255,255,0.2);display:flex;align-items:center;justify-content:center;font-size:10px;font-weight:700;flex-shrink:0;">
                                        @(showoff.UserName?.Length > 0 ? showoff.UserName[0].ToString().ToUpper() : "?")
                                    </div>
                                    <span>@showoff.UserName</span>
                                </div>
                            </div>

                            <div class="card-body d-flex justify-content-center align-items-center gap-2 p-3"
                                 style="min-height:160px;">
                                @{
                                    var items = showoff.Items.OrderBy(i => i.DisplayOrder).ToList();
                                }
                                @foreach (var item in items)
                                {
                                    <div class="showoff-item-cell text-center">
                                        @if (!string.IsNullOrEmpty(item.ImagePath))
                                        {
                                            <img src="@item.ImagePath"
                                                 alt="@item.ItemName"
                                                 style="max-width:70px;max-height:70px;width:auto;height:auto;object-fit:contain;" />
                                        }
                                        else
                                        {
                                            <div style="width:70px;height:70px;background:rgba(255,255,255,0.3);border-radius:8px;"></div>
                                        }
                                    </div>
                                }
                            </div>

                            <div class="card-footer d-flex justify-content-between align-items-center"
                                 style="background: var(--bg-card, #161b22); border-top: 1px solid var(--border-color, #30363d) !important; border-radius: 0 0 14px 14px !important; margin: 0; width: 100%;">
                                <span class="fw-semibold text-truncate" style="max-width:120px;">@showoff.ShowoffName</span>
                                <span class="text-muted small">
                                    <i class="bi bi-heart-fill text-danger"></i> @showoff.LikeCount
                                    <i class="bi bi-eye-fill ms-2"></i> @showoff.ViewCount
                                </span>
                            </div>
                        </div>
                    </div>
                }
            </div>

            @if (!Model.PagedShowoffs.Any())
            {
                <div class="text-center text-muted py-5">
                    <p>No showoffs found.</p>
                </div>
            }

            @if (Model.TotalPages > 1)
            {
                <nav>
                    <ul class="pagination justify-content-center">
                        <li class="page-item @(Model.CurrentPage <= 1 ? "disabled" : "")">
                            <a class="page-link ajax-page-link" href="#" data-page="@(Model.CurrentPage - 1)">&lt;</a>
                        </li>

                        @{
                            var startPage = Math.Max(1, Model.CurrentPage - 1);
                            var endPage = Math.Min(startPage + 2, Model.TotalPages);
                            if (endPage - startPage < 2) startPage = Math.Max(1, endPage - 2);
                        }

                        @for (int p = startPage; p <= endPage; p++)
                        {
                            <li class="page-item">
                                <a class="page-link ajax-page-link @(p == Model.CurrentPage ? "active-page" : "")"
                                   href="#"
                                   data-page="@p"
                                   style="@(p == Model.CurrentPage ? "background:#0d6efd;color:white;border-radius:50%;width:36px;height:36px;display:flex;align-items:center;justify-content:center;" : "")">
                                    @p
                                </a>
                            </li>
                        }

                        @if (endPage < Model.TotalPages)
                        {
                            <li class="page-item disabled">
                                <span class="page-link">...</span>
                            </li>
                            <li class="page-item">
                                <a class="page-link ajax-page-link" href="#" data-page="@Model.TotalPages">@Model.TotalPages</a>
                            </li>
                        }

                        <li class="page-item @(Model.CurrentPage >= Model.TotalPages ? "disabled" : "")">
                            <a class="page-link ajax-page-link" href="#" data-page="@(Model.CurrentPage + 1)">&gt;</a>
                        </li>
                    </ul>
                </nav>
            }

        </div>
    }
    else
    {
        <!-- Profile header -->
        <div class="d-flex align-items-center justify-content-between mb-4">
            <div class="d-flex align-items-center gap-3">
                <div style="width:48px;height:48px;border-radius:50%;overflow:hidden;background:var(--bg-card-hover,#2a3f4a);border:2px solid var(--border-color,#30363d);display:flex;align-items:center;justify-content:center;font-size:16px;font-weight:700;color:var(--text-secondary,#c9d1d9);">
                    @if (!string.IsNullOrEmpty(loggedInUser?.AvatarUrl))
                    {
                        <img src="@loggedInUser.AvatarUrl" style="width:100%;height:100%;object-fit:cover;" />
                    }
                    else
                    {
                        @(loggedInUser?.UserName?.Length > 0 ? loggedInUser.UserName[0].ToString().ToUpper() : "?")
                    }
                </div>
                <div>
                    <h5 class="fw-bold mb-0">@loggedInUser?.UserName</h5>
                    <small class="text-muted">@Model.UserShowoffs.Count showoff@(Model.UserShowoffs.Count != 1 ? "s" : "")</small>
                </div>
            </div>
        </div>

        <!-- Showoff rows — single column -->
        <div class="d-flex flex-column gap-3">
            <a asp-page="./Create" class="text-decoration-none">
                <div style="background:var(--bg-card,#161b22);border:2px dashed var(--border-color,#30363d);border-radius:10px;padding:28px 20px;cursor:pointer;display:flex;align-items:center;justify-content:center;gap:12px;color:var(--text-muted,#484f58);font-size:14px;transition:border-color 0.15s,color 0.15s;"
                     onmouseenter="this.style.borderColor='var(--color-teal,#2dd4bf)';this.style.color='var(--color-teal,#2dd4bf)';"
                     onmouseleave="this.style.borderColor='var(--border-color,#30363d)';this.style.color='var(--text-muted,#484f58)';">
                    <div class="d-flex gap-2">
                        @for (int i = 0; i < 3; i++)
                        {
                            <div style="width:36px;height:36px;border:2px dashed currentColor;border-radius:6px;display:flex;align-items:center;justify-content:center;opacity:0.6;">
                                <i class="bi bi-plus"></i>
                            </div>
                        }
                    </div>
                    <span>Create new showoff</span>
                </div>
            </a>
            
            @foreach (var showoff in Model.UserShowoffs)
            {
                <div class="card border-0 shadow-sm" style="background:var(--bg-card,#161b22);border:1px solid var(--border-color,#21262d) !important;border-radius:10px;">
                    <div class="card-body d-flex gap-3 p-3">
                        <!-- Thumbnail preview -->
                        <div onclick="viewShowoff(@showoff.ShowoffId, '@showoff.UserName')" style="cursor:pointer;flex-shrink:0;width:160px;height:90px;border-radius:8px;overflow:hidden; @(string.IsNullOrEmpty(showoff.BackgroundImagePath) ? $"background-color:{showoff.BackgroundColor};" : $"background-image:url('{showoff.BackgroundImagePath}');background-size:cover;background-position:center;") display:flex;align-items:center;justify-content:center;gap:6px;">
                            @foreach (var item in showoff.Items.OrderBy(i => i.DisplayOrder))
                            {
                                @if (!string.IsNullOrEmpty(item.ImagePath))
                                {
                                    <img src="@item.ImagePath" style="width:45px;height:45px;object-fit:cover;border-radius:6px;"/>
                                }
                                else
                                {
                                    <div style="width:45px;height:45px;background:rgba(255,255,255,0.3);border-radius:6px;"></div>
                                }
                            }
                        </div>

                        <!-- Details -->
                        <div class="d-flex flex-column gap-1" style="flex:1;min-width:0;">
                            <div class="d-flex align-items-center gap-2">
                                <button onclick="viewShowoff(@showoff.ShowoffId, '@showoff.UserName')" class="fw-bold" style="background:none;border:none;padding:0;cursor:pointer;font-size:15px;font-family:inherit;color:var(--text-primary,#e6edf3);text-align:left;">
                                    @showoff.ShowoffName
                                </button>
                                @if (showoff.IsDisabled)
                                {
                                    <span style="font-size:10px;font-weight:600;color:#f85149;background:#2a1f1d;padding:2px 7px;border-radius:4px;">DISABLED</span>
                                }
                                else if (showoff.IsPrivate)
                                {
                                    <span style="font-size:10px;font-weight:600;color:#7d8590;background:var(--bg-card-hover,#21262d);padding:2px 7px;border-radius:4px;">Private</span>
                                }
                                else
                                {
                                    <span style="font-size:10px;font-weight:600;color:#3fb950;background:#122016;padding:2px 7px;border-radius:4px;">Public</span>
                                }
                            </div>

                            @if (!string.IsNullOrEmpty(showoff.Description))
                            {
                                <p class="mb-0 text-muted" style="font-size:13px;overflow:hidden;display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;">@showoff.Description</p>
                            }

                            <!-- Stats -->
                            <div class="d-flex flex-wrap gap-3 text-muted" style="font-size:12px;">
                                <span>❤️ @showoff.LikeCount likes</span>
                                <span>👁 @showoff.ViewCount views</span>
                                <span>💬 @showoff.CommentCount</span>
                                <span>Created @showoff.CreatedAt.ToString("MMM dd, yyyy")</span>
                            </div>

                            <!-- Actions -->
                            <div class="d-flex gap-2 mt-auto">
                                <button class="btn btn-sm" style="background:var(--bg-card-hover,#21262d);border:1px solid var(--border-color,#30363d);color:var(--text-primary,#e6edf3);font-size:12px;padding:5px 10px;" onclick="viewShowoff(@showoff.ShowoffId, '@showoff.UserName')">
                                    View
                                </button>
                                <a class="btn btn-sm" style="background:var(--bg-card-hover,#21262d);border:1px solid var(--border-color,#30363d);color:var(--text-primary,#e6edf3);font-size:12px;padding:5px 10px;" asp-page="./Edit" asp-route-id="@showoff.ShowoffId">
                                    Edit
                                </a>
                                <button class="btn btn-sm" style="background:#2a1f1d;border:1px solid #5a2030;color:#f85149;font-size:12px;padding:5px 10px;" onclick="openDeleteConfirm(@showoff.ShowoffId, '@showoff.ShowoffName')">
                                    Delete
                                </button>
                                @if (!showoff.IsPrivate)
                                {
                                    <button class="btn btn-sm" style="background:none;border:1px solid var(--border-color,#21262d);color:var(--text-muted,#7d8590);font-size:12px;padding:5px 10px;" onclick="navigator.clipboard.writeText(window.location.origin + '/ShowoffPages/Index?tab=feed')">
                                        Share
                                    </button>
                                }
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>

<div class="modal fade" id="viewShowoffModal" tabindex="-1">
    <div class="modal-dialog modal-lg modal-dialog-centered" style="min-height: 80vh;">
        <div class="modal-content" style="min-height: 80vh; display: flex; flex-direction: column; overflow: hidden; background: var(--bg-card, #161b22); border: 1px solid var(--border-color, #30363d); border-radius: 14px;">
            <!-- Header -->
            <div class="modal-header border-bottom" style="border-color:var(--border-color,#21262d) !important;">
                <div>
                    <h5 class="modal-title fw-bold" id="viewShowoffName"></h5>
                    <span id="viewDisabledBadge" style="display:none;font-size:11px;color:#f85149;background:#2a1f1d;padding:2px 8px;border-radius:4px;font-weight:600;">
                        DISABLED BY STAFF
                    </span>
                </div>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>

            <!-- Scrollable body -->
            <div style="overflow-y:auto;flex:1;">
                <!-- Canvas display -->
                <div class="d-flex justify-content-center p-3 pb-0" id="viewShowoffBody">
                </div>

                <!-- Details section -->
                <div class="d-flex flex-column gap-2 p-3">
                    <!-- Description -->
                    <p id="viewDescription" class="mb-0" style="font-size:14px;color:var(--text-secondary,#c9d1d9);line-height:1.6;display:none;"></p>

                    <!-- Item name chips -->
                    <div id="viewItemChips" class="d-flex flex-wrap gap-2" style="display:none;"></div>

                    <!-- Category tags -->
                    <div id="viewCategoryTags" class="d-flex flex-wrap gap-1" style="display:none;"></div>

                    <!-- Meta row -->
                    <div class="d-flex flex-wrap gap-3" style="font-size:12px;color:var(--text-muted,#7d8590);">
                        <span>❤️ <span id="likeCount">0</span> likes</span>
                        <span>👁 <span id="viewCountDisplay">0</span> views</span>
                        <span id="viewCreatedAt"></span>
                    </div>

                    <!-- Owner -->
                    <div class="d-flex align-items-center gap-2" id="viewOwnerInfo">
                        <div style="width:32px;height:32px;border-radius:50%;background:linear-gradient(135deg,#2a3f4a,#1a3a5c);border:2px solid var(--border-color,#30363d);display:flex;align-items:center;justify-content:center;font-size:11px;font-weight:700;color:var(--text-secondary,#c9d1d9);overflow:hidden;" id="viewOwnerAvatar"></div>    
                        <span style="font-size:13px;color:#58a6ff;font-weight:600;" id="viewOwnerName"></span>
                    </div>

                    <!-- Disabled notice for owner -->
                    <div id="viewDisabledNotice" style="display:none;background:#2a1f1d;border:1px solid #5a2030;border-radius:8px;padding:14px;">
                        <p style="margin:0 0 8px;font-size:13px;color:#f85149;font-weight:600;">This showoff has been disabled by staff.</p>
                        <p style="margin:0 0 10px;font-size:13px;color:var(--text-secondary,#c9d1d9);">To appeal this decision, please contact our support team.</p>
                        <a id="appealLink" href="#" style="display:inline-block;background:#f85149;border:none;border-radius:6px;padding:7px 16px;font-size:13px;font-weight:600;color:#fff;text-decoration:none;">
                            Appeal
                        </a>
                    </div>

                    <!-- Action buttons -->
                    <div class="d-flex flex-wrap gap-2">
                        <button type="button" class="btn btn-sm" id="likeBtn" onclick="toggleLike()"
                                style="display:flex;align-items:center;gap:6px;background:var(--bg-card-hover,#21262d);border:1px solid var(--border-color,#30363d);border-radius:7px;padding:7px 14px;font-size:13px;color:var(--text-muted,#7d8590);">
                            <i class="bi bi-heart" id="likeIcon"></i>
                            <span id="likeBtnText">Like</span>
                        </button>
                        <button type="button" class="btn btn-sm" onclick="shareShowoff()"
                                style="display:flex;align-items:center;gap:6px;background:var(--bg-card-hover,#21262d);border:1px solid var(--border-color,#30363d);border-radius:7px;padding:7px 14px;font-size:13px;color:var(--text-muted,#7d8590);">
                            <i class="bi bi-share"></i>
                            <span id="shareText">Share</span>
                        </button>
                        <button type="button" class="btn btn-sm" onclick="openReportModal()" id="reportBtn"
                                style="display:flex;align-items:center;gap:6px;background:var(--bg-card-hover,#21262d);border:1px solid var(--border-color,#30363d);border-radius:7px;padding:7px 14px;font-size:13px;color:var(--text-muted,#7d8590);">
                            <i class="bi bi-flag"></i> Report
                        </button>
                    </div>
                </div>

                <!-- Comments section -->
                <div class="p-3 pt-0" style="border-top:1px solid var(--border-color,#21262d);" id="commentsSection">
                    <h6 class="fw-bold mb-3 pt-3" style="font-size:14px;">
                        Comments (<span id="commentCountDisplay">0</span>)
                    </h6>
                    <div class="d-flex gap-2 mb-3">
                        <input type="text" id="commentInput" class="form-control form-control-sm"
                               placeholder="Write a comment..." maxlength="500"
                               onkeydown="if(event.key==='Enter')postComment()"/>
                        <button class="btn btn-sm" onclick="postComment()"
                                style="background:#2dd4bf;border:none;border-radius:7px;padding:8px 14px;font-size:13px;font-weight:600;color:#0d1117;">
                            Post
                        </button>
                    </div>
                    <div id="commentsList"></div>
                    <button id="loadMoreComments" class="btn btn-sm btn-outline-secondary w-100 mt-2"
                            style="display:none;" onclick="loadMoreComments()">
                        Load more comments
                    </button>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="deleteConfirmModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header border-0">
                <h5 class="modal-title fw-bold">Delete Showoff</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <p>Are you sure you want to delete <strong id="deleteShowoffName"></strong>?</p>
                <p class="text-danger small">This cannot be undone.</p>
            </div>
            <div class="modal-footer border-0">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-danger" onclick="confirmDelete()">Yes, delete</button>
            </div>
        </div>
    </div>
</div>

</div>
</div>
</div>

<!-- Report Modal -->
<div class="modal fade" id="reportModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header border-0">
                <h5 class="modal-title fw-bold">Report Showoff</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <div class="mb-3">
                    <label class="form-label fw-semibold">Reason</label>
                    <select id="reportCategory" class="form-select">
                        <option value="" disabled selected>Select a reason...</option>
                        <option value="Counterfeit / Fake item">Counterfeit / Fake item</option>
                        <option value="Inappropriate content">Inappropriate content</option>
                        <option value="Spam or self-promotion">Spam or self-promotion</option>
                        <option value="Copyright infringement">Copyright infringement</option>
                        <option value="Misleading information">Misleading information</option>
                        <option value="Harassment or hate speech">Harassment or hate speech</option>
                        <option value="Other reasons">Other reasons</option>
                    </select>
                    <div id="reportCategoryError" class="text-danger small mt-1" style="display:none;">Please select a reason.</div>
                </div>
                <div class="mb-3">
                    <label class="form-label fw-semibold">Additional Details (optional)</label>
                    <textarea id="reportReason" class="form-control" rows="3" maxlength="500" placeholder="Describe the issue..."></textarea>
                </div>
            </div>
            <div class="modal-footer border-0">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-warning" onclick="submitReport()">Submit Report</button>
            </div>
        </div>
    </div>
</div>

<!-- Report Feedback Modal -->
<div class="modal fade" id="reportFeedbackModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow">
            <div class="modal-body p-4 text-center">
                <i id="reportFeedbackIcon" class="bi bi-check-circle-fill text-success fs-1 mb-3 d-block"></i>
                <h5 class="fw-bold mb-2" id="reportFeedbackTitle">Report Submitted</h5>
                <p class="text-muted mb-4" style="font-size:14px;" id="reportFeedbackText">
                    A staff member will review it shortly.
                </p>
                <button type="button" class="btn btn-primary px-4" data-bs-dismiss="modal">OK</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        // Fix — prevent aria-hidden focus warning when closing modals
        document.querySelectorAll('.modal').forEach(modalEl => {
            modalEl.addEventListener('hide.bs.modal', () => {
                if (modalEl.contains(document.activeElement)) {
                    document.activeElement.blur();
                }
            });
        });

        // Data from server
        // Fix 5 — normalize currentUser to null when empty, so ownership/like checks behave correctly
        const currentUser = '@loggedInUser?.UserName' === '' ? null : '@loggedInUser?.UserName';
        const apiBase = 'https://localhost:7040/api';
        const userCollectionItems = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.UserCollectionItems));

        const allCategories = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.Categories));

        // State
        let pendingDeleteId = null;
        let pendingDeleteName = null;
        const avatarCache = {}; // username -> avatarUrl string | null

        // ── View Showoff ──
        // Fix 2 — handle both camelCase and PascalCase API payloads, guard against failed fetch
        async function viewShowoff(showoffId, ownerName) {
            currentViewShowoffId = showoffId;

            // Fetch showoff details
            const res = await fetch(`${apiBase}/Showoff/${showoffId}`);
            if (!res.ok) { alert('Could not load showoff.'); return; }
            const showoff = await res.json();

            // Check if user liked
            const likeRes = await fetch(`${apiBase}/ShowoffLike/${showoffId}?userName=${currentUser}`);
            const likeData = await likeRes.json();

            document.getElementById('viewShowoffName').textContent = showoff.showoffName || showoff.ShowoffName;
            document.getElementById('likeCount').textContent = likeData.likeCount ?? likeData.LikeCount ?? 0;
            document.getElementById('likeBtn').dataset.showoffId = showoffId;
            document.getElementById('likeBtn').dataset.liked = likeData.userLiked ?? likeData.UserLiked ?? false;

            const icon = document.getElementById('likeIcon');
            const liked = likeData.userLiked ?? likeData.UserLiked ?? false;
            // Fix 4 — grey heart if not liked, red if liked
            icon.className = liked ? 'bi bi-heart-fill text-danger' : 'bi bi-heart text-secondary';

            const bgColor = showoff.backgroundColor || showoff.BackgroundColor;
            const bgImagePath = showoff.backgroundImagePath || showoff.BackgroundImagePath;
            const items = showoff.items || showoff.Items || [];
            const userName = showoff.userName || showoff.UserName;
            const description = showoff.description || showoff.Description || '';
            const isDisabled = showoff.isDisabled ?? showoff.IsDisabled ?? false;
            const viewCount = showoff.viewCount ?? showoff.ViewCount ?? 0;
            const createdAt = showoff.createdAt || showoff.CreatedAt || '';
            const commentCount = showoff.commentCount ?? showoff.CommentCount ?? 0;

            const body = document.getElementById('viewShowoffBody');

            // Same canvas layout as the Create page preview: flex cells, full image (object-fit:contain), dashed dividers
            const itemCount = items.length;
            const cellsHtml = items.map((item, idx) => {
                const imgPath = item.imagePath || item.ImagePath;
                const itemName = item.itemName || item.ItemName;
                const borderStyle = idx === itemCount - 1 ? '' : 'border-right: 1px dashed rgba(166,177,225,0.15);';
                return `
                <div class="d-flex align-items-center justify-content-center p-2" style="flex:1; overflow:hidden; ${borderStyle}">
                    ${imgPath
                        ? `<img src="${imgPath}" style="max-width:100%; max-height:100%; object-fit:contain; border-radius:6px; filter: drop-shadow(0 4px 8px rgba(0,0,0,0.3));" />`
                        : `<span class="small text-muted text-center px-1" style="font-size:11px; word-break:break-all;">${itemName}</span>`}
                </div>`;
            }).join('');

            body.innerHTML = `
            <div class="rounded-3 shadow-lg mx-auto"
                    style="${bgImagePath ? `background-image:url('${bgImagePath}');background-size:cover;background-position:center;` : `background-color:${bgColor};`} width:100%; max-width:640px; aspect-ratio:16/9; display:flex; align-items:stretch; overflow:hidden;">
                ${cellsHtml}
            </div>`;

            // Description
            const descEl = document.getElementById('viewDescription');
            if (description) {
                descEl.textContent = description;
                descEl.style.display = 'block';
            } else {
                descEl.style.display = 'none';
            }

            // Item name chips
            const chipsEl = document.getElementById('viewItemChips');
            if (items.length > 0) {
                chipsEl.innerHTML = items.map(i => {
                    const name = i.itemName || i.ItemName || '';
                    return `<span style="font-size:12px;color:var(--text-secondary,#a6b1e1);background:rgba(166,177,225,0.05);border:1px solid var(--border-color);padding:3px 10px;border-radius:6px;">${name}</span>`;
                }).join('');
                chipsEl.style.display = 'flex';
            } else {
                chipsEl.style.display = 'none';
            }

            // Category tags
            const tagsEl = document.getElementById('viewCategoryTags');
            const uniqueCats = [];
            items.forEach(i => {
                const cat = i.categoryName || i.CategoryName;
                if (cat && !uniqueCats.includes(cat)) uniqueCats.push(cat);
            });

            if (uniqueCats.length > 0) {
                tagsEl.innerHTML = uniqueCats.map(cat => `
                    <button class="btn btn-sm rounded-pill px-3 py-1" style="font-size:11px; font-family:inherit; color:#58a6ff; background:#0d1f35; border:1px solid #1c3a5e;"
                            onclick="bootstrap.Modal.getInstance(document.getElementById('viewShowoffModal'))?.hide(); refreshGrid({ searchCategory: '${cat.replace(/'/g, "\\'")}', page: 1 }); document.getElementById('searchCategories').value = '${cat.replace(/'/g, "\\'")}'; addRecentCategory('${cat.replace(/'/g, "\\'")}');">
                        #${cat}
                    </button>
                `).join('');
                tagsEl.style.display = 'flex';
            } else {
                tagsEl.style.display = 'none';
            }

            // Meta stats
            document.getElementById('viewCountDisplay').textContent = viewCount;
            document.getElementById('viewCreatedAt').textContent = createdAt ? `Created ${new Date(createdAt).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' })}` : '';
            document.getElementById('commentCountDisplay').textContent = commentCount;

            // Owner — fetch profile photo
            document.getElementById('viewOwnerName').textContent = userName || '';
            const ownerAvatarEl = document.getElementById('viewOwnerAvatar');

            console.log('DEBUG: about to fetch avatar for', userName);   // ADD THIS

            try {
                const userRes = await fetch(`${apiBase}/ArcaneVaultUser/${userName}`);
                console.log('DEBUG: fetch completed, status:', userRes.status);   // ADD THIS
                if (userRes.ok) {
                    const userData = await userRes.json();
                    console.log('DEBUG: userData:', userData);   // ADD THIS
                    const avatarPath = userData.avatarUrl || userData.AvatarUrl;
                    console.log('DEBUG: avatarPath:', avatarPath);   // ADD THIS
                    if (avatarPath) {
                        ownerAvatarEl.innerHTML = `<img src="${avatarPath}" style="width:32px;height:32px;border-radius:50%;object-fit:cover;" alt="${userName}" />`;
                        console.log('DEBUG: after setting innerHTML:', ownerAvatarEl.innerHTML);
                    } else {
                        ownerAvatarEl.textContent = userName ? userName[0].toUpperCase() : '?';
                    }
                } else {
                    ownerAvatarEl.textContent = userName ? userName[0].toUpperCase() : '?';
                }
            } catch (err) {
                console.error('Failed to load owner avatar:', err);
                ownerAvatarEl.textContent = userName ? userName[0].toUpperCase() : '?';
            }

            // Disabled badge & notice
            document.getElementById('viewDisabledBadge').style.display = isDisabled ? 'inline-block' : 'none';
            const isOwner = currentUser && currentUser === userName;
            if (isDisabled && isOwner) {
                document.getElementById('viewDisabledNotice').style.display = 'block';
                // mailto: appeal link with user's email context
                const userEmail = '@(loggedInUser?.Email ?? "")';
                const subject = encodeURIComponent(`Appeal: Disabled Showoff "${showoff.showoffName || showoff.ShowoffName}"`);
                const bodyText = encodeURIComponent(`Hi,\n\nI would like to appeal the disabling of my showoff "${showoff.showoffName || showoff.ShowoffName}" (ID: ${showoffId}).\n\nReason for appeal:\n\n\nThank you.`);
                document.getElementById('appealLink').href = `mailto:allen@example.com?subject=${subject}&body=${bodyText}`;
            } else {
                document.getElementById('viewDisabledNotice').style.display = 'none';
            }

            // Like button text
            document.getElementById('likeBtnText').textContent = liked ? `Liked · ${likeData.likeCount ?? likeData.LikeCount ?? 0}` : `Like · ${likeData.likeCount ?? likeData.LikeCount ?? 0}`;

            const modal = new bootstrap.Modal(document.getElementById('viewShowoffModal'));

            // Record view ONLY when modal is fully shown — single record
            document.getElementById('viewShowoffModal').addEventListener('shown.bs.modal', async function () {
                await fetch(`${apiBase}/ShowoffView`, {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ showoffId, viewerUserName: currentUser || null })
                });
            }, { once: true });

            modal.show();

            // Load comments
            loadComments(1);
        }

        // ── Like / Unlike ──
        // Fix 4 & 5 — grey/red heart icon, works regardless of ownership
        async function toggleLike() {
            const btn = document.getElementById('likeBtn');
            const icon = document.getElementById('likeIcon');
            const showoffId = parseInt(btn.dataset.showoffId);
            const liked = btn.dataset.liked === 'true';

            if (liked) {
                await fetch(`${apiBase}/ShowoffLike/${showoffId}/${currentUser}`, { method: 'DELETE' });
                btn.dataset.liked = 'false';
                // Grey heart when not liked
                icon.className = 'bi bi-heart text-secondary';
                document.getElementById('likeCount').textContent =
                    parseInt(document.getElementById('likeCount').textContent) - 1;
            } else {
                await fetch(`${apiBase}/ShowoffLike`, {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ showoffId, userName: currentUser })
                });
                btn.dataset.liked = 'true';
                // Red filled heart when liked
                icon.className = 'bi bi-heart-fill text-danger';
                document.getElementById('likeCount').textContent =
                    parseInt(document.getElementById('likeCount').textContent) + 1;
            }
        }

        // ── Manage Modal ──
        function openManageModal() {
            bootstrap.Modal.getInstance(document.getElementById('viewShowoffModal'))?.hide();
            new bootstrap.Modal(document.getElementById('manageModal')).show();
        }

        // ── Delete ──
        function openDeleteConfirm(showoffId, showoffName) {
            pendingDeleteId = showoffId;
            pendingDeleteName = showoffName;
            document.getElementById('deleteShowoffName').textContent = showoffName;
            bootstrap.Modal.getInstance(document.getElementById('manageModal'))?.hide();
            new bootstrap.Modal(document.getElementById('deleteConfirmModal')).show();
        }

        function reopenManage() {
            bootstrap.Modal.getInstance(document.getElementById('deleteConfirmModal'))?.hide();
            new bootstrap.Modal(document.getElementById('manageModal')).show();
        }

        async function confirmDelete() {
            // Get showoff details first to retrieve image public IDs
            const res = await fetch(`${apiBase}/Showoff/${pendingDeleteId}`);
            if (res.ok) {
                const showoff = await res.json();
                const items = showoff.items || showoff.Items || [];

                // Delete all images from Cloudinary before soft deleting showoff
                for (const item of items) {
                    const publicId = item.imagePublicId || item.ImagePublicId;
                    if (publicId) {
                        await fetch(`${apiBase}/ImageUpload`, {
                            method: 'DELETE',
                            headers: { 'Content-Type': 'application/json' },
                            body: JSON.stringify(publicId)
                        });
                    }
                }
            }

            // Soft delete the showoff
            await fetch(`${apiBase}/Showoff/${pendingDeleteId}`, { method: 'DELETE' });
            bootstrap.Modal.getInstance(document.getElementById('deleteConfirmModal'))?.hide();
            window.location.reload();
        }

        // ── Create/Edit now use separate pages — link from manage modal ──

        // ── Share ──
        let currentViewShowoffId = null;

        function shareShowoff() {
            const url = `${window.location.origin}/ShowoffPages/Index?tab=feed`;
            navigator.clipboard.writeText(url).then(() => {
                const span = document.getElementById('shareText');
                span.textContent = 'Copied!';
                setTimeout(() => span.textContent = 'Share', 2000);
            });
        }

        // ── Report ──
        function openReportModal() {
            if (!currentUser) { alert('Please log in to report.'); return; }
            document.getElementById('reportCategory').selectedIndex = 0;
            document.getElementById('reportReason').value = '';
            document.getElementById('reportCategoryError').style.display = 'none';
            new bootstrap.Modal(document.getElementById('reportModal')).show();
        }

        function showReportFeedback(success) {
            const icon = document.getElementById('reportFeedbackIcon');
            const title = document.getElementById('reportFeedbackTitle');
            const text = document.getElementById('reportFeedbackText');

            if (success) {
                icon.className = 'bi bi-check-circle-fill text-success fs-1 mb-3 d-block';
                title.textContent = 'Report Submitted';
                text.textContent = 'A staff member will review it shortly.';
            } else {
                icon.className = 'bi bi-x-circle-fill text-danger fs-1 mb-3 d-block';
                title.textContent = 'Submission Failed';
                text.textContent = 'Failed to submit report. Please try again.';
            }

            new bootstrap.Modal(document.getElementById('reportFeedbackModal')).show();
        }

        async function submitReport() {
            const cat = document.getElementById('reportCategory').value;
            const errEl = document.getElementById('reportCategoryError');

            if (!cat) {
                errEl.style.display = 'block';
                return;
            }
            errEl.style.display = 'none';

            const reason = document.getElementById('reportReason').value.trim();

            const res = await fetch(`${apiBase}/ShowoffReport`, {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({
                    showoffId: currentViewShowoffId,
                    reporterUserName: currentUser,
                    category: cat,
                    reason: reason || null
                })
            });

            bootstrap.Modal.getInstance(document.getElementById('reportModal'))?.hide();
            showReportFeedback(res.ok);
        }

        // ── Comments ──
        let commentPage = 1;
        let commentTotalPages = 1;

        async function loadComments(page) {
            if (!currentViewShowoffId) return;
            const res = await fetch(`${apiBase}/ShowoffComment/${currentViewShowoffId}?page=${page}&pageSize=5`);
            if (!res.ok) return;
            const data = await res.json();
            const comments = data.comments || data.Comments || [];
            commentTotalPages = data.totalPages || data.TotalPages || 1;
            commentPage = data.page || data.Page || 1;

            const list = document.getElementById('commentsList');
            if (page === 1) list.innerHTML = '';

            comments.forEach(c => {
                const dateStr = new Date(c.createdAt || c.CreatedAt).toLocaleDateString('en-US', { month: 'short', day: 'numeric' });
                const userName = c.userName || c.UserName;
                const text = c.text || c.Text;
                list.innerHTML += `
                        <div class="d-flex gap-2 mb-2 p-2 rounded" style="background:rgba(166,177,225,0.02); border:1px solid var(--border-color);">
                            <div style="width:28px;height:28px;border-radius:50%;background:rgba(166,177,225,0.1);color:var(--text-secondary);display:flex;align-items:center;justify-content:center;flex-shrink:0;">
                                <i class="bi bi-person-fill small"></i>
                            </div>
                            <div style="flex:1;min-width:0;">
                                <div class="d-flex align-items-center gap-2">
                                    <span class="fw-semibold small">${userName}</span>
                                    <span class="text-muted" style="font-size:11px;">${dateStr}</span>
                                </div>
                                <p class="mb-0 small text-white">${text}</p>
                            </div>
                        </div>`;
            });

            document.getElementById('loadMoreComments').style.display =
                commentPage < commentTotalPages ? 'block' : 'none';
        }

        function loadMoreComments() {
            loadComments(commentPage + 1);
        }

        async function postComment() {
            if (!currentUser) { alert('Please log in to comment.'); return; }
            const input = document.getElementById('commentInput');
            const text = input.value.trim();
            if (!text) return;

            await fetch(`${apiBase}/ShowoffComment`, {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ showoffId: currentViewShowoffId, userName: currentUser, text })
            });

            input.value = '';
            loadComments(1);
        }

        function renderSearchSuggestions(container, data, keyField, onSelect, query) {
            container.innerHTML = '';
            const filtered = query
                ? data.filter(d => d[keyField]?.toLowerCase().includes(query))
                : data;

            if (filtered.length === 0) {
                container.innerHTML = '<div class="list-group-item text-muted">No results</div>';
                return;
            }

            filtered.slice(0, 5).forEach(item => {
                const el = document.createElement('a');
                el.href = '#';
                el.className = 'list-group-item list-group-item-action';
                el.textContent = item[keyField];
                el.addEventListener('click', e => { e.preventDefault(); onSelect(item[keyField]); container.style.display = 'none'; });
                container.appendChild(el);
            });
            container.style.display = 'block';
        }

        // Get unique values for search bars
        const allShowoffs = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.AllShowoffs));
        const uniqueUsers = [...new Set(allShowoffs.map(s => s.UserName))].map(u => ({ UserName: u }));
        const uniqueItems = [...new Set(allShowoffs.flatMap(s => s.Items.map(i => i.ItemName)))].map(n => ({ ItemName: n }));
        const uniqueCategories = [...new Set(allShowoffs.flatMap(s => s.Items.map(i => i.CategoryName).filter(Boolean)))].map(c => ({ CategoryName: c }));

        // ── AJAX Filtering (no page reload) ──
        let currentFilters = {
            searchUser: '@Model.SearchUser' || '',
            searchItem: '@Model.SearchItem' || '',
            searchCategory: '@Model.SearchCategory' || '',
            sort: '@Model.SortBy' || 'popular',
            page: 1
        };

        async function refreshGrid(newFilters = {}) {
            Object.assign(currentFilters, newFilters);

            const params = new URLSearchParams({
                tab: 'feed',
                sort: currentFilters.sort,
                page: currentFilters.page,
                searchUser: currentFilters.searchUser,
                searchItem: currentFilters.searchItem,
                searchCategory: currentFilters.searchCategory
            });

            const res = await fetch(`?handler=Filter&${params.toString()}`, {
                headers: { 'X-Requested-With': 'XMLHttpRequest' }
            });

            if (!res.ok) {
                console.error('Failed to refresh grid');
                return;
            }

            const html = await res.text();
            document.getElementById('showoffGridContainer').innerHTML = html;
            attachGridListeners();

            // Also update the browser URL bar without reloading — keeps refresh/back-button friendly
            const urlParams = new URLSearchParams(window.location.search);
            urlParams.set('sort', currentFilters.sort);
            urlParams.set('page', currentFilters.page);
            currentFilters.searchUser ? urlParams.set('searchUser', currentFilters.searchUser) : urlParams.delete('searchUser');
            currentFilters.searchItem ? urlParams.set('searchItem', currentFilters.searchItem) : urlParams.delete('searchItem');
            currentFilters.searchCategory ? urlParams.set('searchCategory', currentFilters.searchCategory) : urlParams.delete('searchCategory');
            history.replaceState(null, '', `${window.location.pathname}?${urlParams.toString()}`);
        }

        // Re-attach hover + pagination-click listeners after each AJAX swap
        function attachGridListeners() {
            document.querySelectorAll('.showoff-card').forEach(card => {
                card.addEventListener('mouseenter', async () => {
                    const overlay = card.querySelector('.owner-overlay');
                    overlay.style.display = 'block';

                    const username = overlay.dataset.username;
                    const avatarBox = overlay.querySelector('.owner-overlay-avatar');

                    if (avatarCache[username] === undefined) {
                        try {
                            const res = await fetch(`${apiBase}/ArcaneVaultUser/${username}`);
                            const data = res.ok ? await res.json() : null;
                            avatarCache[username] = data ? (data.avatarUrl || data.AvatarUrl || null) : null;
                        } catch {
                            avatarCache[username] = null;
                        }
                    }

                    if (avatarCache[username]) {
                        avatarBox.innerHTML = `<img src="${avatarCache[username]}" style="width:100%;height:100%;object-fit:cover;" />`;
                    }
                });
                card.addEventListener('mouseleave', () => {
                    card.querySelector('.owner-overlay').style.display = 'none';
                });
            });

            document.querySelectorAll('.ajax-page-link').forEach(link => {
                link.addEventListener('click', (e) => {
                    e.preventDefault();
                    if (link.closest('.page-item').classList.contains('disabled')) return;
                    refreshGrid({ page: parseInt(link.dataset.page) });
                });
            });
        }

        // Sort dropdown — AJAX instead of navigation
        document.getElementById('sortSelect')?.addEventListener('change', function () {
            refreshGrid({ sort: this.value, page: 1 });
        });

        // ── Search bars (Feed) — AJAX, keeps focus, no reload ──
        function setupSearch(inputId, suggestionsId, dataArray, keyField, filterKey, searchType) {
            const input = document.getElementById(inputId);
            const suggestions = document.getElementById(suggestionsId);
            if (!input || !suggestions) return;

            const onSelect = async (val) => {
                input.value = val;
                suggestions.style.display = 'none';

                await fetch(`${apiBase}/SearchLog`, {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({
                        searchTerm: val,
                        searchType: searchType,
                        userName: currentUser || null
                    })
                });

                refreshGrid({ [filterKey]: val, page: 1 });
            };

            input.addEventListener('focus', () => {
                renderSearchSuggestions(suggestions, dataArray, keyField, onSelect, '');
                suggestions.style.display = 'block';
            });

            input.addEventListener('input', function () {
                const query = this.value.trim();
                renderSearchSuggestions(suggestions, dataArray, keyField, onSelect, query.toLowerCase());

                clearTimeout(this._searchTimer);
                this._searchTimer = setTimeout(() => {
                    refreshGrid({ [filterKey]: query, page: 1 });
                }, 500);
            });

            input.addEventListener('keydown', function (e) {
                if (e.key === 'Enter') {
                    e.preventDefault();
                    clearTimeout(this._searchTimer);
                    suggestions.style.display = 'none';
                    refreshGrid({ [filterKey]: this.value.trim(), page: 1 });
                }
            });

            document.addEventListener('click', function (e) {
                if (!input.contains(e.target) && !suggestions.contains(e.target))
                    suggestions.style.display = 'none';
            });
        }

        // Updated calls with 6 arguments
        setupSearch('searchUsers', 'userSuggestions', uniqueUsers, 'UserName', 'searchUser', 'User');
        setupSearch('searchItems', 'itemSuggestions', uniqueItems, 'ItemName', 'searchItem', 'Item');
        setupSearch('searchCategories', 'categorySuggestions', uniqueCategories, 'CategoryName', 'searchCategory', 'Category');
        // Initial attach for the server-rendered grid on first page load
        attachGridListeners();

        // ── Recent Category Bubbles ──
        let recentCats = JSON.parse(sessionStorage.getItem('recentCats') || '[]');
        let selectedCat = 'All';

        function addRecentCategory(catName) {
            if (!catName || catName === 'All') return;
            // Move to front, dedupe, cap at 4
            recentCats = [catName, ...recentCats.filter(c => c !== catName)].slice(0, 4);
            sessionStorage.setItem('recentCats', JSON.stringify(recentCats));
            renderCatBubbles();
        }

        function selectCategoryBubble(catName) {
            selectedCat = catName;
            renderCatBubbles();
            if (catName === 'All') {
                refreshGrid({ searchCategory: '', page: 1 });
                document.getElementById('searchCategories').value = '';
            } else {
                refreshGrid({ searchCategory: catName, page: 1 });
                document.getElementById('searchCategories').value = catName;
            }
        }

        function renderCatBubbles() {
            const container = document.getElementById('recentCatBubbles');
            if (!container) return;

            // Hide entirely when no recent categories
            if (recentCats.length === 0) {
                container.style.display = 'none';
                return;
            }
            container.style.display = 'flex';

            // "All" button + only filled recent bubbles (max 4)
            let html = `<button class="btn btn-sm rounded-pill recent-cat-btn ${selectedCat === 'All' ? 'active' : ''}" onclick="selectCategoryBubble('All')">All</button>`;

            recentCats.slice(0, 4).forEach(cat => {
                const isActive = selectedCat === cat;
                html += `<button class="btn btn-sm rounded-pill recent-cat-btn ${isActive ? 'active' : ''}" onclick="selectCategoryBubble('${cat.replace(/'/g, "\\'")}')">` + cat + `</button>`;
            });
            container.innerHTML = html;
        }

        // Hook into category search — when a category is selected from suggestions, add to recent
        const origCatSetup = document.getElementById('searchCategories');
        if (origCatSetup) {
            const origInput = origCatSetup;
            origInput.addEventListener('change', () => {
                const val = origInput.value.trim();
                if (val) addRecentCategory(val);
            });
            // Also hook the suggestion click — override the onSelect in setupSearch
            const catSuggestions = document.getElementById('categorySuggestions');
            if (catSuggestions) {
                const origClickHandler = catSuggestions.onclick;
                catSuggestions.addEventListener('click', (e) => {
                    const target = e.target.closest('.list-group-item-action');
                    if (target) {
                        const catName = target.textContent.trim();
                        setTimeout(() => addRecentCategory(catName), 100);
                    }
                });
            }
        }

        // Render initial state
        renderCatBubbles();
    </script>
    <style>
        .recent-cat-btn {
            font-size: 12px;
            padding: 4px 14px;
            border: 1px solid var(--border-color, #21262d);
            background: var(--bg-card, #161b22);
            color: var(--text-muted, #7d8590);
            transition: all 0.15s;
            min-width: 100px;
            text-align: center;
        }
    
        .recent-cat-btn.active {
            background: #1a3a2a;
            border-color: #3fb950;
            color: #3fb950;
        }
    
        .recent-cat-btn.empty {
            border-color: var(--bg-card-hover, #1a1f26);
            color: var(--bg-card-hover, #2a3040);
            cursor: default;
        }
    
        .recent-cat-btn:not(.empty):not(.active):hover {
            border-color: var(--text-muted, #484f58);
            color: var(--text-secondary, #c9d1d9);
        }
    </style>
}