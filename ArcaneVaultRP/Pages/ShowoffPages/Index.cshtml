        async function submitReport() {
            const cat = document.getElementById('reportCategory').value;
            const errEl = document.getElementById('reportCategoryError');

            if (!cat) {
                errEl.style.display = 'block';
                return;
            }
            errEl.style.display = 'none';

            const reason = document.getElementById('reportReason').value.trim();

            const res = await fetch(`${apiBase}/ShowoffReport`, {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({
                    showoffId: currentViewShowoffId,
                    reporterUserName: currentUser,
                    category: cat,
                    reason: reason || null
                })
            });

            bootstrap.Modal.getInstance(document.getElementById('reportModal'))?.hide();
            showReportFeedback(res.ok);
        }

        // ── Comments ──
        let commentPage = 1;
        let commentTotalPages = 1;

        async function loadComments(page) {
            if (!currentViewShowoffId) return;
            const res = await fetch(`${apiBase}/ShowoffComment/${currentViewShowoffId}?page=${page}&pageSize=5`);
            if (!res.ok) return;
            const data = await res.json();
            const comments = data.comments || data.Comments || [];
            commentTotalPages = data.totalPages || data.TotalPages || 1;
            commentPage = data.page || data.Page || 1;

            const list = document.getElementById('commentsList');
            if (page === 1) list.innerHTML = '';

            comments.forEach((c, idx) => {
                const dateStr = new Date(c.createdAt || c.CreatedAt).toLocaleDateString('en-US', { month: 'short', day: 'numeric' });
                const userName = c.userName || c.UserName;
                const text = c.text || c.Text;
                const avatarId = `commentAvatar-${page}-${idx}`;

                list.innerHTML += `
                                                <div class="d-flex gap-2 mb-2 p-2 rounded" style="background:rgba(166,177,225,0.02); border:1px solid var(--border-color);">
                                                    <div id="${avatarId}" style="width:28px;height:28px;border-radius:50%;background:rgba(166,177,225,0.1);color:var(--text-secondary);display:flex;align-items:center;justify-content:center;flex-shrink:0;overflow:hidden;">
                                                        <i class="bi bi-person-fill small"></i>
                                                    </div>
                                                    <div style="flex:1;min-width:0;">
                                                        <div class="d-flex align-items-center gap-2">
                                                            <span class="fw-semibold small">${userName}</span>
                                                            <span class="text-muted" style="font-size:11px;">${dateStr}</span>
                                                        </div>
                                                        <p class="mb-0 small text-white">${text}</p>
                                                    </div>
                                                </div>`;

                // Fetch this commenter's current avatar directly — same live-fetch approach as
                // the owner avatar in viewShowoff, so it always reflects their latest photo
                // rather than a stale cached one.
                fetch(`${apiBase}/ArcaneVaultUser/${userName}`)
                    .then(r => r.ok ? r.json() : null)
                    .then(userData => {
                        const avatarEl = document.getElementById(avatarId);
                        if (!avatarEl) return; // comment list may have re-rendered already
                        const avatarPath = userData?.avatarUrl || userData?.AvatarUrl;
                        if (avatarPath) {
                            avatarEl.innerHTML = `<img src="${avatarPath}" style="width:100%;height:100%;object-fit:cover;" alt="${userName}" />`;
                        }
                    })
                    .catch(() => { /* keep default icon on failure */ });
            });

            document.getElementById('loadMoreComments').style.display =
                commentPage < commentTotalPages ? 'block' : 'none';
        }

        function loadMoreComments() {
            loadComments(commentPage + 1);
        }

        async function postComment() {
            if (!currentUser) { alert('Please log in to comment.'); return; }
            const input = document.getElementById('commentInput');
            const text = input.value.trim();
            if (!text) return;

            await fetch(`${apiBase}/ShowoffComment`, {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ showoffId: currentViewShowoffId, userName: currentUser, text })
            });

            input.value = '';
            loadComments(1);
        }

        function renderSearchSuggestions(container, data, keyField, onSelect, query) {
            container.innerHTML = '';
            const filtered = query
                ? data.filter(d => d[keyField]?.toLowerCase().includes(query))
                : data;

            if (filtered.length === 0) {
                container.innerHTML = '<div class="list-group-item text-muted">No results</div>';
                return;
            }

            filtered.slice(0, 5).forEach(item => {
                const el = document.createElement('a');
                el.href = '#';
                el.className = 'list-group-item list-group-item-action';
                el.textContent = item[keyField];
                el.addEventListener('click', e => { e.preventDefault(); onSelect(item[keyField]); container.style.display = 'none'; });
                container.appendChild(el);
            });
            container.style.display = 'block';
        }

        // ── Appeal ──
        function openAppealModal() {
            document.getElementById('appealMessageInput').value = '';
            document.getElementById('appealError').style.display = 'none';
            bootstrap.Modal.getInstance(document.getElementById('viewShowoffModal'))?.hide();
            new bootstrap.Modal(document.getElementById('appealModal')).show();
        }

        function showAppealFeedback(success) {
            const icon = document.getElementById('appealFeedbackIcon');
            const title = document.getElementById('appealFeedbackTitle');
            const text = document.getElementById('appealFeedbackText');

            if (success) {
                icon.className = 'bi bi-check-circle-fill text-success fs-1 mb-3 d-block';
                title.textContent = 'Appeal Submitted';
                text.textContent = 'Our support team will review it shortly.';
            } else {
                icon.className = 'bi bi-x-circle-fill text-danger fs-1 mb-3 d-block';
                title.textContent = 'Submission Failed';
                text.textContent = 'Failed to submit appeal. Please try again.';
            }

            new bootstrap.Modal(document.getElementById('appealFeedbackModal')).show();
        }

        async function submitAppeal() {
            const message = document.getElementById('appealMessageInput').value.trim();
            const errEl = document.getElementById('appealError');

            if (!message) {
                errEl.style.display = 'block';
                return;
            }
            errEl.style.display = 'none';

            const btn = document.getElementById('appealSubmitBtn');
            btn.disabled = true;
            btn.innerHTML = `<span class="spinner-border spinner-border-sm me-1"></span>Sending...`;

            const res = await fetch(`${apiBase}/Showoff/${currentViewShowoffId}/appeal`, {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ appealMessage: message })
            });

            btn.disabled = false;
            btn.innerHTML = 'Submit Appeal';

            bootstrap.Modal.getInstance(document.getElementById('appealModal'))?.hide();
            showAppealFeedback(res.ok);
        }

        // Get unique values for search bars
        const allShowoffs = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.AllShowoffs)) || [];
        const uniqueUsers = [...new Set(allShowoffs.map(s => s.UserName).filter(Boolean))].map(u => ({ UserName: u }));
        const uniqueItems = [...new Set(allShowoffs.flatMap(s => (s.Items || []).map(i => i.ItemName)).filter(Boolean))].map(n => ({ ItemName: n }));
        const uniqueCategories = [...new Set(allShowoffs.flatMap(s => (s.Items || []).map(i => i.CategoryName).filter(Boolean)))].map(c => ({ CategoryName: c }));

        // ── AJAX Filtering (no page reload) ──
        let currentFilters = {
            searchUser: '@Model.SearchUser' || '',
            searchItem: '@Model.SearchItem' || '',
            searchCategory: '@Model.SearchCategory' || '',
            sort: '@Model.SortBy' || 'popular',
            page: 1
        };

        function updateFiltersBadge(badgeId, activeCount) {
            const badge = document.getElementById(badgeId);
            if (!badge) return;
            badge.textContent = activeCount;
            badge.style.display = activeCount > 0 ? 'inline-block' : 'none';
        }

        async function refreshGrid(newFilters = {}) {
            Object.assign(currentFilters, newFilters);

            updateFiltersBadge('feedFiltersBadge',
                (currentFilters.sort !== 'popular' ? 1 : 0) +
                (currentFilters.searchUser ? 1 : 0) +
                (currentFilters.searchItem ? 1 : 0) +
                (currentFilters.searchCategory ? 1 : 0));

            const params = new URLSearchParams({
                tab: 'feed',
                sort: currentFilters.sort,
                page: currentFilters.page,
                searchUser: currentFilters.searchUser,
                searchItem: currentFilters.searchItem,
                searchCategory: currentFilters.searchCategory
            });

            const res = await fetch(`?handler=Filter&${params.toString()}`, {
                headers: { 'X-Requested-With': 'XMLHttpRequest' }
            });

            if (!res.ok) {
                console.error('Failed to refresh grid');
                return;
            }

            const html = await res.text();
            document.getElementById('showoffGridContainer').innerHTML = html;
            attachGridListeners();

            // Also update the browser URL bar without reloading — keeps refresh/back-button friendly
            const urlParams = new URLSearchParams(window.location.search);
            urlParams.set('sort', currentFilters.sort);
            urlParams.set('page', currentFilters.page);
            currentFilters.searchUser ? urlParams.set('searchUser', currentFilters.searchUser) : urlParams.delete('searchUser');
            currentFilters.searchItem ? urlParams.set('searchItem', currentFilters.searchItem) : urlParams.delete('searchItem');
            currentFilters.searchCategory ? urlParams.set('searchCategory', currentFilters.searchCategory) : urlParams.delete('searchCategory');
            history.replaceState(null, '', `${window.location.pathname}?${urlParams.toString()}`);
        }

        // Re-attach hover listeners after each AJAX swap.
        function attachGridListeners() {
            document.querySelectorAll('.showoff-card').forEach(card => {
                card.addEventListener('mouseenter', async () => {
                    const overlay = card.querySelector('.owner-overlay');
                    overlay.style.display = 'block';

                    const username = overlay.dataset.username;
                    const avatarBox = overlay.querySelector('.owner-overlay-avatar');

                    if (avatarCache[username] === undefined) {
                        try {
                            const res = await fetch(`${apiBase}/ArcaneVaultUser/${username}`);
                            const data = res.ok ? await res.json() : null;
                            avatarCache[username] = data ? (data.avatarUrl || data.AvatarUrl || null) : null;
                        } catch {
                            avatarCache[username] = null;
                        }
                    }

                    if (avatarCache[username]) {
                        avatarBox.innerHTML = `<img src="${avatarCache[username]}" style="width:100%;height:100%;object-fit:cover;" />`;
                    }
                });
                card.addEventListener('mouseleave', () => {
                    card.querySelector('.owner-overlay').style.display = 'none';
                });
            });
        }

        // Pagination — delegated on `document`, scoped to #showoffGridContainer.
        document.addEventListener('click', (e) => {
            const link = e.target.closest('.ajax-page-link');
            if (!link) return;
            if (!link.closest('#showoffGridContainer')) return;
            e.preventDefault();
            if (link.closest('.page-item')?.classList.contains('disabled')) return;
            refreshGrid({ page: parseInt(link.dataset.page) });
        });

        // Sort dropdown — AJAX instead of navigation
        document.getElementById('sortSelect')?.addEventListener('change', function () {
            refreshGrid({ sort: this.value, page: 1 });
        });

        // ── Search bars (Feed) — AJAX, keeps focus, no reload ──
        function setupSearch(inputId, suggestionsId, dataArray, keyField, filterKey, searchType) {
            const input = document.getElementById(inputId);
            const suggestions = document.getElementById(suggestionsId);
            if (!input || !suggestions) return;

            const onSelect = async (val) => {
                input.value = val;
                suggestions.style.display = 'none';

                await fetch(`${apiBase}/SearchLog`, {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({
                        searchTerm: val,
                        searchType: searchType,
                        userName: currentUser || null
                    })
                });

                refreshGrid({ [filterKey]: val, page: 1 });
            };

            input.addEventListener('focus', () => {
                renderSearchSuggestions(suggestions, dataArray, keyField, onSelect, '');
                suggestions.style.display = 'block';
            });

            input.addEventListener('input', function () {
                const query = this.value.trim();
                renderSearchSuggestions(suggestions, dataArray, keyField, onSelect, query.toLowerCase());

                clearTimeout(this._searchTimer);
                this._searchTimer = setTimeout(() => {
                    refreshGrid({ [filterKey]: query, page: 1 });
                }, 500);
            });

            input.addEventListener('keydown', function (e) {
                if (e.key === 'Enter') {
                    e.preventDefault();
                    clearTimeout(this._searchTimer);
                    suggestions.style.display = 'none';
                    refreshGrid({ [filterKey]: this.value.trim(), page: 1 });
                }
            });

            document.addEventListener('click', function (e) {
                if (!input.contains(e.target) && !suggestions.contains(e.target))
                    suggestions.style.display = 'none';
            });
        }

        setupSearch('searchUsers', 'userSuggestions', uniqueUsers, 'UserName', 'searchUser', 'User');
        setupSearch('searchItems', 'itemSuggestions', uniqueItems, 'ItemName', 'searchItem', 'Item');
        setupSearch('searchCategories', 'categorySuggestions', uniqueCategories, 'CategoryName', 'searchCategory', 'Category');
        // Initial attach for the server-rendered grid on first page load
        attachGridListeners();

        // ════════════════════════════════════════════════
        // SEARCH CLEAR ("×") BUTTONS
        // ════════════════════════════════════════════════
        function enableSearchClear(inputId) {
            const input = document.getElementById(inputId);
            if (!input || input.dataset.clearEnabled) return;

            const wrapper = document.createElement('div');
            wrapper.className = 'search-clear-wrapper';
            wrapper.style.width = '100%';
            input.style.width = '100%';

            input.parentElement.insertBefore(wrapper, input);
            wrapper.appendChild(input);

            const btn = document.createElement('button');
            btn.type = 'button';
            btn.className = 'search-clear-btn';
            btn.innerHTML = '&times;';
            btn.setAttribute('aria-label', 'Clear search');
            wrapper.appendChild(btn);

            function toggleBtn() {
                btn.style.display = input.value.length > 0 ? 'block' : 'none';
            }

            input.addEventListener('input', toggleBtn);
            toggleBtn();

            btn.addEventListener('click', () => {
                input.value = '';
                input.dispatchEvent(new Event('input', { bubbles: true }));
                toggleBtn();
                input.focus();
            });

            input.dataset.clearEnabled = 'true';
        }

        enableSearchClear('searchUsers');
        enableSearchClear('searchItems');
        enableSearchClear('searchCategories');

        updateFiltersBadge('feedFiltersBadge',
            (currentFilters.sort !== 'popular' ? 1 : 0) +
            (currentFilters.searchUser ? 1 : 0) +
            (currentFilters.searchItem ? 1 : 0) +
            (currentFilters.searchCategory ? 1 : 0));

        // ════════════════════════════════════════════════
        // SHOP TAB — Frames & Stickers, server-side AJAX pagination
        // ════════════════════════════════════════════════
        // Maps section key -> Razor Pages handler name (OnGet{Handler}Async)
        const cosmeticHandlerMap = {
            frames: 'FrameGrid',
            stickers: 'StickerGrid'
        };

        async function refreshCosmeticGrid(section, page) {
            const handler = cosmeticHandlerMap[section];
            if (!handler) return;

            const res = await fetch(`?handler=${handler}&page=${page}`, {
                headers: { 'X-Requested-With': 'XMLHttpRequest' }
            });

            if (!res.ok) {
                console.error(`Failed to refresh ${section} grid`);
                return;
            }

            const html = await res.text();
            document.getElementById(`${section}GridContainer`).innerHTML = html;
        }

        // Delegated on `document`, scoped per section container — mirrors the Feed's
        // pagination pattern so it survives repeated innerHTML swaps.
        document.addEventListener('click', (e) => {
            const link = e.target.closest('.cosmetic-ajax-page-link');
            if (!link) return;
            const section = link.dataset.section;
            if (!section || !link.closest(`#${section}GridContainer`)) return;
            e.preventDefault();
            if (link.closest('.page-item')?.classList.contains('disabled')) return;
            refreshCosmeticGrid(section, parseInt(link.dataset.page));
        });

        // ── Cosmetic detail modal — populated straight from the clicked card's
        // own data-* attributes, no extra fetch needed. ──
        function openCosmeticDetail(el) {
            document.getElementById('cosmeticDetailName').textContent = el.dataset.name;
            document.getElementById('cosmeticDetailImage').src = el.dataset.image || '';
            document.getElementById('cosmeticDetailPrice').textContent = 'SGD ' + el.dataset.price;

            const qtyEl = document.getElementById('cosmeticDetailQty');
            if (el.dataset.limited === 'true') {
                qtyEl.textContent = `Limited — ${el.dataset.qty} available`;
                qtyEl.style.display = 'inline-block';
            } else {
                qtyEl.style.display = 'none';
            }

            new bootstrap.Modal(document.getElementById('cosmeticDetailModal')).show();
        }

        async function buyCosmetic(e) {
            e.stopPropagation();

            const card = e.target.closest('.shop-cosmetic-card');
            if (!card) return;

            const type = card.dataset.type === 'frame' ? 'Frame' : 'Sticker';
            const code = card.dataset.code;

            const btn = e.target.closest('button');
            const originalHtml = btn.innerHTML;
            btn.disabled = true;
            btn.innerHTML = `<span class="spinner-border spinner-border-sm"></span>`;

            try {
                const jwtToken = document.getElementById('jwtTokenInput')?.value;
                const res = await fetch(`${apiBase}/Payment/checkout`, {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json', 'Authorization': `Bearer ${jwtToken}` },
                    body: JSON.stringify({ cosmeticType: type, cosmeticCode: code })
                });

                if (!res.ok) {
                    const text = await res.text();
                    alert(text || 'Could not start checkout. Please try again.');
                    btn.disabled = false;
                    btn.innerHTML = originalHtml;
                    return;
                }

                const data = await res.json();
                window.location.href = data.url;
            } catch {
                alert('Could not start checkout. Please try again.');
                btn.disabled = false;
                btn.innerHTML = originalHtml;
            }
        }
    </script>
    <style>
        .pagination .page-link.pagination-box {
            width: 36px;
            height: 36px;
            padding: 0;
            display: flex;
            align-items: center;
            justify-content: center;
            border-radius: 8px;
        }
    </style>
}
