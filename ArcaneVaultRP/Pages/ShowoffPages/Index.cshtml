@page
@model ArcaneVaultRP.Pages.Showoffs.IndexModel
@{
    ViewData["Title"] = "Showoffs";
    var userJson = HttpContext.Session.GetString(SessionKeys.LoggedInUser);
    var loggedInUser = userJson != null ? System.Text.Json.JsonSerializer.Deserialize<Models.ArcaneVaultUser>(userJson) : null;
}

<div class="container mt-4">

    <ul class="nav nav-tabs mb-4">
        <li class="nav-item">
            <a class="nav-link @(Model.ActiveTab == "feed" ? "active" : "")"
               asp-page="./Index" asp-route-tab="feed">Feed</a>
        </li>
        <li class="nav-item">
            <a class="nav-link @(Model.ActiveTab == "profile" ? "active" : "")"
               asp-page="./Index" asp-route-tab="profile">My Profile</a>
        </li>
    </ul>

    @if (Model.ActiveTab == "feed")
    {
        <div class="d-flex justify-content-between align-items-center mb-3">
            <h4 class="fw-bold mb-0">Community Showoffs</h4>
            <div class="d-flex gap-2">
                <select id="sortSelect" class="form-select form-select-sm" style="width:auto;">
                    <option value="popular" selected="@(Model.SortBy == "popular")">Most Popular</option>
                    <option value="newest" selected="@(Model.SortBy == "newest")">Newest</option>
                    <option value="least" selected="@(Model.SortBy == "least")">Least Popular</option>
                </select>
            </div>
        </div>

        <div class="row g-2 mb-4">
            <div class="col-md-4 position-relative">
                <input type="text" id="searchUsers" class="form-control"
                       placeholder="Search users..." autocomplete="off"
                       value="@Model.SearchUser" />
                <div id="userSuggestions" class="list-group position-absolute z-3"
                     style="width:100%;max-height:200px;overflow-y:auto;display:none;"></div>
            </div>
            <div class="col-md-4 position-relative">
                <input type="text" id="searchItems" class="form-control"
                       placeholder="Search items..." autocomplete="off"
                       value="@Model.SearchItem" />
                <div id="itemSuggestions" class="list-group position-absolute z-3"
                     style="width:100%;max-height:200px;overflow-y:auto;display:none;"></div>
            </div>
            <div class="col-md-4 position-relative">
                <input type="text" id="searchCategories" class="form-control"
                       placeholder="Search categories..." autocomplete="off"
                       value="@Model.SearchCategory" />
                <div id="categorySuggestions" class="list-group position-absolute z-3"
                     style="width:100%;max-height:200px;overflow-y:auto;display:none;"></div>
            </div>
        </div>

        <div id="showoffGridContainer">

            <div class="row row-cols-1 row-cols-md-4 g-3 mb-4">
                @foreach (var showoff in Model.PagedShowoffs)
                {
                    <div class="col">
                        <div class="showoff-card card border-0 shadow-sm h-100 position-relative"
                             style="background-color: @showoff.BackgroundColor; cursor:pointer;"
                             onclick="viewShowoff(@showoff.ShowoffId, '@showoff.UserName')">

                            <div class="owner-overlay position-absolute top-0 start-0 p-2"
                                 style="display:none; background:rgba(0,0,0,0.5); color:white; border-radius:4px; font-size:12px;">
                                @showoff.UserName
                            </div>

                            <div class="card-body d-flex justify-content-center align-items-center gap-2 p-3"
                                 style="min-height:160px;">
                                @{
                                    var items = showoff.Items.OrderBy(i => i.DisplayOrder).ToList();
                                }
                                @foreach (var item in items)
                                {
                                    <div class="showoff-item-cell text-center">
                                        @if (!string.IsNullOrEmpty(item.ImagePath))
                                        {
                                            <img src="@item.ImagePath"
                                                 alt="@item.ItemName"
                                                 style="width:70px;height:70px;object-fit:cover;border-radius:8px;" />
                                        }
                                        else
                                        {
                                            <div style="width:70px;height:70px;background:rgba(255,255,255,0.3);border-radius:8px;"></div>
                                        }
                                    </div>
                                }
                            </div>

                            <div class="card-footer bg-transparent border-0 d-flex justify-content-between align-items-center">
                                <span class="fw-semibold text-truncate" style="max-width:120px;">@showoff.ShowoffName</span>
                                <span class="text-muted small">
                                    <i class="bi bi-heart-fill text-danger"></i> @showoff.LikeCount
                                </span>
                            </div>
                        </div>
                    </div>
                }
            </div>

            @if (!Model.PagedShowoffs.Any())
            {
                <div class="text-center text-muted py-5">
                    <p>No showoffs found.</p>
                </div>
            }

            @if (Model.TotalPages > 1)
            {
                <nav>
                    <ul class="pagination justify-content-center">
                        <li class="page-item @(Model.CurrentPage <= 1 ? "disabled" : "")">
                            <a class="page-link ajax-page-link" href="#" data-page="@(Model.CurrentPage - 1)">&lt;</a>
                        </li>

                        @{
                            var startPage = Math.Max(1, Model.CurrentPage - 1);
                            var endPage = Math.Min(startPage + 2, Model.TotalPages);
                            if (endPage - startPage < 2) startPage = Math.Max(1, endPage - 2);
                        }

                        @for (int p = startPage; p <= endPage; p++)
                        {
                            <li class="page-item">
                                <a class="page-link ajax-page-link @(p == Model.CurrentPage ? "active-page" : "")"
                                   href="#"
                                   data-page="@p"
                                   style="@(p == Model.CurrentPage ? "background:#0d6efd;color:white;border-radius:50%;width:36px;height:36px;display:flex;align-items:center;justify-content:center;" : "")">
                                    @p
                                </a>
                            </li>
                        }

                        @if (endPage < Model.TotalPages)
                        {
                            <li class="page-item disabled"><span class="page-link">...</span></li>
                            <li class="page-item">
                                <a class="page-link ajax-page-link" href="#" data-page="@Model.TotalPages">@Model.TotalPages</a>
                            </li>
                        }

                        <li class="page-item @(Model.CurrentPage >= Model.TotalPages ? "disabled" : "")">
                            <a class="page-link ajax-page-link" href="#" data-page="@(Model.CurrentPage + 1)">&gt;</a>
                        </li>
                    </ul>
                </nav>
            }

        </div>
    }
    else
    {
        <div class="d-flex justify-content-between align-items-center mb-4">
            <div class="d-flex align-items-center gap-3">
                <div style="width:60px;height:60px;border-radius:50%;background:#dee2e6;display:flex;align-items:center;justify-content:center;">
                    <i class="bi bi-person-fill fs-4 text-muted"></i>
                </div>
                <div>
                    <h5 class="fw-bold mb-0">@loggedInUser?.UserName</h5>
                    <small class="text-muted">@Model.UserShowoffs.Count showoff(s)</small>
                </div>
            </div>
            <button class="btn btn-outline-secondary btn-sm" onclick="openManageModal()">
                Manage Showoffs
            </button>
        </div>

        <div class="row row-cols-1 row-cols-md-4 g-3">
            @foreach (var showoff in Model.UserShowoffs)
            {
                <div class="col">
                    <div class="card border-0 shadow-sm h-100"
                         style="background-color: @showoff.BackgroundColor;">
                        <div class="card-body d-flex justify-content-center align-items-center gap-2 p-3"
                             style="min-height:160px;">
                            @foreach (var item in showoff.Items.OrderBy(i => i.DisplayOrder))
                            {
                                <div>
                                    @if (!string.IsNullOrEmpty(item.ImagePath))
                                    {
                                        <img src="@item.ImagePath"
                                             style="width:70px;height:70px;object-fit:cover;border-radius:8px;" />
                                    }
                                    else
                                    {
                                        <div style="width:70px;height:70px;background:rgba(255,255,255,0.3);border-radius:8px;"></div>
                                    }
                                </div>
                            }
                        </div>
                        <div class="card-footer bg-transparent border-0 d-flex justify-content-between">
                            <span class="fw-semibold text-truncate" style="max-width:120px;">@showoff.ShowoffName</span>
                            <span class="badge @(showoff.IsPrivate ? "bg-secondary" : "bg-success")">
                                @(showoff.IsPrivate ? "Private" : "Public")
                            </span>
                        </div>
                    </div>
                </div>
            }

            @if (Model.UserShowoffs.Count < 3)
            {
                <div class="col">
                    <div class="card border-dashed h-100"
                         style="border:2px dashed #dee2e6;cursor:pointer;min-height:200px;"
                         onclick="openCreateModal()">
                        <div class="card-body d-flex justify-content-center align-items-center gap-3">
                            @for (int i = 0; i < 3; i++)
                            {
                                <div style="width:60px;height:60px;border:2px dashed #adb5bd;border-radius:8px;display:flex;align-items:center;justify-content:center;">
                                    <i class="bi bi-plus fs-4 text-muted"></i>
                                </div>
                            }
                        </div>
                        <div class="card-footer bg-transparent border-0 text-center text-muted small">
                            Create new showoff
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>

<div class="modal fade" id="viewShowoffModal" tabindex="-1">
    <div class="modal-dialog modal-lg modal-dialog-centered" style="min-height: 80vh;">
        <div class="modal-content" style="min-height: 80vh; display: flex; flex-direction: column;">
            <div class="modal-header border-0">
                <h5 class="modal-title fw-bold" id="viewShowoffName"></h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body flex-grow-1 d-flex align-items-center justify-content-center" id="viewShowoffBody">
            </div>
            <div class="modal-footer border-0 d-flex justify-content-between w-100">
                <button type="button" class="btn btn-outline-secondary" id="likeBtn" onclick="toggleLike()">
                    <i class="bi bi-heart text-secondary" id="likeIcon"></i>
                    <span id="likeCount">0</span>
                </button>
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="manageModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title fw-bold">Manage Showoffs</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body" id="manageModalBody">
                @foreach (var showoff in Model.UserShowoffs)
                {
                    <div class="d-flex align-items-center justify-content-between p-2 border-bottom">
                        <div>
                            <div class="fw-semibold">@showoff.ShowoffName</div>
                            <small class="text-muted">
                                @(showoff.IsPrivate ? "Private" : "Public") · @showoff.Items.Count item(s)
                            </small>
                        </div>
                        <div class="d-flex gap-2">
                            <button class="btn btn-warning btn-sm"
                                    onclick="openEditModal(@showoff.ShowoffId)">
                                Edit
                            </button>
                            <button class="btn btn-danger btn-sm"
                                    onclick="openDeleteConfirm(@showoff.ShowoffId, '@showoff.ShowoffName')">
                                Delete
                            </button>
                        </div>
                    </div>
                }
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="deleteConfirmModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header border-0">
                <h5 class="modal-title fw-bold">Delete Showoff</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <p>Are you sure you want to delete <strong id="deleteShowoffName"></strong>?</p>
                <p class="text-danger small">This cannot be undone.</p>
            </div>
            <div class="modal-footer border-0">
                <button type="button" class="btn btn-secondary" onclick="reopenManage()">Cancel</button>
                <button type="button" class="btn btn-danger" onclick="confirmDelete()">Yes, delete</button>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="createEditModal" tabindex="-1" data-bs-backdrop="static">
    <div class="modal-dialog modal-xl">
        <div class="modal-content">
            <div class="modal-header border-0">
                <h5 class="modal-title fw-bold" id="createEditTitle">Create Showoff</h5>
                <button type="button" class="btn-close" onclick="closeCreateEdit()"></button>
            </div>
            <div class="modal-body">
                <div class="row g-4">

                    <div class="col-md-5">
                        <div class="mb-3">
                            <label class="form-label fw-semibold">Showoff Name</label>
                            <input type="text" id="showoffName" class="form-control"
                                   maxlength="40" placeholder="Enter showoff name"
                                   oninput="updatePreview()" />
                            <small class="text-muted"><span id="nameCharCount">0</span>/40</small>
                        </div>

                        <div class="mb-3">
                            <label class="form-label fw-semibold">Background Color</label>
                            <div class="d-flex align-items-center gap-2">
                                <input type="color" id="bgColor" class="form-control form-control-color"
                                       value="#ffffff" oninput="updatePreview()" />
                                <span id="bgColorHex" class="text-muted small">#ffffff</span>
                            </div>
                        </div>

                        <div class="mb-3">
                            <label class="form-label fw-semibold">Visibility</label>
                            <div>
                                <div class="form-check form-check-inline">
                                    <input class="form-check-input" type="radio"
                                           name="visibility" id="visPublic" value="false"
                                           checked onchange="updatePreview()" />
                                    <label class="form-check-label" for="visPublic">Public</label>
                                </div>
                                <div class="form-check form-check-inline">
                                    <input class="form-check-input" type="radio"
                                           name="visibility" id="visPrivate" value="true"
                                           onchange="updatePreview()" />
                                    <label class="form-check-label" for="visPrivate">Private</label>
                                </div>
                            </div>
                        </div>

                        <div class="mb-3">
                            <label class="form-label fw-semibold">Items (max 3)</label>
                            <div id="selectedItemsList">
                                <p class="text-muted small">Click a cell in the preview to add items.</p>
                            </div>
                        </div>
                    </div>

                    <div class="col-md-7">
                        <label class="form-label fw-semibold">Preview</label>
                        <div id="showoffPreview"
                             class="card border-0 shadow"
                             style="background-color:#ffffff;min-height:200px;">
                            <div class="card-body d-flex justify-content-center align-items-center gap-3 p-4"
                                 style="min-height:160px;">
                                <div class="preview-cell"
                                     onclick="openItemPicker(0)"
                                     style="width:80px;height:80px;border:2px dashed #adb5bd;border-radius:8px;cursor:pointer;display:flex;align-items:center;justify-content:center;"
                                     id="previewCell0">
                                    <i class="bi bi-plus text-muted fs-4"></i>
                                </div>
                                <div class="preview-cell"
                                     onclick="openItemPicker(1)"
                                     style="width:80px;height:80px;border:2px dashed #adb5bd;border-radius:8px;cursor:pointer;display:flex;align-items:center;justify-content:center;"
                                     id="previewCell1">
                                    <i class="bi bi-plus text-muted fs-4"></i>
                                </div>
                                <div class="preview-cell"
                                     onclick="openItemPicker(2)"
                                     style="width:80px;height:80px;border:2px dashed #adb5bd;border-radius:8px;cursor:pointer;display:flex;align-items:center;justify-content:center;"
                                     id="previewCell2">
                                    <i class="bi bi-plus text-muted fs-4"></i>
                                </div>
                            </div>
                            <div class="card-footer bg-transparent border-0 d-flex justify-content-between align-items-center">
                                <span id="previewName" class="fw-semibold text-truncate" style="max-width:150px;">Showoff Name</span>
                                <span id="previewBadge" class="badge bg-success">Public</span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="modal-footer border-0">
                <button type="button" class="btn btn-secondary" onclick="closeCreateEdit()">Cancel</button>
                <button type="button" class="btn btn-primary" onclick="saveShowoff()">Save</button>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="itemPickerModal" tabindex="-1" data-bs-backdrop="static">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header border-0">
                <h5 class="modal-title fw-bold">Select Item</h5>
            </div>
            <div class="modal-body">
                <div class="position-relative mb-3">
                    <input type="text" id="itemPickerSearch" class="form-control"
                           placeholder="Search your collection items..."
                           autocomplete="off" />
                    <div id="itemPickerSuggestions"
                         class="list-group position-absolute z-3"
                         style="width:100%;max-height:200px;overflow-y:auto;display:none;"></div>
                </div>

                <hr />

                <div class="mb-3">
                    <label class="form-label fw-semibold">Item Image</label>
                    <input type="file" id="itemImageUpload" class="form-control"
                           accept=".jpg,.jpeg,.png" />
                    <small class="text-muted">JPG or PNG, max 5MB</small>
                    <div id="imagePreviewContainer" class="mt-2" style="display:none;">
                        <img id="imagePreview" src="" style="max-width:100%;max-height:150px;border-radius:8px;" />
                        <button type="button" class="btn btn-sm btn-outline-danger mt-1"
                                onclick="removeImage()">
                            Remove
                        </button>
                    </div>
                </div>
            </div>
            <div class="modal-footer border-0">
                <button type="button" class="btn btn-secondary" onclick="closeItemPicker()">Cancel</button>
                <button type="button" class="btn btn-primary" onclick="confirmItemPick()">Add Item</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        // Fix — prevent aria-hidden focus warning when closing modals
        document.querySelectorAll('.modal').forEach(modalEl => {
            modalEl.addEventListener('hide.bs.modal', () => {
                if (modalEl.contains(document.activeElement)) {
                    document.activeElement.blur();
                }
            });
        });

        // Data from server
        // Fix 5 — normalize currentUser to null when empty, so ownership/like checks behave correctly
        const currentUser = '@loggedInUser?.UserName' === '' ? null : '@loggedInUser?.UserName';
        const apiBase = 'https://localhost:7040/api';
        const userCollectionItems = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.UserCollectionItems));
        const allCategories = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.Categories));

        // State
        let selectedItems = [null, null, null]; // 3 cells
        let currentPickerCell = 0;
        let currentShowoffId = null;
        let pendingDeleteId = null;
        let pendingDeleteName = null;
        let selectedItemForPicker = null;
        let uploadedImageData = null;

        // ── View Showoff ──
        // Fix 2 — handle both camelCase and PascalCase API payloads, guard against failed fetch
        async function viewShowoff(showoffId, ownerName) {
            // Record view
            await fetch(`${apiBase}/ShowoffView`, {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ showoffId, viewerUserName: currentUser || null })
            });

            // Fetch showoff details
            const res = await fetch(`${apiBase}/Showoff/${showoffId}`);
            if (!res.ok) { alert('Could not load showoff.'); return; }
            const showoff = await res.json();

            // Check if user liked
            const likeRes = await fetch(`${apiBase}/ShowoffLike/${showoffId}?userName=${currentUser}`);
            const likeData = await likeRes.json();

            document.getElementById('viewShowoffName').textContent = showoff.showoffName || showoff.ShowoffName;
            document.getElementById('likeCount').textContent = likeData.likeCount ?? likeData.LikeCount ?? 0;
            document.getElementById('likeBtn').dataset.showoffId = showoffId;
            document.getElementById('likeBtn').dataset.liked = likeData.userLiked ?? likeData.UserLiked ?? false;

            const icon = document.getElementById('likeIcon');
            const liked = likeData.userLiked ?? likeData.UserLiked ?? false;
            // Fix 4 — grey heart if not liked, red if liked
            icon.className = liked ? 'bi bi-heart-fill text-danger' : 'bi bi-heart text-secondary';

            const bgColor = showoff.backgroundColor || showoff.BackgroundColor;
            const items = showoff.items || showoff.Items || [];

            const body = document.getElementById('viewShowoffBody');

            // Determine image size based on item count — 1 item = largest, 3 items = smallest
            const itemCount = items.length;
            const imageSize = itemCount === 1 ? 260 : itemCount === 2 ? 190 : 140;
            const cellWidth = itemCount === 1 ? 280 : itemCount === 2 ? 210 : 160;

            body.innerHTML = `
                        <div class="rounded-3 p-4 d-flex flex-column align-items-center justify-content-center w-100 h-100"
                             style="background-color:${bgColor}; min-height:60vh;">
                            <div class="d-flex justify-content-center align-items-start flex-wrap gap-4 w-100">
                                ${items.map(item => {
                const imgPath = item.imagePath || item.ImagePath;
                const itemName = item.itemName || item.ItemName;
                const catName = item.categoryName || item.CategoryName;
                return `
                                        <div class="text-center d-flex flex-column align-items-center"
                                             style="width:${cellWidth}px;">
                                            ${imgPath
                        ? `<img src="${imgPath}"
                                                        style="width:${imageSize}px;height:${imageSize}px;object-fit:cover;border-radius:14px;box-shadow:0 4px 14px rgba(0,0,0,0.25);" />`
                        : `<div style="width:${imageSize}px;height:${imageSize}px;background:rgba(255,255,255,0.3);border-radius:14px;"></div>`}
                                            <div class="mt-3 fw-bold fs-5 text-center"
                                                 style="width:100%; word-wrap:break-word; overflow-wrap:break-word;">
                                                ${itemName || ''}
                                            </div>
                                            ${catName ? `
                                            <div class="text-muted fs-6 text-center"
                                                 style="width:100%; word-wrap:break-word; overflow-wrap:break-word;">
                                                ${catName}
                                            </div>` : ''}
                                        </div>`;
            }).join('')}
                            </div>
                            <div class="mt-4 text-center">
                                <span class="text-muted fs-6">By <strong>${showoff.userName || showoff.UserName}</strong></span>
                            </div>
                        </div>`;

            const modal = new bootstrap.Modal(document.getElementById('viewShowoffModal'));
            modal.show();
        }

        // ── Like / Unlike ──
        // Fix 4 & 5 — grey/red heart icon, works regardless of ownership
        async function toggleLike() {
            const btn = document.getElementById('likeBtn');
            const icon = document.getElementById('likeIcon');
            const showoffId = parseInt(btn.dataset.showoffId);
            const liked = btn.dataset.liked === 'true';

            if (liked) {
                await fetch(`${apiBase}/ShowoffLike/${showoffId}/${currentUser}`, { method: 'DELETE' });
                btn.dataset.liked = 'false';
                // Grey heart when not liked
                icon.className = 'bi bi-heart text-secondary';
                document.getElementById('likeCount').textContent =
                    parseInt(document.getElementById('likeCount').textContent) - 1;
            } else {
                await fetch(`${apiBase}/ShowoffLike`, {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ showoffId, userName: currentUser })
                });
                btn.dataset.liked = 'true';
                // Red filled heart when liked
                icon.className = 'bi bi-heart-fill text-danger';
                document.getElementById('likeCount').textContent =
                    parseInt(document.getElementById('likeCount').textContent) + 1;
            }
        }

        // ── Manage Modal ──
        function openManageModal() {
            bootstrap.Modal.getInstance(document.getElementById('viewShowoffModal'))?.hide();
            new bootstrap.Modal(document.getElementById('manageModal')).show();
        }

        // ── Delete ──
        function openDeleteConfirm(showoffId, showoffName) {
            pendingDeleteId = showoffId;
            pendingDeleteName = showoffName;
            document.getElementById('deleteShowoffName').textContent = showoffName;
            bootstrap.Modal.getInstance(document.getElementById('manageModal'))?.hide();
            new bootstrap.Modal(document.getElementById('deleteConfirmModal')).show();
        }

        function reopenManage() {
            bootstrap.Modal.getInstance(document.getElementById('deleteConfirmModal'))?.hide();
            new bootstrap.Modal(document.getElementById('manageModal')).show();
        }

        async function confirmDelete() {
            await fetch(`${apiBase}/Showoff/${pendingDeleteId}`, { method: 'DELETE' });
            bootstrap.Modal.getInstance(document.getElementById('deleteConfirmModal'))?.hide();
            window.location.reload();
        }

        // ── Create/Edit Modal ──
        function openCreateModal() {
            currentShowoffId = null;
            selectedItems = [null, null, null];
            document.getElementById('createEditTitle').textContent = 'Create Showoff';
            document.getElementById('showoffName').value = '';
            document.getElementById('bgColor').value = '#ffffff';
            document.getElementById('nameCharCount').textContent = '0';
            document.getElementById('visPublic').checked = true;
            resetPreviewCells();
            updatePreview();
            new bootstrap.Modal(document.getElementById('createEditModal')).show();
        }

        async function openEditModal(showoffId) {
            currentShowoffId = showoffId;
            bootstrap.Modal.getInstance(document.getElementById('manageModal'))?.hide();

            const res = await fetch(`${apiBase}/Showoff/${showoffId}`);
            const showoff = await res.json();

            document.getElementById('createEditTitle').textContent = 'Edit Showoff';
            document.getElementById('showoffName').value = showoff.showoffName;
            document.getElementById('nameCharCount').textContent = showoff.showoffName.length;
            document.getElementById('bgColor').value = showoff.backgroundColor;
            document.getElementById(showoff.isPrivate ? 'visPrivate' : 'visPublic').checked = true;

            selectedItems = [null, null, null];
            showoff.items.forEach(item => {
                selectedItems[item.displayOrder] = {
                    itemId: item.itemId,
                    itemName: item.itemName,
                    imagePath: item.imagePath,
                    imagePublicId: item.imagePublicId,
                    displayOrder: item.displayOrder
                };
            });

            updatePreview();
            updateSelectedItemsList();
            new bootstrap.Modal(document.getElementById('createEditModal')).show();
        }

        // Fix 1 — Cancel from Create card should not reopen Manage; Cancel from Edit should
        function closeCreateEdit() {
            bootstrap.Modal.getInstance(document.getElementById('createEditModal'))?.hide();
            if (currentShowoffId !== null) {
                // Came from Edit in Manage — reopen Manage
                new bootstrap.Modal(document.getElementById('manageModal')).show();
            }
            // Came from Create card — just close, no Manage
        }

        function resetPreviewCells() {
            for (let i = 0; i < 3; i++) {
                const cell = document.getElementById(`previewCell${i}`);
                cell.innerHTML = '<i class="bi bi-plus text-muted fs-4"></i>';
                cell.style.border = '2px dashed #adb5bd';
            }
        }

        function updatePreview() {
            const name = document.getElementById('showoffName').value;
            const color = document.getElementById('bgColor').value;
            const isPrivate = document.getElementById('visPrivate').checked;

            document.getElementById('showoffPreview').style.backgroundColor = color;
            document.getElementById('previewName').textContent = name || 'Showoff Name';
            document.getElementById('bgColorHex').textContent = color;
            document.getElementById('nameCharCount').textContent = name.length;

            const badge = document.getElementById('previewBadge');
            badge.textContent = isPrivate ? 'Private' : 'Public';
            badge.className = `badge ${isPrivate ? 'bg-secondary' : 'bg-success'}`;

            // Update cells
            for (let i = 0; i < 3; i++) {
                const cell = document.getElementById(`previewCell${i}`);
                const item = selectedItems[i];
                if (item) {
                    if (item.imagePath) {
                        cell.innerHTML = `<img src="${item.imagePath}" style="width:76px;height:76px;object-fit:cover;border-radius:6px;" />`;
                    } else {
                        cell.innerHTML = `<span class="small text-center px-1" style="font-size:10px;">${item.itemName}</span>`;
                    }
                    cell.style.border = 'none';
                } else {
                    cell.innerHTML = '<i class="bi bi-plus text-muted fs-4"></i>';
                    cell.style.border = '2px dashed #adb5bd';
                }
            }
        }

        function updateSelectedItemsList() {
            const list = document.getElementById('selectedItemsList');
            const activeItems = selectedItems.filter(i => i !== null);
            if (activeItems.length === 0) {
                list.innerHTML = '<p class="text-muted small">Click a cell in the preview to add items.</p>';
                return;
            }
            list.innerHTML = activeItems.map((item, idx) => `
                            <div class="d-flex align-items-center justify-content-between mb-1">
                                <span class="small">${item.itemName}</span>
                                <button class="btn btn-sm btn-outline-danger" onclick="removeItem(${item.displayOrder})">×</button>
                            </div>
                        `).join('');
        }

        function removeItem(displayOrder) {
            selectedItems[displayOrder] = null;
            updatePreview();
            updateSelectedItemsList();
        }

        // ── Item Picker ──
        function openItemPicker(cellIndex) {
            currentPickerCell = cellIndex;
            selectedItemForPicker = null;
            uploadedImageData = null;
            document.getElementById('itemPickerSearch').value = '';
            document.getElementById('itemPickerSuggestions').style.display = 'none';
            document.getElementById('itemImageUpload').value = '';
            document.getElementById('imagePreviewContainer').style.display = 'none';

            bootstrap.Modal.getInstance(document.getElementById('createEditModal'))?.hide();
            new bootstrap.Modal(document.getElementById('itemPickerModal')).show();
        }

        function closeItemPicker() {
            bootstrap.Modal.getInstance(document.getElementById('itemPickerModal'))?.hide();
            new bootstrap.Modal(document.getElementById('createEditModal')).show();
        }

        // Item picker search
        const itemPickerSearch = document.getElementById('itemPickerSearch');
        const itemPickerSuggestions = document.getElementById('itemPickerSuggestions');

        itemPickerSearch.addEventListener('focus', function () {
            renderItemPickerSuggestions(userCollectionItems);
            itemPickerSuggestions.style.display = 'block';
        });

        itemPickerSearch.addEventListener('input', function () {
            const query = this.value.trim().toLowerCase();
            if (query.length === 0) {
                renderItemPickerSuggestions(userCollectionItems);
                return;
            }
            const filtered = userCollectionItems.filter(i =>
                i.ItemName && i.ItemName.toLowerCase().includes(query)
            );
            renderItemPickerSuggestions(filtered);
        });

        function renderItemPickerSuggestions(items) {
            itemPickerSuggestions.innerHTML = '';
            if (items.length === 0) {
                itemPickerSuggestions.innerHTML = '<div class="list-group-item text-muted">No items found</div>';
                return;
            }
            items.forEach(item => {
                const el = document.createElement('a');
                el.href = '#';
                el.className = 'list-group-item list-group-item-action';
                el.textContent = item.ItemName + (item.CategoryName ? ` — ${item.CategoryName}` : '');
                el.addEventListener('click', function (e) {
                    e.preventDefault();
                    selectedItemForPicker = item;
                    itemPickerSearch.value = item.ItemName;
                    itemPickerSuggestions.style.display = 'none';
                });
                itemPickerSuggestions.appendChild(el);
            });
        }

        // Image upload preview
        document.getElementById('itemImageUpload').addEventListener('change', function () {
            const file = this.files[0];
            if (!file) return;

            if (!['image/jpeg', 'image/png'].includes(file.type)) {
                alert('Only JPG and PNG files are allowed.');
                this.value = '';
                return;
            }
            if (file.size > 5 * 1024 * 1024) {
                alert('File size must not exceed 5MB.');
                this.value = '';
                return;
            }

            uploadedImageData = file;
            const reader = new FileReader();
            reader.onload = function (e) {
                document.getElementById('imagePreview').src = e.target.result;
                document.getElementById('imagePreviewContainer').style.display = 'block';
            };
            reader.readAsDataURL(file);
        });

        function removeImage() {
            uploadedImageData = null;
            document.getElementById('itemImageUpload').value = '';
            document.getElementById('imagePreviewContainer').style.display = 'none';
        }

        async function confirmItemPick() {
            if (!selectedItemForPicker) {
                alert('Please select an item.');
                return;
            }

            let imagePath = null;
            let imagePublicId = null;

            // Upload image if provided
            if (uploadedImageData) {
                const formData = new FormData();
                formData.append('file', uploadedImageData);

                const uploadRes = await fetch(`${apiBase}/ImageUpload`, {
                    method: 'POST',
                    body: formData
                });

                if (!uploadRes.ok) {
                    alert('Image upload failed. Please try again.');
                    return;
                }

                const uploadData = await uploadRes.json();
                imagePath = uploadData.imagePath;
                imagePublicId = uploadData.imagePublicId;
            }

            // Remove existing item at this cell if replacing
            const existing = selectedItems[currentPickerCell];
            if (existing?.imagePublicId) {
                // Mark for deletion on save
                window.pendingImageDeletes = window.pendingImageDeletes || [];
                window.pendingImageDeletes.push(existing.imagePublicId);
            }

            selectedItems[currentPickerCell] = {
                itemId: selectedItemForPicker.ItemId,
                itemName: selectedItemForPicker.ItemName,
                imagePath,
                imagePublicId,
                displayOrder: currentPickerCell
            };

            updatePreview();
            updateSelectedItemsList();
            closeItemPicker();
        }

        // ── Save Showoff ──
        async function saveShowoff() {
            const name = document.getElementById('showoffName').value.trim();
            if (!name) { alert('Please enter a showoff name.'); return; }

            const activeItems = selectedItems.filter(i => i !== null);
            if (activeItems.length === 0) { alert('Please add at least 1 item.'); return; }

            const isPrivate = document.getElementById('visPrivate').checked;
            const bgColor = document.getElementById('bgColor').value;

            const payload = {
                showoffName: name,
                backgroundColor: bgColor,
                isPrivate,
                userName: currentUser,
                items: activeItems.map(i => ({
                    itemId: i.itemId,
                    imagePath: i.imagePath,
                    imagePublicId: i.imagePublicId,
                    displayOrder: i.displayOrder
                }))
            };

            // Delete pending images if editing
            if (window.pendingImageDeletes?.length) {
                for (const publicId of window.pendingImageDeletes) {
                    await fetch(`${apiBase}/ImageUpload`, {
                        method: 'DELETE',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify(publicId)
                    });
                }
                window.pendingImageDeletes = [];
            }

            let res;
            if (currentShowoffId) {
                res = await fetch(`${apiBase}/Showoff/${currentShowoffId}`, {
                    method: 'PUT',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify(payload)
                });
            } else {
                res = await fetch(`${apiBase}/Showoff`, {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify(payload)
                });
            }

            if (res.ok) {
                bootstrap.Modal.getInstance(document.getElementById('createEditModal'))?.hide();
                window.location.reload();
            } else {
                const err = await res.text();
                alert(`Failed to save: ${err}`);
            }
        }

        function renderSearchSuggestions(container, data, keyField, onSelect, query) {
            container.innerHTML = '';
            const filtered = query
                ? data.filter(d => d[keyField]?.toLowerCase().includes(query))
                : data;

            if (filtered.length === 0) {
                container.innerHTML = '<div class="list-group-item text-muted">No results</div>';
                return;
            }

            filtered.slice(0, 5).forEach(item => {
                const el = document.createElement('a');
                el.href = '#';
                el.className = 'list-group-item list-group-item-action';
                el.textContent = item[keyField];
                el.addEventListener('click', e => { e.preventDefault(); onSelect(item[keyField]); container.style.display = 'none'; });
                container.appendChild(el);
            });
            container.style.display = 'block';
        }

        // Get unique values for search bars
        const allShowoffs = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.AllShowoffs));
        const uniqueUsers = [...new Set(allShowoffs.map(s => s.UserName))].map(u => ({ UserName: u }));
        const uniqueItems = [...new Set(allShowoffs.flatMap(s => s.Items.map(i => i.ItemName)))].map(n => ({ ItemName: n }));
        const uniqueCategories = [...new Set(allShowoffs.flatMap(s => s.Items.map(i => i.CategoryName).filter(Boolean)))].map(c => ({ CategoryName: c }));

        // ── AJAX Filtering (no page reload) ──
        let currentFilters = {
            searchUser: '@Model.SearchUser' || '',
            searchItem: '@Model.SearchItem' || '',
            searchCategory: '@Model.SearchCategory' || '',
            sort: '@Model.SortBy' || 'popular',
            page: 1
        };

        async function refreshGrid(newFilters = {}) {
            Object.assign(currentFilters, newFilters);

            const params = new URLSearchParams({
                tab: 'feed',
                sort: currentFilters.sort,
                page: currentFilters.page,
                searchUser: currentFilters.searchUser,
                searchItem: currentFilters.searchItem,
                searchCategory: currentFilters.searchCategory
            });

            const res = await fetch(`?handler=Filter&${params.toString()}`, {
                headers: { 'X-Requested-With': 'XMLHttpRequest' }
            });

            if (!res.ok) {
                console.error('Failed to refresh grid');
                return;
            }

            const html = await res.text();
            document.getElementById('showoffGridContainer').innerHTML = html;
            attachGridListeners();

            // Also update the browser URL bar without reloading — keeps refresh/back-button friendly
            const urlParams = new URLSearchParams(window.location.search);
            urlParams.set('sort', currentFilters.sort);
            urlParams.set('page', currentFilters.page);
            currentFilters.searchUser ? urlParams.set('searchUser', currentFilters.searchUser) : urlParams.delete('searchUser');
            currentFilters.searchItem ? urlParams.set('searchItem', currentFilters.searchItem) : urlParams.delete('searchItem');
            currentFilters.searchCategory ? urlParams.set('searchCategory', currentFilters.searchCategory) : urlParams.delete('searchCategory');
            history.replaceState(null, '', `${window.location.pathname}?${urlParams.toString()}`);
        }

        // Re-attach hover + pagination-click listeners after each AJAX swap
        function attachGridListeners() {
            document.querySelectorAll('.showoff-card').forEach(card => {
                card.addEventListener('mouseenter', () => {
                    card.querySelector('.owner-overlay').style.display = 'block';
                });
                card.addEventListener('mouseleave', () => {
                    card.querySelector('.owner-overlay').style.display = 'none';
                });
            });

            document.querySelectorAll('.ajax-page-link').forEach(link => {
                link.addEventListener('click', (e) => {
                    e.preventDefault();
                    if (link.closest('.page-item').classList.contains('disabled')) return;
                    refreshGrid({ page: parseInt(link.dataset.page) });
                });
            });
        }

        // Sort dropdown — AJAX instead of navigation
        document.getElementById('sortSelect')?.addEventListener('change', function () {
            refreshGrid({ sort: this.value, page: 1 });
        });

        // ── Search bars (Feed) — AJAX, keeps focus, no reload ──
        function setupSearch(inputId, suggestionsId, dataArray, keyField, filterKey) {
            const input = document.getElementById(inputId);
            const suggestions = document.getElementById(suggestionsId);
            if (!input || !suggestions) return;

            input.addEventListener('focus', () => {
                renderSearchSuggestions(suggestions, dataArray, keyField, (val) => {
                    input.value = val;
                    suggestions.style.display = 'none';
                    refreshGrid({ [filterKey]: val, page: 1 });
                }, '');
                suggestions.style.display = 'block';
            });

            input.addEventListener('input', function () {
                const query = this.value.trim();
                renderSearchSuggestions(suggestions, dataArray, keyField, (val) => {
                    input.value = val;
                    suggestions.style.display = 'none';
                    refreshGrid({ [filterKey]: val, page: 1 });
                }, query.toLowerCase());

                clearTimeout(this._searchTimer);
                this._searchTimer = setTimeout(() => {
                    refreshGrid({ [filterKey]: query, page: 1 });
                }, 500);
            });

            input.addEventListener('keydown', function (e) {
                if (e.key === 'Enter') {
                    e.preventDefault();
                    clearTimeout(this._searchTimer);
                    suggestions.style.display = 'none';
                    refreshGrid({ [filterKey]: this.value.trim(), page: 1 });
                }
            });

            document.addEventListener('click', function (e) {
                if (!input.contains(e.target) && !suggestions.contains(e.target))
                    suggestions.style.display = 'none';
            });
        }

        setupSearch('searchUsers', 'userSuggestions', uniqueUsers, 'UserName', 'searchUser');
        setupSearch('searchItems', 'itemSuggestions', uniqueItems, 'ItemName', 'searchItem');
        setupSearch('searchCategories', 'categorySuggestions', uniqueCategories, 'CategoryName', 'searchCategory');

        // Initial attach for the server-rendered grid on first page load
        attachGridListeners();
    </script>
}