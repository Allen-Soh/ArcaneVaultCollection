@model ArcaneVaultRP.Pages.Showoffs.IndexModel

<div class="row row-cols-2 row-cols-md-4 g-3">
    @foreach (var frame in Model.PagedFrames)
    {
        <div class="col">
            <div class="card h-100 p-2 shop-cosmetic-card position-relative" style="cursor:pointer;"
                 onclick="openCosmeticDetail(this)"
                 data-type="frame"
                 data-code="@frame.FrameCode"
                 data-name="@frame.FrameName"
                 data-image="@frame.ImagePath"
                 data-price="@frame.Price.ToString("0.00")"
                 data-limited="@frame.IsLimited.ToString().ToLower()"
                 data-qty="@(frame.LimitedQuantity?.ToString() ?? "")">
                @if (frame.IsLimited)
                {
                    <span class="shop-limited-badge">Limited</span>
                }
                <div class="text-center" style="height:100px;display:flex;align-items:center;justify-content:center;">
                    @if (!string.IsNullOrEmpty(frame.ImagePath))
                    {
                        <img src="@frame.ImagePath" alt="@frame.FrameName" style="max-width:100%;max-height:100%;object-fit:contain;" />
                    }
                    else
                    {
                        <div style="width:80px;height:80px;background:rgba(255,255,255,0.1);border-radius:8px;"></div>
                    }
                </div>
                <div class="small fw-semibold mt-2 text-center text-truncate">@frame.FrameName</div>
                <button type="button" class="btn btn-sm btn-primary w-100 mt-2 shop-buy-btn" onclick="buyCosmetic(event)">
                    <i class="bi bi-cart"></i> SGD @frame.Price.ToString("0.00")
                </button>
            </div>
        </div>
    }

    @if (!Model.PagedFrames.Any())
    {
        <div class="col-12 text-center text-muted py-4">No items yet.</div>
    }
</div>

@if (Model.FrameTotalPages > 1)
{
    <nav class="d-flex justify-content-end mt-2">
        <ul class="pagination pagination-sm mb-0 gap-2">
            @if (Model.FrameCurrentPage > 1)
            {
                <li class="page-item">
                    <a class="page-link cosmetic-ajax-page-link pagination-box" href="#" data-section="frames" data-page="@(Model.FrameCurrentPage - 1)">&lt;</a>
                </li>
            }
            @if (Model.FrameCurrentPage < Model.FrameTotalPages)
            {
                <li class="page-item">
                    <a class="page-link cosmetic-ajax-page-link pagination-box" href="#" data-section="frames" data-page="@(Model.FrameCurrentPage + 1)">&gt;</a>
                </li>
            }
        </ul>
    </nav>
}
