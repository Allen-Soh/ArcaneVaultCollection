@page
@model ArcaneVaultRP.Pages.ShowoffPages.CreateFrameModel
@{
    ViewData["Title"] = "Create Frame";
}

<div class="container mt-4 mb-5" style="max-width: 640px;">
    <div class="d-flex align-items-center gap-3 mb-4">
        <a asp-page="/ShowoffPages/Index" asp-route-tab="shop" class="btn btn-secondary btn-sm">
            <i class="bi bi-arrow-left"></i> Back
        </a>
        <h4 class="fw-bold mb-0">Create Frame</h4>
    </div>

    <div class="card border-0 shadow-sm p-4" style="background: rgba(166, 177, 225, 0.02); border: 1px solid var(--border-color) !important;">

        <!-- Frame Code -->
        <div class="mb-3">
            <label class="form-label fw-semibold">Frame Code</label>
            <input type="text" id="frameCode" class="form-control" maxlength="20"
                   placeholder="e.g. FRM_GOLD" oninput="this.value = this.value.toUpperCase()" />
            <small class="text-muted">A short, unique identifier. Cannot be changed later.</small>
        </div>

        <!-- Frame Name -->
        <div class="mb-3">
            <label class="form-label fw-semibold">Frame Name</label>
            <input type="text" id="frameName" class="form-control" maxlength="60"
                   placeholder="e.g. Golden Frame" oninput="updateCharCount()" />
            <div class="d-flex justify-content-end">
                <small class="text-muted"><span id="nameCharCount">0</span>/60</small>
            </div>
        </div>

        <!-- Orientation -->
        <div class="mb-3">
            <label class="form-label fw-semibold d-block">Dimension</label>
            <div class="d-flex gap-3">
                <div class="form-check">
                    <input class="form-check-input" type="radio" name="orientation" id="orientationLandscape" value="Landscape" checked onchange="revalidateOrientation()">
                    <label class="form-check-label" for="orientationLandscape">Landscape</label>
                </div>
                <div class="form-check">
                    <input class="form-check-input" type="radio" name="orientation" id="orientationPortrait" value="Portrait" onchange="revalidateOrientation()">
                    <label class="form-check-label" for="orientationPortrait">Portrait</label>
                </div>
            </div>
        </div>

        <!-- Image -->
        <div class="mb-2">
            <label class="form-label fw-semibold d-block">Image</label>
            <div id="imageDropZone"
                 class="d-flex align-items-center justify-content-center position-relative"
                 style="height:140px; border:2px dashed var(--border-color); border-radius:8px; cursor:pointer; overflow:hidden;"
                 onclick="triggerFileUpload()">
                <img id="imagePreviewThumb" src="" style="display:none; max-width:100%; max-height:100%; object-fit:contain;" />
                <span id="imagePlaceholder" class="text-muted small"><i class="bi bi-image"></i> Click to upload image or GIF</span>
                <input type="file" id="imageFileInput" accept=".jpg,.jpeg,.png,.gif" style="display:none;" onchange="handleImageUpload(event)" />
            </div>
            <div class="d-flex justify-content-end mt-1">
                <button type="button" id="imageRemoveBtn" class="btn btn-sm btn-outline-danger"
                        style="display:none; font-size:11px; padding:2px 8px;" onclick="removeImage()">
                    Remove image
                </button>
            </div>
        </div>
        <div class="mb-4">
            <small class="text-muted d-block">Background must be transparent</small>
            <small class="text-muted d-block">Dimension should be appropriate</small>
            <small class="text-muted d-block">Frame design should be appropriate</small>
        </div>

        <!-- Price -->
        <div class="mb-3">
            <label class="form-label fw-semibold">Price (SGD)</label>
            <input type="number" id="priceInput" class="form-control" step="0.01" min="0" placeholder="0.00" />
        </div>

        <!-- Limited / Unlimited -->
        <div class="mb-4">
            <label class="form-label fw-semibold d-block">Availability</label>
            <select id="limitedSelect" class="form-select" onchange="toggleLimitedQty()">
                <option value="unlimited" selected>Unlimited</option>
                <option value="limited">Limited</option>
            </select>
            <div id="limitedQtyWrapper" class="mt-2" style="display:none;">
                <label class="form-label fw-semibold small">Quantity</label>
                <input type="number" id="limitedQtyInput" class="form-control" min="1" step="1" placeholder="e.g. 50" />
            </div>
        </div>

        <div class="d-flex justify-content-end mb-3">
            <button type="button" class="btn btn-outline-secondary btn-sm" onclick="openPreview()">
                <i class="bi bi-eye"></i> Preview
            </button>
        </div>

        <div id="formError" class="alert alert-danger py-2" style="display:none;font-size:13px;"></div>

        <div class="d-flex gap-2 justify-content-end">
            <a asp-page="/ShowoffPages/Index" asp-route-tab="shop" class="btn btn-secondary px-4">Cancel</a>
            <button type="button" class="btn btn-primary px-4" id="saveBtn" onclick="saveFrame()">Create Frame</button>
        </div>
    </div>
</div>

<!-- Preview modal -->
<div class="modal fade" id="previewModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content" style="background: var(--bg-card, #161b22); border: 1px solid var(--border-color, #30363d); border-radius: 14px;">
            <div class="modal-header border-bottom" style="border-color:var(--border-color,#21262d) !important;">
                <h5 class="modal-title fw-bold">Preview</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <div class="card p-2 position-relative mx-auto" style="max-width:220px;">
                    <span class="shop-limited-badge" id="previewLimitedBadge" style="display:none;">Limited</span>
                    <div class="text-center" style="height:140px;display:flex;align-items:center;justify-content:center;">
                        <img id="previewImage" src="" style="max-width:100%;max-height:100%;object-fit:contain;" />
                    </div>
                    <div class="small fw-semibold mt-2 text-center text-truncate" id="previewName"></div>
                    <button type="button" class="btn btn-sm btn-primary w-100 mt-2 shop-buy-btn" disabled>
                        <i class="bi bi-cart"></i> <span id="previewPrice"></span>
                    </button>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        const apiBase = document.getElementById('apiBaseInput')?.value || 'https://localhost:7040/api';
        let imagePath = null;
        let imagePublicId = null;
        let lastImageDims = null;

        function updateCharCount() {
            document.getElementById('nameCharCount').textContent = document.getElementById('frameName').value.length;
        }

        function triggerFileUpload() {
            document.getElementById('imageFileInput').click();
        }

        function toggleLimitedQty() {
            const wrapper = document.getElementById('limitedQtyWrapper');
            wrapper.style.display = document.getElementById('limitedSelect').value === 'limited' ? 'block' : 'none';
        }

        function readImageDimensions(file) {
            return new Promise((resolve, reject) => {
                const img = new Image();
                const url = URL.createObjectURL(file);
                img.onload = () => { URL.revokeObjectURL(url); resolve({ width: img.naturalWidth, height: img.naturalHeight }); };
                img.onerror = () => { URL.revokeObjectURL(url); reject(new Error('Could not read image dimensions.')); };
                img.src = url;
            });
        }

        function orientationMatches(dims, orientation) {
            const isLandscapeShape = dims.width > dims.height;
            return orientation === 'Landscape' ? isLandscapeShape : !isLandscapeShape;
        }

        function selectedOrientation() {
            return document.querySelector('input[name="orientation"]:checked').value;
        }

        // Re-checks the already-uploaded image against a newly selected orientation.
        function revalidateOrientation() {
            if (!lastImageDims) return;
            if (!orientationMatches(lastImageDims, selectedOrientation())) {
                showError('Use an appropriate dimension content for selected Frame dimension.');
            } else {
                document.getElementById('formError').style.display = 'none';
            }
        }

        async function handleImageUpload(event) {
            const file = event.target.files[0];
            if (!file) return;

            if (!['image/jpeg', 'image/png', 'image/gif'].includes(file.type)) {
                showError('Only JPG, PNG, and GIF files are allowed.');
                return;
            }
            if (file.size > 5 * 1024 * 1024) {
                showError('Max 5MB file size.');
                return;
            }

            let dims;
            try {
                dims = await readImageDimensions(file);
            } catch {
                showError('Could not read image dimensions.');
                return;
            }

            if (!orientationMatches(dims, selectedOrientation())) {
                showError('Use an appropriate dimension content for selected Frame dimension.');
                return;
            }
            lastImageDims = dims;
            document.getElementById('formError').style.display = 'none';

            const formData = new FormData();
            formData.append('file', file);

            const uploadRes = await fetch(`${apiBase}/ImageUpload`, { method: 'POST', body: formData });
            if (!uploadRes.ok) { showError('Image upload failed.'); return; }
            const data = await uploadRes.json();

            if (imagePublicId) {
                window.pendingImageDeletes = window.pendingImageDeletes || [];
                window.pendingImageDeletes.push(imagePublicId);
            }

            imagePath = data.imagePath;
            imagePublicId = data.imagePublicId;
            renderImagePreview();
        }

        function removeImage() {
            if (imagePublicId) {
                window.pendingImageDeletes = window.pendingImageDeletes || [];
                window.pendingImageDeletes.push(imagePublicId);
            }
            imagePath = null;
            imagePublicId = null;
            lastImageDims = null;
            renderImagePreview();
        }

        function renderImagePreview() {
            const thumb = document.getElementById('imagePreviewThumb');
            const placeholder = document.getElementById('imagePlaceholder');
            const removeBtn = document.getElementById('imageRemoveBtn');

            if (imagePath) {
                thumb.src = imagePath;
                thumb.style.display = 'block';
                placeholder.style.display = 'none';
                removeBtn.style.display = 'inline-block';
            } else {
                thumb.style.display = 'none';
                placeholder.style.display = 'block';
                removeBtn.style.display = 'none';
            }
        }

        function showError(msg) {
            const el = document.getElementById('formError');
            el.textContent = msg;
            el.style.display = 'block';
        }

        function openPreview() {
            document.getElementById('previewName').textContent = document.getElementById('frameName').value.trim() || '(no name)';
            document.getElementById('previewImage').src = imagePath || '';
            const price = parseFloat(document.getElementById('priceInput').value) || 0;
            document.getElementById('previewPrice').textContent = 'SGD ' + price.toFixed(2);
            document.getElementById('previewLimitedBadge').style.display =
                document.getElementById('limitedSelect').value === 'limited' ? 'inline-block' : 'none';
            new bootstrap.Modal(document.getElementById('previewModal')).show();
        }

        async function saveFrame() {
            const frameCode = document.getElementById('frameCode').value.trim();
            const frameName = document.getElementById('frameName').value.trim();
            const priceRaw = document.getElementById('priceInput').value.trim();
            const isLimited = document.getElementById('limitedSelect').value === 'limited';
            const limitedQtyRaw = document.getElementById('limitedQtyInput').value.trim();

            if (!frameCode) { showError('Please enter a frame code.'); return; }
            if (!frameName) { showError('Please enter a frame name.'); return; }
            if (!/^\d+(\.\d{1,2})?$/.test(priceRaw)) { showError('Enter a valid price (up to 2 decimal places).'); return; }
            if (isLimited && (!limitedQtyRaw || parseInt(limitedQtyRaw) < 1)) { showError('Enter a limited quantity of at least 1.'); return; }

            document.getElementById('formError').style.display = 'none';

            const btn = document.getElementById('saveBtn');
            btn.disabled = true;
            btn.innerHTML = `<span class="spinner-border spinner-border-sm me-1"></span>Saving...`;

            const payload = {
                frameCode: frameCode,
                frameName: frameName,
                imagePath: imagePath,
                imagePublicId: imagePublicId,
                orientation: selectedOrientation(),
                price: parseFloat(priceRaw),
                isLimited: isLimited,
                limitedQuantity: isLimited ? parseInt(limitedQtyRaw) : null,
                isDelisted: false
            };

            const jwtToken = document.getElementById('jwtTokenInput')?.value;
            const res = await fetch(`${apiBase}/Frame`, {
                method: 'POST',
                headers: { 'Content-Type': 'application/json', 'Authorization': `Bearer ${jwtToken}` },
                body: JSON.stringify(payload)
            });

            btn.disabled = false;
            btn.textContent = 'Create Frame';

            if (res.ok) {
                window.location.href = '/ShowoffPages/Index?tab=shop';
            } else {
                const text = await res.text();
                showError(`Failed to create frame: ${text || 'Please check the code isn’t already in use.'}`);
            }
        }
    </script>
}
