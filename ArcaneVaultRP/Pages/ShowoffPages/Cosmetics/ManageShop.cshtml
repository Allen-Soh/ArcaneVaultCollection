@page
@model ArcaneVaultRP.Pages.ShowoffPages.ManageShopModel
@{
    ViewData["Title"] = "Manage Shop";
}

<div class="container mt-4 mb-5">
    <div id="actionMessage" class="alert alert-success" style="display:none;"></div>

    <div class="d-flex align-items-center justify-content-between mb-4 flex-wrap gap-2">
        <h4 class="fw-bold mb-0">Manage Shop</h4>
        <div class="d-flex align-items-center gap-2">
            <select id="typeSelect" class="form-select form-select-sm" style="width:auto;" onchange="switchType()">
                <option value="sticker">Sticker</option>
                <option value="frame">Frame</option>
            </select>
            <a id="createNewBtn" href="/ShowoffPages/Cosmetics/CreateSticker" class="btn btn-primary btn-sm">
                <i class="bi bi-plus-circle"></i> Create New
            </a>
        </div>
    </div>

    <!-- Name search -->
    <div class="mb-3 position-relative" style="max-width:320px;">
        <input type="text" id="cosmeticNameSearch" class="form-control form-control-sm"
               placeholder="Search by name..." autocomplete="off" oninput="applyNameFilter()" />
    </div>

    <!-- Sticker list -->
    <div id="stickerList">
        @if (!Model.AllStickers.Any())
        {
            <div class="text-center text-muted py-4">No stickers yet.</div>
        }
        <div id="stickerSearchEmpty" style="display:none;" class="text-center text-muted py-4">No stickers match your search.</div>
        @foreach (var sticker in Model.AllStickers)
        {
            <div class="card mb-2 p-2 d-flex flex-row align-items-center gap-3" data-name="@sticker.StickerName" style="@(sticker.IsDelisted ? "opacity:0.55;" : "")">
                <div style="width:56px;height:56px;flex:0 0 auto;display:flex;align-items:center;justify-content:center;background:rgba(255,255,255,0.05);border-radius:8px;">
                    @if (!string.IsNullOrEmpty(sticker.ImagePath))
                    {
                        <img src="@sticker.ImagePath" alt="@sticker.StickerName" style="max-width:100%;max-height:100%;object-fit:contain;" />
                    }
                </div>
                <div class="flex-grow-1">
                    <div class="fw-semibold">
                        @sticker.StickerName
                        @if (sticker.IsLimited)
                        {
                            <span class="shop-limited-badge ms-1" style="position:static;">Limited</span>
                        }
                        @if (sticker.IsDelisted)
                        {
                            <span class="badge bg-secondary ms-1">Delisted</span>
                        }
                    </div>
                    <div class="text-muted small">SGD @sticker.Price.ToString("0.00") · @sticker.StickerCode</div>
                </div>
                <a href="/ShowoffPages/Cosmetics/EditSticker/@sticker.StickerCode" class="btn btn-sm btn-outline-secondary">
                    <i class="bi bi-pencil"></i> Edit
                </a>
                @if (sticker.IsDelisted)
                {
                    <button type="button" class="btn btn-sm btn-outline-success" onclick="confirmToggle('sticker', '@sticker.StickerCode', '@sticker.StickerName', false)">
                        Relist
                    </button>
                }
                else
                {
                    <button type="button" class="btn btn-sm btn-outline-danger" onclick="confirmToggle('sticker', '@sticker.StickerCode', '@sticker.StickerName', true)">
                        Delist
                    </button>
                }
            </div>
        }
    </div>

    <!-- Frame list -->
    <div id="frameList" style="display:none;">
        @if (!Model.AllFrames.Any())
        {
            <div class="text-center text-muted py-4">No frames yet.</div>
        }
        <div id="frameSearchEmpty" style="display:none;" class="text-center text-muted py-4">No frames match your search.</div>
        @foreach (var frame in Model.AllFrames)
        {
            <div class="card mb-2 p-2 d-flex flex-row align-items-center gap-3" data-name="@frame.FrameName" style="@(frame.IsDelisted ? "opacity:0.55;" : "")">
                <div style="width:56px;height:56px;flex:0 0 auto;display:flex;align-items:center;justify-content:center;background:rgba(255,255,255,0.05);border-radius:8px;">
                    @if (!string.IsNullOrEmpty(frame.ImagePath))
                    {
                        <img src="@frame.ImagePath" alt="@frame.FrameName" style="max-width:100%;max-height:100%;object-fit:contain;" />
                    }
                </div>
                <div class="flex-grow-1">
                    <div class="fw-semibold">
                        @frame.FrameName
                        <span class="badge bg-dark-subtle text-body ms-1">@frame.Orientation</span>
                        @if (frame.IsLimited)
                        {
                            <span class="shop-limited-badge ms-1" style="position:static;">Limited</span>
                        }
                        @if (frame.IsDelisted)
                        {
                            <span class="badge bg-secondary ms-1">Delisted</span>
                        }
                    </div>
                    <div class="text-muted small">SGD @frame.Price.ToString("0.00") · @frame.FrameCode</div>
                </div>
                <a href="/ShowoffPages/Cosmetics/EditFrame/@frame.FrameCode" class="btn btn-sm btn-outline-secondary">
                    <i class="bi bi-pencil"></i> Edit
                </a>
                @if (frame.IsDelisted)
                {
                    <button type="button" class="btn btn-sm btn-outline-success" onclick="confirmToggle('frame', '@frame.FrameCode', '@frame.FrameName', false)">
                        Relist
                    </button>
                }
                else
                {
                    <button type="button" class="btn btn-sm btn-outline-danger" onclick="confirmToggle('frame', '@frame.FrameCode', '@frame.FrameName', true)">
                        Delist
                    </button>
                }
            </div>
        }
    </div>
</div>

<!-- Delist/Relist confirmation modal -->
<div class="modal fade" id="toggleConfirmModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header border-0">
                <h5 class="modal-title fw-bold" id="toggleConfirmTitle">Delist item</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <p id="toggleConfirmText"></p>
            </div>
            <div class="modal-footer border-0">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-danger" id="toggleConfirmBtn" onclick="doToggle()">Confirm</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        const apiBase = document.getElementById('apiBaseInput')?.value;
        if (!apiBase) console.error('apiBaseInput is missing its value — ApiSettings:BaseUrl may not be configured.');
        let pendingToggle = null; // { type, code, delist }

        // ── Success confirmation after cosmetic Edit ──
        (function () {
            const params = new URLSearchParams(window.location.search);
            if ((params.get('updated') || '').toLowerCase() === 'true') {
                const msg = document.getElementById('actionMessage');
                msg.textContent = 'Cosmetic updated.';
                msg.style.display = 'block';
                setTimeout(() => msg.style.display = 'none', 4000);
                params.delete('updated');
                const remaining = params.toString();
                history.replaceState(null, '', window.location.pathname + (remaining ? `?${remaining}` : ''));
            }
        })();

        function switchType() {
            const type = document.getElementById('typeSelect').value;
            document.getElementById('stickerList').style.display = type === 'sticker' ? 'block' : 'none';
            document.getElementById('frameList').style.display = type === 'frame' ? 'block' : 'none';
            document.getElementById('createNewBtn').href = type === 'frame'
                ? '/ShowoffPages/Cosmetics/CreateFrame'
                : '/ShowoffPages/Cosmetics/CreateSticker';
        }

        // ── Name search (live filter over the server-rendered cards) ──
        function applyNameFilter() {
            const query = document.getElementById('cosmeticNameSearch').value.trim().toLowerCase();

            ['stickerList', 'frameList'].forEach(listId => {
                const cards = document.querySelectorAll(`#${listId} .card[data-name]`);
                let visibleCount = 0;
                cards.forEach(card => {
                    const match = !query || card.dataset.name.toLowerCase().includes(query);
                    card.style.display = match ? '' : 'none';
                    if (match) visibleCount++;
                });

                const emptyEl = document.getElementById(`${listId === 'stickerList' ? 'sticker' : 'frame'}SearchEmpty`);
                emptyEl.style.display = (query && cards.length > 0 && visibleCount === 0) ? 'block' : 'none';
            });
        }

        // Adds a clear ("×") button to a search input; shows only when it has text.
        function enableSearchClear(inputId) {
            const input = document.getElementById(inputId);
            if (!input || input.dataset.clearEnabled) return;

            const wrapper = document.createElement('div');
            wrapper.className = 'search-clear-wrapper';
            wrapper.style.width = '100%';
            input.style.width = '100%';

            input.parentElement.insertBefore(wrapper, input);
            wrapper.appendChild(input);

            const btn = document.createElement('button');
            btn.type = 'button';
            btn.className = 'search-clear-btn';
            btn.innerHTML = '&times;';
            btn.setAttribute('aria-label', 'Clear search');
            wrapper.appendChild(btn);

            function toggleBtn() {
                btn.style.display = input.value.length > 0 ? 'block' : 'none';
            }

            input.addEventListener('input', toggleBtn);
            toggleBtn();

            btn.addEventListener('click', () => {
                input.value = '';
                input.dispatchEvent(new Event('input', { bubbles: true }));
                toggleBtn();
                input.focus();
            });

            input.dataset.clearEnabled = 'true';
        }

        function confirmToggle(type, code, name, delist) {
            pendingToggle = { type, code, delist };
            document.getElementById('toggleConfirmTitle').textContent = delist ? 'Delist item' : 'Relist item';
            document.getElementById('toggleConfirmText').innerHTML = delist
                ? `Delist <strong>${name}</strong>? It will disappear from the public Shop tab, but stays owned by anyone who already has it.`
                : `Relist <strong>${name}</strong>? It will reappear in the public Shop tab.`;
            document.getElementById('toggleConfirmBtn').className = delist ? 'btn btn-danger' : 'btn btn-success';
            new bootstrap.Modal(document.getElementById('toggleConfirmModal')).show();
        }

        async function doToggle() {
            if (!pendingToggle) return;
            const { type, code, delist } = pendingToggle;
            const controller = type === 'frame' ? 'Frame' : 'Sticker';
            const action = delist ? 'delist' : 'relist';

            const jwtToken = document.getElementById('jwtTokenInput')?.value;
            const res = await fetch(`${apiBase}/${controller}/${encodeURIComponent(code)}/${action}`, {
                method: 'PUT',
                headers: { 'Authorization': `Bearer ${jwtToken}` }
            });

            bootstrap.Modal.getInstance(document.getElementById('toggleConfirmModal'))?.hide();

            if (res.ok) {
                window.location.reload();
            } else {
                alert('Failed to update item. Please try again.');
            }
        }

        enableSearchClear('cosmeticNameSearch');
    </script>
}
