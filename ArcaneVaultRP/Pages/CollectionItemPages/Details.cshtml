@page
@model ArcaneVaultRP.Pages.CollectionItemPages.DetailsModel
@{
    ViewData["Title"] = "Item Details";
}

<div class="container mt-4" style="max-width:580px;">

    <div class="mb-1">
        <a asp-page="./Index"
           class="text-decoration-none d-inline-flex align-items-center gap-1"
           style="font-size:13px;">
            <i class="bi bi-arrow-left" style="font-size:13px;"></i> My Collection
        </a>
    </div>

    <!-- Item image -->
    @if (!string.IsNullOrEmpty(Model.CollectionItem.ImageUrl))
    {
        <div class="mb-4 rounded-3 overflow-hidden d-flex justify-content-center align-items-center"
             style="width:100%;background:rgba(166, 177, 225, 0.02);border:1px solid var(--border-color);">
            <img src="@Model.CollectionItem.ImageUrl"
                 alt="@Model.CollectionItem.ItemName"
                 style="max-width:100%;max-height:450px;object-fit:contain;" />
        </div>
    }
    else
    {
        <div class="mb-4 rounded-3 d-flex align-items-center justify-content-center"
             style="width:100%;aspect-ratio:3/2;background:rgba(166,177,225,0.03);border:1px dashed var(--border-color);">
            <div class="text-center">
                <i class="bi bi-image" style="font-size:40px;color:var(--text-secondary);display:block;margin-bottom:6px;"></i>
                <span style="font-size:13px;color:var(--text-secondary);">No photo</span>
            </div>
        </div>
    }

    <h1 style="font-size:22px;font-weight:500;margin:0 0 4px;">
        @Model.CollectionItem.ItemName
    </h1>

    @if (Model.ItemCategory != null)
    {
        <p class="text-muted mb-4" style="font-size:13px;">
            @if (HttpContext.Session.GetString(SessionKeys.UserRole) == "1")
            {
                @($"{Model.ItemCategory.CategoryName} ({Model.ItemCategory.CategoryCode})")
            }
            else
            {
                @Model.ItemCategory.CategoryName
            }
        </p>
    }
    else
    {
        <p class="text-muted mb-4" style="font-size:13px;">No category</p>
    }

    <div class="row g-3 mb-4">
        <div class="col-6">
            <div class="rounded p-3" style="background:#f8f9fa;">
                <p class="text-muted mb-1" style="font-size:12px;">Starting quantity</p>
                <p class="fw-500 mb-0" style="font-size:20px;">
                    @Model.CollectionItem.StartingQuantity
                </p>
            </div>
        </div>
        <div class="col-6">
            <div class="rounded p-3" style="background:#f8f9fa;">
                <p class="text-muted mb-1" style="font-size:12px;">Current quantity</p>
                <p class="fw-500 mb-0" style="font-size:20px;">
                    @Model.CollectionItem.CurrentQuantity
                </p>
            </div>
        </div>
    </div>

    <div class="d-flex gap-2">
        <a asp-page="./Edit"
           asp-route-itemid="@Model.CollectionItem.ItemId"
           class="btn btn-primary">Edit</a>
        <a asp-page="./Index" class="btn btn-outline-secondary">Back</a>
    </div>
</div>