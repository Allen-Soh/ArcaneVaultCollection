@page
@model ArcaneVaultRP.Pages.CollectionItemPages.IndexModel
@{
    ViewData["Title"] = "Collection Items";
}

<h1>Collection Items</h1>

<form method="get">
    <div class="row g-2 mb-3">
        <div class="col-md-4">
            <label class="form-label fw-semibold">Item Name</label>
            <input type="text"
                   name="SearchIN"
                   class="form-control"
                   placeholder="Search by item name..." />
        </div>

        <div class="col-md-3">
            <label class="form-label fw-semibold">Starting Quantity</label>
            <input type="number"
                   name="SearchSQ"
                   class="form-control"
                   min="0"
                   placeholder="e.g. 5" />
        </div>

        <div class="col-md-3">
            <label class="form-label fw-semibold">Current Quantity</label>
            <input type="number"
                   name="SearchCQ"
                   class="form-control"
                   min="0"
                   placeholder="e.g. 3" />
        </div>

        <div class="col-md-2 d-flex align-items-end gap-2">
            <button type="submit" class="btn btn-primary">Search</button>
            <a asp-page="./Index" class="btn btn-secondary">Clear</a>
        </div>

    </div>
</form>

<p>
    <a asp-page="Create" class="btn btn-success">Create New</a>
</p>

<table class="table">
    <thead>
        <tr>
            <th>Item ID</th>
            <th>Item Name</th>
            <th>Starting Quantity</th>
            <th>Current Quantity</th>
            <th>User Name</th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model.CollectionItem)
        {
            <tr>
                <td>@item.ItemId</td>
                <td>@item.ItemName</td>
                <td>@item.StartingQuantity</td>
                <td>@item.CurrentQuantity</td>
                <td>@item.UserName</td>
                <td>
                    <a asp-page="./Edit"
                       asp-route-itemid="@item.ItemId"
                       class="btn btn-warning btn-sm">Edit</a>
                    <a asp-page="./Details"
                       asp-route-itemid="@item.ItemId"
                       class="btn btn-info btn-sm">Details</a>
                    <a asp-page="./Delete"
                       asp-route-itemid="@item.ItemId"
                       class="btn btn-danger btn-sm">Delete</a>
                </td>
            </tr>
        }
    </tbody>
</table>