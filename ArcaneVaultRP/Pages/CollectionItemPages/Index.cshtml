@page
@model ArcaneVaultRP.Pages.CollectionItemPages.IndexModel
@{
    ViewData["Title"] = "Collection Items";
    var isStaff = HttpContext.Session.GetString(SessionKeys.UserRole) == "1";
}

<h1>Collection Items</h1>

<form method="get" id="searchForm">
    <div class="row g-2 mb-3">

        <!-- Item Name smart search -->
        <div class="col-md-4 position-relative">
            <label class="form-label fw-semibold">Item Name</label>
            <input type="text"
                   name="SearchItemName"
                   id="searchItemName"
                   value="@Model.SearchItemName"
                   class="form-control"
                   placeholder="Search by item name..."
                   autocomplete="off" />
            <div id="itemNameSuggestions"
                 class="list-group position-absolute z-3"
                 style="width:100%;height:200px;overflow-y:auto;display:none;"></div>
        </div>

        <!-- Category smart search dropdown -->
        <div class="col-md-4 position-relative">
            <label class="form-label fw-semibold">Category</label>
            <input type="text"
                   name="SearchCategory"
                   id="searchCategory"
                   value="@Model.SearchCategory"
                   class="form-control"
                   placeholder="Click to browse or type to search..."
                   autocomplete="off" />
            <div id="categorySuggestions"
                 class="list-group position-absolute z-3"
                 style="width:100%;height:200px;overflow-y:auto;display:none;"></div>
        </div>

        <!-- Current Quantity -->
        <div class="col-md-2">
            <label class="form-label fw-semibold">Current Quantity</label>
            <input type="number"
                   name="SearchCurrentQuantity"
                   value="@Model.SearchCurrentQuantity"
                   class="form-control"
                   min="0"
                   placeholder="e.g. 3" />
        </div>

        <!-- Buttons -->
        <div class="col-md-2 d-flex align-items-end gap-2">
            <button type="submit" class="btn btn-primary">Search</button>
            <a asp-page="./Index" class="btn btn-secondary">Clear</a>
        </div>

    </div>
</form>

<p>
    <a asp-page="Create" class="btn btn-success">Create New</a>
</p>

<div class="border rounded overflow-hidden" style="position:relative;">
    <div id="itemTableWrapper" style="overflow-y:auto;">
        <table class="table mb-0" style="width:100%;">
            <thead class="table-light" style="position:sticky; top:0; z-index:2;">
                <tr>
                    <th style="padding:12px;">Item Name</th>
                    <th style="padding:12px;">Category</th>
                    <th style="padding:12px;">Current Quantity</th>
                    <th style="padding:12px; width: 1%;">Actions</th>
                </tr>
            </thead>
            <tbody id="itemTableBody"></tbody>
        </table>
    </div>
    <div id="tableEmpty" style="display:none;" class="text-center text-muted py-4">
        No items match your search.
    </div>
</div>
<div class="d-flex justify-content-between mt-2 mb-4" id="itemTableIndicatorRow">
    <p class="text-muted mb-0" id="itemScrollIndicator" style="font-size:12px;"></p>
    <p class="text-muted mb-0" id="itemScrollMoreText" style="font-size:12px;">Scroll to load more</p>
</div>

@section Scripts {
    <script>
        const allItems = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.AllItems));
        const displayItems = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.CollectionItem));
        const categories = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.Categories));
        const isStaff = @isStaff.ToString().ToLower();

        function truncate(text) {
            if (!text) return '';
            return text.length <= 40 ? text : text.substring(0, 40) + '...';
        }

        function buildCategoryText(cat) {
            return isStaff
                ? truncate(cat.CategoryName) + ' (' + cat.CategoryCode + ')'
                : truncate(cat.CategoryName);
        }

        // ── Item Name smart search ──
        const searchItemName = document.getElementById('searchItemName');
        const itemNameSuggestions = document.getElementById('itemNameSuggestions');

        function renderItemNames(matches) {
            itemNameSuggestions.innerHTML = '';
            if (matches.length === 0) {
                const noResult = document.createElement('div');
                noResult.className = 'list-group-item text-muted';
                noResult.textContent = 'No items found';
                itemNameSuggestions.appendChild(noResult);
                return;
            }
            matches.forEach(name => {
                const item = document.createElement('a');
                item.href = '#';
                item.className = 'list-group-item list-group-item-action';
                item.textContent = truncate(name);
                item.addEventListener('click', function (e) {
                    e.preventDefault();
                    searchItemName.value = name;
                    itemNameSuggestions.style.display = 'none';
                    document.getElementById('searchForm').submit();
                });
                itemNameSuggestions.appendChild(item);
            });
        }

        searchItemName.addEventListener('focus', function () {
            const allNames = allItems
                .map(item => item.ItemName)
                .filter((name, index, self) => self.indexOf(name) === index);
            renderItemNames(allNames);
            itemNameSuggestions.style.display = 'block';
        });

        searchItemName.addEventListener('input', function () {
            const query = this.value.trim().toLowerCase();
            if (query.length === 0) {
                const allNames = allItems
                    .map(item => item.ItemName)
                    .filter((name, index, self) => self.indexOf(name) === index);
                renderItemNames(allNames);
                return;
            }
            const matches = allItems
                .filter(item => item.ItemName && item.ItemName.toLowerCase().includes(query))
                .map(item => item.ItemName)
                .filter((name, index, self) => self.indexOf(name) === index)
                .slice(0, 5);
            renderItemNames(matches);
        });

        // ── Category smart search ──
        const searchCategory = document.getElementById('searchCategory');
        const categorySuggestions = document.getElementById('categorySuggestions');

        function renderCategories(filtered) {
            categorySuggestions.innerHTML = '';
            if (filtered.length === 0) {
                const noResult = document.createElement('div');
                noResult.className = 'list-group-item text-muted';
                noResult.textContent = 'No categories found';
                categorySuggestions.appendChild(noResult);
                return;
            }
            filtered.forEach(cat => {
                const item = document.createElement('a');
                item.href = '#';
                item.className = 'list-group-item list-group-item-action';
                item.textContent = buildCategoryText(cat);
                item.addEventListener('click', function (e) {
                    e.preventDefault();
                    searchCategory.value = cat.CategoryName;
                    categorySuggestions.style.display = 'none';
                    document.getElementById('searchForm').submit();
                });
                categorySuggestions.appendChild(item);
            });
        }

        // Show all on focus
        searchCategory.addEventListener('focus', function () {
            renderCategories(categories);
            categorySuggestions.style.display = 'block';
        });

        // Filter on input
        searchCategory.addEventListener('input', function () {
            const query = this.value.trim().toLowerCase();
            if (query.length === 0) {
                renderCategories(categories);
                return;
            }
            const filtered = categories.filter(c => {
                const nameMatch = c.CategoryName && c.CategoryName.toLowerCase().includes(query);
                const codeMatch = isStaff && c.CategoryCode && c.CategoryCode.toLowerCase().includes(query);
                return nameMatch || codeMatch;
            });
            renderCategories(filtered);
        });

        // Close on outside click
        document.addEventListener('click', function (e) {
            if (!searchCategory.contains(e.target) && !categorySuggestions.contains(e.target)) {
                categorySuggestions.style.display = 'none';
            }
            if (!searchItemName.contains(e.target) && !itemNameSuggestions.contains(e.target)) {
                itemNameSuggestions.style.display = 'none';
            }
        });

        // ── Virtual Scroll Table Implementation (Copied from Insights) ──
        const ROW_HEIGHT = 53;
        const BUFFER = 5;
        const THRESHOLD = 10;

        function createVirtualTable(wrapperId, tbodyId, data, renderRowFn) {
            const wrapper = document.getElementById(wrapperId);
            const tbody = document.getElementById(tbodyId);
            if (!wrapper || !tbody) return;

            if (data.length <= THRESHOLD) {
                wrapper.style.height = '';
                wrapper.style.maxHeight = '';
                wrapper.onscroll = null;
                tbody.innerHTML = data.map((row, i) => renderRowFn(row, i)).join('');
                return;
            }

            const visibleHeight = ROW_HEIGHT * THRESHOLD + 18;
            wrapper.style.height = `${visibleHeight}px`;
            wrapper.style.maxHeight = `${visibleHeight}px`;
            wrapper.style.overflowY = 'auto';

            function render() {
                const scrollTop = wrapper.scrollTop;
                const startIdx = Math.max(0, Math.floor(scrollTop / ROW_HEIGHT) - BUFFER);
                const endIdx = Math.min(
                    data.length,
                    Math.ceil((scrollTop + visibleHeight) / ROW_HEIGHT) + BUFFER
                );

                const topPad = startIdx * ROW_HEIGHT;
                const bottomPad = (data.length - endIdx) * ROW_HEIGHT;

                const topSpacer = topPad > 0
                    ? `<tr style="height:${topPad}px;"><td colspan="10"></td></tr>`
                    : '';
                const bottomSpacer = bottomPad > 0
                    ? `<tr style="height:${bottomPad}px;"><td colspan="10"></td></tr>`
                    : '';

                tbody.innerHTML =
                    topSpacer +
                    data.slice(startIdx, endIdx).map((row, i) => renderRowFn(row, startIdx + i)).join('') +
                    bottomSpacer;
            }

            let ticking = false;
            wrapper.onscroll = () => {
                if (!ticking) {
                    requestAnimationFrame(() => { render(); ticking = false; });
                    ticking = true;
                }
            };

            wrapper.scrollTop = 0;
            render();
        }

        function renderTable(data) {
            const empty = document.getElementById('tableEmpty');
            const wrapper = document.getElementById('itemTableWrapper');
            const indicatorRow = document.getElementById('itemTableIndicatorRow');
            const moreText = document.getElementById('itemScrollMoreText');

            if (data.length === 0) {
                empty.style.display = 'block';
                document.getElementById('itemTableBody').innerHTML = '';
                wrapper.style.height = '';
                wrapper.style.maxHeight = '';
                wrapper.onscroll = null;
                indicatorRow.style.display = 'none';
                return;
            }

            empty.style.display = 'none';
            indicatorRow.style.removeProperty('display');
            moreText.style.display = data.length > THRESHOLD ? 'block' : 'none';

            function updateIndicator() {
                const scrollTop = wrapper.scrollTop;
                const visStart = Math.max(1, Math.floor(scrollTop / ROW_HEIGHT) + 1);
                const visEnd = Math.min(data.length, visStart + THRESHOLD - 1);
                document.getElementById('itemScrollIndicator').textContent =
                    data.length > THRESHOLD
                        ? `Showing ${visStart}–${visEnd} of ${data.length}`
                        : `${data.length} item${data.length === 1 ? '' : 's'}`;
            }

            wrapper.removeEventListener('scroll', updateIndicator);
            wrapper.addEventListener('scroll', updateIndicator);

            createVirtualTable('itemTableWrapper', 'itemTableBody', data, (item, idx) => {
                const border = idx > 0 ? 'border-top:1px solid var(--border-color);' : '';
                const categoryDisplay = item.CategoryName != null
                    ? (isStaff
                        ? truncate(item.CategoryName) + " (" + item.CategoryCode + ")"
                        : truncate(item.CategoryName))
                    : "No Category";

                return `
                    <tr style="${border}height:${ROW_HEIGHT}px;">
                        <td style="padding:12px;">${truncate(item.ItemName)}</td>
                        <td style="padding:12px;">${categoryDisplay}</td>
                        <td style="padding:12px;">${item.CurrentQuantity}</td>
                        <td style="padding:12px; white-space:nowrap;">
                            <div class="d-inline-flex gap-1">
                                <a href="/CollectionItemPages/Edit?itemid=${item.ItemId}" class="btn btn-warning btn-sm">Edit</a>
                                <a href="/CollectionItemPages/Details?itemid=${item.ItemId}" class="btn btn-info btn-sm">Details</a>
                                <a href="/CollectionItemPages/Delete?itemid=${item.ItemId}" class="btn btn-danger btn-sm">Delete</a>
                            </div>
                        </td>
                    </tr>`;
            });
            updateIndicator();
        }

        renderTable(displayItems);
    </script>
}