@page
@model ArcaneVaultRP.Pages.CollectionItemPages.IndexModel
@{
    ViewData["Title"] = "Collection Items";
    var isStaff = HttpContext.Session.GetString(SessionKeys.UserRole) == "1";
}

<h1>Collection Items</h1>

<form method="get" id="searchForm">
    <div class="row g-2 mb-3">

        <!-- Item Name smart search -->
        <div class="col-md-4 position-relative">
            <label class="form-label fw-semibold">Item Name</label>
            <input type="text"
                   name="SearchItemName"
                   id="searchItemName"
                   value="@Model.SearchItemName"
                   class="form-control"
                   placeholder="Search by item name..."
                   autocomplete="off" />
            <div id="itemNameSuggestions"
                 class="list-group position-absolute z-3"
                 style="width:100%;height:200px;overflow-y:auto;display:none;"></div>
        </div>

        <!-- Category smart search dropdown -->
        <div class="col-md-4 position-relative">
            <label class="form-label fw-semibold">Category</label>
            <input type="text"
                   name="SearchCategory"
                   id="searchCategory"
                   value="@Model.SearchCategory"
                   class="form-control"
                   placeholder="Click to browse or type to search..."
                   autocomplete="off" />
            <div id="categorySuggestions"
                 class="list-group position-absolute z-3"
                 style="width:100%;height:200px;overflow-y:auto;display:none;"></div>
        </div>

        <!-- Current Quantity -->
        <div class="col-md-2">
            <label class="form-label fw-semibold">Current Quantity</label>
            <input type="number"
                   name="SearchCurrentQuantity"
                   value="@Model.SearchCurrentQuantity"
                   class="form-control"
                   min="0"
                   placeholder="e.g. 3" />
        </div>

        <!-- Buttons -->
        <div class="col-md-2 d-flex align-items-end gap-2">
            <button type="submit" class="btn btn-primary">Search</button>
            <a asp-page="./Index" class="btn btn-secondary">Clear</a>
        </div>

    </div>
</form>

<p>
    <a asp-page="Create" class="btn btn-success">Create New</a>
</p>

<table class="table">
    <thead>
        <tr>
            <th>Item Name</th>
            <th>Category</th>
            <th>Current Quantity</th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model.CollectionItem)
        {
            var categoryDisplay = item.CategoryName != null
                ? (isStaff
                    ? Model.Truncate(item.CategoryName) + " (" + item.CategoryCode + ")"
                    : Model.Truncate(item.CategoryName))
                : "No Category";

            <tr>
                <td>@Model.Truncate(item.ItemName)</td>
                <td>@categoryDisplay</td>
                <td>@item.CurrentQuantity</td>
                <td>
                    <a asp-page="./Edit" asp-route-itemid="@item.ItemId" class="btn btn-warning btn-sm">Edit</a>
                    <a asp-page="./Details" asp-route-itemid="@item.ItemId" class="btn btn-info btn-sm">Details</a>
                    <a asp-page="./Delete" asp-route-itemid="@item.ItemId" class="btn btn-danger btn-sm">Delete</a>
                </td>
            </tr>
        }
    </tbody>
</table>

@section Scripts {
    <script>
        const allItems = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.AllItems));
        const categories = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.Categories));
        const isStaff = @isStaff.ToString().ToLower();

        function truncate(text) {
            if (!text) return '';
            return text.length <= 40 ? text : text.substring(0, 40) + '...';
        }

        function buildCategoryText(cat) {
            return isStaff
                ? truncate(cat.CategoryName) + ' (' + cat.CategoryCode + ')'
                : truncate(cat.CategoryName);
        }

        // ── Item Name smart search ──
        const searchItemName = document.getElementById('searchItemName');
        const itemNameSuggestions = document.getElementById('itemNameSuggestions');

        function renderItemNames(matches) {
            itemNameSuggestions.innerHTML = '';
            if (matches.length === 0) {
                const noResult = document.createElement('div');
                noResult.className = 'list-group-item text-muted';
                noResult.textContent = 'No items found';
                itemNameSuggestions.appendChild(noResult);
                return;
            }
            matches.forEach(name => {
                const item = document.createElement('a');
                item.href = '#';
                item.className = 'list-group-item list-group-item-action';
                item.textContent = truncate(name);
                item.addEventListener('click', function (e) {
                    e.preventDefault();
                    searchItemName.value = name;
                    itemNameSuggestions.style.display = 'none';
                    document.getElementById('searchForm').submit();
                });
                itemNameSuggestions.appendChild(item);
            });
        }

        searchItemName.addEventListener('focus', function () {
            const allNames = allItems
                .map(item => item.ItemName)
                .filter((name, index, self) => self.indexOf(name) === index);
            renderItemNames(allNames);
            itemNameSuggestions.style.display = 'block';
        });

        searchItemName.addEventListener('input', function () {
            const query = this.value.trim().toLowerCase();
            if (query.length === 0) {
                const allNames = allItems
                    .map(item => item.ItemName)
                    .filter((name, index, self) => self.indexOf(name) === index);
                renderItemNames(allNames);
                return;
            }
            const matches = allItems
                .filter(item => item.ItemName && item.ItemName.toLowerCase().includes(query))
                .map(item => item.ItemName)
                .filter((name, index, self) => self.indexOf(name) === index)
                .slice(0, 5);
            renderItemNames(matches);
        });

        // ── Category smart search ──
        const searchCategory = document.getElementById('searchCategory');
        const categorySuggestions = document.getElementById('categorySuggestions');

        function renderCategories(filtered) {
            categorySuggestions.innerHTML = '';
            if (filtered.length === 0) {
                const noResult = document.createElement('div');
                noResult.className = 'list-group-item text-muted';
                noResult.textContent = 'No categories found';
                categorySuggestions.appendChild(noResult);
                return;
            }
            filtered.forEach(cat => {
                const item = document.createElement('a');
                item.href = '#';
                item.className = 'list-group-item list-group-item-action';
                item.textContent = buildCategoryText(cat);
                item.addEventListener('click', function (e) {
                    e.preventDefault();
                    searchCategory.value = cat.CategoryName;
                    categorySuggestions.style.display = 'none';
                    document.getElementById('searchForm').submit();
                });
                categorySuggestions.appendChild(item);
            });
        }

        // Show all on focus
        searchCategory.addEventListener('focus', function () {
            renderCategories(categories);
            categorySuggestions.style.display = 'block';
        });

        // Filter on input
        searchCategory.addEventListener('input', function () {
            const query = this.value.trim().toLowerCase();
            if (query.length === 0) {
                renderCategories(categories);
                return;
            }
            const filtered = categories.filter(c => {
                const nameMatch = c.CategoryName && c.CategoryName.toLowerCase().includes(query);
                const codeMatch = isStaff && c.CategoryCode && c.CategoryCode.toLowerCase().includes(query);
                return nameMatch || codeMatch;
            });
            renderCategories(filtered);
        });

        // Close on outside click
        document.addEventListener('click', function (e) {
            if (!searchCategory.contains(e.target) && !categorySuggestions.contains(e.target)) {
                categorySuggestions.style.display = 'none';
            }
            if (!searchItemName.contains(e.target) && !itemNameSuggestions.contains(e.target)) {
                itemNameSuggestions.style.display = 'none';
            }
        });
    </script>
}