@page
@model ArcaneVaultRP.Pages.CollectionItemPages.IndexModel
@{
    ViewData["Title"] = "Collection Items";
}

<div class="d-flex align-items-start justify-content-between mb-3 flex-wrap gap-2">
    <h1>Collection Items</h1>
    <button class="btn btn-outline-secondary btn-sm filters-toggle-btn" type="button"
            data-bs-toggle="collapse" data-bs-target="#itemFiltersPanel"
            aria-expanded="false" aria-controls="itemFiltersPanel">
        <i class="bi bi-funnel"></i> Filters
        <span class="filters-badge" id="itemFiltersBadge" style="display:none;"></span>
        <i class="bi bi-chevron-down"></i>
    </button>
</div>

<div id="actionMessage" class="alert alert-success" style="display:none;"></div>

<div class="collapse filters-panel" id="itemFiltersPanel">
    <div class="row g-2 mb-3">

        <!-- Item Name smart search -->
        <div class="col-md-4 position-relative">
            <label class="form-label fw-semibold">Item Name</label>
            <input type="text"
                   id="searchItemName"
                   class="form-control"
                   placeholder="Search by item name..."
                   autocomplete="off"
                   value="@Model.SearchItemName" />
            <div id="itemNameSuggestions"
                 class="list-group position-absolute z-3"
                 style="width:100%;height:200px;overflow-y:auto;display:none;"></div>
        </div>

        <!-- Category smart search dropdown -->
        <div class="col-md-4 position-relative">
            <label class="form-label fw-semibold">Category</label>
            <input type="text"
                   id="searchCategory"
                   class="form-control"
                   placeholder="Click to browse or type to search..."
                   autocomplete="off"
                   value="@Model.SearchCategory" />
            <div id="categorySuggestions"
                 class="list-group position-absolute z-3"
                 style="width:100%;height:200px;overflow-y:auto;display:none;"></div>
        </div>

        <!-- Current Quantity -->
        <div class="col-md-2">
            <label class="form-label fw-semibold">Current Quantity</label>
            <input type="number"
                   id="searchCurrentQuantity"
                   class="form-control"
                   min="0"
                   placeholder="e.g. 3"
                   value="@Model.SearchCurrentQuantity" />
        </div>
    </div>
</div>

<p>
    <a asp-page="Create" class="btn btn-success">Create New</a>
</p>

<div id="itemTableContainer">
    @await Html.PartialAsync("_CollectionItemTable", Model)
</div>

@section Scripts {
    <script>
        // Full item/category lists — power the name/category suggestion dropdowns only (actual
        // filtering/paging happens server-side via the Filter handler, same pattern as the Showoff feed).
        const allItems = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.AllItems));
        const categories = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.Categories));
        const isStaff = @Model.IsStaff.ToString().ToLower();

        // ── Success confirmation after Create/Edit ──
        (function () {
            const params = new URLSearchParams(window.location.search);
            let text = null;
            if ((params.get('created') || '').toLowerCase() === 'true') text = 'Item created.';
            else if ((params.get('updated') || '').toLowerCase() === 'true') text = 'Item updated.';
            if (text) {
                const msg = document.getElementById('actionMessage');
                msg.textContent = text;
                msg.style.display = 'block';
                setTimeout(() => msg.style.display = 'none', 4000);
                params.delete('created');
                params.delete('updated');
                const remaining = params.toString();
                history.replaceState(null, '', window.location.pathname + (remaining ? `?${remaining}` : ''));
            }
        })();

        function truncate(text) {
            if (!text) return '';
            return text.length <= 40 ? text : text.substring(0, 40) + '...';
        }

        function buildCategoryText(cat) {
            return isStaff
                ? truncate(cat.CategoryName) + ' (' + cat.CategoryCode + ')'
                : truncate(cat.CategoryName);
        }

        // ── AJAX Filtering (no page reload) — mirrors the Showoff feed's refreshGrid() pattern ──
        let currentFilters = {
            searchItemName: '@Model.SearchItemName' || '',
            searchCategory: '@Model.SearchCategory' || '',
            searchCurrentQuantity: '@Model.SearchCurrentQuantity' || '',
            page: 1
        };

        function updateFiltersBadge(badgeId, activeCount) {
            const badge = document.getElementById(badgeId);
            if (!badge) return;
            badge.textContent = activeCount;
            badge.style.display = activeCount > 0 ? 'inline-block' : 'none';
        }

        async function refreshTable(newFilters = {}) {
            Object.assign(currentFilters, newFilters);

            updateFiltersBadge('itemFiltersBadge',
                (currentFilters.searchItemName ? 1 : 0) +
                (currentFilters.searchCategory ? 1 : 0) +
                (currentFilters.searchCurrentQuantity !== '' ? 1 : 0));

            const params = new URLSearchParams({
                page: currentFilters.page,
                searchItemName: currentFilters.searchItemName,
                searchCategory: currentFilters.searchCategory,
                searchCurrentQuantity: currentFilters.searchCurrentQuantity
            });

            const res = await fetch(`?handler=Filter&${params.toString()}`, {
                headers: { 'X-Requested-With': 'XMLHttpRequest' }
            });

            if (!res.ok) {
                console.error('Failed to refresh item table');
                return;
            }

            const html = await res.text();
            document.getElementById('itemTableContainer').innerHTML = html;

            const urlParams = new URLSearchParams(window.location.search);
            urlParams.set('page', currentFilters.page);
            currentFilters.searchItemName ? urlParams.set('searchItemName', currentFilters.searchItemName) : urlParams.delete('searchItemName');
            currentFilters.searchCategory ? urlParams.set('searchCategory', currentFilters.searchCategory) : urlParams.delete('searchCategory');
            currentFilters.searchCurrentQuantity !== '' ? urlParams.set('searchCurrentQuantity', currentFilters.searchCurrentQuantity) : urlParams.delete('searchCurrentQuantity');
            history.replaceState(null, '', `${window.location.pathname}?${urlParams.toString()}`);
        }

        // Pagination — delegated on `document`, scoped to #itemTableContainer.
        document.addEventListener('click', (e) => {
            const link = e.target.closest('.ajax-page-link');
            if (!link) return;
            if (!link.closest('#itemTableContainer')) return;
            e.preventDefault();
            refreshTable({ page: parseInt(link.dataset.page) });
        });

        // ── Item Name smart search ──
        const searchItemName = document.getElementById('searchItemName');
        const itemNameSuggestions = document.getElementById('itemNameSuggestions');

        function renderItemNames(matches) {
            itemNameSuggestions.innerHTML = '';
            if (matches.length === 0) {
                const noResult = document.createElement('div');
                noResult.className = 'list-group-item text-muted';
                noResult.textContent = 'No items found';
                itemNameSuggestions.appendChild(noResult);
                return;
            }
            matches.forEach(name => {
                const item = document.createElement('a');
                item.href = '#';
                item.className = 'list-group-item list-group-item-action';
                item.textContent = truncate(name);
                item.addEventListener('click', function (e) {
                    e.preventDefault();
                    searchItemName.value = name;
                    itemNameSuggestions.style.display = 'none';
                    refreshTable({ searchItemName: name, page: 1 });
                });
                itemNameSuggestions.appendChild(item);
            });
        }

        searchItemName.addEventListener('focus', function () {
            const allNames = allItems
                .map(item => item.ItemName)
                .filter((name, index, self) => self.indexOf(name) === index);
            renderItemNames(allNames);
            itemNameSuggestions.style.display = 'block';
        });

        searchItemName.addEventListener('input', function () {
            const query = this.value.trim().toLowerCase();
            if (query.length === 0) {
                const allNames = allItems
                    .map(item => item.ItemName)
                    .filter((name, index, self) => self.indexOf(name) === index);
                renderItemNames(allNames);
            } else {
                const matches = allItems
                    .filter(item => item.ItemName && item.ItemName.toLowerCase().includes(query))
                    .map(item => item.ItemName)
                    .filter((name, index, self) => self.indexOf(name) === index)
                    .slice(0, 5);
                renderItemNames(matches);
            }

            clearTimeout(this._searchTimer);
            this._searchTimer = setTimeout(() => {
                refreshTable({ searchItemName: this.value.trim(), page: 1 });
            }, 500);
        });

        searchItemName.addEventListener('keydown', function (e) {
            if (e.key === 'Enter') {
                e.preventDefault();
                clearTimeout(this._searchTimer);
                itemNameSuggestions.style.display = 'none';
                refreshTable({ searchItemName: this.value.trim(), page: 1 });
            }
        });

        // ── Category smart search ──
        const searchCategory = document.getElementById('searchCategory');
        const categorySuggestions = document.getElementById('categorySuggestions');

        function renderCategories(filtered) {
            categorySuggestions.innerHTML = '';
            if (filtered.length === 0) {
                const noResult = document.createElement('div');
                noResult.className = 'list-group-item text-muted';
                noResult.textContent = 'No categories found';
                categorySuggestions.appendChild(noResult);
                return;
            }
            filtered.forEach(cat => {
                const item = document.createElement('a');
                item.href = '#';
                item.className = 'list-group-item list-group-item-action';
                item.textContent = buildCategoryText(cat);
                item.addEventListener('click', function (e) {
                    e.preventDefault();
                    searchCategory.value = cat.CategoryName;
                    categorySuggestions.style.display = 'none';
                    refreshTable({ searchCategory: cat.CategoryName, page: 1 });
                });
                categorySuggestions.appendChild(item);
            });
        }

        searchCategory.addEventListener('focus', function () {
            renderCategories(categories);
            categorySuggestions.style.display = 'block';
        });

        searchCategory.addEventListener('input', function () {
            const query = this.value.trim().toLowerCase();
            if (query.length === 0) {
                renderCategories(categories);
            } else {
                const filtered = categories.filter(c => {
                    const nameMatch = c.CategoryName && c.CategoryName.toLowerCase().includes(query);
                    const codeMatch = isStaff && c.CategoryCode && c.CategoryCode.toLowerCase().includes(query);
                    return nameMatch || codeMatch;
                });
                renderCategories(filtered);
            }

            clearTimeout(this._searchTimer);
            this._searchTimer = setTimeout(() => {
                refreshTable({ searchCategory: this.value.trim(), page: 1 });
            }, 500);
        });

        searchCategory.addEventListener('keydown', function (e) {
            if (e.key === 'Enter') {
                e.preventDefault();
                clearTimeout(this._searchTimer);
                categorySuggestions.style.display = 'none';
                refreshTable({ searchCategory: this.value.trim(), page: 1 });
            }
        });

        // Close on outside click
        document.addEventListener('click', function (e) {
            if (!searchCategory.contains(e.target) && !categorySuggestions.contains(e.target)) {
                categorySuggestions.style.display = 'none';
            }
            if (!searchItemName.contains(e.target) && !itemNameSuggestions.contains(e.target)) {
                itemNameSuggestions.style.display = 'none';
            }
        });

        // ── Current Quantity — live, debounced ──
        const searchCurrentQuantity = document.getElementById('searchCurrentQuantity');
        searchCurrentQuantity.addEventListener('input', function () {
            clearTimeout(this._searchTimer);
            this._searchTimer = setTimeout(() => {
                refreshTable({ searchCurrentQuantity: this.value, page: 1 });
            }, 500);
        });

        // Adds a clear ("×") button to a search input; shows only when it has text.
        // Wraps the input in its own dedicated box (rather than reusing input.parentElement,
        // which on this page is the whole label+input+suggestions column) so the × is
        // always centered against the input itself, matching the Insights pages behavior.
        function enableSearchClear(inputId) {
            const input = document.getElementById(inputId);
            if (!input || input.dataset.clearEnabled) return;

            const wrapper = document.createElement('div');
            wrapper.className = 'search-clear-wrapper';
            wrapper.style.width = '100%';
            input.style.width = '100%';

            input.parentElement.insertBefore(wrapper, input);
            wrapper.appendChild(input);

            const btn = document.createElement('button');
            btn.type = 'button';
            btn.className = 'search-clear-btn';
            btn.innerHTML = '&times;';
            btn.setAttribute('aria-label', 'Clear search');
            wrapper.appendChild(btn);

            function toggleBtn() {
                btn.style.display = input.value.length > 0 ? 'block' : 'none';
            }

            input.addEventListener('input', toggleBtn);
            toggleBtn();

            btn.addEventListener('click', () => {
                input.value = '';
                input.dispatchEvent(new Event('input', { bubbles: true }));
                toggleBtn();
                input.focus();
            });

            input.dataset.clearEnabled = 'true';
        }

        enableSearchClear('searchItemName');
        enableSearchClear('searchCategory');
    </script>
}
