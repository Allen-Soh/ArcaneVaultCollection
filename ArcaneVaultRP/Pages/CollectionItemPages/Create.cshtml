@page
@model ArcaneVaultRP.Pages.CollectionItemPages.CreateModel
@{
    ViewData["Title"] = "Create Collection Item";
    var isStaff = HttpContext.Session.GetString(SessionKeys.UserRole) == "1";
}

<h1>Add Collection Item</h1>
<hr />

<div class="row">
    <div class="col-md-5">
        <form method="post">
            <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

            <!-- Item Name -->
            <div class="mb-3">
                <label asp-for="CollectionItem.ItemName" class="form-label fw-semibold">Item Name</label>
                <input asp-for="CollectionItem.ItemName" class="form-control" placeholder="Enter item name" />
                <span asp-validation-for="CollectionItem.ItemName" class="text-danger small"></span>
            </div>

            <!-- Category smart dropdown -->
            <div class="mb-3 position-relative">
                <label class="form-label fw-semibold">Category</label>
                <input type="text"
                       id="categorySearch"
                       class="form-control"
                       placeholder="Click to browse or type to search..."
                       autocomplete="off" />
                <input type="hidden"
                       id="selectedCategoryCode"
                       name="SelectedCategoryCode" />
                <div id="categorySuggestions"
                     class="list-group position-absolute z-3"
                     style="width:100%;height:200px;overflow-y:auto;display:none;"></div>
                <small class="text-muted">Select a category for your item</small>
            </div>

            <!-- Item Quantity -->
            <div class="mb-3">
                <label class="form-label fw-semibold" for="CollectionItem_StartingQuantity">Item Quantity</label>
                <div class="input-group">
                    <button type="button" class="btn btn-outline-secondary" id="decreaseBtn">-</button>
                    <input asp-for="CollectionItem.StartingQuantity"
                           class="form-control text-center"
                           id="CollectionItem_StartingQuantity"
                           min="0"
                           placeholder="0" />
                    <button type="button" class="btn btn-outline-secondary" id="increaseBtn">+</button>
                </div>
                <span asp-validation-for="CollectionItem.StartingQuantity" class="text-danger small"></span>
            </div>

            <div class="mt-4">
                <input type="submit" value="Create" class="btn btn-primary me-2" />
                <a asp-page="./Index" class="btn btn-secondary">Back to List</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
    <script>
        const categories = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.Categories));
        const isStaff = @isStaff.ToString().ToLower();

        function truncate(text) {
            if (!text) return '';
            return text.length <= 40 ? text : text.substring(0, 40) + '...';
        }

        function buildSuggestionText(cat) {
            if (isStaff) {
                return truncate(cat.CategoryName) + ' (' + cat.CategoryCode + ')';
            }
            return truncate(cat.CategoryName);
        }

        const categorySearch = document.getElementById('categorySearch');
        const categorySuggestions = document.getElementById('categorySuggestions');
        const selectedCategoryCode = document.getElementById('selectedCategoryCode');

        function renderSuggestions(filtered) {
            categorySuggestions.innerHTML = '';
            if (filtered.length === 0) {
                const noResult = document.createElement('div');
                noResult.className = 'list-group-item text-muted';
                noResult.textContent = 'No categories found';
                categorySuggestions.appendChild(noResult);
                return;
            }
            filtered.forEach(cat => {
                const item = document.createElement('a');
                item.href = '#';
                item.className = 'list-group-item list-group-item-action';
                item.textContent = buildSuggestionText(cat);
                item.addEventListener('click', function (e) {
                    e.preventDefault();
                    categorySearch.value = truncate(cat.CategoryName);
                    selectedCategoryCode.value = cat.CategoryCode;
                    categorySuggestions.style.display = 'none';
                });
                categorySuggestions.appendChild(item);
            });
        }

        // Show all on focus
        categorySearch.addEventListener('focus', function () {
            renderSuggestions(categories);
            categorySuggestions.style.display = 'block';
        });

        // Filter on input
        categorySearch.addEventListener('input', function () {
            const query = this.value.trim().toLowerCase();
            if (query.length === 0) {
                renderSuggestions(categories);
                return;
            }

            const filtered = categories.filter(c => {
                const nameMatch = c.CategoryName && c.CategoryName.toLowerCase().includes(query);
                // Staff can also search by code
                const codeMatch = isStaff && c.CategoryCode && c.CategoryCode.toLowerCase().includes(query);
                return nameMatch || codeMatch;
            });

            renderSuggestions(filtered);
        });

        // Close on outside click
        document.addEventListener('click', function (e) {
            if (!categorySearch.contains(e.target) && !categorySuggestions.contains(e.target)) {
                categorySuggestions.style.display = 'none';
            }
        });

        // Quantity buttons
        const quantityInput = document.getElementById("CollectionItem_StartingQuantity");
        const increaseBtn = document.getElementById("increaseBtn");
        const decreaseBtn = document.getElementById("decreaseBtn");

        if (quantityInput.value === "") quantityInput.value = 0;

        increaseBtn.addEventListener("click", function () {
            quantityInput.value = parseInt(quantityInput.value || 0) + 1;
        });

        decreaseBtn.addEventListener("click", function () {
            const current = parseInt(quantityInput.value || 0);
            if (current > 0) quantityInput.value = current - 1;
        });

        quantityInput.addEventListener("input", function () {
            this.value = this.value.replace(/[^0-9]/g, "");
            if (this.value === "") this.value = 0;
        });
    </script>
}