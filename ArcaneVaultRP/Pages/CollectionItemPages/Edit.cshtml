@page
@model ArcaneVaultRP.Pages.CollectionItemPages.EditModel

@{
    ViewData["Title"] = "Edit Collection Item";
}

<h1>Edit Collection Item</h1>
<hr />

<div class="row">
    <div class="col-md-5">
        <form method="post">
            <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

            <!-- Hidden ItemId -->
            <input type="hidden" asp-for="CollectionItem.ItemId" />
            <input type="hidden" asp-for="CollectionItem.IsDeleted" />
            <input type="hidden" asp-for="CollectionItem.StartingQuantity" />
            <input type="hidden" asp-for="CollectionItem.UserName" />

            <!-- Item Name -->
            <div class="mb-3">
                <label asp-for="CollectionItem.ItemName" class="form-label fw-semibold">Item Name</label>
                <input asp-for="CollectionItem.ItemName" class="form-control" placeholder="Enter item name" />
                <span asp-validation-for="CollectionItem.ItemName" class="text-danger small"></span>
            </div>

            <!-- Item Quantity with +/- buttons -->
            <div class="mb-3">
                <label class="form-label fw-semibold" for="CollectionItem_CurrentQuantity">Item Quantity</label>
                <div class="input-group">
                    <button type="button" class="btn btn-outline-secondary" id="decreaseBtn">-</button>
                    <input asp-for="CollectionItem.CurrentQuantity"
                           class="form-control text-center"
                           id="CollectionItem_CurrentQuantity"
                           min="0" />
                    <button type="button" class="btn btn-outline-secondary" id="increaseBtn">+</button>
                </div>
                <span asp-validation-for="CollectionItem.CurrentQuantity" class="text-danger small"></span>
            </div>

            <div class="mt-4">
                <input type="submit" value="Save" class="btn btn-primary me-2" />
                <a asp-page="./Index" class="btn btn-secondary">Back to List</a>
            </div>

        </form>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

    <script>
        const quantityInput = document.getElementById("CollectionItem_CurrentQuantity");
        const increaseBtn = document.getElementById("increaseBtn");
        const decreaseBtn = document.getElementById("decreaseBtn");

        increaseBtn.addEventListener("click", function () {
            quantityInput.value = parseInt(quantityInput.value || 0) + 1;
        });

        decreaseBtn.addEventListener("click", function () {
            const current = parseInt(quantityInput.value || 0);
            if (current > 0) {
                quantityInput.value = current - 1;
            }
        });

        // Prevent non-integer input
        quantityInput.addEventListener("input", function () {
            this.value = this.value.replace(/[^0-9]/g, "");
            if (this.value === "") this.value = 0;
        });
    </script>
}