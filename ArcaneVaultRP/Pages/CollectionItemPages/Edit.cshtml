@page
@model ArcaneVaultRP.Pages.CollectionItemPages.EditModel
@{
    ViewData["Title"] = "Edit Collection Item";
}

<h1>Edit Collection Item</h1>
<hr />

<div class="row">
    <div class="col-md-5">
        <form method="post">
            <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

            <!-- Hidden fields -->
            <input type="hidden" asp-for="CollectionItem.ItemId" />
            <input type="hidden" asp-for="CollectionItem.IsDeleted" />
            <input type="hidden" asp-for="CollectionItem.StartingQuantity" />
            <input type="hidden" asp-for="CollectionItem.UserName" />

            <!-- Item Name -->
            <div class="mb-3">
                <label asp-for="CollectionItem.ItemName" class="form-label fw-semibold">Item Name</label>
                <input asp-for="CollectionItem.ItemName" class="form-control" placeholder="Enter item name" />
                <span asp-validation-for="CollectionItem.ItemName" class="text-danger small"></span>
            </div>

            <!-- Category smart search -->
            <div class="mb-3 position-relative">
                <label class="form-label fw-semibold">Category</label>
                @if (Model.CurrentCategoryName != null)
                {
                    <p class="text-muted small mb-1">
                        Current: @Model.CurrentCategoryName (@Model.CurrentCategoryCode)
                    </p>
                }
                <input type="text"
                       id="categorySearch"
                       class="form-control"
                       placeholder="Search to change category..."
                       autocomplete="off" />
                <input type="hidden"
                       id="selectedCategoryCode"
                       name="SelectedCategoryCode"
                       value="@Model.CurrentCategoryCode" />
                <div id="categorySuggestions"
                     class="list-group position-absolute z-3"
                     style="width:100%;max-height:200px;overflow-y:auto;"></div>
            </div>

            <!-- Item Quantity -->
            <div class="mb-3">
                <label class="form-label fw-semibold" for="CollectionItem_CurrentQuantity">Item Quantity</label>
                <div class="input-group">
                    <button type="button" class="btn btn-outline-secondary" id="decreaseBtn">-</button>
                    <input asp-for="CollectionItem.CurrentQuantity"
                           class="form-control text-center"
                           id="CollectionItem_CurrentQuantity"
                           min="0" />
                    <button type="button" class="btn btn-outline-secondary" id="increaseBtn">+</button>
                </div>
                <span asp-validation-for="CollectionItem.CurrentQuantity" class="text-danger small"></span>
            </div>

            <div class="mt-4">
                <input type="submit" value="Save" class="btn btn-primary me-2" />
                <a asp-page="./Index" class="btn btn-secondary">Back to List</a>
            </div>

        </form>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

    <script>
        const categories = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.Categories));

        function truncate(text) {
            if (!text) return '';
            return text.length <= 20 ? text : text.substring(0, 20) + '...';
        }

        const categorySearch = document.getElementById('categorySearch');
        const categorySuggestions = document.getElementById('categorySuggestions');
        const selectedCategoryCode = document.getElementById('selectedCategoryCode');

        categorySearch.addEventListener('input', function () {
            const query = this.value.trim().toLowerCase();
            categorySuggestions.innerHTML = '';

            if (query.length === 0) return;

            const matches = categories
                .filter(c =>
                    c.CategoryName.toLowerCase().includes(query) ||
                    c.CategoryCode.toLowerCase().includes(query))
                .slice(0, 5);

            matches.forEach(cat => {
                const item = document.createElement('a');
                item.href = '#';
                item.className = 'list-group-item list-group-item-action';
                item.textContent = truncate(cat.CategoryName) + ' (' + cat.CategoryCode + ')';
                item.addEventListener('click', function (e) {
                    e.preventDefault();
                    categorySearch.value = truncate(cat.CategoryName) + ' (' + cat.CategoryCode + ')';
                    selectedCategoryCode.value = cat.CategoryCode;
                    categorySuggestions.innerHTML = '';
                });
                categorySuggestions.appendChild(item);
            });
        });

        document.addEventListener('click', function (e) {
            if (!categorySearch.contains(e.target)) categorySuggestions.innerHTML = '';
        });

        // Quantity +/- buttons
        const quantityInput = document.getElementById("CollectionItem_CurrentQuantity");
        const increaseBtn = document.getElementById("increaseBtn");
        const decreaseBtn = document.getElementById("decreaseBtn");

        increaseBtn.addEventListener("click", function () {
            quantityInput.value = parseInt(quantityInput.value || 0) + 1;
        });

        decreaseBtn.addEventListener("click", function () {
            const current = parseInt(quantityInput.value || 0);
            if (current > 0) quantityInput.value = current - 1;
        });

        quantityInput.addEventListener("input", function () {
            this.value = this.value.replace(/[^0-9]/g, "");
            if (this.value === "") this.value = 0;
        });
    </script>
}