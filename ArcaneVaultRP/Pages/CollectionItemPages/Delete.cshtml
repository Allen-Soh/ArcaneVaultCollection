@page
@model ArcaneVaultRP.Pages.CollectionItemPages.DeleteModel
@{
    ViewData["Title"] = "Delete";
}

<h1>Delete Collection Item</h1>
<hr />

<div class="alert alert-warning" role="alert">
    Are you sure you want to delete this item?
</div>

<div class="row">
    <div class="col-md-5">
        <div class="card shadow-sm border-0 rounded-3">
            <div class="card-body p-4">

                <div class="mb-3">
                    <label class="form-label fw-semibold">Item Name</label>
                    <p class="form-control-plaintext">@Model.CollectionItem.ItemName</p>
                </div>

                <div class="mb-3">
                    <label class="form-label fw-semibold">Category</label>
                    <p class="form-control-plaintext">
                        @if (Model.ItemCategory != null)
                        {
                            @Model.ItemCategory.CategoryName
                            <span class="text-muted">(@Model.ItemCategory.CategoryCode)</span>
                        }
                        else
                        {
                            <span class="text-muted">No category assigned</span>
                        }
                    </p>
                </div>

                <div class="mb-3">
                    <label class="form-label fw-semibold">Current Quantity</label>
                    <p class="form-control-plaintext">@Model.CollectionItem.CurrentQuantity</p>
                </div>

                <form method="post">
                    <input type="hidden" asp-for="CollectionItem.ItemId" />
                    <input type="submit" value="Delete" class="btn btn-danger me-2" />
                    <a asp-page="./Index" class="btn btn-secondary">Back to List</a>
                </form>

            </div>
        </div>
    </div>
</div>