@page
@model ArcaneVaultRP.Pages.SupportPages.IndexModel
@{
    ViewData["Title"] = "Customer Support";
    var userJson = HttpContext.Session.GetString(SessionKeys.LoggedInUser);
    var loggedInUser = userJson != null ? System.Text.Json.JsonSerializer.Deserialize<Models.ArcaneVaultUser>(userJson) : null;
}

<div class="container mt-4" style="max-width:600px;">
    <h4 class="fw-bold mb-1">Contact Support</h4>
    <p class="text-muted mb-4">Have an issue or question? Send us a message and we'll get back to you.</p>

    <div id="ticketFormCard" class="card border-0 shadow-sm p-4" style="background: rgba(166, 177, 225, 0.02); border: 1px solid var(--border-color) !important;">
        <div class="mb-3">
            <label class="form-label fw-semibold">Name</label>
            <input type="text" id="ticketName" class="form-control" maxlength="80" placeholder="Your name" />
        </div>
        <div class="mb-3">
            <label class="form-label fw-semibold">Email</label>
            <input type="email" id="ticketEmail" class="form-control" placeholder="you@example.com" />
        </div>
        <div class="mb-3">
            <label class="form-label fw-semibold">Subject</label>
            <input type="text" id="ticketSubject" class="form-control" maxlength="120" placeholder="Brief summary" />
        </div>
        <div class="mb-3">
            <label class="form-label fw-semibold">Issue</label>
            <textarea id="ticketIssue" class="form-control" rows="5" maxlength="2000" placeholder="Describe your issue in detail..."></textarea>
        </div>
        <div id="ticketError" class="text-danger small mb-2" style="display:none;"></div>
        <div class="d-flex gap-2 justify-content-end">
            <button type="button" class="btn btn-secondary" onclick="clearForm()">Clear</button>
            <button type="button" class="btn btn-primary" onclick="submitTicket()">Submit</button>
        </div>
    </div>

    <div id="ticketSuccessCard" class="card border-0 shadow-sm p-4 text-center" style="display:none; background: rgba(166, 177, 225, 0.02); border: 1px solid var(--border-color) !important;">
        <i class="bi bi-check-circle-fill text-success fs-1 mb-3 d-block"></i>
        <h5 class="fw-bold mb-2">Ticket submitted</h5>
        <p class="text-muted mb-1">Your reference number is:</p>
        <p class="fw-bold fs-4 mb-3" style="color: var(--text-primary, #e6edf3);" id="ticketUidDisplay"></p>
        <p class="text-muted small">A confirmation email has been sent to your inbox. Our team will get back to you soon.</p>
        <button class="btn btn-outline-primary mt-2" onclick="resetForm()">Submit another ticket</button>
    </div>
</div>

@section Scripts {
    <script>
        const apiBase = document.getElementById('apiBaseInput')?.value || 'https://localhost:7040/api';
        const currentUser = '@loggedInUser?.UserName' === '' ? null : '@loggedInUser?.UserName';

        function clearForm() {
            document.getElementById('ticketName').value = '';
            document.getElementById('ticketEmail').value = '';
            document.getElementById('ticketSubject').value = '';
            document.getElementById('ticketIssue').value = '';
            document.getElementById('ticketError').style.display = 'none';
        }

        function resetForm() {
            clearForm();
            document.getElementById('ticketFormCard').style.display = 'block';
            document.getElementById('ticketSuccessCard').style.display = 'none';
        }

        let ticketSubmitInFlight = false;

        async function submitTicket() {
            if (ticketSubmitInFlight) return; // ignore extra clicks while a request is already in progress

            const name = document.getElementById('ticketName').value.trim();
            const email = document.getElementById('ticketEmail').value.trim();
            const subject = document.getElementById('ticketSubject').value.trim();
            const issue = document.getElementById('ticketIssue').value.trim();
            const errEl = document.getElementById('ticketError');
            errEl.style.display = 'none';

            if (!name || !email || !subject || !issue) {
                errEl.textContent = 'Please fill in all fields.';
                errEl.style.display = 'block';
                return;
            }
            if (!email.includes('@@')) {
                errEl.textContent = 'Please enter a valid email address.';
                errEl.style.display = 'block';
                return;
            }

            const submitBtn = document.querySelector('#ticketFormCard button.btn-primary');
            ticketSubmitInFlight = true;
            submitBtn.disabled = true;
            submitBtn.innerHTML = `<span class="spinner-border spinner-border-sm me-1"></span>Submitting...`;

            try {
                const res = await fetch(`${apiBase}/SupportTicket`, {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ Name: name, Email: email, Subject: subject, Issue: issue, UserName: currentUser })
                });

                if (!res.ok) {
                    errEl.textContent = 'Failed to submit ticket. Please try again.';
                    errEl.style.display = 'block';
                    return;
                }

                const data = await res.json();
                document.getElementById('ticketUidDisplay').textContent = data.ticketUid || data.TicketUid;
                document.getElementById('ticketFormCard').style.display = 'none';
                document.getElementById('ticketSuccessCard').style.display = 'block';
            } finally {
                ticketSubmitInFlight = false;
                submitBtn.disabled = false;
                submitBtn.innerHTML = 'Submit';
            }
        }
    </script>
}