@page
@model ArcaneVaultRP.Pages.SupportPages.StaffModel
@{
    ViewData["Title"] = "Customer Support";
}

<div class="container mt-4">
    <div class="d-flex align-items-start justify-content-between mb-3 flex-wrap gap-2">
        <div>
            <h4 class="fw-bold mb-1">User Support Tickets</h4>
            <p class="text-muted small mb-0" id="ticketCountText"></p>
        </div>
        <div>
            <button class="btn btn-outline-secondary btn-sm filters-toggle-btn" type="button"
                    data-bs-toggle="collapse" data-bs-target="#staffFiltersPanel"
                    aria-expanded="false" aria-controls="staffFiltersPanel">
                <i class="bi bi-funnel"></i> Filters
                <span class="filters-badge" id="staffFiltersBadge" style="display:none;"></span>
                <i class="bi bi-chevron-down"></i>
            </button>
        </div>
    </div>

    <div class="collapse filters-panel" id="staffFiltersPanel">
        <div class="d-flex align-items-center gap-2 flex-wrap mb-3">
            <input type="text" id="uidSearchInput" class="form-control form-control-sm"
                   placeholder="Search ticket UID..." style="width:200px;" oninput="applyFilters()" />
            <label class="text-muted small" style="white-space:nowrap;">Status:</label>
            <select id="filterStatus" class="form-select form-select-sm" style="width:auto;" onchange="applyFilters()">
                <option value="All">All</option>
                <option value="Active">Active</option>
                <option value="Resolved">Resolved</option>
            </select>
        </div>
    </div>

    <ul class="nav nav-tabs mb-4">
        <li class="nav-item">
            <a class="nav-link @(Model.ActiveTab == "all" ? "active" : "")"
               asp-page="./Staff" asp-route-tab="all">All Tickets</a>
        </li>
        <li class="nav-item">
            <a class="nav-link @(Model.ActiveTab == "my" ? "active" : "")"
               asp-page="./Staff" asp-route-tab="my">My Tickets</a>
        </li>
    </ul>

    <div id="actionMessage" class="alert alert-success" style="display:none;"></div>

    <div class="border rounded overflow-hidden" style="position:relative;">
        <div id="ticketTableWrapper" style="overflow-y:auto;">
            <table class="table mb-0" style="width:100%;">
                <thead class="table-light" style="position:sticky; top:0; z-index:2;">
                    <tr>
                        <th style="padding:12px;">Ticket</th>
                        <th style="padding:12px; width:180px; text-align:right;">Actions</th>
                    </tr>
                </thead>
                <tbody id="ticketTableBody"></tbody>
            </table>
        </div>
        <div id="tableEmpty" style="display:none;" class="text-center text-muted py-5">
            <i class="bi bi-check-circle fs-2 d-block mb-2"></i>
            <span id="emptyText">No support tickets — all clear!</span>
        </div>
    </div>
    <div class="d-flex justify-content-between mt-2 mb-4" id="ticketTableIndicatorRow">
        <p class="text-muted mb-0" id="ticketScrollIndicator" style="font-size:12px;"></p>
        <p class="text-muted mb-0" id="ticketScrollMoreText" style="font-size:12px;">Scroll to load more</p>
    </div>
</div>

<!-- Review Modal -->
<div class="modal fade" id="viewTicketModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header border-0">
                <h5 class="modal-title fw-bold" id="viewTicketUid"></h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <p class="mb-1"><strong>Name:</strong> <span id="viewTicketName"></span></p>
                <p class="mb-1"><strong>Email:</strong> <span id="viewTicketEmail"></span></p>
                <p class="mb-1"><strong>Subject:</strong> <span id="viewTicketSubject"></span></p>
                <hr />
                <p class="mb-0" style="white-space:pre-wrap;" id="viewTicketIssue"></p>
            </div>
            <div class="modal-footer border-0">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
            </div>
        </div>
    </div>
</div>

<!-- Reply Modal -->
<div class="modal fade" id="replyTicketModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header border-0">
                <h5 class="modal-title fw-bold">Reply to Ticket</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <p class="text-muted small">This will be emailed to the customer and mark the ticket as resolved.</p>
                <textarea id="replyMessageInput" class="form-control" rows="5" maxlength="2000" placeholder="Type your response..."></textarea>
                <div id="replyError" class="text-danger small mt-1" style="display:none;">Please enter a message.</div>
            </div>
            <div class="modal-footer border-0">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-success" id="replySubmitBtn" onclick="submitReply()">Send Reply & Resolve</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        const apiBase = document.getElementById('apiBaseInput')?.value || 'https://localhost:7040/api';
        const currentStaff = '@Model.CurrentStaffUserName';
        const activeTab = '@Model.ActiveTab';
        let allTickets = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.ActiveTab == "my" ? Model.MyTickets : Model.AllTickets));
        let currentReviewTicket = null;

        function updateFiltersBadge(badgeId, activeCount) {
            const badge = document.getElementById(badgeId);
            if (!badge) return;
            badge.textContent = activeCount;
            badge.style.display = activeCount > 0 ? 'inline-block' : 'none';
        }

        function applyFilters() {
            const status = document.getElementById('filterStatus').value;
            const query = document.getElementById('uidSearchInput').value.trim().toLowerCase();

            updateFiltersBadge('staffFiltersBadge', (status !== 'All' ? 1 : 0) + (query ? 1 : 0));

            let filtered = [...allTickets];

            if (query) {
                filtered = filtered.filter(t => (t.ticketUid || t.TicketUid).toLowerCase().includes(query));
            }

            if (status !== 'All') {
                filtered = filtered.filter(t => {
                    const resolved = t.isResolved ?? t.IsResolved;
                    return status === 'Resolved' ? resolved : !resolved;
                });
            }

            filtered.sort((a, b) => {
                const ar = a.isResolved ?? a.IsResolved;
                const br = b.isResolved ?? b.IsResolved;
                return ar === br ? 0 : (ar ? 1 : -1);
            });

            renderTable(filtered);
        }

        // ── Virtual Scroll Implementation (same pattern as Reports/Category/CollectionItems) ──
        const ROW_HEIGHT = 130;
        const BUFFER = 3;
        const THRESHOLD = 5;

        function createVirtualTable(wrapperId, tbodyId, data, renderRowFn) {
            const wrapper = document.getElementById(wrapperId);
            const tbody = document.getElementById(tbodyId);
            if (!wrapper || !tbody) return;

            if (data.length <= THRESHOLD) {
                wrapper.style.height = '';
                wrapper.style.maxHeight = '';
                wrapper.onscroll = null;
                tbody.innerHTML = data.map((row, i) => renderRowFn(row, i)).join('');
                return;
            }

            // Fixed height based on THRESHOLD rows only — stays constant regardless of how
            // many additional rows exist beyond it, so the table never grows/shrinks as data changes.
            const visibleHeight = ROW_HEIGHT * THRESHOLD + 18;
            wrapper.style.height = `${visibleHeight}px`;
            wrapper.style.maxHeight = `${visibleHeight}px`;
            wrapper.style.overflowY = 'auto';

            function render() {
                const scrollTop = wrapper.scrollTop;
                const startIdx = Math.max(0, Math.floor(scrollTop / ROW_HEIGHT) - BUFFER);
                const endIdx = Math.min(data.length, Math.ceil((scrollTop + visibleHeight) / ROW_HEIGHT) + BUFFER);
                const topPad = startIdx * ROW_HEIGHT;
                const bottomPad = (data.length - endIdx) * ROW_HEIGHT;
                tbody.innerHTML =
                    (topPad > 0 ? `<tr style="height:${topPad}px;"><td colspan="2"></td></tr>` : '') +
                    data.slice(startIdx, endIdx).map((row, i) => renderRowFn(row, startIdx + i)).join('') +
                    (bottomPad > 0 ? `<tr style="height:${bottomPad}px;"><td colspan="2"></td></tr>` : '');
            }

            let ticking = false;
            wrapper.onscroll = () => {
                if (!ticking) {
                    requestAnimationFrame(() => { render(); ticking = false; });
                    ticking = true;
                }
            };
            wrapper.scrollTop = 0;
            render();
        }

        function renderTicketRow(t, idx) {
            const uid = t.ticketUid || t.TicketUid;
            const name = t.name || t.Name;
            const email = t.email || t.Email;
            const subject = t.subject || t.Subject;
            const assignedStaff = t.assignedStaffUserName || t.AssignedStaffUserName || 'Unassigned';
            const resolved = t.isResolved ?? t.IsResolved;
            const dateStr = new Date(t.createdAt || t.CreatedAt).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' });

            const statusBadge = resolved
                ? `<span class="badge" style="background:rgba(88,166,255,0.15);color:#58a6ff;border:1px solid rgba(88,166,255,0.3);font-size:10px;">RESOLVED</span>`
                : `<span class="badge" style="background:rgba(25,135,84,0.15);color:#7ef5a6;border:1px solid rgba(25,135,84,0.3);font-size:10px;">● Active</span>`;

            return `
                                        <tr style="height:${ROW_HEIGHT}px;${resolved ? 'opacity:0.6;' : ''}">
                                            <td style="padding:16px;vertical-align:top;">
                                                <div class="d-flex align-items-center gap-2 mb-1">
                                                    <span class="fw-bold" style="font-size:15px;">${uid}</span>
                                                    ${statusBadge}
                                                </div>
                                                <div style="font-size:13px;color:var(--text-secondary);">${name} · ${email}</div>
                                                <div style="font-size:13px;color:var(--text-muted);">${subject}</div>
                                                <div style="font-size:11px;color:var(--text-muted);margin-top:4px;">
                                                    Assigned to <strong>${assignedStaff}</strong> · ${dateStr}
                                                </div>
                                            </td>
                                            <td style="padding:16px;vertical-align:top;text-align:right;">
                                                <div class="d-flex flex-column gap-1 align-items-end">
                                                <button class="btn btn-secondary btn-sm" style="font-size:11px;padding:4px 12px;" onclick='reviewTicket(${JSON.stringify(t)})'>Review</button>
                                                ${(assignedStaff === currentStaff || activeTab === 'my') ? (resolved
                    ? `<button class="btn btn-outline-secondary btn-sm" style="font-size:11px;padding:4px 12px;" onclick="reopenTicket(${t.ticketId ?? t.TicketId})">Reopen</button>`
                    : `<button class="btn btn-success btn-sm" style="font-size:11px;padding:4px 12px;" onclick="openReplyModal(${t.ticketId ?? t.TicketId})">Reply &amp; Resolve</button>`
                ) : ''}
                                                </div>
                                            </td>
                                        </tr>`;
        }

        function renderTable(tickets) {
            const empty = document.getElementById('tableEmpty');
            const wrapper = document.getElementById('ticketTableWrapper');
            const indicatorRow = document.getElementById('ticketTableIndicatorRow');
            const moreText = document.getElementById('ticketScrollMoreText');

            const pendingCount = allTickets.filter(t => !(t.isResolved ?? t.IsResolved)).length;
            document.getElementById('ticketCountText').textContent = `${pendingCount} pending ticket${pendingCount !== 1 ? 's' : ''}`;

            if (tickets.length === 0) {
                empty.style.display = 'block';
                document.getElementById('ticketTableBody').innerHTML = '';
                wrapper.style.height = '';
                wrapper.style.maxHeight = '';
                wrapper.onscroll = null;
                indicatorRow.style.display = 'none';
                return;
            }

            empty.style.display = 'none';
            indicatorRow.style.removeProperty('display');
            moreText.style.display = tickets.length > THRESHOLD ? 'block' : 'none';

            function updateIndicator() {
                const scrollTop = wrapper.scrollTop;
                const visStart = Math.max(1, Math.floor(scrollTop / ROW_HEIGHT) + 1);
                const visEnd = Math.min(tickets.length, visStart + THRESHOLD - 1);
                document.getElementById('ticketScrollIndicator').textContent =
                    tickets.length > THRESHOLD
                        ? `Showing ${visStart}–${visEnd} of ${tickets.length}`
                        : `${tickets.length} ticket${tickets.length === 1 ? '' : 's'}`;
            }

            wrapper.removeEventListener('scroll', updateIndicator);
            wrapper.addEventListener('scroll', updateIndicator);

            createVirtualTable('ticketTableWrapper', 'ticketTableBody', tickets, renderTicketRow);
            updateIndicator();
        }

        function reviewTicket(ticket) {
            document.getElementById('viewTicketUid').textContent = ticket.ticketUid || ticket.TicketUid;
            document.getElementById('viewTicketName').textContent = ticket.name || ticket.Name;
            document.getElementById('viewTicketEmail').textContent = ticket.email || ticket.Email;
            document.getElementById('viewTicketSubject').textContent = ticket.subject || ticket.Subject;
            document.getElementById('viewTicketIssue').textContent = ticket.issue || ticket.Issue;
            new bootstrap.Modal(document.getElementById('viewTicketModal')).show();
        }

        // Resolve — opens the staff's default email client with recipient + Re: subject prefilled,
        // then marks the ticket resolved in the background
        let pendingReplyTicketId = null;

        function openReplyModal(ticketId) {
            pendingReplyTicketId = ticketId;
            document.getElementById('replyMessageInput').value = '';
            document.getElementById('replyError').style.display = 'none';
            new bootstrap.Modal(document.getElementById('replyTicketModal')).show();
        }

        async function submitReply() {
            const message = document.getElementById('replyMessageInput').value.trim();
            const errEl = document.getElementById('replyError');

            if (!message) {
                errEl.style.display = 'block';
                return;
            }
            errEl.style.display = 'none';

            const btn = document.getElementById('replySubmitBtn');
            btn.disabled = true;
            btn.innerHTML = `<span class="spinner-border spinner-border-sm me-1"></span>Sending...`;

            const res = await fetch(`${apiBase}/SupportTicket/${pendingReplyTicketId}/reply`, {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ message })
            });

            btn.disabled = false;
            btn.innerHTML = 'Send Reply & Resolve';

            bootstrap.Modal.getInstance(document.getElementById('replyTicketModal'))?.hide();

            if (res.ok) {
                allTickets.forEach(t => {
                    if ((t.ticketId ?? t.TicketId) === pendingReplyTicketId) {
                        t.isResolved = true;
                        t.IsResolved = true;
                    }
                });
                const msg = document.getElementById('actionMessage');
                msg.textContent = 'Reply sent and ticket marked as resolved.';
                msg.style.display = 'block';
                setTimeout(() => msg.style.display = 'none', 4000);
                applyFilters();
            } else {
                alert('Failed to send reply. Please try again.');
            }
        }

        async function reopenTicket(ticketId) {
            const res = await fetch(`${apiBase}/SupportTicket/${ticketId}/unresolve`, { method: 'PATCH' });

            if (res.ok) {
                allTickets.forEach(t => {
                    if ((t.ticketId ?? t.TicketId) === ticketId) {
                        t.isResolved = false;
                        t.IsResolved = false;
                    }
                });
                const msg = document.getElementById('actionMessage');
                msg.textContent = 'Ticket reopened.';
                msg.style.display = 'block';
                setTimeout(() => msg.style.display = 'none', 4000);
                applyFilters();
            }
        }

        // Adds a clear ("×") button to a search input; shows only when it has text.
        // Wraps the input in its own dedicated box (rather than reusing a shared flex-row
        // parent that might also contain a <select> etc.), so the button always sits
        // against the input itself, never a sibling control.
        function enableSearchClear(inputId) {
            const input = document.getElementById(inputId);
            if (!input || input.dataset.clearEnabled) return;

            const wrapper = document.createElement('div');
            wrapper.className = 'search-clear-wrapper';

            if (input.style.flex) {
                wrapper.style.flex = input.style.flex;
                input.style.flex = '';
            } else {
                wrapper.style.width = '100%';
            }
            if (input.style.minWidth) {
                wrapper.style.minWidth = input.style.minWidth;
                input.style.minWidth = '';
            }
            input.style.width = '100%';

            input.parentElement.insertBefore(wrapper, input);
            wrapper.appendChild(input);

            const btn = document.createElement('button');
            btn.type = 'button';
            btn.className = 'search-clear-btn';
            btn.innerHTML = '&times;';
            btn.setAttribute('aria-label', 'Clear search');
            wrapper.appendChild(btn);

            function toggleBtn() {
                btn.style.display = input.value.length > 0 ? 'block' : 'none';
            }

            input.addEventListener('input', toggleBtn);
            toggleBtn();

            btn.addEventListener('click', () => {
                input.value = '';
                input.dispatchEvent(new Event('input', { bubbles: true }));
                toggleBtn();
                input.focus();
            });

            input.dataset.clearEnabled = 'true';
        }

        applyFilters();
        enableSearchClear('uidSearchInput');
    </script>
}
