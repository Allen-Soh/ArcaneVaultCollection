@page
@model ArcaneVaultRP.Pages.CategoryPages.DeleteModel
@{
    ViewData["Title"] = "Delete Category";
}

<h1>Delete Category</h1>
<hr />

<div class="alert alert-warning" role="alert">
    Are you sure you want to delete this category?
</div>

<div class="row">
    <div class="col-md-5">
        <div class="card shadow-sm border-0 rounded-3">
            <div class="card-body p-4">

                <div class="mb-3">
                    <label class="form-label fw-semibold">Category Code</label>
                    <p class="form-control-plaintext">@Model.Category.CategoryCode</p>
                </div>

                <div class="mb-3">
                    <label class="form-label fw-semibold">Category Name</label>
                    <p class="form-control-plaintext">@Model.Category.CategoryName</p>
                </div>

                <form method="post">
                    <input type="hidden" asp-for="Category.CategoryCode" />
                    <input type="submit" value="Delete" class="btn btn-danger me-2" />
                    <a asp-page="./Index" class="btn btn-secondary">Back to List</a>
                </form>

            </div>
        </div>
    </div>
</div>