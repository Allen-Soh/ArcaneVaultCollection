@page
@model ArcaneVaultRP.Pages.CategoryPages.CreateModel
@{
    ViewData["Title"] = "Create Category";
}

<h1>Create Category</h1>
<hr />

<div class="row">
    <div class="col-md-5">
        <form method="post">
            <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

            <!-- Category Name -->
            <div class="mb-3">
                <label asp-for="Category.CategoryName" class="form-label fw-semibold">Category Name</label>
                <input asp-for="Category.CategoryName"
                       class="form-control"
                       placeholder="Enter category name" />
                <span asp-validation-for="Category.CategoryName" class="text-danger small"></span>
            </div>

            <div class="mt-4">
                <input type="submit" value="Create" class="btn btn-primary me-2" />
                <a asp-page="./Index" class="btn btn-secondary">Back to List</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}