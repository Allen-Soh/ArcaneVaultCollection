@page
@model ArcaneVaultRP.Pages.CategoryPages.IndexModel
@{
    ViewData["Title"] = "Categories";
}

<div class="d-flex align-items-start justify-content-between mb-3 flex-wrap gap-2">
    <h1>Categories</h1>
    <button class="btn btn-outline-secondary btn-sm filters-toggle-btn" type="button"
            data-bs-toggle="collapse" data-bs-target="#categoryFiltersPanel"
            aria-expanded="false" aria-controls="categoryFiltersPanel">
        <i class="bi bi-funnel"></i> Filters
        <span class="filters-badge" id="categoryFiltersBadge" style="display:none;"></span>
        <i class="bi bi-chevron-down"></i>
    </button>
</div>

<div id="actionMessage" class="alert alert-success" style="display:none;"></div>

<!-- Search -->
<div class="collapse filters-panel" id="categoryFiltersPanel">
    <div class="row g-2 mb-3">
        <div class="col-md-6 position-relative">
            <label class="form-label fw-semibold">Category Name</label>
            <input type="text"
                   id="searchCategoryName"
                   class="form-control"
                   placeholder="Search by category name..."
                   autocomplete="off"
                   value="@Model.SearchCategoryName" />
            <div id="categoryNameSuggestions"
                 class="list-group position-absolute z-3"
                 style="width:100%;max-height:200px;overflow-y:auto;display:none;"></div>
        </div>
    </div>
</div>

<p>
    <a asp-page="Create" class="btn btn-success">Create New</a>
</p>

<div id="categoryTableContainer">
    @await Html.PartialAsync("_CategoryTable", Model)
</div>

@section Scripts {
    <script>
        // Full category list — powers the name-suggestion dropdown only (actual filtering/paging
        // happens server-side via the Filter handler, same pattern as the Showoff feed).
        const categories = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.AllCategories));

        // ── Success confirmation after Create/Edit ──
        (function () {
            const params = new URLSearchParams(window.location.search);
            let text = null;
            if ((params.get('created') || '').toLowerCase() === 'true') text = 'Category created.';
            else if ((params.get('updated') || '').toLowerCase() === 'true') text = 'Category updated.';
            if (text) {
                const msg = document.getElementById('actionMessage');
                msg.textContent = text;
                msg.style.display = 'block';
                setTimeout(() => msg.style.display = 'none', 4000);
                params.delete('created');
                params.delete('updated');
                const remaining = params.toString();
                history.replaceState(null, '', window.location.pathname + (remaining ? `?${remaining}` : ''));
            }
        })();

        function truncate(text) {
            if (!text) return '';
            return text.length <= 40 ? text : text.substring(0, 40) + '...';
        }

        // ── AJAX Filtering (no page reload) — mirrors the Showoff feed's refreshGrid() pattern ──
        let currentFilters = {
            searchCategoryName: '@Model.SearchCategoryName' || '',
            page: 1
        };

        function updateFiltersBadge(badgeId, activeCount) {
            const badge = document.getElementById(badgeId);
            if (!badge) return;
            badge.textContent = activeCount;
            badge.style.display = activeCount > 0 ? 'inline-block' : 'none';
        }

        async function refreshTable(newFilters = {}) {
            Object.assign(currentFilters, newFilters);

            updateFiltersBadge('categoryFiltersBadge', currentFilters.searchCategoryName ? 1 : 0);

            const params = new URLSearchParams({
                page: currentFilters.page,
                searchCategoryName: currentFilters.searchCategoryName
            });

            const res = await fetch(`?handler=Filter&${params.toString()}`, {
                headers: { 'X-Requested-With': 'XMLHttpRequest' }
            });

            if (!res.ok) {
                console.error('Failed to refresh category table');
                return;
            }

            const html = await res.text();
            document.getElementById('categoryTableContainer').innerHTML = html;

            const urlParams = new URLSearchParams(window.location.search);
            urlParams.set('page', currentFilters.page);
            currentFilters.searchCategoryName ? urlParams.set('searchCategoryName', currentFilters.searchCategoryName) : urlParams.delete('searchCategoryName');
            history.replaceState(null, '', `${window.location.pathname}?${urlParams.toString()}`);
        }

        // Pagination — delegated on `document`, scoped to #categoryTableContainer.
        document.addEventListener('click', (e) => {
            const link = e.target.closest('.ajax-page-link');
            if (!link) return;
            if (!link.closest('#categoryTableContainer')) return;
            e.preventDefault();
            refreshTable({ page: parseInt(link.dataset.page) });
        });

        const searchCategoryName = document.getElementById('searchCategoryName');
        const categoryNameSuggestions = document.getElementById('categoryNameSuggestions');

        function renderCategorySuggestions(query) {
            categoryNameSuggestions.innerHTML = '';

            const matches = categories
                .filter(c =>
                    (c.CategoryName && c.CategoryName.toLowerCase().includes(query)) ||
                    (c.CategoryCode && c.CategoryCode.toLowerCase().includes(query)))
                .slice(0, 5);

            if (matches.length === 0) {
                categoryNameSuggestions.style.display = 'none';
                return;
            }

            categoryNameSuggestions.style.display = 'block';

            matches.forEach(cat => {
                const item = document.createElement('a');
                item.href = '#';
                item.className = 'list-group-item list-group-item-action';
                item.textContent = truncate(cat.CategoryName) + ' (' + cat.CategoryCode + ')';
                item.addEventListener('click', function (e) {
                    e.preventDefault();
                    searchCategoryName.value = cat.CategoryName;
                    categoryNameSuggestions.innerHTML = '';
                    categoryNameSuggestions.style.display = 'none';
                    refreshTable({ searchCategoryName: cat.CategoryName, page: 1 });
                });
                categoryNameSuggestions.appendChild(item);
            });
        }

        searchCategoryName.addEventListener('focus', function () {
            renderCategorySuggestions(this.value.trim().toLowerCase());
        });

        searchCategoryName.addEventListener('input', function () {
            const query = this.value.trim();
            if (query.length === 0) {
                categoryNameSuggestions.style.display = 'none';
            } else {
                renderCategorySuggestions(query.toLowerCase());
            }

            clearTimeout(this._searchTimer);
            this._searchTimer = setTimeout(() => {
                refreshTable({ searchCategoryName: query, page: 1 });
            }, 500);
        });

        searchCategoryName.addEventListener('keydown', function (e) {
            if (e.key === 'Enter') {
                e.preventDefault();
                clearTimeout(this._searchTimer);
                categoryNameSuggestions.style.display = 'none';
                refreshTable({ searchCategoryName: this.value.trim(), page: 1 });
            }
        });

        document.addEventListener('click', function (e) {
            if (!searchCategoryName.contains(e.target) && !categoryNameSuggestions.contains(e.target)) {
                categoryNameSuggestions.innerHTML = '';
                categoryNameSuggestions.style.display = 'none';
            }
        });

        // Adds a clear ("×") button to a search input; shows only when it has text.
        function enableSearchClear(inputId) {
            const input = document.getElementById(inputId);
            if (!input || input.dataset.clearEnabled) return;

            const wrapper = document.createElement('div');
            wrapper.className = 'search-clear-wrapper';
            wrapper.style.width = '100%';
            input.style.width = '100%';

            input.parentElement.insertBefore(wrapper, input);
            wrapper.appendChild(input);

            const btn = document.createElement('button');
            btn.type = 'button';
            btn.className = 'search-clear-btn';
            btn.innerHTML = '&times;';
            btn.setAttribute('aria-label', 'Clear search');
            wrapper.appendChild(btn);

            function toggleBtn() {
                btn.style.display = input.value.length > 0 ? 'block' : 'none';
            }

            input.addEventListener('input', toggleBtn);
            toggleBtn();

            btn.addEventListener('click', () => {
                input.value = '';
                input.dispatchEvent(new Event('input', { bubbles: true }));
                toggleBtn();
                input.focus();
            });

            input.dataset.clearEnabled = 'true';
        }

        enableSearchClear('searchCategoryName');
    </script>
}
