@page
@model ArcaneVaultRP.Pages.CategoryPages.IndexModel
@{
    ViewData["Title"] = "Categories";
}

<h1>Categories</h1>

<!-- Search -->
<form method="get">
    <div class="row g-2 mb-3">
        <!-- Replace existing text input in CategoryPages/Index.cshtml -->
        <div class="col-md-6 position-relative">
            <label class="form-label fw-semibold">Category Name</label>
            <input type="text"
                   name="SearchCategoryName"
                   id="searchCategoryName"
                   value="@Model.SearchCategoryName"
                   class="form-control"
                   placeholder="Search by category name..."
                   autocomplete="off" />
            <div id="categoryNameSuggestions"
                 class="list-group position-absolute z-3"
                 style="width:100%;max-height:200px;overflow-y:auto;"></div>
        </div>

        <div class="col-md-2 d-flex align-items-end gap-2">
            <button type="submit" class="btn btn-primary">Search</button>
            <a asp-page="./Index" class="btn btn-secondary">Clear</a>
        </div>
    </div>
</form>

<p>
    <a asp-page="Create" class="btn btn-success">Create New</a>
</p>

<div class="border rounded overflow-hidden" style="position:relative;">
    <div id="categoryTableWrapper" style="overflow-y:auto;">
        <table class="table mb-0" style="width:100%;">
            <thead class="table-light" style="position:sticky; top:0; z-index:2;">
                <tr>
                    <th style="padding:12px;">Category Code</th>
                    <th style="padding:12px;">Category Name</th>
                    <th style="padding:12px; width: 1%;">Actions</th>
                </tr>
            </thead>
            <tbody id="categoryTableBody"></tbody>
        </table>
    </div>
    <div id="tableEmpty" style="display:none;" class="text-center text-muted py-4">
        No categories match your search.
    </div>
</div>
<div class="d-flex justify-content-between mt-2 mb-4" id="categoryTableIndicatorRow">
    <p class="text-muted mb-0" id="categoryScrollIndicator" style="font-size:12px;"></p>
    <p class="text-muted mb-0" id="categoryScrollMoreText" style="font-size:12px;">Scroll to load more</p>
</div>

@section Scripts {
    <script>
        // FIXED — named consistently as categories
        const categories = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.Category));

        function truncate(text) {
            if (!text) return '';
            return text.length <= 40 ? text : text.substring(0, 40) + '...';
        }

        const searchCategoryName = document.getElementById('searchCategoryName');
        const categoryNameSuggestions = document.getElementById('categoryNameSuggestions');

        searchCategoryName.addEventListener('input', function () {
            const query = this.value.trim().toLowerCase();
            categoryNameSuggestions.innerHTML = '';

            if (query.length === 0) return;

            const matches = categories
                .filter(c =>
                    (c.CategoryName && c.CategoryName.toLowerCase().includes(query)) ||
                    (c.CategoryCode && c.CategoryCode.toLowerCase().includes(query)))
                .slice(0, 5);

            // FIXED — cat is the object, use cat.CategoryName and cat.CategoryCode
            matches.forEach(cat => {
                const item = document.createElement('a');
                item.href = '#';
                item.className = 'list-group-item list-group-item-action';
                item.textContent = truncate(cat.CategoryName) + ' (' + cat.CategoryCode + ')';
                item.addEventListener('click', function (e) {
                    e.preventDefault();
                    searchCategoryName.value = cat.CategoryName;  // ← assign string not object
                    categoryNameSuggestions.innerHTML = '';
                    document.querySelector('form').submit();
                });
                categoryNameSuggestions.appendChild(item);
            });
        });

        document.addEventListener('click', function (e) {
            if (!searchCategoryName.contains(e.target)) categoryNameSuggestions.innerHTML = '';
        });

        // ── Virtual Scroll Table Implementation (Copied from Insights) ──
        const ROW_HEIGHT = 60;
        const BUFFER = 5;
        const THRESHOLD = 7;

        function createVirtualTable(wrapperId, tbodyId, data, renderRowFn) {
            const wrapper = document.getElementById(wrapperId);
            const tbody = document.getElementById(tbodyId);
            if (!wrapper || !tbody) return;

            if (data.length <= THRESHOLD) {
                wrapper.style.height = '';
                wrapper.style.maxHeight = '';
                wrapper.onscroll = null;
                tbody.innerHTML = data.map((row, i) => renderRowFn(row, i)).join('');
                return;
            }

            const visibleHeight = ROW_HEIGHT * THRESHOLD + 15;
            wrapper.style.height = `${visibleHeight}px`;
            wrapper.style.maxHeight = `${visibleHeight}px`;
            wrapper.style.overflowY = 'auto';

            function render() {
                const scrollTop = wrapper.scrollTop;
                const startIdx = Math.max(0, Math.floor(scrollTop / ROW_HEIGHT) - BUFFER);
                const endIdx = Math.min(
                    data.length,
                    Math.ceil((scrollTop + visibleHeight) / ROW_HEIGHT) + BUFFER
                );

                const topPad = startIdx * ROW_HEIGHT;
                const bottomPad = (data.length - endIdx) * ROW_HEIGHT;

                const topSpacer = topPad > 0
                    ? `<tr style="height:${topPad}px;"><td colspan="10"></td></tr>`
                    : '';
                const bottomSpacer = bottomPad > 0
                    ? `<tr style="height:${bottomPad}px;"><td colspan="10"></td></tr>`
                    : '';

                tbody.innerHTML =
                    topSpacer +
                    data.slice(startIdx, endIdx).map((row, i) => renderRowFn(row, startIdx + i)).join('') +
                    bottomSpacer;
            }

            let ticking = false;
            wrapper.onscroll = () => {
                if (!ticking) {
                    requestAnimationFrame(() => { render(); ticking = false; });
                    ticking = true;
                }
            };

            wrapper.scrollTop = 0;
            render();
        }

        function renderTable(data) {
            const empty = document.getElementById('tableEmpty');
            const wrapper = document.getElementById('categoryTableWrapper');
            const indicatorRow = document.getElementById('categoryTableIndicatorRow');
            const moreText = document.getElementById('categoryScrollMoreText');

            if (data.length === 0) {
                empty.style.display = 'block';
                document.getElementById('categoryTableBody').innerHTML = '';
                wrapper.style.height = '';
                wrapper.style.maxHeight = '';
                wrapper.onscroll = null;
                indicatorRow.style.display = 'none';
                return;
            }

            empty.style.display = 'none';
            indicatorRow.style.removeProperty('display');
            moreText.style.display = data.length > THRESHOLD ? 'block' : 'none';

            function updateIndicator() {
                const scrollTop = wrapper.scrollTop;
                const visStart = Math.max(1, Math.floor(scrollTop / ROW_HEIGHT) + 1);
                const visEnd = Math.min(data.length, visStart + THRESHOLD - 2);
                document.getElementById('categoryScrollIndicator').textContent =
                    data.length > THRESHOLD
                        ? `Showing ${visStart}–${visEnd} of ${data.length}`
                        : `${data.length} categor${data.length === 1 ? 'y' : 'ies'}`;
            }

            wrapper.removeEventListener('scroll', updateIndicator);
            wrapper.addEventListener('scroll', updateIndicator);

            createVirtualTable('categoryTableWrapper', 'categoryTableBody', data, (cat, idx) => {
                const border = idx > 0 ? 'border-top:1px solid var(--border-color);' : '';
                return `
                    <tr style="${border}height:${ROW_HEIGHT}px;">
                        <td style="padding:12px;">${cat.CategoryCode}</td>
                        <td style="padding:12px;">${truncate(cat.CategoryName)}</td>
                        <td style="padding:12px; white-space:nowrap;">
                            <div class="d-inline-flex gap-1">
                                <a href="/CategoryPages/Edit?categorycode=${encodeURIComponent(cat.CategoryCode)}" class="btn btn-warning btn-sm">Edit</a>
                                <a href="/CategoryPages/Details?categorycode=${encodeURIComponent(cat.CategoryCode)}" class="btn btn-info btn-sm">View</a>
                                <a href="/CategoryPages/Delete?categorycode=${encodeURIComponent(cat.CategoryCode)}" class="btn btn-danger btn-sm">Delete</a>
                            </div>
                        </td>
                    </tr>`;
            });
            updateIndicator();
        }

        renderTable(categories);
    </script>
}