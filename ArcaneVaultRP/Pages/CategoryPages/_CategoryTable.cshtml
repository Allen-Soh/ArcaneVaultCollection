@model ArcaneVaultRP.Pages.CategoryPages.IndexModel

<div class="border rounded overflow-hidden" style="position:relative;">
    <div style="overflow-y:auto;">
        <table class="table mb-0" style="width:100%;">
            <thead class="table-light" style="position:sticky; top:0; z-index:2;">
                <tr>
                    <th style="padding:12px;">Category Code</th>
                    <th style="padding:12px;">Category Name</th>
                    <th style="padding:12px; width: 1%;">Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var cat in Model.PagedCategories)
                {
                    <tr style="border-top:1px solid var(--border-color);">
                        <td style="padding:12px;">@cat.CategoryCode</td>
                        <td style="padding:12px;">@Model.Truncate(cat.CategoryName)</td>
                        <td style="padding:12px; white-space:nowrap;">
                            <div class="d-inline-flex gap-1">
                                <a href="/CategoryPages/Edit?categorycode=@Uri.EscapeDataString(cat.CategoryCode)" class="btn btn-warning btn-sm">Edit</a>
                                <a href="/CategoryPages/Details?categorycode=@Uri.EscapeDataString(cat.CategoryCode)" class="btn btn-info btn-sm">View</a>
                                <a href="/CategoryPages/Delete?categorycode=@Uri.EscapeDataString(cat.CategoryCode)" class="btn btn-danger btn-sm">Delete</a>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
    @if (!Model.PagedCategories.Any())
    {
        <div class="text-center text-muted py-4">
            No categories match your search.
        </div>
    }
</div>

@if (Model.TotalPages > 1)
{
    <nav class="mt-2">
        <ul class="pagination justify-content-center gap-2">
            @if (Model.CurrentPage > 1)
            {
                <li class="page-item">
                    <a class="page-link ajax-page-link pagination-box" href="#" data-page="@(Model.CurrentPage - 1)">&lt;</a>
                </li>
            }
            @if (Model.CurrentPage < Model.TotalPages)
            {
                <li class="page-item">
                    <a class="page-link ajax-page-link pagination-box" href="#" data-page="@(Model.CurrentPage + 1)">&gt;</a>
                </li>
            }
        </ul>
    </nav>
}
