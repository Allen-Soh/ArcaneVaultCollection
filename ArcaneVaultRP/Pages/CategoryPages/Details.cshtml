@page
@model ArcaneVaultRP.Pages.CategoryPages.DetailsModel
@{
    ViewData["Title"] = "Category Details";
}

<h1>Category Details</h1>
<hr />

<div class="row">
    <div class="col-md-5">
        <div class="card shadow-sm border-0 rounded-3">
            <div class="card-body p-4">

                <div class="mb-3">
                    <label class="form-label fw-semibold">Category Code</label>
                    <p class="form-control-plaintext">@Model.Category.CategoryCode</p>
                </div>

                <div class="mb-3">
                    <label class="form-label fw-semibold">Category Name</label>
                    <p class="form-control-plaintext">@Model.Category.CategoryName</p>
                </div>

                <div class="mt-4">
                    <a asp-page="./Edit"
                       asp-route-categorycode="@Model.Category.CategoryCode"
                       class="btn btn-warning me-2">Edit</a>
                    <a asp-page="./Index" class="btn btn-secondary">Back to List</a>
                </div>

            </div>
        </div>
    </div>
</div>