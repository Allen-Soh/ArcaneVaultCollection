@page
@model ArcaneVaultRP.Pages.InventoryPages.IndexModel
@{
    ViewData["Title"] = "Inventory";
}

<div class="container mt-4 mb-5">
    <h4 class="fw-bold mb-4">Inventory</h4>

    @if (!Model.Items.Any())
    {
        <div class="text-center text-muted py-5">
            <i class="bi bi-box-seam fs-1 d-block mb-2"></i>
            <span>You don't own any cosmetics yet. Visit the Shop to get started!</span>
        </div>
    }
    else
    {
        <div class="row row-cols-3 row-cols-md-6 g-3">
            @foreach (var item in Model.Items)
            {
                <div class="col">
                    <div class="card p-2 shop-cosmetic-card" style="cursor:pointer;aspect-ratio:1;display:flex;align-items:center;justify-content:center;"
                         onclick="openInventoryDetail(this)"
                         data-name="@item.CosmeticName"
                         data-image="@item.ImagePath"
                         data-type="@item.CosmeticType"
                         data-limited="@item.IsLimited.ToString().ToLower()"
                         data-copy="@item.CopyNumber"
                         data-cap="@item.LimitedQuantity">
                        @if (!string.IsNullOrEmpty(item.ImagePath))
                        {
                            <img src="@item.ImagePath" alt="@item.CosmeticName" style="max-width:100%;max-height:100%;object-fit:contain;" />
                        }
                        else
                        {
                            <div style="width:60%;height:60%;background:rgba(255,255,255,0.1);border-radius:8px;"></div>
                        }
                    </div>
                </div>
            }
        </div>
    }
</div>

<!-- Inventory item detail modal -->
<div class="modal fade" id="inventoryDetailModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content" style="background: var(--bg-card, #161b22); border: 1px solid var(--border-color, #30363d); border-radius: 14px;">
            <div class="modal-header border-bottom" style="border-color:var(--border-color,#21262d) !important;">
                <h5 class="modal-title fw-bold" id="inventoryDetailName"></h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <div class="d-flex justify-content-center mb-3" style="height:220px;">
                    <img id="inventoryDetailImage" src="" style="max-width:100%;max-height:100%;object-fit:contain;" />
                </div>
                <div class="d-flex justify-content-between align-items-center">
                    <span class="text-muted small" id="inventoryDetailType"></span>
                    <span id="inventoryDetailCopy" class="badge shop-limited-badge" style="display:none;"></span>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function openInventoryDetail(el) {
            document.getElementById('inventoryDetailName').textContent = el.dataset.name;
            document.getElementById('inventoryDetailImage').src = el.dataset.image || '';
            document.getElementById('inventoryDetailType').textContent = el.dataset.type;

            const copyEl = document.getElementById('inventoryDetailCopy');
            if (el.dataset.limited === 'true') {
                copyEl.textContent = `#${el.dataset.copy} of ${el.dataset.cap}`;
                copyEl.style.display = 'inline-block';
            } else {
                copyEl.style.display = 'none';
            }

            new bootstrap.Modal(document.getElementById('inventoryDetailModal')).show();
        }
    </script>
}
