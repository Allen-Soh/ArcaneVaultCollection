@page
@model ArcaneVaultRP.Pages.InsightPages.IndexModel
@{
    ViewData["Title"] = "Insights";
}

<div class="container mt-4" style="max-width:860px;">

    <!-- Header -->
    <div class="mb-4 animate-fade-in">
        <h2 class="fw-500 mb-1" style="font-size:24px; font-family: 'Outfit', sans-serif;">Insights Dashboard</h2>
        <p class="text-muted" style="font-size:13px;">Staff only · Data refreshes on each page load</p>
    </div>

    <!-- Rows -->
    <div class="animate-fade-in" style="border-top: 1px solid var(--border-color); border-bottom: 1px solid var(--border-color); background-color: var(--bg-card); border-radius: 12px; overflow: hidden; box-shadow: 0 4px 20px rgba(0,0,0,0.2);">

        <!-- Popular Items -->
        <a asp-page="./PopularItems"
           class="d-flex justify-content-between align-items-start py-3 px-3 text-decoration-none"
           style="border-bottom: 1px solid var(--border-color); transition: background 0.2s;"
           onmouseenter="this.style.background='var(--bg-card-hover)'"
           onmouseleave="this.style.background='transparent'">
            <div style="flex:1;">
                <div class="d-flex align-items-center gap-2 mb-1">
                    <i class="bi bi-trophy-fill text-warning" style="font-size:16px;"></i>
                    <span class="fw-bold" style="font-size:16px; color: var(--text-primary);">Popular items</span>
                </div>
                @{
                    var topItem = Model.PopularItems.FirstOrDefault();
                    var topCat  = Model.CategoryBreakdown.FirstOrDefault();
                }
                @if (topItem != null)
                {
                    <p class="mb-1 text-light" style="font-size:14px;">
                        Most owned: <strong class="text-white">@topItem.ItemName</strong>
                        <span class="text-muted">(@topItem.OwnerCount owners)</span>
                    </p>
                    <p class="mb-0 text-muted" style="font-size:13px;">
                        Top category: @(topCat?.CategoryName ?? "—") ·
                        @Model.PopularItems.Count items tracked across all users
                    </p>
                }
                else
                {
                    <p class="mb-0 text-muted" style="font-size:13px;">No item data yet.</p>
                }
            </div>
            <i class="bi bi-chevron-right text-muted ms-3 mt-1" style="font-size:15px;"></i>
        </a>

        <!-- User Activity -->
        <a asp-page="./UserActivity"
           class="d-flex justify-content-between align-items-start py-3 px-3 text-decoration-none"
           style="border-bottom: 1px solid var(--border-color); transition: background 0.2s;"
           onmouseenter="this.style.background='var(--bg-card-hover)'"
           onmouseleave="this.style.background='transparent'">
            <div style="flex:1;">
                <div class="d-flex align-items-center gap-2 mb-1">
                    <i class="bi bi-people-fill text-primary" style="font-size:16px; color: var(--color-periwinkle) !important;"></i>
                    <span class="fw-bold" style="font-size:16px; color: var(--text-primary);">User activity and engagement</span>
                </div>
                @{
                    var mostActive = Model.UserActivities
                        .OrderByDescending(u => u.TotalLogins)
                        .FirstOrDefault();
                }
                <p class="mb-1 text-light" style="font-size:14px;">
                    Active today: <strong>@Model.DAU</strong> ·
                    This week: <strong>@Model.WAU</strong> ·
                    This month: <strong>@Model.MAU</strong>
                </p>
                <p class="mb-0 text-muted" style="font-size:13px;">
                    Most active: @(mostActive?.UserName ?? "—") ·
                    Last login: @(mostActive?.LastLogin != null
                        ? DateTime.Parse(mostActive.LastLogin).ToString("dd MMM yyyy")
                        : "—")
                </p>
            </div>
            <i class="bi bi-chevron-right text-muted ms-3 mt-1" style="font-size:15px;"></i>
        </a>

        <!-- Market Demand -->
        <a asp-page="./MarketDemand"
           class="d-flex justify-content-between align-items-start py-3 px-3 text-decoration-none"
           style="border-bottom: 1px solid var(--border-color); transition: background 0.2s;"
           onmouseenter="this.style.background='var(--bg-card-hover)'"
           onmouseleave="this.style.background='transparent'">
            <div style="flex:1;">
                <div class="d-flex align-items-center gap-2 mb-1">
                    <i class="bi bi-graph-up-arrow text-success" style="font-size:16px; color: var(--color-lavender) !important;"></i>
                    <span class="fw-bold" style="font-size:16px; color: var(--text-primary);">Market demand and trends</span>
                </div>
                @{
                    var topMarket = Model.MarketDemand
                        .OrderByDescending(i => i.CurrentOwners)
                        .FirstOrDefault();
                    var topMarketCat = Model.MarketDemand
                        .GroupBy(i => i.CategoryName)
                        .OrderByDescending(g => g.Count())
                        .FirstOrDefault();
                }
                @if (topMarket != null)
                {
                    <p class="mb-1 text-light" style="font-size:14px;">
                        Trending: <strong class="text-white">@topMarket.ItemName</strong>
                        <span class="text-muted">(@topMarket.CurrentOwners owners in the last @Model.MarketDays days)</span>
                    </p>
                    <p class="mb-0 text-muted" style="font-size:13px;">
                        Most collected category this week: @(topMarketCat?.Key ?? "—")
                    </p>
                }
                else
                {
                    <p class="mb-0 text-muted" style="font-size:13px;">No market data yet.</p>
                }
            </div>
            <i class="bi bi-chevron-right text-muted ms-3 mt-1" style="font-size:15px;"></i>
        </a>

        <!-- Community Interest -->
        <a asp-page="./CommunityInterest"
           class="d-flex justify-content-between align-items-start py-3 px-3 text-decoration-none"
           style="transition: background 0.2s;"
           onmouseenter="this.style.background='var(--bg-card-hover)'"
           onmouseleave="this.style.background='transparent'">
            <div style="flex:1;">
                <div class="d-flex align-items-center gap-2 mb-1">
                    <i class="bi bi-heart-fill text-danger" style="font-size:16px;"></i>
                    <span class="fw-bold" style="font-size:16px; color: var(--text-primary);">Community interest</span>
                </div>
                @{
                    var totalViews = Model.CommunityInterest.MostViewed.Sum(s => s.ViewCount);
                    var totalLikes = Model.CommunityInterest.MostViewed.Sum(s => s.LikeCount);
                    var topSearch  = Model.SearchTrends.FirstOrDefault();
                    var topShowoff = Model.CommunityInterest.MostViewed.FirstOrDefault();
                }
                <p class="mb-1 text-light" style="font-size:14px;">
                    <strong>@totalViews</strong> showoff views this week ·
                    <strong>@totalLikes</strong> likes this week
                </p>
                <p class="mb-0 text-muted" style="font-size:13px;">
                    Most searched: "@(topSearch?.SearchTerm ?? "—")" ·
                    Most viewed showoff: "@(topShowoff?.ShowoffName ?? "—")"
                </p>
            </div>
            <i class="bi bi-chevron-right text-muted ms-3 mt-1" style="font-size:15px;"></i>
        </a>

    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script>
        // ════════════════════════════════════════════════
        // 1. SERVER DATA
        // ════════════════════════════════════════════════
        const popularItems = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.PopularItems));
        const categoryBreakdown = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.CategoryBreakdown));
        const marketDemand = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.MarketDemand));
        const marketOverTime = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.MarketDemandOverTime));
        const loginActivity = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.LoginActivity));
        const userActivities = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.UserActivities));
        const communityRaw = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.CommunityInterest));
        const searchTrends = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.SearchTrends));
        const communityOverTime = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.CommunityOverTime));

        // ════════════════════════════════════════════════
        // 2. EXTRACT COMMUNITY DATA — handle PascalCase + camelCase
        // ════════════════════════════════════════════════
        const mostLiked = communityRaw.MostLiked || communityRaw.mostLiked || [];
        const mostViewed = communityRaw.MostViewed || communityRaw.mostViewed || [];
        const catData = communityRaw.CategoryPopularity || communityRaw.categoryPopularity || [];

        // ════════════════════════════════════════════════
        // 3. CONSTANTS
        // ════════════════════════════════════════════════
        const colors = [
        '#4e79a7', '#f28e2b', '#e15759', '#76b7b2',
        '#59a14f', '#edc948', '#b07aa1', '#ff9da7',
        '#9c755f', '#bab0ac'
        ];

        // ════════════════════════════════════════════════
        // 4. HELPERS
        // ════════════════════════════════════════════════

        // Generic chart factory
        function makeChart(id, type, labels, data, label) {
        const ctx = document.getElementById(id);
        if (!ctx) return null;

        // Destroy existing chart on canvas if re-rendering
        const existing = Chart.getChart(ctx);
        if (existing) existing.destroy();

        return new Chart(ctx, {
        type,
        data: {
        labels,
        datasets: [{
        label,
        data,
        backgroundColor: type === 'line'
        ? 'rgba(78,121,167,0.15)'
        : colors,
        borderColor: type === 'line'
        ? '#4e79a7'
        : colors,
        borderWidth: type === 'line' ? 2 : 1,
        fill: type === 'line',
        tension: 0.4,
        pointRadius: type === 'line' ? 3 : 0
        }]
        },
        options: {
        indexAxis: type === 'bar' ? 'y' : 'x',
        responsive: true,
        plugins: {
        legend: { display: false },
        tooltip: { enabled: true }
        },
        scales: type !== 'doughnut' && type !== 'pie'
        ? {
        x: { beginAtZero: true },
        y: { beginAtZero: true }
        }
        : {}
        }
        });
        }

        // Show empty state inside a canvas container
        function showEmpty(id, message = 'No data yet.') {
        const ctx = document.getElementById(id);
        if (ctx) {
        ctx.style.display = 'none';
        const wrapper = ctx.parentElement;
        if (!wrapper.querySelector('.empty-state')) {
        const el = document.createElement('p');
        el.className = 'text-muted text-center py-3 empty-state';
        el.textContent = message;
        wrapper.appendChild(el);
        }
        }
        }

        // Render category trends as a table
        function renderCategoryTable(data, tbodyId) {
        const tbody = document.getElementById(tbodyId);
        if (!tbody) return;

        if (!data || data.length === 0) {
        tbody.innerHTML = `
        <tr>
        <td colspan="2" class="text-muted text-center py-3">
        No category data yet.
        </td>
        </tr>`;
        return;
        }

        tbody.innerHTML = data.map((c, i) => {
        const name = c.CategoryName || c.categoryName || 'Uncategorized';
        const count = c.UserCount || c.userCount || 0;
        return `
        <tr>
        <td>
        <span style="
        display:inline-block;
        width:10px;height:10px;
        border-radius:50%;
        background:${colors[i % colors.length]};
        margin-right:6px;">
        </span>
        ${name}
        </td>
        <td class="text-end fw-semibold">${count}</td>
        </tr>`;
        }).join('');
        }

        // ════════════════════════════════════════════════
        // 5. MINIMIZED CARD CHARTS — rendered on page load
        // ════════════════════════════════════════════════

        // Popular Items — horizontal bar
        if (popularItems.length > 0) {
        makeChart(
        'chartPopular', 'bar',
        popularItems.map(i => i.ItemName || i.itemName),
        popularItems.map(i => i.OwnerCount || i.ownerCount || 0),
        'Owners'
        );
        } else {
        showEmpty('chartPopular', 'No item data yet.');
        }

        // Market Demand — horizontal bar
        if (marketDemand.length > 0) {
        makeChart(
        'chartMarket', 'bar',
        marketDemand.map(i => i.ItemName || i.itemName),
        marketDemand.map(i => i.CurrentOwners || i.currentOwners || 0),
        'Owners'
        );
        } else {
        showEmpty('chartMarket', 'No market data yet.');
        }

        // User Activity — line chart
        if (loginActivity.length > 0) {
        makeChart(
        'chartActivity', 'line',
        loginActivity.map(d => d.Date || d.date),
        loginActivity.map(d => d.ActiveUsers || d.activeUsers || 0),
        'Active Users'
        );
        } else {
        showEmpty('chartActivity', 'No login activity yet.');
        }

        // Top Engaged Showoffs — horizontal bar (likes)
        if (mostLiked.length > 0) {
        makeChart(
        'chartEngaged', 'bar',
        mostLiked.map(s => s.ShowoffName || s.showoffName),
        mostLiked.map(s => s.LikeCount || s.likeCount || 0),
        'Likes'
        );
        } else {
        showEmpty('chartEngaged', 'No showoff data yet.');
        }

        // Category Trends — table
        renderCategoryTable(catData, 'categoryTrendsTableBody');

        // ════════════════════════════════════════════════
        // 6. EXPANDED MODAL CHARTS — rendered on modal open
        // ════════════════════════════════════════════════

        function renderExpandedCharts(modalId) {
        switch (modalId) {

        case 'modalPopular':
        // Top items bar chart
        if (popularItems.length > 0) {
        makeChart(
        'chartPopularExpanded', 'bar',
        popularItems.map(i => i.ItemName || i.itemName),
        popularItems.map(i => i.OwnerCount || i.ownerCount || 0),
        'Owners'
        );
        } else {
        showEmpty('chartPopularExpanded', 'No item data yet.');
        }

        // Category breakdown — doughnut if ≤6, bar otherwise
        if (categoryBreakdown.length > 0) {
        const catType = categoryBreakdown.length <= 6 ? 'doughnut' : 'bar';
        makeChart(
        'chartCategoryBreakdown', catType,
        categoryBreakdown.map(c => c.CategoryName || c.categoryName || 'Uncategorized'),
        categoryBreakdown.map(c => c.OwnerCount || c.ownerCount || 0),
        'Owners'
        );
        } else {
        showEmpty('chartCategoryBreakdown', 'No category data yet.');
        }
        break;

        case 'modalMarket':
        // Top items by owners
        if (marketDemand.length > 0) {
        makeChart(
        'chartMarketExpanded', 'bar',
        marketDemand.map(i => i.ItemName || i.itemName),
        marketDemand.map(i => i.CurrentOwners || i.currentOwners || 0),
        'Owners'
        );
        } else {
        showEmpty('chartMarketExpanded', 'No market data yet.');
        }

        // Active users over time
        if (marketOverTime.length > 0) {
        makeChart(
        'chartMarketOverTime', 'line',
        marketOverTime.map(d => d.Date || d.date),
        marketOverTime.map(d => d.ActiveUsers || d.activeUsers || 0),
        'Active Users'
        );
        } else {
        showEmpty('chartMarketOverTime', 'No trend data yet.');
        }
        break;

        case 'modalActivity':
        // Login activity line chart
        if (loginActivity.length > 0) {
        makeChart(
        'chartActivityExpanded', 'line',
        loginActivity.map(d => d.Date || d.date),
        loginActivity.map(d => d.ActiveUsers || d.activeUsers || 0),
        'Active Users'
        );
        } else {
        showEmpty('chartActivityExpanded', 'No login activity yet.');
        }
        // User breakdown table already rendered server-side via Razor
        break;

        case 'modalEngaged':
        // Top liked showoffs bar chart
        if (mostLiked.length > 0) {
        makeChart(
        'chartEngagedExpanded', 'bar',
        mostLiked.map(s => s.ShowoffName || s.showoffName),
        mostLiked.map(s => s.LikeCount || s.likeCount || 0),
        'Likes'
        );
        } else {
        showEmpty('chartEngagedExpanded', 'No showoff data yet.');
        }
        break;

        case 'modalCommunity':
        // Most searched terms bar chart
        if (searchTrends.length > 0) {
        makeChart(
        'chartSearchExpanded', 'bar',
        searchTrends.map(s => s.SearchTerm || s.searchTerm),
        searchTrends.map(s => s.Count || s.count || 0),
        'Searches'
        );
        } else {
        showEmpty('chartSearchExpanded', 'No search data yet.');
        }

        // Views over time line chart
        if (communityOverTime.length > 0) {
        makeChart(
        'chartCommunityOverTime', 'line',
        communityOverTime.map(d => d.Date || d.date),
        communityOverTime.map(d => d.Count || d.count || 0),
        'Views'
        );
        } else {
        showEmpty('chartCommunityOverTime', 'No view data yet.');
        }

        // Category trends expanded table
        
        case 'modalCatTrend':
        if (catData.length > 0) {
        makeChart(
        'chartCatTrendExpanded',
        catData.length <= 6 ? 'doughnut' : 'bar',
        catData.map(c => c.CategoryName || c.categoryName || 'Uncategorized'),
        catData.map(c => c.UserCount || c.userCount || 0),
        'Users'
        );
        renderCategoryTable(catData, 'categoryTrendsTableBodyExpanded');
        } else {
        showEmpty('chartCatTrendExpanded', 'No category data yet.');
        }
        break;
        }
        }

        // ════════════════════════════════════════════════
        // 7. EXPAND CARD — open modal + render expanded charts
        // ════════════════════════════════════════════════
        function expandCard(modalId) {
        const modal = new bootstrap.Modal(document.getElementById(modalId));
        modal.show();

        document.getElementById(modalId).addEventListener(
        'shown.bs.modal',
        function () { renderExpandedCharts(modalId); },
        { once: true }
        );
        }

        // ════════════════════════════════════════════════
        // 8. SECTION TOGGLES
        // ════════════════════════════════════════════════
        function toggleSection(cardId, checkbox) {
        document.getElementById(cardId).style.display = checkbox.checked ? '' : 'none';

        const allChecks = document.querySelectorAll('.section-check');
        const allChecked = Array.from(allChecks).every(c => c.checked);
        const anyChecked = Array.from(allChecks).some(c => c.checked);

        const showAll = document.getElementById('showAll');
        showAll.checked = allChecked;
        showAll.indeterminate = !allChecked && anyChecked;
        }

        function toggleAll(checkbox) {
        document.querySelectorAll('.section-check').forEach(c => {
        c.checked = checkbox.checked;
        });
        ['cardPopular', 'cardMarket', 'cardActivity', 'cardEngaged', 'cardCommunity']
        .forEach(id => {
        document.getElementById(id).style.display = checkbox.checked ? '' : 'none';
        });
        }

        // ════════════════════════════════════════════════
        // 9. CATEGORY FILTER FOR POPULAR ITEMS
        // ════════════════════════════════════════════════
        function filterPopularByCategory(category) {
        const filtered = category
        ? popularItems.filter(i =>
        (i.CategoryName || i.categoryName || '') === category)
        : popularItems;

        makeChart(
        'chartPopular', 'bar',
        filtered.map(i => i.ItemName || i.itemName),
        filtered.map(i => i.OwnerCount || i.ownerCount || 0),
        'Owners'
        );
        }

        // ════════════════════════════════════════════════
        // 10. CATEGORY FILTER FOR MARKET DEMAND
        // ════════════════════════════════════════════════
        function filterMarketByCategory(category) {
        const filtered = category
        ? marketDemand.filter(i =>
        (i.CategoryName || i.categoryName || '') === category)
        : marketDemand;

        makeChart(
        'chartMarket', 'bar',
        filtered.map(i => i.ItemName || i.itemName),
        filtered.map(i => i.CurrentOwners || i.currentOwners || 0),
        'Owners'
        );
        }
    </script>
}