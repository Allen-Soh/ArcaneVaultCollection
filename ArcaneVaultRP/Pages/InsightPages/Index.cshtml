@page
@model ArcaneVaultRP.Pages.InsightPages.IndexModel
@{
    ViewData["Title"] = "Insights";
    var marketDays = Model.MarketDays;
    var communityDays = Model.CommunityDays;
}

<div class="container mt-4">
    <h2 class="fw-bold mb-1">Insights</h2>
    <p class="text-muted small mb-3">Staff only</p>

    <!-- Filters Button -->
    <button class="btn btn-outline-secondary btn-sm d-flex align-items-center gap-2 mb-3"
            type="button"
            data-bs-toggle="collapse"
            data-bs-target="#filtersPanel">
        <i class="bi bi-funnel"></i> Filters
        <i class="bi bi-chevron-down"></i>
    </button>

    <!-- Filters Panel -->
    <div class="collapse mb-4" id="filtersPanel">
        <div class="card card-body border-0 shadow-sm">

            <!-- Search bars -->
            <p class="text-muted small mb-2">Search</p>
            <div class="row g-2 mb-3">
                <div class="col-md-4">
                    <input type="text" class="form-control form-control-sm"
                           placeholder="Search users" id="filterUser" />
                </div>
                <div class="col-md-4">
                    <input type="text" class="form-control form-control-sm"
                           placeholder="Search items" id="filterItem" />
                </div>
                <div class="col-md-4">
                    <input type="text" class="form-control form-control-sm"
                           placeholder="Search categories" id="filterCategory" />
                </div>
            </div>

            <!-- Show sections -->
            <p class="text-muted small mb-2">Show sections</p>
            <div class="border-bottom pb-2 mb-2">
                <div class="form-check">
                    <input class="form-check-input" type="checkbox" id="showAll"
                           checked onchange="toggleAll(this)" />
                    <label class="form-check-label fw-semibold" for="showAll">Show all</label>
                </div>
            </div>
            <div class="row g-1">
                <div class="col-md-3">
                    <div class="form-check">
                        <input class="form-check-input section-check" type="checkbox"
                               id="chkPopular" checked
                               data-target="cardPopular"
                               onchange="toggleSection(this)" />
                        <label class="form-check-label small" for="chkPopular">Popular items</label>
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="form-check">
                        <input class="form-check-input section-check" type="checkbox"
                               id="chkRising" checked
                               data-target="cardRising"
                               onchange="toggleSection(this)" />
                        <label class="form-check-label small" for="chkRising">Rising / declining</label>
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="form-check">
                        <input class="form-check-input section-check" type="checkbox"
                               id="chkCatTrend" checked
                               data-target="cardCatTrend"
                               onchange="toggleSection(this)" />
                        <label class="form-check-label small" for="chkCatTrend">Category trends</label>
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="form-check">
                        <input class="form-check-input section-check" type="checkbox"
                               id="chkActive" checked
                               data-target="cardActive"
                               onchange="toggleSection(this)" />
                        <label class="form-check-label small" for="chkActive">Active users</label>
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="form-check">
                        <input class="form-check-input section-check" type="checkbox"
                               id="chkEngaged" checked
                               data-target="cardEngaged"
                               onchange="toggleSection(this)" />
                        <label class="form-check-label small" for="chkEngaged">Top engaged showoffs</label>
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="form-check">
                        <input class="form-check-input section-check" type="checkbox"
                               id="chkSearched" checked
                               data-target="cardSearched"
                               onchange="toggleSection(this)" />
                        <label class="form-check-label small" for="chkSearched">Most-searched terms</label>
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="form-check">
                        <input class="form-check-input section-check" type="checkbox"
                               id="chkViewed" checked
                               data-target="cardViewed"
                               onchange="toggleSection(this)" />
                        <label class="form-check-label small" for="chkViewed">Most-viewed</label>
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="form-check">
                        <input class="form-check-input section-check" type="checkbox"
                               id="chkCatPop" checked
                               data-target="cardCatPop"
                               onchange="toggleSection(this)" />
                        <label class="form-check-label small" for="chkCatPop">Category popularity</label>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Popular Items -->
    <p class="text-muted small fw-semibold mb-2">Popular items</p>
    <div class="card border-0 shadow-sm mb-4 position-relative" id="cardPopular">
        <div class="card-header bg-transparent border-0 d-flex justify-content-between align-items-center">
            <h6 class="fw-bold mb-0">Top 10 items</h6>
            <div class="d-flex gap-2 align-items-center">
                <select class="form-select form-select-sm" style="width:auto;"
                        id="popularCategoryFilter" onchange="filterPopularByCategory(this.value)">
                    <option value="">All Categories</option>
                    @foreach (var cat in Model.CategoryBreakdown)
                    {
                        <option value="@cat.CategoryName">@cat.CategoryName</option>
                    }
                </select>
                <button class="btn btn-sm btn-outline-secondary"
                        onclick="expandCard('modalPopular')">
                    <i class="bi bi-arrows-fullscreen"></i>
                </button>
            </div>
        </div>
        <div class="card-body">
            <canvas id="chartPopular" height="120"></canvas>
        </div>
    </div>

    <!-- Market Demand and Trends -->
    <p class="text-muted small fw-semibold mb-2">Market demand and trends</p>
    <div class="row g-3 mb-4">
        <div class="col-md-6" id="cardRising">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-header bg-transparent border-0 d-flex justify-content-between align-items-center">
                    <h6 class="fw-bold mb-0">Rising / Declining</h6>
                    <div class="d-flex gap-2 align-items-center">
                        <select class="form-select form-select-sm" style="width:auto;"
                                onchange="window.location.href='?MarketDays=' + this.value + '&CommunityDays=@communityDays'">
                            <option value="7" selected ="@(Model.CommunityDays == 7)">7 days</option>
                            <option value="30" selected ="@(Model.CommunityDays == 30)">30 days</option>
                        </select>
                        <button class="btn btn-sm btn-outline-secondary"
                                onclick="expandCard('modalMarket')">
                            <i class="bi bi-arrows-fullscreen"></i>
                        </button>
                    </div>
                </div>
                <div class="card-body">
                    <canvas id="chartMarket" height="180"></canvas>
                </div>
            </div>
        </div>
        <div class="col-md-6" id="cardCatTrend">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-header bg-transparent border-0 d-flex justify-content-between align-items-center">
                    <h6 class="fw-bold mb-0">Category Trends</h6>
                    <button class="btn btn-sm btn-outline-secondary"
                            onclick="expandCard('modalCatTrend')">
                        <i class="bi bi-arrows-fullscreen"></i>
                    </button>
                </div>
                <div class="card-body">
                    <canvas id="chartCatTrend" height="180"></canvas>
                </div>
            </div>
        </div>
    </div>

    <!-- User Activity and Engagement -->
    <p class="text-muted small fw-semibold mb-2">User activity and engagement</p>
    <div class="row g-3 mb-4">
        <div class="col-md-6" id="cardActive">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-header bg-transparent border-0 d-flex justify-content-between align-items-center">
                    <h6 class="fw-bold mb-0">Active Users (DAU / WAU / MAU)</h6>
                    <button class="btn btn-sm btn-outline-secondary"
                            onclick="expandCard('modalActivity')">
                        <i class="bi bi-arrows-fullscreen"></i>
                    </button>
                </div>
                <div class="card-body">
                    <div class="d-flex gap-4 mb-3">
                        <div class="text-center">
                            <div class="fw-bold fs-5">@Model.DAU</div>
                            <small class="text-muted">DAU</small>
                        </div>
                        <div class="text-center">
                            <div class="fw-bold fs-5">@Model.WAU</div>
                            <small class="text-muted">WAU</small>
                        </div>
                        <div class="text-center">
                            <div class="fw-bold fs-5">@Model.MAU</div>
                            <small class="text-muted">MAU</small>
                        </div>
                    </div>
                    <canvas id="chartActivity" height="150"></canvas>
                </div>
            </div>
        </div>
        <div class="col-md-6" id="cardEngaged">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-header bg-transparent border-0 d-flex justify-content-between align-items-center">
                    <h6 class="fw-bold mb-0">Top Engaged Showoffs</h6>
                    <div class="d-flex gap-2 align-items-center">
                        <select class="form-select form-select-sm" style="width:auto;"
                                id="engagedCategoryFilter" onchange="filterEngagedByCategory(this.value)">
                            <option value="">All Categories</option>
                            @foreach (var cat in Model.CategoryBreakdown)
                            {
                                <option value="@cat.CategoryName">@cat.CategoryName</option>
                            }
                        </select>
                        <button class="btn btn-sm btn-outline-secondary"
                                onclick="expandCard('modalEngaged')">
                            <i class="bi bi-arrows-fullscreen"></i>
                        </button>
                    </div>
                </div>
                <div class="card-body">
                    <canvas id="chartEngaged" height="150"></canvas>
                </div>
            </div>
        </div>
    </div>

    <!-- Community Interest -->
    <p class="text-muted small fw-semibold mb-2">Community interest</p>
    <div class="row g-3 mb-4">
        <div class="col-md-4" id="cardSearched">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-header bg-transparent border-0 d-flex justify-content-between align-items-center">
                    <h6 class="fw-bold mb-0">Most-searched terms</h6>
                    <button class="btn btn-sm btn-outline-secondary"
                            onclick="expandCard('modalCommunity')">
                        <i class="bi bi-arrows-fullscreen"></i>
                    </button>
                </div>
                <div class="card-body">
                    <canvas id="chartSearched" height="180"></canvas>
                </div>
            </div>
        </div>
        <div class="col-md-4" id="cardViewed">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-header bg-transparent border-0 d-flex justify-content-between align-items-center">
                    <h6 class="fw-bold mb-0">Most-viewed</h6>
                    <div class="d-flex gap-2 align-items-center">
                        <select class="form-select form-select-sm" style="width:auto;"
                                onchange="window.location.href='?MarketDays=@marketDays&CommunityDays=' + this.value">
                            <option value="7" selected="@(Model.CommunityDays == 7)">7 days</option>
                            <option value="30" selected ="@(Model.CommunityDays == 30)">30 days</option>
                        </select>
                        <button class="btn btn-sm btn-outline-secondary"
                                onclick="expandCard('modalCommunity')">
                            <i class="bi bi-arrows-fullscreen"></i>
                        </button>
                    </div>
                </div>
                <div class="card-body">
                    <canvas id="chartViewed" height="180"></canvas>
                </div>
            </div>
        </div>
        <div class="col-md-4" id="cardCatPop">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-header bg-transparent border-0 d-flex justify-content-between align-items-center">
                    <h6 class="fw-bold mb-0">Category popularity</h6>
                    <button class="btn btn-sm btn-outline-secondary"
                            onclick="expandCard('modalCommunity')">
                        <i class="bi bi-arrows-fullscreen"></i>
                    </button>
                </div>
                <div class="card-body">
                    <canvas id="chartCatPop" height="180"></canvas>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Expanded Modals -->

<!-- Popular Items Modal -->
<div class="modal fade" id="modalPopular" tabindex="-1">
    <div class="modal-dialog modal-xl modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header border-0">
                <h5 class="fw-bold">Popular Items — Detail</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <div class="row g-4">
                    <div class="col-md-6">
                        <h6 class="fw-semibold mb-3">Top 10 Items by Owner Count</h6>
                        <canvas id="chartPopularExpanded"></canvas>
                    </div>
                    <div class="col-md-6">
                        <h6 class="fw-semibold mb-3">Category Breakdown</h6>
                        <canvas id="chartCategoryBreakdown"></canvas>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Market Demand Modal -->
<div class="modal fade" id="modalMarket" tabindex="-1">
    <div class="modal-dialog modal-xl modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header border-0">
                <h5 class="fw-bold">Market Demand — Detail</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <div class="row g-4">
                    <div class="col-md-6">
                        <h6 class="fw-semibold mb-3">Top Items by Owners</h6>
                        <canvas id="chartMarketExpanded"></canvas>
                    </div>
                    <div class="col-md-6">
                        <h6 class="fw-semibold mb-3">Active Users Over Time</h6>
                        <canvas id="chartMarketOverTime"></canvas>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Category Trends Modal -->
<div class="modal fade" id="modalCatTrend" tabindex="-1">
    <div class="modal-dialog modal-xl modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header border-0">
                <h5 class="fw-bold">Category Trends — Detail</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <div class="row g-4">
                    <div class="col-md-6">
                        <h6 class="fw-semibold mb-3">Category Popularity Chart</h6>
                        <canvas id="chartCatTrendExpanded"></canvas>
                    </div>
                    <div class="col-md-6">
                        <h6 class="fw-semibold mb-3">Category Breakdown</h6>
                        <div style="max-height:300px;overflow-y:auto;">
                            <table class="table table-sm table-hover mb-0">
                                <thead class="table-light sticky-top">
                                    <tr>
                                        <th>Category</th>
                                        <th class="text-end">Users</th>
                                    </tr>
                                </thead>
                                <tbody id="categoryTrendsTableBodyExpanded"></tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- User Activity Modal -->
<div class="modal fade" id="modalActivity" tabindex="-1">
    <div class="modal-dialog modal-xl modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header border-0">
                <h5 class="fw-bold">User Activity — Detail</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <div class="row g-4">
                    <div class="col-md-6">
                        <h6 class="fw-semibold mb-3">Login Activity (Last 30 Days)</h6>
                        <canvas id="chartActivityExpanded"></canvas>
                    </div>
                    <div class="col-md-6">
                        <h6 class="fw-semibold mb-3">User Breakdown</h6>
                        <div style="max-height:300px;overflow-y:auto;">
                            <table class="table table-sm">
                                <thead>
                                    <tr>
                                        <th>User</th>
                                        <th>Logins</th>
                                        <th>Showoffs</th>
                                        <th>Last Login</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var user in Model.UserActivities)
                                    {
                                        <tr>
                                            <td>@user.UserName</td>
                                            <td>@user.TotalLogins</td>
                                            <td>@user.TotalShowoffs</td>
                                            <td class="text-muted small">
                                                @(user.LastLogin != null
                                                    ? DateTime.Parse(user.LastLogin).ToString("dd MMM yyyy")
                                                    : "Never")
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Top Engaged Showoffs Modal -->
<div class="modal fade" id="modalEngaged" tabindex="-1">
    <div class="modal-dialog modal-xl modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header border-0">
                <h5 class="fw-bold">Top Engaged Showoffs — Detail</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <canvas id="chartEngagedExpanded"></canvas>
            </div>
        </div>
    </div>
</div>

<!-- Community Interest Modal -->
<div class="modal fade" id="modalCommunity" tabindex="-1">
    <div class="modal-dialog modal-xl modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header border-0">
                <h5 class="fw-bold">Community Interest — Detail</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <div class="row g-4">
                    <div class="col-md-4">
                        <h6 class="fw-semibold mb-3">Most Searched Terms</h6>
                        <canvas id="chartSearchExpanded"></canvas>
                    </div>
                    <div class="col-md-4">
                        <h6 class="fw-semibold mb-3">Most Viewed Showoffs</h6>
                        <canvas id="chartViewsExpanded"></canvas>
                    </div>
                    <div class="col-md-4">
                        <h6 class="fw-semibold mb-3">Category Popularity</h6>
                        <canvas id="chartCatPopExpanded"></canvas>
                    </div>
                </div>
                <div class="mt-4">
                    <h6 class="fw-semibold mb-3">Views Over Time</h6>
                    <canvas id="chartCommunityOverTime"></canvas>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script>
        // ════════════════════════════════════════════════
        // 1. SERVER DATA
        // ════════════════════════════════════════════════
        const popularItems = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.PopularItems));
        const categoryBreakdown = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.CategoryBreakdown));
        const marketDemand = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.MarketDemand));
        const marketOverTime = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.MarketDemandOverTime));
        const loginActivity = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.LoginActivity));
        const userActivities = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.UserActivities));
        const communityRaw = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.CommunityInterest));
        const searchTrends = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.SearchTrends));
        const communityOverTime = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.CommunityOverTime));

        // ════════════════════════════════════════════════
        // 2. EXTRACT COMMUNITY DATA — handle PascalCase + camelCase
        // ════════════════════════════════════════════════
        const mostLiked = communityRaw.MostLiked || communityRaw.mostLiked || [];
        const mostViewed = communityRaw.MostViewed || communityRaw.mostViewed || [];
        const catData = communityRaw.CategoryPopularity || communityRaw.categoryPopularity || [];

        // ════════════════════════════════════════════════
        // 3. CONSTANTS
        // ════════════════════════════════════════════════
        const colors = [
        '#4e79a7', '#f28e2b', '#e15759', '#76b7b2',
        '#59a14f', '#edc948', '#b07aa1', '#ff9da7',
        '#9c755f', '#bab0ac'
        ];

        // ════════════════════════════════════════════════
        // 4. HELPERS
        // ════════════════════════════════════════════════

        // Generic chart factory
        function makeChart(id, type, labels, data, label) {
        const ctx = document.getElementById(id);
        if (!ctx) return null;

        // Destroy existing chart on canvas if re-rendering
        const existing = Chart.getChart(ctx);
        if (existing) existing.destroy();

        return new Chart(ctx, {
        type,
        data: {
        labels,
        datasets: [{
        label,
        data,
        backgroundColor: type === 'line'
        ? 'rgba(78,121,167,0.15)'
        : colors,
        borderColor: type === 'line'
        ? '#4e79a7'
        : colors,
        borderWidth: type === 'line' ? 2 : 1,
        fill: type === 'line',
        tension: 0.4,
        pointRadius: type === 'line' ? 3 : 0
        }]
        },
        options: {
        indexAxis: type === 'bar' ? 'y' : 'x',
        responsive: true,
        plugins: {
        legend: { display: false },
        tooltip: { enabled: true }
        },
        scales: type !== 'doughnut' && type !== 'pie'
        ? {
        x: { beginAtZero: true },
        y: { beginAtZero: true }
        }
        : {}
        }
        });
        }

        // Show empty state inside a canvas container
        function showEmpty(id, message = 'No data yet.') {
        const ctx = document.getElementById(id);
        if (ctx) {
        ctx.style.display = 'none';
        const wrapper = ctx.parentElement;
        if (!wrapper.querySelector('.empty-state')) {
        const el = document.createElement('p');
        el.className = 'text-muted text-center py-3 empty-state';
        el.textContent = message;
        wrapper.appendChild(el);
        }
        }
        }

        // Render category trends as a table
        function renderCategoryTable(data, tbodyId) {
        const tbody = document.getElementById(tbodyId);
        if (!tbody) return;

        if (!data || data.length === 0) {
        tbody.innerHTML = `
        <tr>
        <td colspan="2" class="text-muted text-center py-3">
        No category data yet.
        </td>
        </tr>`;
        return;
        }

        tbody.innerHTML = data.map((c, i) => {
        const name = c.CategoryName || c.categoryName || 'Uncategorized';
        const count = c.UserCount || c.userCount || 0;
        return `
        <tr>
        <td>
        <span style="
        display:inline-block;
        width:10px;height:10px;
        border-radius:50%;
        background:${colors[i % colors.length]};
        margin-right:6px;">
        </span>
        ${name}
        </td>
        <td class="text-end fw-semibold">${count}</td>
        </tr>`;
        }).join('');
        }

        // ════════════════════════════════════════════════
        // 5. MINIMIZED CARD CHARTS — rendered on page load
        // ════════════════════════════════════════════════

        // Popular Items — horizontal bar
        if (popularItems.length > 0) {
        makeChart(
        'chartPopular', 'bar',
        popularItems.map(i => i.ItemName || i.itemName),
        popularItems.map(i => i.OwnerCount || i.ownerCount || 0),
        'Owners'
        );
        } else {
        showEmpty('chartPopular', 'No item data yet.');
        }

        // Market Demand — horizontal bar
        if (marketDemand.length > 0) {
        makeChart(
        'chartMarket', 'bar',
        marketDemand.map(i => i.ItemName || i.itemName),
        marketDemand.map(i => i.CurrentOwners || i.currentOwners || 0),
        'Owners'
        );
        } else {
        showEmpty('chartMarket', 'No market data yet.');
        }

        // User Activity — line chart
        if (loginActivity.length > 0) {
        makeChart(
        'chartActivity', 'line',
        loginActivity.map(d => d.Date || d.date),
        loginActivity.map(d => d.ActiveUsers || d.activeUsers || 0),
        'Active Users'
        );
        } else {
        showEmpty('chartActivity', 'No login activity yet.');
        }

        // Top Engaged Showoffs — horizontal bar (likes)
        if (mostLiked.length > 0) {
        makeChart(
        'chartEngaged', 'bar',
        mostLiked.map(s => s.ShowoffName || s.showoffName),
        mostLiked.map(s => s.LikeCount || s.likeCount || 0),
        'Likes'
        );
        } else {
        showEmpty('chartEngaged', 'No showoff data yet.');
        }

        // Category Trends — table
        renderCategoryTable(catData, 'categoryTrendsTableBody');

        // ════════════════════════════════════════════════
        // 6. EXPANDED MODAL CHARTS — rendered on modal open
        // ════════════════════════════════════════════════

        function renderExpandedCharts(modalId) {
        switch (modalId) {

        case 'modalPopular':
        // Top items bar chart
        if (popularItems.length > 0) {
        makeChart(
        'chartPopularExpanded', 'bar',
        popularItems.map(i => i.ItemName || i.itemName),
        popularItems.map(i => i.OwnerCount || i.ownerCount || 0),
        'Owners'
        );
        } else {
        showEmpty('chartPopularExpanded', 'No item data yet.');
        }

        // Category breakdown — doughnut if ≤6, bar otherwise
        if (categoryBreakdown.length > 0) {
        const catType = categoryBreakdown.length <= 6 ? 'doughnut' : 'bar';
        makeChart(
        'chartCategoryBreakdown', catType,
        categoryBreakdown.map(c => c.CategoryName || c.categoryName || 'Uncategorized'),
        categoryBreakdown.map(c => c.OwnerCount || c.ownerCount || 0),
        'Owners'
        );
        } else {
        showEmpty('chartCategoryBreakdown', 'No category data yet.');
        }
        break;

        case 'modalMarket':
        // Top items by owners
        if (marketDemand.length > 0) {
        makeChart(
        'chartMarketExpanded', 'bar',
        marketDemand.map(i => i.ItemName || i.itemName),
        marketDemand.map(i => i.CurrentOwners || i.currentOwners || 0),
        'Owners'
        );
        } else {
        showEmpty('chartMarketExpanded', 'No market data yet.');
        }

        // Active users over time
        if (marketOverTime.length > 0) {
        makeChart(
        'chartMarketOverTime', 'line',
        marketOverTime.map(d => d.Date || d.date),
        marketOverTime.map(d => d.ActiveUsers || d.activeUsers || 0),
        'Active Users'
        );
        } else {
        showEmpty('chartMarketOverTime', 'No trend data yet.');
        }
        break;

        case 'modalActivity':
        // Login activity line chart
        if (loginActivity.length > 0) {
        makeChart(
        'chartActivityExpanded', 'line',
        loginActivity.map(d => d.Date || d.date),
        loginActivity.map(d => d.ActiveUsers || d.activeUsers || 0),
        'Active Users'
        );
        } else {
        showEmpty('chartActivityExpanded', 'No login activity yet.');
        }
        // User breakdown table already rendered server-side via Razor
        break;

        case 'modalEngaged':
        // Top liked showoffs bar chart
        if (mostLiked.length > 0) {
        makeChart(
        'chartEngagedExpanded', 'bar',
        mostLiked.map(s => s.ShowoffName || s.showoffName),
        mostLiked.map(s => s.LikeCount || s.likeCount || 0),
        'Likes'
        );
        } else {
        showEmpty('chartEngagedExpanded', 'No showoff data yet.');
        }
        break;

        case 'modalCommunity':
        // Most searched terms bar chart
        if (searchTrends.length > 0) {
        makeChart(
        'chartSearchExpanded', 'bar',
        searchTrends.map(s => s.SearchTerm || s.searchTerm),
        searchTrends.map(s => s.Count || s.count || 0),
        'Searches'
        );
        } else {
        showEmpty('chartSearchExpanded', 'No search data yet.');
        }

        // Views over time line chart
        if (communityOverTime.length > 0) {
        makeChart(
        'chartCommunityOverTime', 'line',
        communityOverTime.map(d => d.Date || d.date),
        communityOverTime.map(d => d.Count || d.count || 0),
        'Views'
        );
        } else {
        showEmpty('chartCommunityOverTime', 'No view data yet.');
        }

        // Category trends expanded table
        
        case 'modalCatTrend':
        if (catData.length > 0) {
        makeChart(
        'chartCatTrendExpanded',
        catData.length <= 6 ? 'doughnut' : 'bar',
        catData.map(c => c.CategoryName || c.categoryName || 'Uncategorized'),
        catData.map(c => c.UserCount || c.userCount || 0),
        'Users'
        );
        renderCategoryTable(catData, 'categoryTrendsTableBodyExpanded');
        } else {
        showEmpty('chartCatTrendExpanded', 'No category data yet.');
        }
        break;
        }
        }

        // ════════════════════════════════════════════════
        // 7. EXPAND CARD — open modal + render expanded charts
        // ════════════════════════════════════════════════
        function expandCard(modalId) {
        const modal = new bootstrap.Modal(document.getElementById(modalId));
        modal.show();

        document.getElementById(modalId).addEventListener(
        'shown.bs.modal',
        function () { renderExpandedCharts(modalId); },
        { once: true }
        );
        }

        // ════════════════════════════════════════════════
        // 8. SECTION TOGGLES
        // ════════════════════════════════════════════════
        function toggleSection(cardId, checkbox) {
        document.getElementById(cardId).style.display = checkbox.checked ? '' : 'none';

        const allChecks = document.querySelectorAll('.section-check');
        const allChecked = Array.from(allChecks).every(c => c.checked);
        const anyChecked = Array.from(allChecks).some(c => c.checked);

        const showAll = document.getElementById('showAll');
        showAll.checked = allChecked;
        showAll.indeterminate = !allChecked && anyChecked;
        }

        function toggleAll(checkbox) {
        document.querySelectorAll('.section-check').forEach(c => {
        c.checked = checkbox.checked;
        });
        ['cardPopular', 'cardMarket', 'cardActivity', 'cardEngaged', 'cardCommunity']
        .forEach(id => {
        document.getElementById(id).style.display = checkbox.checked ? '' : 'none';
        });
        }

        // ════════════════════════════════════════════════
        // 9. CATEGORY FILTER FOR POPULAR ITEMS
        // ════════════════════════════════════════════════
        function filterPopularByCategory(category) {
        const filtered = category
        ? popularItems.filter(i =>
        (i.CategoryName || i.categoryName || '') === category)
        : popularItems;

        makeChart(
        'chartPopular', 'bar',
        filtered.map(i => i.ItemName || i.itemName),
        filtered.map(i => i.OwnerCount || i.ownerCount || 0),
        'Owners'
        );
        }

        // ════════════════════════════════════════════════
        // 10. CATEGORY FILTER FOR MARKET DEMAND
        // ════════════════════════════════════════════════
        function filterMarketByCategory(category) {
        const filtered = category
        ? marketDemand.filter(i =>
        (i.CategoryName || i.categoryName || '') === category)
        : marketDemand;

        makeChart(
        'chartMarket', 'bar',
        filtered.map(i => i.ItemName || i.itemName),
        filtered.map(i => i.CurrentOwners || i.currentOwners || 0),
        'Owners'
        );
        }
    </script>
}