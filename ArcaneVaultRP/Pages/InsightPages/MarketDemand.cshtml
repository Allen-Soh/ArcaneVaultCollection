@page
@model ArcaneVaultRP.Pages.InsightPages.MarketDemandModel
@{
    ViewData["Title"] = "Market Demand";
}

<div class="container mt-4" style="max-width:860px;">

    <!-- Back link + Header -->
    <div class="mb-1">
        <a asp-page="./Index" class="text-decoration-none d-inline-flex align-items-center gap-1"
           style="font-size:13px;">
            <i class="bi bi-arrow-left" style="font-size:13px;"></i> Insights
        </a>
    </div>

    <div class="d-flex justify-content-between align-items-center mb-1">
        <h1 style="font-size:22px;font-weight:500;margin:0;">Market demand and trends</h1>
        <select id="periodSelect" onchange="renderAll()"
                class="form-select form-select-sm" style="width:auto;">
            <option value="7">Last 7 days</option>
            <option value="30">Last 30 days</option>
        </select>
    </div>
    <p class="text-muted mb-4" style="font-size:13px;">
        Collection quantity changes across all users
    </p>

    <!-- Summary cards -->
    <div class="row g-3 mb-4">
        <div class="col-4">
            <div class="rounded p-3" style="background:#f8f9fa;">
                <p class="text-muted mb-1" style="font-size:12px;">Rising items</p>
                <p class="mb-0 fw-500" id="risingCount" style="font-size:22px;color:#0F6E56;">—</p>
            </div>
        </div>
        <div class="col-4">
            <div class="rounded p-3" style="background:#f8f9fa;">
                <p class="text-muted mb-1" style="font-size:12px;">Declining items</p>
                <p class="mb-0 fw-500" id="decliningCount" style="font-size:22px;color:#A32D2D;">—</p>
            </div>
        </div>
        <div class="col-4">
            <div class="rounded p-3" style="background:#f8f9fa;">
                <p class="text-muted mb-1" style="font-size:12px;">Net platform change</p>
                <p class="mb-0 fw-500" id="netChange" style="font-size:22px;">—</p>
            </div>
        </div>
    </div>

    <!-- Rising vs Declining chart -->
    <div class="border-top pt-4 mb-4">
        <p class="fw-500 mb-1" style="font-size:15px;">Rising vs Declining — Top 10</p>
        <p class="text-muted mb-3" style="font-size:13px;">Items ranked by absolute % change</p>

        <div class="d-flex justify-content-center gap-4 mb-2">
            <span style="font-size:11px;" class="text-muted d-flex align-items-center gap-1">
                <span style="display:inline-block;width:10px;height:10px;border-radius:2px;background:#1D9E75;"></span>
                Rising
            </span>
            <span style="font-size:11px;" class="text-muted d-flex align-items-center gap-1">
                <span style="display:inline-block;width:10px;height:10px;border-radius:2px;background:#E24B4A;"></span>
                Declining
            </span>
        </div>

        <div class="d-flex justify-content-between mb-2">
            <span class="text-muted" style="font-size:11px;">← Declining</span>
            <span class="text-muted" style="font-size:11px;">0%</span>
            <span class="text-muted" style="font-size:11px;">Rising →</span>
        </div>

        <div id="chartRows" style="display:flex;flex-direction:column;gap:6px;"></div>

        <div class="d-flex justify-content-end mt-3">
            <button id="toggleBtn" onclick="toggleTable()"
                    class="btn btn-link p-0 text-decoration-none d-flex align-items-center gap-1"
                    style="font-size:13px;">
                See more <i class="bi bi-arrow-right" style="font-size:13px;"></i>
            </button>
        </div>

        <!-- Expandable full table -->
        <div id="tableSection" style="display:none;" class="mt-3">
            <div class="d-flex gap-2 mb-3 flex-wrap">
                <div class="d-flex border rounded overflow-hidden" style="background:#f8f9fa;">
                    <select id="operator" onchange="applyFilters()"
                            class="border-0 border-end form-select form-select-sm"
                            style="width:auto;border-radius:0;background:#fff;">
                        <option value="gt">&gt;</option>
                        <option value="lt">&lt;</option>
                        <option value="gte">&gt;=</option>
                        <option value="lte">&lt;=</option>
                        <option value="eq">=</option>
                    </select>
                    <input type="number" id="pctInput" placeholder="% change" step="1"
                           oninput="applyFilters()"
                           class="border-0 form-control form-control-sm"
                           style="width:90px;border-radius:0;" />
                </div>
                <input type="text" id="nameInput" placeholder="Search item name"
                       oninput="applyFilters()"
                       class="form-control form-control-sm" style="flex:1;min-width:160px;" />
            </div>

            <div class="border rounded overflow-hidden">
                <table class="table table-sm mb-0" style="font-size:13px;table-layout:fixed;">
                    <thead class="table-light">
                        <tr>
                            <th onclick="sortTable('name')" style="width:30%;cursor:pointer;">
                                Item <i class="bi bi-arrow-down-up" style="font-size:10px;"></i>
                            </th>
                            <th onclick="sortTable('category')" style="width:22%;cursor:pointer;">
                                Category <i class="bi bi-arrow-down-up" style="font-size:10px;"></i>
                            </th>
                            <th onclick="sortTable('start')" class="text-end" style="width:12%;cursor:pointer;">
                                Start <i class="bi bi-arrow-down-up" style="font-size:10px;"></i>
                            </th>
                            <th onclick="sortTable('current')" class="text-end" style="width:13%;cursor:pointer;">
                                Current <i class="bi bi-arrow-down-up" style="font-size:10px;"></i>
                            </th>
                            <th onclick="sortTable('pct')" class="text-end" style="width:13%;cursor:pointer;">
                                % change <i class="bi bi-arrow-down-up" style="font-size:10px;"></i>
                            </th>
                            <th class="text-center" style="width:10%;">Status</th>
                        </tr>
                    </thead>
                    <tbody id="tableBody"></tbody>
                </table>
                <div id="emptyState" style="display:none;"
                     class="text-center text-muted py-4" style="font-size:13px;">
                    No items match your filters.
                </div>
            </div>
        </div>
    </div>

    <!-- Category trends -->
    <div class="border-top pt-4 mb-4">
        <p class="fw-500 mb-1" style="font-size:15px;">Category trends</p>
        <p class="text-muted mb-3" style="font-size:13px;">Collection count by category</p>
        <div id="catBars" style="display:flex;flex-direction:column;gap:10px;"></div>
    </div>

    <!-- Starting vs Current Quantity -->
    <div class="border-top pt-4 mb-4">
        <p class="fw-500 mb-1" style="font-size:15px;">Starting vs current quantity</p>
        <p class="text-muted mb-3" style="font-size:13px;">Per item across all users</p>
        <div class="border rounded overflow-hidden" style="position:relative;">
            <table class="table table-sm mb-0" style="font-size:13px;table-layout:fixed;width:100%;">
                <thead class="table-light" style="position:sticky;top:0;z-index:1;">
                    <tr>
                        <th style="width:25%;">Item</th>
                        <th style="width:30%;">Category</th>
                        <th class="text-end" style="width:15%;">Start</th>
                        <th class="text-end" style="width:15%;">Current</th>
                        <th class="text-center" style="width:10%;">Status</th>
                    </tr>
                </thead>
            </table>
            <div style="position:relative;overflow:hidden;">
                <table class="table table-sm mb-0" style="font-size:13px;table-layout:fixed;width:100%;margin:0;">
                    <tbody id="qtyTableBody"></tbody>
                </table>
            </div>
        </div>
    </div>

    <!-- At-risk items -->
    <div class="border-top pt-4 mb-5">
        <div class="d-flex align-items-center gap-2 mb-1">
            <i class="bi bi-exclamation-triangle-fill" style="color:#BA7517;font-size:15px;"></i>
            <p class="fw-500 mb-0" style="font-size:15px;">At-risk items</p>
        </div>
        <p class="text-muted mb-3" style="font-size:13px;">
            Items where current quantity is significantly below starting quantity
        </p>
        <div id="atRiskList" style="display:flex;flex-direction:column;gap:8px;"></div>
    </div>

</div>

@section Scripts {
    <script>
        // ── Data from server ──
        const allItems = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.MarketDetail));

        // Compute pct on client side
        allItems.forEach(i => {
            i.pct = i.Start === 0 ? 0 : Math.round(((i.Current - i.Start) / i.Start) * 100);
            i.name = i.Name || i.name;
            i.category = i.Category || i.category;
            i.start = i.Start || i.start || 0;
            i.current = i.Current || i.current || 0;
        });

        const colors = [
            '#4e79a7', '#f28e2b', '#e15759', '#76b7b2',
            '#59a14f', '#edc948', '#b07aa1', '#ff9da7'
        ];

        let sortKey = 'pct', sortDir = -1, tableOpen = false;

        // ── Render all sections ──
        function renderAll() {
            renderSummary();
            renderChart();
            renderCategoryBars();
            renderQtyTable();
            renderAtRisk();
            if (tableOpen) applyFilters();
        }

        // ── Summary cards ──
        function renderSummary() {
            const rising = allItems.filter(i => i.pct > 0).length;
            const declining = allItems.filter(i => i.pct < 0).length;
            const net = allItems.reduce((s, i) => s + (i.current - i.start), 0);

            document.getElementById('risingCount').textContent = rising;
            document.getElementById('decliningCount').textContent = declining;

            const netEl = document.getElementById('netChange');
            netEl.textContent = (net >= 0 ? '+' : '') + net;
            netEl.style.color = net > 0 ? '#0F6E56' : net < 0 ? '#A32D2D' : '#212529';
        }

        // ── Diverging bar chart ──
        function renderChart() {
            const top10 = [...allItems]
                .sort((a, b) => Math.abs(b.pct) - Math.abs(a.pct))
                .slice(0, 10)
                .sort((a, b) => b.pct - a.pct);

            const maxAbs = Math.max(...top10.map(i => Math.abs(i.pct)), 1);
            const container = document.getElementById('chartRows');
            container.innerHTML = '';

            top10.forEach(item => {
                const barPct = (Math.abs(item.pct) / maxAbs) * 44;
                const isRising = item.pct >= 0;
                const color = item.pct === 0 ? '#dee2e6' : isRising ? '#1D9E75' : '#E24B4A';
                const labelCol = item.pct === 0 ? '#6c757d' : isRising ? '#0F6E56' : '#A32D2D';
                const label = item.pct > 0 ? `+${item.pct}%` : `${item.pct}%`;

                const row = document.createElement('div');
                row.style.cssText = 'display:flex;align-items:center;height:26px;';

                if (isRising) {
                    row.innerHTML = `
                            <div style="width:50%;display:flex;justify-content:flex-end;align-items:center;padding-right:8px;">
                                <span style="font-size:12px;color:#6c757d;text-align:right;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;max-width:190px;">${item.name}</span>
                            </div>
                            <div style="width:50%;display:flex;align-items:center;border-left:0.5px solid #dee2e6;">
                                <div style="margin-left:1px;height:16px;width:${barPct}%;background:${color};border-radius:0 3px 3px 0;min-width:2px;"></div>
                                <span style="font-size:11px;font-weight:500;color:${labelCol};margin-left:5px;white-space:nowrap;">${label}</span>
                            </div>`;
                } else {
                    row.innerHTML = `
                            <div style="width:50%;display:flex;justify-content:flex-end;align-items:center;padding-right:8px;">
                                <span style="font-size:11px;font-weight:500;color:${labelCol};margin-right:5px;white-space:nowrap;">${label}</span>
                                <div style="height:16px;width:${barPct}%;background:${color};border-radius:3px 0 0 3px;min-width:2px;"></div>
                            </div>
                            <div style="width:50%;display:flex;align-items:center;border-left:0.5px solid #dee2e6;padding-left:8px;">
                                <span style="font-size:12px;color:#6c757d;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;max-width:190px;">${item.name}</span>
                            </div>`;
                }

                container.appendChild(row);
            });
        }

        // ── Category bars ──
        function renderCategoryBars() {
            const cats = {};
            allItems.forEach(i => { cats[i.category] = (cats[i.category] || 0) + i.current; });

            const entries = Object.entries(cats).sort((a, b) => b[1] - a[1]);
            const maxVal = Math.max(...entries.map(e => e[1]), 1);

            document.getElementById('catBars').innerHTML = entries.map(([cat, val], idx) => `
                    <div style="display:flex;align-items:center;gap:10px;">
                        <span style="font-size:12px;color:#6c757d;width:160px;text-align:right;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;">${cat}</span>
                        <div style="flex:1;height:16px;background:#f8f9fa;border-radius:3px;overflow:hidden;">
                            <div style="height:100%;width:${Math.round((val / maxVal) * 100)}%;background:${colors[idx % colors.length]};border-radius:3px;"></div>
                        </div>
                        <span style="font-size:12px;color:#6c757d;width:24px;">${val}</span>
                    </div>`).join('');
        }

        // ── Qty table ──
        function renderQtyTable() {
            const tbody = document.getElementById('qtyTableBody');
            tbody.innerHTML = allItems.map((item, idx) => {
                const diff = item.current - item.start;
                const dotColor = diff > 0 ? '#1D9E75' : diff < 0 ? '#E24B4A' : '#6c757d';
                const border = idx > 0 ? 'border-top:0.5px solid #dee2e6;' : '';
                return `
                        <tr style="${border}">
                            <td style="padding:7px 12px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;">${item.name}</td>
                            <td style="padding:7px 12px;color:#6c757d;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;">${item.category}</td>
                            <td style="padding:7px 12px;text-align:right;color:#6c757d;">${item.start}</td>
                            <td style="padding:7px 12px;text-align:right;color:#6c757d;">${item.current}</td>
                            <td style="padding:7px 12px;text-align:center;">
                                <span style="display:inline-block;width:8px;height:8px;border-radius:50%;background:${dotColor};"></span>
                            </td>
                        </tr>`;
            }).join('');
        }

        // ════════════════════════════════════════════════
        // VIRTUAL SCROLL — shared utility
        // ════════════════════════════════════════════════
        const ROW_HEIGHT = 37;   // px — must match actual rendered row height
        const BUFFER = 5;    // extra rows above/below viewport
        const THRESHOLD = 12;   // min rows before virtual scroll activates

        function createVirtualTable(containerId, data, renderRowFn, colCount) {
            const container = document.getElementById(containerId);
            if (!container) return;

            // Below threshold — render normally, no scroll wrapper needed
            if (data.length <= THRESHOLD) {
                container.style.height = '';
                container.style.overflow = '';
                container.innerHTML = data.map((row, i) => renderRowFn(row, i)).join('');
                return;
            }

            const totalHeight = data.length * ROW_HEIGHT;
            const visibleHeight = ROW_HEIGHT * THRESHOLD;  // fixed container height

            // Wrap container in scrollable div
            const wrapper = container.closest('.virtual-scroll-wrapper') || (() => {
                const w = document.createElement('div');
                w.className = 'virtual-scroll-wrapper';
                w.style.cssText = `
                    height:${visibleHeight}px;
                    overflow-y:auto;
                    position:relative;
                    border-radius:0 0 4px 4px;`;
                container.parentNode.insertBefore(w, container);
                w.appendChild(container);
                return w;
            })();

            // Spacer div — gives scroll the correct total height
            let spacer = wrapper.querySelector('.vs-spacer');
            if (!spacer) {
                spacer = document.createElement('div');
                spacer.className = 'vs-spacer';
                spacer.style.cssText = 'position:absolute;top:0;left:0;width:1px;pointer-events:none;';
                wrapper.appendChild(spacer);
            }
            spacer.style.height = `${totalHeight}px`;

            // tbody stays position:absolute so it overlaps spacer correctly
            container.style.cssText = `
                position:absolute;
                top:0;left:0;right:0;
                will-change:transform;`;

            function renderVisible() {
                const scrollTop = wrapper.scrollTop;
                const startIdx = Math.max(0, Math.floor(scrollTop / ROW_HEIGHT) - BUFFER);
                const endIdx = Math.min(
                    data.length,
                    Math.ceil((scrollTop + visibleHeight) / ROW_HEIGHT) + BUFFER
                );

                const offsetY = startIdx * ROW_HEIGHT;
                container.style.transform = `translateY(${offsetY}px)`;
                container.innerHTML = data
                    .slice(startIdx, endIdx)
                    .map((row, i) => renderRowFn(row, startIdx + i))
                    .join('');
            }

            // Throttled scroll handler
            let ticking = false;
            wrapper.onscroll = () => {
                if (!ticking) {
                    requestAnimationFrame(() => { renderVisible(); ticking = false; });
                    ticking = true;
                }
            };

            renderVisible();
        }

        // ════════════════════════════════════════════════
        // STARTING VS CURRENT QTY TABLE — virtual scroll
        // (for MarketDemand page)
        // ════════════════════════════════════════════════
        function renderQtyTable() {
            function rowFn(item, idx) {
                const diff = item.current - item.start;
                const dotColor = diff > 0 ? '#1D9E75' : diff < 0 ? '#E24B4A' : '#6c757d';
                const border = idx > 0 ? 'border-top:0.5px solid #dee2e6;' : '';
                return `
                    <tr style="${border}height:${ROW_HEIGHT}px;">
                        <td style="padding:7px 12px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;">${item.name}</td>
                        <td style="padding:7px 12px;color:#6c757d;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;">${item.category}</td>
                        <td style="padding:7px 12px;text-align:right;color:#6c757d;">${item.start}</td>
                        <td style="padding:7px 12px;text-align:right;color:#6c757d;">${item.current}</td>
                        <td style="padding:7px 12px;text-align:center;">
                            <span style="display:inline-block;width:8px;height:8px;border-radius:50%;background:${dotColor};"></span>
                        </td>
                    </tr>`;
            }

            createVirtualTable('qtyTableBody', allItems, rowFn, 5);
        }

        // ── At-risk items (pct ≤ -20) ──
        function renderAtRisk() {
            const atRisk = allItems.filter(i => i.pct <= -20);
            const container = document.getElementById('atRiskList');

            if (atRisk.length === 0) {
                container.innerHTML = '<p class="text-muted mb-0" style="font-size:13px;">No at-risk items detected.</p>';
                return;
            }

            container.innerHTML = atRisk.map(item => `
                    <div class="d-flex align-items-center justify-content-between p-3 rounded"
                         style="background:#FFF8E7;border:0.5px solid #f0c040;">
                        <div>
                            <p class="fw-500 mb-0" style="font-size:13px;color:#BA7517;">${item.name}</p>
                            <p class="mb-0" style="font-size:12px;color:#BA7517;opacity:0.85;">
                                ${item.category} · started at ${item.start}, now ${item.current}
                            </p>
                        </div>
                        <span class="fw-500" style="font-size:13px;color:#BA7517;">${item.pct}%</span>
                    </div>`).join('');
        }

        // ── Toggle expandable table ──
        function toggleTable() {
            tableOpen = !tableOpen;
            document.getElementById('tableSection').style.display = tableOpen ? 'block' : 'none';
            const btn = document.getElementById('toggleBtn');
            btn.innerHTML = tableOpen
                ? `Show less <i class="bi bi-arrow-left" style="font-size:13px;"></i>`
                : `See more <i class="bi bi-arrow-right" style="font-size:13px;"></i>`;
            if (tableOpen) applyFilters();
        }

        // ── Filter + sort full table ──
        function applyFilters() {
            const op = document.getElementById('operator').value;
            const pctVal = document.getElementById('pctInput').value;
            const nameQ = document.getElementById('nameInput').value.trim().toLowerCase();

            let filtered = [...allItems];

            if (nameQ) filtered = filtered.filter(i => i.name.toLowerCase().includes(nameQ));

            if (pctVal !== '') {
                const num = parseInt(pctVal);
                const ops = { gt: (a, b) => a > b, lt: (a, b) => a < b, gte: (a, b) => a >= b, lte: (a, b) => a <= b, eq: (a, b) => a === b };
                filtered = filtered.filter(i => ops[op](i.pct, num));
            }

            filtered.sort((a, b) => {
                const av = a[sortKey], bv = b[sortKey];
                return typeof av === 'string'
                    ? sortDir * av.localeCompare(bv)
                    : sortDir * (av - bv);
            });

            const tbody = document.getElementById('tableBody');
            const empty = document.getElementById('emptyState');

            if (filtered.length === 0) {
                tbody.innerHTML = '';
                empty.style.display = 'block';
                return;
            }

            empty.style.display = 'none';
            tbody.innerHTML = filtered.map((item, idx) => {
                const isRising = item.pct > 0, isFlat = item.pct === 0;
                const badgeBg = isFlat ? '#f8f9fa' : isRising ? '#E1F5EE' : '#FCEBEB';
                const badgeColor = isFlat ? '#6c757d' : isRising ? '#0F6E56' : '#A32D2D';
                const icon = isFlat ? 'bi-dash' : isRising ? 'bi-arrow-up' : 'bi-arrow-down';
                const pctLabel = item.pct > 0 ? `+${item.pct}%` : `${item.pct}%`;
                const pctColor = isFlat ? '#6c757d' : isRising ? '#0F6E56' : '#A32D2D';
                const border = idx > 0 ? 'border-top:0.5px solid #dee2e6;' : '';

                return `
                        <tr style="${border}">
                            <td style="padding:7px 10px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;">${item.name}</td>
                            <td style="padding:7px 10px;color:#6c757d;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;">${item.category}</td>
                            <td style="padding:7px 10px;text-align:right;color:#6c757d;">${item.start}</td>
                            <td style="padding:7px 10px;text-align:right;color:#6c757d;">${item.current}</td>
                            <td style="padding:7px 10px;text-align:right;font-weight:500;color:${pctColor};">${pctLabel}</td>
                            <td style="padding:7px 10px;text-align:center;">
                                <span style="display:inline-flex;align-items:center;gap:3px;font-size:11px;padding:2px 7px;border-radius:999px;background:${badgeBg};color:${badgeColor};">
                                    <i class="bi ${icon}" style="font-size:11px;"></i>
                                    ${isFlat ? 'Flat' : isRising ? 'Rising' : 'Declining'}
                                </span>
                            </td>
                        </tr>`;
            }).join('');
        }

        function sortTable(key) {
            if (sortKey === key) sortDir *= -1;
            else { sortKey = key; sortDir = -1; }
            applyFilters();
        }

        // ── Init ──
        renderAll();
    </script>
}