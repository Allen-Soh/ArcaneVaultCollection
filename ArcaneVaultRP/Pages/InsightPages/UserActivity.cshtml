@page
@model ArcaneVaultRP.Pages.InsightPages.UserActivityModel
@{
    ViewData["Title"] = "User Activity";
}

<div class="container mt-4" style="max-width:860px;">

    <!-- Back + Header -->
    <div class="mb-1">
        <a asp-page="./Index"
           class="text-decoration-none d-inline-flex align-items-center gap-1"
           style="font-size:13px;">
            <i class="bi bi-arrow-left" style="font-size:13px;"></i> Insights
        </a>
    </div>

    <div class="d-flex justify-content-between align-items-center mb-1">
        <h1 style="font-size:22px;font-weight:500;margin:0;">
            User activity and engagement
        </h1>
        <select id="periodSelect"
                onchange="window.location.href='?Days=' + this.value"
                class="form-select form-select-sm" style="width:auto;">
            <option value="7" selected="@(Model.Days == 7)"> Last 7 days</option>
            <option value="30" selected="@(Model.Days == 30)">Last 30 days</option>
            <option value="90" selected="@(Model.Days == 90)">Last 3 months</option>
            <option value="180" selected="@(Model.Days == 180)">Last 6 months</option>
            <option value="365" selected="@(Model.Days == 365)">Last 12 months</option>
        </select>
    </div>
    <p class="text-muted mb-4" style="font-size:13px;">
        Login activity and engagement metrics across all users
    </p>

    <!-- KPI cards -->
    <div class="row g-3 mb-4">
        <div class="col">
            <div class="rounded p-3" style="background:#f8f9fa;">
                <p class="text-muted mb-1" style="font-size:12px;">DAU</p>
                <p class="fw-500 mb-1" style="font-size:22px;">@Model.DAU</p>
                <p class="text-muted mb-0" style="font-size:11px;">Active today</p>
            </div>
        </div>
        <div class="col">
            <div class="rounded p-3" style="background:#f8f9fa;">
                <p class="text-muted mb-1" style="font-size:12px;">WAU</p>
                <p class="fw-500 mb-1" style="font-size:22px;">@Model.WAU</p>
                <p class="text-muted mb-0" style="font-size:11px;">Active this week</p>
            </div>
        </div>
        <div class="col">
            <div class="rounded p-3" style="background:#f8f9fa;">
                <p class="text-muted mb-1" style="font-size:12px;">MAU</p>
                <p class="fw-500 mb-1" style="font-size:22px;">@Model.MAU</p>
                <p class="text-muted mb-0" style="font-size:11px;">Active this month</p>
            </div>
        </div>
        <div class="col">
            <div class="rounded p-3" style="background:#f8f9fa;">
                <p class="text-muted mb-1" style="font-size:12px;">Stickiness</p>
                <p class="fw-500 mb-1" id="stickinessVal" style="font-size:22px;">
                    @(Model.MAU > 0 ? $"{Math.Round((double)Model.DAU / Model.MAU * 100)}%" : "—")
                </p>
                <p class="text-muted mb-0" style="font-size:11px;">DAU / MAU</p>
            </div>
        </div>
        <div class="col">
            <div class="rounded p-3" style="background:#f8f9fa;">
                <p class="text-muted mb-1" style="font-size:12px;" id="card5Label">
                    @(Model.Days == 365 ? "Most active month" : "Most active day")
                </p>
                <p class="fw-500 mb-1" style="font-size:18px;" id="card5Value">—</p>
                <p class="text-muted mb-0" style="font-size:11px;" id="card5Sub">
                    @(Model.Days == 365 ? "By total login count" : "By login count")
                </p>
            </div>
        </div>
    </div>

    <!-- Login activity chart -->
    <div class="border-top pt-4 mb-4">
        <div class="d-flex justify-content-between align-items-start mb-1">
            <p class="fw-500 mb-0" style="font-size:15px;">Login activity</p>
            <span id="groupingBadge"
                  class="text-muted"
                  style="font-size:11px;background:#f8f9fa;padding:2px 8px;
                border-radius:999px;border:0.5px solid #dee2e6;">
                Grouped by day
            </span>
        </div>
        <p class="text-muted mb-3" style="font-size:13px;" id="chartSubtitle"></p>
        <div style="position:relative;height:180px;width:100%;">
            <canvas id="loginChart" style="width:100%;height:100%;"></canvas>
        </div>
    </div>

    <!-- Breakdown bars — day of week or month -->
    <div class="border-top pt-4 mb-4">
        <p class="fw-500 mb-1" style="font-size:15px;" id="breakdownTitle">
            @(Model.Days == 365 ? "Activity by month" : "Activity by day of week")
        </p>
        <p class="text-muted mb-3" style="font-size:13px;" id="breakdownSubtitle">
            @(Model.Days == 365 ? "Which months see the most logins" : "Which days see the most logins")
        </p>
        <div id="breakdownBars" style="display:flex;flex-direction:column;gap:8px;"></div>
    </div>

    <!-- Country demographic -->
    <div class="border-top pt-4 mb-5">
        <p class="fw-500 mb-1" style="font-size:15px;">Country demographic</p>
        <p class="text-muted mb-3" style="font-size:13px;">
            Where your users are from — all registered users
        </p>

        @if (!Model.CountryData.Any())
        {
            <p class="text-muted" style="font-size:13px;">No country data yet.</p>
        }
        else
        {
            <div style="display:flex;flex-direction:column;gap:10px;">
                @foreach (var (country, idx) in Model.CountryData.Select((c, i) => (c, i)))
                {
                    var flag = ArcaneVaultRP.Helpers.CountryHelper.GetFlag(country.Country);
                    var barWidth = (int)Math.Round(country.Percentage);
                    var isTop = idx == 0;
                    var barColor = isTop ? "#4e79a7" : "#93b4d4";

                    <div style="display:flex;align-items:center;gap:10px;">
                        <!-- Flag + name -->
                        <div style="width:200px;display:flex;align-items:center;
                            gap:6px;flex-shrink:0;justify-content:flex-end;">
                            <span style="font-size:16px;line-height:1;">@flag</span>
                            <span style="font-size:12px;color:#6c757d;
                            overflow:hidden;text-overflow:ellipsis;
                            white-space:nowrap;">@country.Country</span>
                        </div>
                        <!-- Bar -->
                        <div style="flex:1;height:14px;background:#f8f9fa;
                            border-radius:3px;overflow:hidden;">
                            <div style="height:100%;width:@(barWidth)%;
                            background:@barColor;border-radius:3px;"></div>
                        </div>
                        <!-- Count + % -->
                        <div style="width:80px;display:flex;align-items:center;
                            gap:4px;flex-shrink:0;">
                            <span style="font-size:12px;font-weight:@(isTop ? "500" : "400");
                                color:@(isTop ? "var(--text-primary)" : "var(--text-muted)");">
                                @country.UserCount
                            </span>
                            <span style="font-size:11px;color:#adb5bd;">
                                (@country.Percentage%)
                            </span>
                        </div>
                    </div>
                }
            </div>
        }
    </div>

    <!-- User breakdown table -->
    <div class="border-top pt-4 mb-5">
        <p class="fw-500 mb-1" style="font-size:15px;">User breakdown</p>
        <p class="text-muted mb-3" style="font-size:13px;">
            Individual login and engagement data per user
        </p>

        <div class="d-flex gap-2 mb-3">
            <input type="text" id="userSearch" placeholder="Search username"
                   oninput="renderTable()"
                   class="form-control form-control-sm" style="flex:1;" />
            <select id="tableSortSelect" onchange="renderTable()"
                    class="form-select form-select-sm" style="width:auto;flex-shrink:0;">
                <option value="logins">Most logins</option>
                <option value="showoffs">Most showoffs</option>
                <option value="name">Username A – Z</option>
                <option value="lastLogin">Most recent login</option>
            </select>
        </div>

        <div class="border rounded overflow-hidden" style="position:relative;">
            <div id="userTableWrapper" style="overflow-y:auto;">
                <table class="table table-sm mb-0"
                       style="font-size:13px;table-layout:fixed;width:100%;">
                    <colgroup>
                        <col style="width:28%;" />
                        <col style="width:18%;" />
                        <col style="width:18%;" />
                        <col style="width:22%;" />
                        <col style="width:14%;" />
                    </colgroup>
                    <thead class="table-light" style="position:sticky;top:0;z-index:2;">
                        <tr>
                            <th style="padding:8px 12px;">Username</th>
                            <th style="padding:8px 12px;text-align:right;">Total logins</th>
                            <th style="padding:8px 12px;text-align:right;">Showoffs</th>
                            <th style="padding:8px 12px;">Last login</th>
                            <th style="padding:8px 12px;text-align:center;">Status</th>
                        </tr>
                    </thead>
                    <tbody id="userTableBody"></tbody>
                </table>
            </div>
            <div id="tableEmpty" style="display:none;"
                 class="text-center text-muted py-4" style="font-size:13px;">
                No users match your search.
            </div>
        </div>
        <div class="d-flex justify-content-between mt-2 mb-4" id="userTableIndicatorRow">
            <p class="text-muted mb-0" id="userScrollIndicator" style="font-size:12px;"></p>
            <p class="text-muted mb-0" id="userScrollMoreText" style="font-size:12px;">Scroll to load more</p>
        </div>
    </div>

</div>

@section Scripts {
    <script>
        // ════════════════════════════════════════════════
        // 1. SERVER DATA
        // ════════════════════════════════════════════════
        const rawDetail = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.ActivityDetail));
        const days = @Model.Days;

        const loginActivity = rawDetail.LoginActivity || rawDetail.loginActivity || [];
        const dowData = rawDetail.DayOfWeek || rawDetail.dayOfWeek || new Array(7).fill(0);
        const monthData = rawDetail.MonthData || rawDetail.monthData || new Array(12).fill(0);
        const users = rawDetail.Users || rawDetail.users || [];

        // Normalise user objects
        users.forEach(u => {
            u.name = u.Name || u.name;
            u.logins = u.Logins || u.logins || 0;
            u.showoffs = u.Showoffs || u.showoffs || 0;
            u.lastLogin = u.LastLogin || u.lastLogin || null;
        });

        const dayNames = ['Sunday', 'Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday'];
        const monthNames = ['January', 'February', 'March', 'April', 'May', 'June',
            'July', 'August', 'September', 'October', 'November', 'December'];
        const shortMonths = ['Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun',
            'Jul', 'Aug', 'Sep', 'Oct', 'Nov', 'Dec'];

        // ════════════════════════════════════════════════
        // 2. VIRTUAL SCROLL CONSTANTS
        // ════════════════════════════════════════════════
        const ROW_HEIGHT = 37;
        const BUFFER = 5;
        const THRESHOLD = 12;

        // ════════════════════════════════════════════════
        // 3. GROUPING LOGIC
        // ════════════════════════════════════════════════
        function getGrouping() {
            if (days <= 30) return 'day';
            if (days <= 180) return 'week';
            return 'month';
        }

        function groupLoginActivity(grouping) {
            if (grouping === 'day') {
                return loginActivity.map(d => ({
                    label: formatDate(d.Date || d.date),
                    count: d.Count || d.count || 0
                }));
            }

            const buckets = {};
            loginActivity.forEach(d => {
                const date = new Date(d.Date || d.date);
                let key;
                if (grouping === 'week') {
                    const ws = new Date(date);
                    ws.setDate(date.getDate() - date.getDay());
                    key = ws.toLocaleDateString('en-GB', { day: '2-digit', month: 'short' });
                } else {
                    key = shortMonths[date.getMonth()] + ' ' + date.getFullYear();
                }
                buckets[key] = (buckets[key] || 0) + (d.Count || d.count || 0);
            });

            return Object.entries(buckets).map(([label, count]) => ({ label, count }));
        }

        function formatDate(dateStr) {
            if (!dateStr) return '';
            const d = new Date(dateStr);
            return d.toLocaleDateString('en-GB', { day: '2-digit', month: 'short' });
        }

        // ════════════════════════════════════════════════
        // 4. KPI CARD 5 — dynamic day/month
        // ════════════════════════════════════════════════
        function renderCard5() {
            if (days === 365) {
                const topMonthIdx = monthData.indexOf(Math.max(...monthData));
                document.getElementById('card5Label').textContent = 'Most active month';
                document.getElementById('card5Value').textContent = monthNames[topMonthIdx] || '—';
                document.getElementById('card5Sub').textContent = 'By total login count';
            } else {
                const topDayIdx = dowData.indexOf(Math.max(...dowData));
                document.getElementById('card5Label').textContent = 'Most active day';
                document.getElementById('card5Value').textContent = dayNames[topDayIdx] || '—';
                document.getElementById('card5Sub').textContent = 'By login count';
            }
        }

        // ════════════════════════════════════════════════
        // 5. GROUPING BADGE + CHART SUBTITLE
        // ════════════════════════════════════════════════
        function renderBadge() {
            const grouping = getGrouping();
            const labelMap = { day: 'Grouped by day', week: 'Grouped by week', month: 'Grouped by month' };
            const periodLabels = {
                7: '7 days', 30: '30 days', 90: '3 months', 180: '6 months', 365: '12 months'
            };
            const prefix = { day: 'Daily', week: 'Weekly', month: 'Monthly' }[grouping];
            document.getElementById('groupingBadge').textContent = labelMap[grouping];
            document.getElementById('chartSubtitle').textContent =
                `${prefix} active users over the last ${periodLabels[days] || days + ' days'}`;
        }

        // ════════════════════════════════════════════════
        // 6. LINE CHART — canvas drawn manually
        // ════════════════════════════════════════════════
        function renderLineChart() {
            const grouping = getGrouping();
            const data = groupLoginActivity(grouping);

            const canvas = document.getElementById('loginChart');
            canvas.width = canvas.offsetWidth || 800;
            canvas.height = 180;
            const ctx = canvas.getContext('2d');
            ctx.clearRect(0, 0, canvas.width, canvas.height);

            if (data.length === 0) {
                ctx.fillStyle = '#9ca3af';
                ctx.font = '13px sans-serif';
                ctx.textAlign = 'center';
                ctx.fillText('No login data for this period.', canvas.width / 2, 90);
                return;
            }

            const pad = { top: 12, right: 12, bottom: 32, left: 32 };
            const w = canvas.width - pad.left - pad.right;
            const h = canvas.height - pad.top - pad.bottom;
            const maxVal = Math.max(...data.map(d => d.count), 1);

            // Grid lines + Y labels
            ctx.strokeStyle = '#e5e7eb';
            ctx.lineWidth = 0.5;
            [0, 0.25, 0.5, 0.75, 1].forEach(f => {
                const y = pad.top + h - f * h;
                ctx.beginPath();
                ctx.moveTo(pad.left, y);
                ctx.lineTo(pad.left + w, y);
                ctx.stroke();
                ctx.fillStyle = '#9ca3af';
                ctx.font = '10px sans-serif';
                ctx.textAlign = 'right';
                ctx.fillText(Math.round(f * maxVal), pad.left - 4, y + 3);
            });

            // X labels — max 8 visible
            const maxLabels = grouping === 'month' ? data.length : 8;
            const step = Math.max(1, Math.ceil(data.length / maxLabels));
            ctx.fillStyle = '#9ca3af';
            ctx.font = '10px sans-serif';
            ctx.textAlign = 'center';
            data.forEach((d, i) => {
                if (i % step === 0 || i === data.length - 1) {
                    const x = pad.left + (data.length > 1 ? (i / (data.length - 1)) * w : w / 2);
                    ctx.fillText(d.label, x, pad.top + h + 20);
                }
            });

            if (data.length < 2) return;

            // Fill area
            ctx.beginPath();
            data.forEach((d, i) => {
                const x = pad.left + (i / (data.length - 1)) * w;
                const y = pad.top + h - (d.count / maxVal) * h;
                i === 0 ? ctx.moveTo(x, y) : ctx.lineTo(x, y);
            });
            ctx.lineTo(pad.left + w, pad.top + h);
            ctx.lineTo(pad.left, pad.top + h);
            ctx.closePath();
            ctx.fillStyle = 'rgba(78,121,167,0.12)';
            ctx.fill();

            // Line
            ctx.beginPath();
            ctx.strokeStyle = '#4e79a7';
            ctx.lineWidth = 2;
            data.forEach((d, i) => {
                const x = pad.left + (i / (data.length - 1)) * w;
                const y = pad.top + h - (d.count / maxVal) * h;
                i === 0 ? ctx.moveTo(x, y) : ctx.lineTo(x, y);
            });
            ctx.stroke();

            // Dots — only if not too many points
            if (grouping !== 'month' || data.length <= 12) {
                data.forEach((d, i) => {
                    const x = pad.left + (i / (data.length - 1)) * w;
                    const y = pad.top + h - (d.count / maxVal) * h;
                    ctx.beginPath();
                    ctx.arc(x, y, 3, 0, Math.PI * 2);
                    ctx.fillStyle = '#4e79a7';
                    ctx.fill();
                });
            }
        }

        // ════════════════════════════════════════════════
        // 7. BREAKDOWN BARS — day of week or month
        // ════════════════════════════════════════════════
        function renderBreakdown() {
            const container = document.getElementById('breakdownBars');

            if (days === 365) {
                document.getElementById('breakdownTitle').textContent = 'Activity by month';
                document.getElementById('breakdownSubtitle').textContent = 'Which months see the most logins';

                const maxVal = Math.max(...monthData, 1);
                const maxMonthVal = Math.max(...monthData);

                container.innerHTML = monthNames.map((m, i) => {
                    const val = monthData[i] || 0;
                    const w = Math.round((val / maxVal) * 100);
                    const isMax = val === maxMonthVal && val > 0;
                    return `
                            <div style="display:flex;align-items:center;gap:10px;">
                                <span style="font-size:12px;color:#6c757d;width:90px;
                                             text-align:right;flex-shrink:0;">${m}</span>
                                <div style="flex:1;height:14px;background:#f8f9fa;border-radius:3px;overflow:hidden;">
                                    <div style="height:100%;width:${w}%;
                                                background:${isMax ? '#4e79a7' : '#93b4d4'};
                                                border-radius:3px;"></div>
                                </div>
                                <span style="font-size:12px;
                                             color:${isMax ? 'var(--text-primary)' : 'var(--text-muted)'};
                                             font-weight:${isMax ? '500' : '400'};
                                             width:24px;text-align:right;flex-shrink:0;">${val}</span>
                            </div>`;
                }).join('');
            } else {
                document.getElementById('breakdownTitle').textContent = 'Activity by day of week';
                document.getElementById('breakdownSubtitle').textContent = 'Which days see the most logins';

                const maxVal = Math.max(...dowData, 1);
                const maxDowVal = Math.max(...dowData);

                container.innerHTML = dayNames.map((day, i) => {
                    const val = dowData[i] || 0;
                    const w = Math.round((val / maxVal) * 100);
                    const isMax = val === maxDowVal && val > 0;
                    return `
                            <div style="display:flex;align-items:center;gap:10px;">
                                <span style="font-size:12px;color:#6c757d;width:90px;
                                             text-align:right;flex-shrink:0;">${day}</span>
                                <div style="flex:1;height:14px;background:#f8f9fa;border-radius:3px;overflow:hidden;">
                                    <div style="height:100%;width:${w}%;
                                                background:${isMax ? '#4e79a7' : '#93b4d4'};
                                                border-radius:3px;"></div>
                                </div>
                                <span style="font-size:12px;
                                             color:${isMax ? 'var(--text-primary)' : 'var(--text-muted)'};
                                             font-weight:${isMax ? '500' : '400'};
                                             width:24px;text-align:right;flex-shrink:0;">${val}</span>
                            </div>`;
                }).join('');
            }
        }

        // ════════════════════════════════════════════════
        // 8. USER TABLE — virtual scroll
        // ════════════════════════════════════════════════
        function getFilteredUsers() {
            const q = (document.getElementById('userSearch')?.value || '').trim().toLowerCase();
            const sort = document.getElementById('tableSortSelect')?.value || 'logins';

            let filtered = [...users];
            if (q) filtered = filtered.filter(u => u.name.toLowerCase().includes(q));

            filtered.sort((a, b) => {
                if (sort === 'logins') return b.logins - a.logins;
                if (sort === 'showoffs') return b.showoffs - a.showoffs;
                if (sort === 'name') return a.name.localeCompare(b.name);
                if (sort === 'lastLogin') return new Date(b.lastLogin || 0) - new Date(a.lastLogin || 0);
                return 0;
            });

            return filtered;
        }

        function renderTable() {
            const data = getFilteredUsers();
            const tbody = document.getElementById('userTableBody');
            const empty = document.getElementById('tableEmpty');
            const wrapper = document.getElementById('userTableWrapper');
            const indicatorRow = document.getElementById('userTableIndicatorRow');
            const moreText = document.getElementById('userScrollMoreText');

            if (data.length === 0) {
                empty.style.display = 'block';
                tbody.innerHTML = '';
                wrapper.style.height = '';
                wrapper.onscroll = null;
                indicatorRow.style.display = 'none';
                return;
            }

            empty.style.display = 'none';
            indicatorRow.style.removeProperty('display');
            moreText.style.display = data.length > THRESHOLD ? 'block' : 'none';

            const now = new Date();

            function updateIndicator() {
                const scrollTop = wrapper.scrollTop;
                const visStart = Math.max(1, Math.floor(scrollTop / ROW_HEIGHT) + 1);
                const visEnd = Math.min(data.length, visStart + THRESHOLD - 1);
                document.getElementById('userScrollIndicator').textContent =
                    data.length > THRESHOLD
                        ? `Showing ${visStart}–${visEnd} of ${data.length}`
                        : `${data.length} user${data.length === 1 ? '' : 's'}`;
            }

            function rowFn(u, idx) {
                const border = idx > 0 ? 'border-top:0.5px solid #dee2e6;' : '';
                const lastDate = u.lastLogin ? new Date(u.lastLogin) : null;
                const diff = lastDate
                    ? Math.floor((now - lastDate) / (1000 * 60 * 60 * 24))
                    : null;
                const lastLabel = diff === null ? '—'
                    : diff === 0 ? 'Today'
                        : diff === 1 ? 'Yesterday'
                            : `${diff} days ago`;
                const isActive = diff !== null && diff <= 7;
                const badgeBg = isActive ? 'rgba(126, 245, 166, 0.15)' : 'rgba(166, 177, 225, 0.1)';
                const badgeColor = isActive ? '#7ef5a6' : '#8d94ba';
                const badgeLabel = isActive ? 'Active' : 'Inactive';

                return `
                                <tr style="${border}height:${ROW_HEIGHT}px;">
                                    <td style="padding:8px 12px;font-weight:500;">${u.name}</td>
                                    <td style="padding:8px 12px;text-align:right;color:#6c757d;">${u.logins}</td>
                                    <td style="padding:8px 12px;text-align:right;color:#6c757d;">${u.showoffs}</td>
                                    <td style="padding:8px 12px;color:#adb5bd;">${lastLabel}</td>
                                    <td style="padding:8px 12px;text-align:center;">
                                        <span style="display:inline-block;font-size:11px;padding:2px 8px;
                                                        border-radius:999px;background:${badgeBg};
                                                        color:${badgeColor};">${badgeLabel}</span>
                                    </td>
                                </tr>`;
            }

            if (data.length <= THRESHOLD) {
                wrapper.style.height = '';
                wrapper.style.maxHeight = '';
                wrapper.onscroll = null;
                tbody.innerHTML = data.map((u, i) => rowFn(u, i)).join('');
                updateIndicator();
                return;
            }

            updateIndicator();

            const visibleHeight = ROW_HEIGHT * THRESHOLD + 18;
            wrapper.style.height = `${visibleHeight}px`;
            wrapper.style.maxHeight = `${visibleHeight}px`;
            wrapper.style.overflowY = 'auto';

            function render() {
                const scrollTop = wrapper.scrollTop;
                const startIdx = Math.max(0, Math.floor(scrollTop / ROW_HEIGHT) - BUFFER);
                const endIdx = Math.min(
                    data.length,
                    Math.ceil((scrollTop + visibleHeight) / ROW_HEIGHT) + BUFFER
                );
                const topPad = startIdx * ROW_HEIGHT;
                const bottomPad = (data.length - endIdx) * ROW_HEIGHT;

                tbody.innerHTML =
                    (topPad > 0 ? `<tr style="height:${topPad}px;"><td colspan="5"></td></tr>` : '') +
                    data.slice(startIdx, endIdx).map((u, i) => rowFn(u, startIdx + i)).join('') +
                    (bottomPad > 0 ? `<tr style="height:${bottomPad}px;"><td colspan="5"></td></tr>` : '');

                updateIndicator();
            }

            let ticking = false;
            wrapper.onscroll = () => {
                if (!ticking) {
                    requestAnimationFrame(() => { render(); ticking = false; });
                    ticking = true;
                }
            };

            wrapper.scrollTop = 0;
            render();
        }

        // ════════════════════════════════════════════════
        // 9. SEARCH CLEAR ("×") BUTTONS
        // ════════════════════════════════════════════════
        // Adds a clear ("×") button to a search input; shows only when it has text.
        // Wraps the input in its own dedicated box (rather than reusing a shared flex-row
        // parent that might also contain a <select> etc.), so the button always sits
        // against the input itself, never a sibling control.
        function enableSearchClear(inputId) {
            const input = document.getElementById(inputId);
            if (!input || input.dataset.clearEnabled) return;

            const wrapper = document.createElement('div');
            wrapper.className = 'search-clear-wrapper';

            // Preserve whatever sizing the input relied on from its old parent (flex-row
            // sizing via style="flex:1", or block width:100% from .form-control), moving
            // those responsibilities onto the new wrapper instead.
            if (input.style.flex) {
                wrapper.style.flex = input.style.flex;
                input.style.flex = '';
            } else {
                wrapper.style.width = '100%';
            }
            if (input.style.minWidth) {
                wrapper.style.minWidth = input.style.minWidth;
                input.style.minWidth = '';
            }
            input.style.width = '100%';

            input.parentElement.insertBefore(wrapper, input);
            wrapper.appendChild(input);

            const btn = document.createElement('button');
            btn.type = 'button';
            btn.className = 'search-clear-btn';
            btn.innerHTML = '&times;';
            btn.setAttribute('aria-label', 'Clear search');
            wrapper.appendChild(btn);

            function toggleBtn() {
                btn.style.display = input.value.length > 0 ? 'block' : 'none';
            }

            input.addEventListener('input', toggleBtn);
            toggleBtn();

            btn.addEventListener('click', () => {
                input.value = '';
                input.dispatchEvent(new Event('input', { bubbles: true }));
                toggleBtn();
                input.focus();
            });

            input.dataset.clearEnabled = 'true';
        }

        // ════════════════════════════════════════════════
        // 10. INIT
        // ════════════════════════════════════════════════
        renderCard5();
        renderBadge();
        renderLineChart();
        renderBreakdown();
        renderTable();
        enableSearchClear('userSearch');

        // Re-render chart on window resize
        window.addEventListener('resize', renderLineChart);
    </script>
}
