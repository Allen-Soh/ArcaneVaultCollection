@page
@model ArcaneVaultRP.Pages.InsightPages.CommunityInterestModel
@{
    ViewData["Title"] = "Community Interest";
}

<div class="container mt-4" style="max-width:860px;">

    <!-- Back + Header -->
    <div class="mb-1">
        <a asp-page="./Index"
           class="text-decoration-none d-inline-flex align-items-center gap-1"
           style="font-size:13px;">
            <i class="bi bi-arrow-left" style="font-size:13px;"></i> Insights
        </a>
    </div>

    <div class="d-flex justify-content-between align-items-center mb-1">
        <h1 style="font-size:22px;font-weight:500;margin:0;">Community interest</h1>
        <select id="periodSelect"
                onchange="window.location.href='?Days=' + this.value"
                class="form-select form-select-sm" style="width:auto;">
            <option value="7"  selected ="@(Model.Days == 7)">Last 7 days</option>
            <option value="30" selected = "@(Model.Days == 30)">Last 30 days</option>
        </select>
    </div>
    <p class="text-muted mb-4" style="font-size:13px;">
        Showoff engagement and search activity across the platform
    </p>

    <!-- KPI cards -->
    <div class="row g-3 mb-4">
        <div class="col">
            <div class="rounded p-3" style="background:#f8f9fa;">
                <p class="text-muted mb-1" style="font-size:12px;">Total views</p>
                <p class="fw-500 mb-1" style="font-size:22px;">@Model.Detail.TotalViews</p>
                <p class="text-muted mb-0" style="font-size:11px;">
                    @(Model.Days == 7 ? "This week" : "This month")
                </p>
            </div>
        </div>
        <div class="col">
            <div class="rounded p-3" style="background:#f8f9fa;">
                <p class="text-muted mb-1" style="font-size:12px;">Total likes</p>
                <p class="fw-500 mb-1" style="font-size:22px;">@Model.Detail.TotalLikes</p>
                <p class="text-muted mb-0" style="font-size:11px;">All time</p>
            </div>
        </div>
        <div class="col">
            <div class="rounded p-3" style="background:#f8f9fa;">
                <p class="text-muted mb-1" style="font-size:12px;">Most searched</p>
                @{
                    var topSearch = Model.Detail.SearchTerms.FirstOrDefault();
                }
                <p class="fw-500 mb-1"
                   style="font-size:16px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;">
                    @(topSearch != null ? $"\"{topSearch.SearchTerm}\"" : "—")
                </p>
                <p class="text-muted mb-0" style="font-size:11px;">
                    @(topSearch != null ? $"{topSearch.Count} searches" : "No searches yet")
                </p>
            </div>
        </div>
        <div class="col">
            <div class="rounded p-3" style="background:#f8f9fa;">
                <p class="text-muted mb-1" style="font-size:12px;">Most viewed showoff</p>
                @{
                    var topShowoff = Model.Detail.MostViewed.FirstOrDefault();
                }
                <p class="fw-500 mb-1"
                   style="font-size:14px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;">
                    @(topShowoff?.ShowoffName ?? "—")
                </p>
                <p class="text-muted mb-0" style="font-size:11px;">
                    @(topShowoff != null ? $"{topShowoff.ViewCount} views" : "No views yet")
                </p>
            </div>
        </div>
    </div>

    <!-- Views over time -->
    <div class="border-top pt-4 mb-4">
        <div class="d-flex justify-content-between align-items-start mb-1">
            <p class="fw-500 mb-0" style="font-size:15px;">Views over time</p>
            <span class="text-muted"
                  style="font-size:11px;background:#f8f9fa;padding:2px 8px;
                         border-radius:999px;border:0.5px solid #dee2e6;">
                Grouped by day
            </span>
        </div>
        <p class="text-muted mb-3" style="font-size:13px;">
            Daily showoff views over the last @(Model.Days == 7 ? "7 days" : "30 days")
        </p>
        <div style="position:relative;height:160px;width:100%;">
            <canvas id="viewsChart" style="width:100%;height:100%;"></canvas>
        </div>
    </div>

    <!-- Showoff engagement — most viewed + most liked -->
    <div class="border-top pt-4 mb-4">
        <p class="fw-500 mb-1" style="font-size:15px;">Showoff engagement</p>
        <p class="text-muted mb-3" style="font-size:13px;">
            Top showoffs by views and by likes
        </p>
        <div class="row g-4">
            <div class="col-md-6">
                <p class="fw-500 mb-2 d-flex align-items-center gap-1"
                   style="font-size:13px;color:#6c757d;">
                    <i class="bi bi-eye" style="font-size:14px;"></i> Most viewed
                </p>
                <div id="mostViewedBars" style="display:flex;flex-direction:column;gap:7px;"></div>
            </div>
            <div class="col-md-6">
                <p class="fw-500 mb-2 d-flex align-items-center gap-1"
                   style="font-size:13px;color:#6c757d;">
                    <i class="bi bi-heart" style="font-size:14px;"></i> Most liked
                </p>
                <div id="mostLikedBars" style="display:flex;flex-direction:column;gap:7px;"></div>
            </div>
        </div>
    </div>

    <!-- Most searched terms -->
    <div class="border-top pt-4 mb-4">
        <p class="fw-500 mb-1" style="font-size:15px;">Most searched terms</p>
        <p class="text-muted mb-3" style="font-size:13px;">
            What users are looking for on the platform
        </p>
        <div id="searchBars" style="display:flex;flex-direction:column;gap:7px;"></div>
    </div>

    <!-- Views vs likes comparison table -->
    <div class="border-top pt-4 mb-5">
        <p class="fw-500 mb-1" style="font-size:15px;">Views vs likes comparison</p>
        <p class="text-muted mb-1" style="font-size:13px;">
            Identifies passive scrolling vs genuine interest based on like rate
        </p>
        <p class="text-muted mb-3" style="font-size:12px;">
            <span style="display:inline-block;width:8px;height:8px;border-radius:50%;
                         background:#0F6E56;margin-right:4px;"></span>
            High engagement (≥25% like rate) &nbsp;
            <span style="display:inline-block;width:8px;height:8px;border-radius:50%;
                         background:#E24B4A;margin-right:4px;"></span>
            Low engagement (&lt;25%)
        </p>

        <!-- Filters -->
        <div class="d-flex gap-2 mb-2 flex-wrap">
            <input type="text" id="nameFilter"
                   placeholder="Search showoff name"
                   oninput="applyTableFilters()"
                   class="form-control form-control-sm" style="flex:1;min-width:140px;" />
            <input type="text" id="ownerFilter"
                   placeholder="Search owner"
                   oninput="applyTableFilters()"
                   class="form-control form-control-sm" style="flex:1;min-width:120px;" />
            <select id="signalFilter" onchange="applyTableFilters()"
                    class="form-select form-select-sm" style="width:auto;flex-shrink:0;">
                <option value="">All signals</option>
                <option value="high">High engagement</option>
                <option value="low">Low engagement</option>
            </select>
            <select id="tableSort" onchange="applyTableFilters()"
                    class="form-select form-select-sm" style="width:auto;flex-shrink:0;">
                <option value="views">Most views</option>
                <option value="likes">Most likes</option>
                <option value="rateHigh">Highest like rate</option>
                <option value="rateLow">Lowest like rate</option>
                <option value="name">Name A – Z</option>
            </select>
        </div>

        <!-- Result count -->
        <p class="text-muted mb-2" id="resultCount" style="font-size:12px;"></p>

        <!-- Table -->
        <div class="border rounded overflow-hidden">
            <!-- Fixed header -->
            <table class="table table-sm mb-0"
                   style="font-size:13px;table-layout:fixed;width:100%;">
                <colgroup>
                    <col style="width:32%;" />
                    <col style="width:18%;" />
                    <col style="width:13%;" />
                    <col style="width:13%;" />
                    <col style="width:14%;" />
                    <col style="width:10%;" />
                </colgroup>
                <thead class="table-light" style="position:sticky;top:0;z-index:2;">
                    <tr>
                        <th style="padding:8px 12px;">Showoff</th>
                        <th style="padding:8px 12px;">Owner</th>
                        <th style="padding:8px 12px;text-align:right;">Views</th>
                        <th style="padding:8px 12px;text-align:right;">Likes</th>
                        <th style="padding:8px 12px;text-align:right;">Like rate</th>
                        <th style="padding:8px 12px;text-align:center;">Signal</th>
                    </tr>
                </thead>
            </table>

            <!-- Virtual scroll container -->
            <div id="scrollContainer"
                 style="height:444px;overflow-y:auto;position:relative;"
                 onscroll="onTableScroll()">
                <div id="spacerTop" style="height:0px;"></div>
                <table style="width:100%;border-collapse:collapse;
                               font-size:13px;table-layout:fixed;">
                    <colgroup>
                        <col style="width:32%;" />
                        <col style="width:18%;" />
                        <col style="width:13%;" />
                        <col style="width:13%;" />
                        <col style="width:14%;" />
                        <col style="width:10%;" />
                    </colgroup>
                    <tbody id="virtualBody"></tbody>
                </table>
                <div id="spacerBottom" style="height:0px;"></div>
            </div>
        </div>

        <div class="d-flex justify-content-between mt-2">
            <p class="text-muted mb-0" id="scrollIndicator" style="font-size:12px;"></p>
            <p class="text-muted mb-0" id="scrollMoreText" style="font-size:12px;">Scroll to load more</p>
        </div>
    </div>

</div>

@section Scripts {
<script>
    // ════════════════════════════════════════════════
    // 1. SERVER DATA
    // ════════════════════════════════════════════════
    const detail = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.Detail));

    const viewsOverTime = detail.ViewsOverTime || detail.viewsOverTime || [];
    const mostViewed    = detail.MostViewed    || detail.mostViewed    || [];
    const mostLiked     = detail.MostLiked     || detail.mostLiked     || [];
    const allShowoffs   = detail.AllShowoffs   || detail.allShowoffs   || [];
    const searchTerms   = detail.SearchTerms   || detail.searchTerms   || [];

    // Normalise property names
    allShowoffs.forEach(s => {
        s.name     = s.ShowoffName || s.showoffName || s.name;
        s.owner    = s.UserName    || s.userName    || s.owner;
        s.views    = s.ViewCount   || s.viewCount   || 0;
        s.likes    = s.LikeCount   || s.likeCount   || 0;
        s.likeRate = s.LikeRate    || s.likeRate    || 0;
    });

    mostViewed.forEach(s => {
        s.name  = s.ShowoffName || s.showoffName;
        s.views = s.ViewCount   || s.viewCount || 0;
        s.likes = s.LikeCount   || s.likeCount || 0;
    });

    mostLiked.forEach(s => {
        s.name  = s.ShowoffName || s.showoffName;
        s.views = s.ViewCount   || s.viewCount || 0;
        s.likes = s.LikeCount   || s.likeCount || 0;
    });

    searchTerms.forEach(s => {
        s.term  = s.SearchTerm  || s.searchTerm  || s.Term  || s.term;
        s.count = s.Count       || s.count       || 0;
    });

    // ════════════════════════════════════════════════
    // 2. CONSTANTS
    // ════════════════════════════════════════════════
    const colors      = ['#4e79a7','#f28e2b','#e15759','#76b7b2','#59a14f','#edc948'];
    const ROW_HEIGHT  = 37;
    const VISIBLE_ROWS = 12;
    let filteredData  = [];

    // ════════════════════════════════════════════════
    // 3. LINE CHART — canvas drawn manually
    // ════════════════════════════════════════════════
    function renderLineChart() {
        const canvas = document.getElementById('viewsChart');
        canvas.width  = canvas.offsetWidth || 800;
        canvas.height = 160;
        const ctx = canvas.getContext('2d');
        ctx.clearRect(0, 0, canvas.width, canvas.height);

        const data = viewsOverTime.map(d => ({
            label: formatDate(d.Date || d.date),
            count: d.Count || d.count || 0
        }));

        if (data.length === 0) {
            ctx.fillStyle   = '#9ca3af';
            ctx.font        = '13px sans-serif';
            ctx.textAlign   = 'center';
            ctx.fillText('No view data for this period.', canvas.width / 2, 80);
            return;
        }

        const pad    = { top:10, right:12, bottom:28, left:32 };
        const w      = canvas.width  - pad.left - pad.right;
        const h      = canvas.height - pad.top  - pad.bottom;
        const maxVal = Math.max(...data.map(d => d.count), 1);

        // Grid lines
        ctx.strokeStyle = '#e5e7eb';
        ctx.lineWidth   = 0.5;
        [0, 0.25, 0.5, 0.75, 1].forEach(f => {
            const y = pad.top + h - f * h;
            ctx.beginPath();
            ctx.moveTo(pad.left, y);
            ctx.lineTo(pad.left + w, y);
            ctx.stroke();
            ctx.fillStyle   = '#9ca3af';
            ctx.font        = '10px sans-serif';
            ctx.textAlign   = 'right';
            ctx.fillText(Math.round(f * maxVal), pad.left - 4, y + 3);
        });

        // X labels
        const step = Math.max(1, Math.ceil(data.length / 8));
        ctx.fillStyle = '#9ca3af';
        ctx.font      = '10px sans-serif';
        ctx.textAlign = 'center';
        data.forEach((d, i) => {
            if (i % step === 0 || i === data.length - 1) {
                const x = pad.left + (data.length > 1 ? (i / (data.length - 1)) * w : w / 2);
                ctx.fillText(d.label, x, pad.top + h + 18);
            }
        });

        if (data.length < 2) return;

        // Fill area
        ctx.beginPath();
        data.forEach((d, i) => {
            const x = pad.left + (i / (data.length - 1)) * w;
            const y = pad.top  + h - (d.count / maxVal) * h;
            i === 0 ? ctx.moveTo(x, y) : ctx.lineTo(x, y);
        });
        ctx.lineTo(pad.left + w, pad.top + h);
        ctx.lineTo(pad.left,     pad.top + h);
        ctx.closePath();
        ctx.fillStyle = 'rgba(229,87,89,0.10)';
        ctx.fill();

        // Line
        ctx.beginPath();
        ctx.strokeStyle = '#e15759';
        ctx.lineWidth   = 2;
        data.forEach((d, i) => {
            const x = pad.left + (i / (data.length - 1)) * w;
            const y = pad.top  + h - (d.count / maxVal) * h;
            i === 0 ? ctx.moveTo(x, y) : ctx.lineTo(x, y);
        });
        ctx.stroke();

        // Dots
        data.forEach((d, i) => {
            const x = pad.left + (i / (data.length - 1)) * w;
            const y = pad.top  + h - (d.count / maxVal) * h;
            ctx.beginPath();
            ctx.arc(x, y, 3, 0, Math.PI * 2);
            ctx.fillStyle = '#e15759';
            ctx.fill();
        });
    }

    function formatDate(dateStr) {
        if (!dateStr) return '';
        const d = new Date(dateStr);
        return d.toLocaleDateString('en-GB', { day:'2-digit', month:'short' });
    }

    // ════════════════════════════════════════════════
    // 4. ENGAGEMENT BARS
    // ════════════════════════════════════════════════
    function renderEngagementBars() {
        // Most viewed
        const maxViews = Math.max(...mostViewed.map(s => s.views), 1);
        document.getElementById('mostViewedBars').innerHTML = mostViewed.length === 0
            ? '<p class="text-muted" style="font-size:13px;">No view data yet.</p>'
            : mostViewed.map((s, i) => `
                <div style="display:flex;align-items:center;gap:8px;">
                    <span style="font-size:11px;color:#6c757d;width:120px;text-align:right;
                                 white-space:nowrap;overflow:hidden;text-overflow:ellipsis;
                                 flex-shrink:0;">${s.name}</span>
                    <div style="flex:1;height:14px;background:#f8f9fa;border-radius:3px;overflow:hidden;">
                        <div style="height:100%;width:${Math.round((s.views / maxViews) * 100)}%;
                                    background:${colors[i % colors.length]};border-radius:3px;"></div>
                    </div>
                    <span style="font-size:11px;color:#adb5bd;width:22px;
                                 text-align:right;flex-shrink:0;">${s.views}</span>
                </div>`).join('');

        // Most liked
        const maxLikes = Math.max(...mostLiked.map(s => s.likes), 1);
        document.getElementById('mostLikedBars').innerHTML = mostLiked.length === 0
            ? '<p class="text-muted" style="font-size:13px;">No like data yet.</p>'
            : mostLiked.map((s, i) => `
                <div style="display:flex;align-items:center;gap:8px;">
                    <span style="font-size:11px;color:#6c757d;width:120px;text-align:right;
                                 white-space:nowrap;overflow:hidden;text-overflow:ellipsis;
                                 flex-shrink:0;">${s.name}</span>
                    <div style="flex:1;height:14px;background:#f8f9fa;border-radius:3px;overflow:hidden;">
                        <div style="height:100%;width:${Math.round((s.likes / maxLikes) * 100)}%;
                                    background:#e15759;border-radius:3px;"></div>
                    </div>
                    <span style="font-size:11px;color:#adb5bd;width:22px;
                                 text-align:right;flex-shrink:0;">${s.likes}</span>
                </div>`).join('');
    }

    // ════════════════════════════════════════════════
    // 5. SEARCH TERM BARS
    // ════════════════════════════════════════════════
    function renderSearchBars() {
        const container = document.getElementById('searchBars');

        if (searchTerms.length === 0) {
            container.innerHTML =
                '<p class="text-muted" style="font-size:13px;">No search data yet.</p>';
            return;
        }

        const maxCount = Math.max(...searchTerms.map(s => s.count), 1);
        container.innerHTML = searchTerms.map((s, i) => `
            <div style="display:flex;align-items:center;gap:8px;">
                <span style="font-size:12px;color:#6c757d;width:110px;text-align:right;
                             flex-shrink:0;overflow:hidden;text-overflow:ellipsis;
                             white-space:nowrap;">${s.term}</span>
                <div style="flex:1;height:14px;background:#f8f9fa;border-radius:3px;overflow:hidden;">
                    <div style="height:100%;width:${Math.round((s.count / maxCount) * 100)}%;
                                background:#76b7b2;border-radius:3px;"></div>
                </div>
                <span style="font-size:12px;color:#adb5bd;width:24px;
                             text-align:right;flex-shrink:0;">${s.count}</span>
            </div>`).join('');
    }

    // ════════════════════════════════════════════════
    // 6. COMPARISON TABLE — virtual scroll
    // ════════════════════════════════════════════════
    function applyTableFilters() {
        const nameQ  = (document.getElementById('nameFilter')?.value  || '').trim().toLowerCase();
        const ownerQ = (document.getElementById('ownerFilter')?.value || '').trim().toLowerCase();
        const signal = document.getElementById('signalFilter')?.value || '';
        const sort   = document.getElementById('tableSort')?.value    || 'views';

        let data = [...allShowoffs];

        if (nameQ)             data = data.filter(s => s.name.toLowerCase().includes(nameQ));
        if (ownerQ)            data = data.filter(s => s.owner.toLowerCase().includes(ownerQ));
        if (signal === 'high') data = data.filter(s => s.likeRate >= 25);
        if (signal === 'low')  data = data.filter(s => s.likeRate < 25);

        data.sort((a, b) => {
            if (sort === 'views')    return b.views    - a.views;
            if (sort === 'likes')    return b.likes    - a.likes;
            if (sort === 'rateHigh') return b.likeRate - a.likeRate;
            if (sort === 'rateLow')  return a.likeRate - b.likeRate;
            if (sort === 'name')     return a.name.localeCompare(b.name);
            return 0;
        });

        filteredData = data;

        document.getElementById('resultCount').textContent =
            `${data.length} showoff${data.length === 1 ? '' : 's'} found`;

        const sc = document.getElementById('scrollContainer');
        sc.scrollTop = 0;
        renderVirtualRows(0);
    }

    function renderVirtualRows(scrollTop) {
        const total  = filteredData.length;
        const startIdx = Math.max(0, Math.floor(scrollTop / ROW_HEIGHT) - 2);
        const endIdx   = Math.min(total, startIdx + VISIBLE_ROWS + 4);

        const sc = document.getElementById('scrollContainer');
        if (total <= VISIBLE_ROWS) {
            sc.style.height = `${total * ROW_HEIGHT}px`;
            sc.style.maxHeight = `${total * ROW_HEIGHT}px`;
        } else {
            sc.style.height = `${VISIBLE_ROWS * ROW_HEIGHT}px`;
            sc.style.maxHeight = `${VISIBLE_ROWS * ROW_HEIGHT}px`;
        }

        document.getElementById('spacerTop').style.height =
            `${startIdx * ROW_HEIGHT}px`;
        document.getElementById('spacerBottom').style.height =
            `${(total - endIdx) * ROW_HEIGHT}px`;

        const visStart = Math.max(0, Math.floor(scrollTop / ROW_HEIGHT) + 1);
        const visEnd   = Math.min(total, visStart + VISIBLE_ROWS);

        document.getElementById('scrollIndicator').textContent =
            total === 0
                ? 'No results'
                : total > VISIBLE_ROWS
                    ? `Showing ${visStart}–${visEnd} of ${total}`
                    : `${total} showoff${total === 1 ? '' : 's'}`;

        document.getElementById('scrollMoreText').style.display =
            total > VISIBLE_ROWS ? 'block' : 'none';

        document.getElementById('virtualBody').innerHTML =
            filteredData.slice(startIdx, endIdx).map(s => {
                const rate     = s.likeRate.toFixed(0);
                const isHigh   = parseFloat(rate) >= 25;
                const dotColor = isHigh ? '#0F6E56' : '#E24B4A';
                const rateCol  = isHigh ? '#0F6E56' : '#E24B4A';
                return `
                    <tr style="height:${ROW_HEIGHT}px;border-top:0.5px solid #dee2e6;">
                        <td style="padding:0 12px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;">${s.name}</td>
                        <td style="padding:0 12px;color:#6c757d;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;">${s.owner}</td>
                        <td style="padding:0 12px;text-align:right;color:#6c757d;">${s.views}</td>
                        <td style="padding:0 12px;text-align:right;color:#6c757d;">${s.likes}</td>
                        <td style="padding:0 12px;text-align:right;font-weight:500;color:${rateCol};">${rate}%</td>
                        <td style="padding:0 12px;text-align:center;">
                            <span style="display:inline-block;width:8px;height:8px;border-radius:50%;background:${dotColor};"></span>
                        </td>
                    </tr>`;
            }).join('');
    }

    function onTableScroll() {
        const sc = document.getElementById('scrollContainer');
        renderVirtualRows(sc.scrollTop);
    }

    // ════════════════════════════════════════════════
    // 7. INIT
    // ════════════════════════════════════════════════
    renderLineChart();
    renderEngagementBars();
    renderSearchBars();
    applyTableFilters();

    window.addEventListener('resize', renderLineChart);
</script>
}