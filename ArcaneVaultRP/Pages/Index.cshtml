@page
@using System.Text.Json
@using ArcaneVaultRP.Models
@using ArcaneVaultRP
@model ArcaneVaultRP.Pages.IndexModel
@{
    ViewData["Title"] = "Home";

    var userJson = HttpContext.Session.GetString(SessionKeys.LoggedInUser);
    var loggedInUser = userJson != null ? JsonSerializer.Deserialize<ArcaneVaultUser>(userJson) : null;
    var isStaff = HttpContext.Session.GetString(SessionKeys.UserRole) == "1";
}

<div class="container mt-4 animate-fade-in">

    @if (loggedInUser != null)
    {
        <!-- Welcome Banner -->
        <div class="p-4 mb-4 rounded-3 border-0 position-relative overflow-hidden" 
             style="background: linear-gradient(135deg, rgba(66, 72, 116, 0.3) 0%, rgba(27, 29, 46, 0.8) 100%); 
                    border: 1px solid var(--border-color) !important;">
            <div class="position-absolute top-0 end-0" style="opacity: 0.1; transform: translate(10%, -20%); pointer-events: none;">
                <i class="bi bi-magic" style="font-size: 180px; color: var(--color-periwinkle);"></i>
            </div>
            
            <div class="position-relative" style="z-index: 1;">
                <h2 class="fw-bold mb-2" style="font-family: 'Outfit', sans-serif;">Welcome back, @loggedInUser.UserName!</h2>
                <p class="mb-0 text-secondary d-flex align-items-center gap-2">
                    @if (isStaff)
                    {
                        <span class="badge bg-danger">Staff</span>
                    }
                    else
                    {
                        <span class="badge bg-primary">Collector</span>
                    }
                    <span>Logged in as <strong>@loggedInUser.Email</strong></span>
                </p>
            </div>
        </div>

        <!-- Quick Access Section -->
        <div class="d-flex justify-content-between align-items-center mb-3 mt-5">
            <h4 class="fw-semibold mb-0" style="font-family: 'Outfit', sans-serif; letter-spacing: -0.5px;">Quick Access</h4>
        </div>
        <div class="row g-4 mb-5">

            <!-- Collection Items card — all users -->
            <div class="col-md-4">
                <div class="card h-100">
                    <div class="card-body p-4 d-flex flex-column">
                        <div class="d-flex align-items-center justify-content-center bg-dark rounded-3 mb-3" style="width: 48px; height: 48px; background-color: rgba(166, 177, 225, 0.1) !important;">
                            <i class="bi bi-gem text-info fs-4"></i>
                        </div>
                        <h5 class="card-title fw-bold">My Collection</h5>
                        <p class="card-text text-muted flex-grow-1">View and manage your collectible items, and details.</p>
                        <a asp-page="/CollectionItemPages/Index" class="btn btn-primary w-100 mt-3 d-flex align-items-center justify-content-center gap-2">
                            <span>Go to Collection</span>
                            <i class="bi bi-arrow-right"></i>
                        </a>
                    </div>
                </div>
            </div>

            <!-- Add Item card — all users -->
            <div class="col-md-4">
                <div class="card h-100">
                    <div class="card-body p-4 d-flex flex-column">
                        <div class="d-flex align-items-center justify-content-center bg-dark rounded-3 mb-3" style="width: 48px; height: 48px; background-color: rgba(220, 214, 247, 0.1) !important;">
                            <i class="bi bi-plus-circle text-success fs-4" style="color: var(--color-lavender) !important;"></i>
                        </div>
                        <h5 class="card-title fw-bold">Add New Item</h5>
                        <p class="card-text text-muted flex-grow-1">Expand your vault by listing a new collectible item.</p>
                        <a asp-page="/CollectionItemPages/Create" class="btn btn-success w-100 mt-3 d-flex align-items-center justify-content-center gap-2">
                            <span>Add Item</span>
                            <i class="bi bi-plus-lg"></i>
                        </a>
                    </div>
                </div>
            </div>

            @if (isStaff)
            {
                <!-- Categories card — Staff only -->
                <div class="col-md-4">
                    <div class="card h-100">
                        <div class="card-body p-4 d-flex flex-column">
                            <div class="d-flex align-items-center justify-content-center bg-dark rounded-3 mb-3" style="width: 48px; height: 48px; background-color: rgba(66, 72, 116, 0.2) !important;">
                                <i class="bi bi-tags text-warning fs-4"></i>
                            </div>
                            <h5 class="card-title fw-bold">Manage Categories</h5>
                            <p class="card-text text-muted flex-grow-1">Create, edit, and organize categories for items.</p>
                            <a asp-page="/CategoryPages/Index" class="btn btn-secondary w-100 mt-3 d-flex align-items-center justify-content-center gap-2">
                                <span>Go to Categories</span>
                                <i class="bi bi-gear"></i>
                            </a>
                        </div>
                    </div>
                </div>
            }

        </div>

        @if (isStaff)
        {
            <!-- Staff Notice -->
            <div class="alert alert-warning border-0 shadow-sm d-flex align-items-center gap-3" role="alert">
                <i class="bi bi-magic fs-4"></i>
                <div>
                    <strong>Staff Access:</strong> You have administrative privileges to manage collection categories and oversee insights.
                </div>
            </div>
        }
    }
    else
    {
        <!-- Not logged in: Split Hero Section inspired by Collectr -->
        <div class="row align-items-center py-5 min-vh-75 position-relative">
            <div class="col-lg-6 mb-5 mb-lg-0">
                <div class="badge bg-primary mb-3 px-3 py-2 text-uppercase fw-bold letter-spacing-1" style="font-size: 11px; background-color: rgba(166, 177, 225, 0.1) !important; color: var(--color-periwinkle) !important; border: 1px solid rgba(166, 177, 225, 0.25);">
                    Collect. Show. Vault.
                </div>
                <h1 class="display-4 fw-extrabold mb-3" style="font-family: 'Outfit', sans-serif; font-size: clamp(2.5rem, 5vw, 4rem); line-height: 1.1; letter-spacing: -1.5px;">
                    Know that your <br />collection is <span style="background: linear-gradient(135deg, var(--color-lavender) 0%, var(--color-periwinkle) 100%); -webkit-background-clip: text; -webkit-text-fill-color: transparent;">precious.</span>
                </h1>
                <p class="lead text-muted mb-4 fs-5" style="max-width: 48ch; line-height: 1.6;">
                    The premium vault for your trading cards, memorabilia, and other collectibles. Catalog your collection, showcase your items to the community, and check out theirs too.
                </p>
                <div class="d-flex flex-wrap gap-3 mb-5">
                    <a asp-page="/Registration" class="btn btn-primary btn-lg px-4 py-3 d-flex align-items-center gap-2">
                        <span>Start today</span>
                        <i class="bi bi-arrow-right"></i>
                    </a>
                    <a asp-page="/Login" class="btn btn-outline-primary btn-lg px-4 py-3">
                        Login to Vault
                    </a>
                </div>
                
                <!-- Trust strip stats -->
                <div class="d-flex gap-4 border-top pt-4 border-color" style="border-top: 1px solid var(--border-color) !important;">
                    <div>
                        <div class="fw-bold fs-4" style="color: var(--color-light);">4.9★</div>
                        <div class="small text-muted">Vault Rating</div>
                    </div>
                    <div class="border-end border-color" style="border-right: 1px solid var(--border-color) !important;"></div>
                    <div>
                        <div class="fw-bold fs-4" style="color: var(--color-light);">10K+</div>
                        <div class="small text-muted">Collectors</div>
                    </div>
                    <div class="border-end border-color" style="border-right: 1px solid var(--border-color) !important;"></div>
                    <div>
                        <div class="fw-bold fs-4" style="color: var(--color-light);">100%</div>
                        <div class="small text-muted">Secure Vault</div>
                    </div>
                </div>
            </div>
            
            <div class="col-lg-6 d-flex justify-content-center align-items-center" style="min-height: 600px;">
                <!-- Animated Vault Container -->
                <div class="vault-container position-relative overflow-visible" style="width: 440px; height: 440px;">
                    
                    <!-- The Vault Image -->
                    <img src="/images/opened_vault.jpg" alt="Opened Vault" class="vault-img position-absolute w-100 h-100" style="object-fit: contain; z-index: 2; border-radius: 24px; filter: drop-shadow(0 0 20px rgba(166,177,225,0.25));" />
                    
                    <!-- Ambient Glow backdrop -->
                    <div class="vault-glow position-absolute w-100 h-100 rounded-circle" style="background: radial-gradient(circle, rgba(166, 177, 225, 0.25) 0%, rgba(0,0,0,0) 70%); z-index: 1; transform: scale(1.3); filter: blur(10px); pointer-events: none;"></div>
                    
                    <!-- Item 1: Ronaldo Jersey (Left) -->
                    <div class="popped-item left-item" id="itemLeft">
                        <img src="/images/car.webp" alt="Car" class="popped-img" />
                    </div>
                    
                    <!-- Item 2: Treekachu Pikachu Card (Middle) -->
                    <div class="popped-item middle-item" id="itemMiddle">
                        <img src="/images/treekachu.jpg" alt="Treekachu Card" class="popped-img" />
                    </div>
                    
                    <!-- Item 3: Iron Man Figure (Right) -->
                    <div class="popped-item right-item" id="itemRight">
                        <img src="/images/ironman.png" alt="Iron Man" class="popped-img" />
                    </div>

                </div>
            </div>
        </div>
    }

</div>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', () => {
            setTimeout(() => {
                document.getElementById('itemLeft')?.classList.add('popped');
                document.getElementById('itemMiddle')?.classList.add('popped');
                document.getElementById('itemRight')?.classList.add('popped');
            }, 400);
        });
    </script>
}
