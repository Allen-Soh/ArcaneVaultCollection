@page
@model ArcaneVaultRP.Pages.RegistrationModel
@{
    ViewData["Title"] = "Registration";
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-5">
            <div class="card shadow-sm border-0 rounded-3">
                <div class="card-body p-4">

                    <h2 class="card-title text-center fw-bold mb-4">Register</h2>

                    <!-- Validation summary — shows model-level errors -->
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

                    <form method="post">

                        <!-- Username -->
                        <div class="mb-3">
                            <label asp-for="Input.Username" class="form-label fw-semibold">Username</label>
                            <input asp-for="Input.Username" class="form-control" placeholder="Enter your username" />
                            <span asp-validation-for="Input.Username" class="text-danger small"></span>
                        </div>

                        <!-- Email -->
                        <div class="mb-3">
                            <label asp-for="Input.Email" class="form-label fw-semibold">Email</label>
                            <input asp-for="Input.Email" class="form-control" placeholder="Enter your email" />
                            <span asp-validation-for="Input.Email" class="text-danger small"></span>
                        </div>

                        <!-- Country -->
                        <div class="mb-3">
                            <label class="form-label fw-semibold" for="countrySearch">Country</label>
                            <div class="position-relative">
                                <input type="text"
                                       id="countrySearch"
                                       class="form-control"
                                       placeholder="Search for your country..."
                                       autocomplete="off" />
                                <input type="hidden"
                                       id="selectedCountry"
                                       name="Input.Country" />
                                <div id="countrySuggestions"
                                     class="list-group position-absolute z-3"
                                     style="width:100%;max-height:220px;overflow-y:auto;display:none;"></div>
                            </div>
                            <span id="countryError" class="text-danger small" style="display:none;">
                                Please select your country.
                            </span>
                        </div>

                        <!-- Password -->
                        <div class="mb-3">
                            <label asp-for="Input.Password" class="form-label fw-semibold">Password</label>
                            <div class="input-group">
                                <input asp-for="Input.Password" class="form-control" placeholder="Enter your password" id="Input_Password" />
                                <button class="btn btn-outline-secondary" type="button" id="togglePassword">
                                    <i class="bi bi-eye" id="eyeIcon"></i>
                                </button>
                            </div>
                            <span asp-validation-for="Input.Password" class="text-danger small"></span>
                        </div>

                        <!-- Confirm Password -->
                        <div class="mb-4">
                            <label asp-for="Input.ConfirmPassword" class="form-label fw-semibold">Confirm Password</label>
                            <div class="input-group">
                                <input asp-for="Input.ConfirmPassword" class="form-control" placeholder="Re-enter your password" id="Input_ConfirmPassword" />
                                <button class="btn btn-outline-secondary" type="button" id="toggleConfirmPassword">
                                    <i class="bi bi-eye" id="eyeIconConfirm"></i>
                                </button>
                            </div>
                            <span asp-validation-for="Input.ConfirmPassword" class="text-danger small"></span>
                        </div>

                        <div class="d-grid mb-3">
                            <button type="submit" class="btn btn-primary btn-lg">Register</button>
                        </div>

                    </form>

                    <!-- Login link -->
                    <div class="text-center">
                        <span class="text-muted">Already have an account?</span>
                        <a asp-page="/Login" class="text-decoration-none fw-semibold ms-1">Login here</a>
                    </div>

                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

    <script>
        // ── Country data ──
        const countries = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(
                    ArcaneVaultRP.Helpers.CountryHelper.AllCountries
                    ));

        const flagMap = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(
                    ArcaneVaultRP.Helpers.CountryHelper.FlagMap
                    ));

        const countrySearch = document.getElementById('countrySearch');
        const countrySuggestions = document.getElementById('countrySuggestions');
        const selectedCountry = document.getElementById('selectedCountry');

        function renderCountrySuggestions(query) {
            const filtered = query
                ? countries.filter(c => c.toLowerCase().includes(query.toLowerCase()))
                : countries;

            countrySuggestions.innerHTML = '';

            if (filtered.length === 0) {
                const noResult = document.createElement('div');
                noResult.className = 'list-group-item text-muted';
                noResult.textContent = 'No countries found.';
                countrySuggestions.appendChild(noResult);
                countrySuggestions.style.display = 'block';
                return;
            }

            filtered.forEach(country => {
                const flag = flagMap[country] || '🌐';
                const item = document.createElement('a');
                item.href = '#';
                item.className = 'list-group-item list-group-item-action d-flex align-items-center gap-2';
                item.style.fontSize = '14px';
                item.innerHTML = `<span style="font-size:18px;line-height:1;">${flag}</span>${country}`;
                item.addEventListener('click', function (e) {
                    e.preventDefault();
                    countrySearch.value = `${flag} ${country}`;
                    selectedCountry.value = country;
                    countrySuggestions.style.display = 'none';
                    document.getElementById('countryError').style.display = 'none';
                });
                countrySuggestions.appendChild(item);
            });

            countrySuggestions.style.display = 'block';
        }

        // Show all on focus
        countrySearch.addEventListener('focus', function () {
            renderCountrySuggestions(this.value.trim());
        });

        // Filter on input
        countrySearch.addEventListener('input', function () {
            selectedCountry.value = '';  // clear selection when typing
            renderCountrySuggestions(this.value.trim());
        });

        // Close on outside click
        document.addEventListener('click', function (e) {
            if (!countrySearch.contains(e.target) && !countrySuggestions.contains(e.target)) {
                countrySuggestions.style.display = 'none';
            }
        });

        // Validate country selected before form submit
        document.querySelector('form').addEventListener('submit', function (e) {
            if (!selectedCountry.value) {
                e.preventDefault();
                document.getElementById('countryError').style.display = 'block';
                countrySearch.focus();
            }
        });

        // Password toggle
        document.getElementById("togglePassword").addEventListener("click", function () {
            const input = document.getElementById("Input_Password");
            const icon = document.getElementById("eyeIcon");
            if (input.type === "password") {
                input.type = "text";
                icon.classList.replace("bi-eye", "bi-eye-slash");
            } else {
                input.type = "password";
                icon.classList.replace("bi-eye-slash", "bi-eye");
            }
        });

        // Confirm password toggle
        document.getElementById("toggleConfirmPassword").addEventListener("click", function () {
            const input = document.getElementById("Input_ConfirmPassword");
            const icon = document.getElementById("eyeIconConfirm");
            if (input.type === "password") {
                input.type = "text";
                icon.classList.replace("bi-eye", "bi-eye-slash");
            } else {
                input.type = "password";
                icon.classList.replace("bi-eye-slash", "bi-eye");
            }
        });
    </script>
}