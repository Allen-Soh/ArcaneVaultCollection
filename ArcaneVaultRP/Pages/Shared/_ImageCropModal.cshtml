@* Reusable image upload + crop modal pair *@
@* Usage: include with @await Html.RenderPartialAsync("_ImageCropModal") *@

<!-- Modal 1: Upload -->
<div class="modal fade" id="itemUploadModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow">
            <div class="modal-header border-0 pb-0">
                <h5 class="fw-bold mb-0">Add Item Photo</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body px-4 pt-3 pb-4">
                <div id="itemDropZone"
                     onclick="document.getElementById('itemFileInput').click()"
                     ondragover="event.preventDefault();this.style.borderColor='#4e79a7';"
                     ondragleave="this.style.borderColor='#dee2e6';"
                     ondrop="onItemFileDrop(event)"
                     style="border:2px dashed #dee2e6;border-radius:12px;
                    padding:40px 20px;text-align:center;cursor:pointer;
                    transition:border-color 0.2s;">
                    <i class="bi bi-image"
                       style="font-size:36px;color:#adb5bd;display:block;margin-bottom:12px;"></i>
                    <p style="font-size:14px;font-weight:500;margin:0 0 4px;">
                        Drag and drop your photo here
                    </p>
                    <p style="font-size:12px;color:#adb5bd;margin:0;">
                        or click to browse · JPG or PNG · max 5MB
                    </p>
                </div>
                <div id="itemUploadError" class="text-danger small mt-2"
                     style="display:none;"></div>
            </div>
        </div>
    </div>
</div>

<!-- Hidden file input -->
<input type="file" id="itemFileInput" accept=".jpg,.jpeg,.png"
       style="display:none;" onchange="onItemFileSelected(this)" />

<!-- Modal 2: Crop -->
<div class="modal fade" id="itemCropModal" tabindex="-1" data-bs-backdrop="static">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content border-0 shadow">
            <div class="modal-header border-0 pb-0">
                <h5 class="fw-bold mb-0">Crop Photo</h5>
            </div>
            <div class="modal-body px-4 pt-2 pb-2">
                <p class="text-muted mb-2" style="font-size:13px;">
                    Drag handles to resize · Scroll to zoom · Drag image to reposition
                </p>

                <!-- Crop area with bar indicators -->
                <div style="position:relative;">
                    <div style="background:#111;border-radius:8px;overflow:hidden;
                        max-height:420px;position:relative;">
                        <img id="itemCropImage" src=""
                             style="display:block;max-width:100%;" />
                    </div>

                    <!-- Width indicator bar -->
                    <div style="margin-top:8px;display:flex;align-items:center;gap:8px;">
                        <span style="font-size:11px;color:#adb5bd;width:32px;">W</span>
                        <div style="flex:1;height:4px;background:#f0f0f0;border-radius:2px;overflow:hidden;">
                            <div id="cropWidthBar"
                                 style="height:100%;background:#4e79a7;border-radius:2px;
                            transition:width 0.1s;width:80%;"></div>
                        </div>
                        <span id="cropWidthLabel"
                              style="font-size:11px;color:#adb5bd;width:70px;text-align:right;">—</span>
                    </div>

                    <!-- Height indicator bar -->
                    <div style="margin-top:4px;display:flex;align-items:center;gap:8px;">
                        <span style="font-size:11px;color:#adb5bd;width:32px;">H</span>
                        <div style="flex:1;height:4px;background:#f0f0f0;border-radius:2px;overflow:hidden;">
                            <div id="cropHeightBar"
                                 style="height:100%;background:#76b7b2;border-radius:2px;
                            transition:width 0.1s;width:80%;"></div>
                        </div>
                        <span id="cropHeightLabel"
                              style="font-size:11px;color:#adb5bd;width:70px;text-align:right;">—</span>
                    </div>

                    <!-- Max size note -->
                    <p class="text-muted mt-2 mb-0" style="font-size:11px;">
                        Max output: 1200 × 800 px
                    </p>
                </div>
            </div>
            <div class="modal-footer border-0 pt-0 pb-3">
                <button type="button" class="btn btn-outline-secondary"
                        onclick="cancelItemCrop()">
                    Cancel
                </button>
                <button type="button" class="btn btn-primary"
                        id="itemCropSaveBtn" onclick="saveItemCrop()">
                    Use this photo
                </button>
            </div>
        </div>
    </div>
</div>