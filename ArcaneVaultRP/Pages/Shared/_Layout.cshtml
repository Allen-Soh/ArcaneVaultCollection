<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - ArcaneVault</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/cropperjs/1.5.13/cropper.min.css" />
</head>
<body>
    <!-- Background ambient glows -->
    <div class="position-fixed top-0 start-0 w-100 h-100 overflow-hidden" style="pointer-events: none; z-index: -1;">
        <div class="glow glow-indigo" style="width: 500px; height: 500px; top: -150px; left: -100px; opacity: 0.2;"></div>
        <div class="glow glow-periwinkle" style="width: 600px; height: 600px; top: 35%; right: -150px; opacity: 0.12;"></div>
        <div class="glow glow-lavender" style="width: 500px; height: 500px; bottom: -100px; left: 10%; opacity: 0.15;"></div>
    </div>

    <header class="position-relative" style="z-index: 10;">
        <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-dark mb-4">
            <div class="container">
                <a class="navbar-brand d-flex align-items-center gap-2" asp-area="" asp-page="/Index">
                    <i class="bi bi-magic text-light"></i>
                    <span>Arcane Vault</span>
                </a>
                <button class="navbar-toggler border-0" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                     <ul class="navbar-nav flex-grow-1">
                        <li class="nav-item">
                            <a class="nav-link" asp-area="" asp-page="/Index">Home</a>
                        </li>
                        @if (Context.Session.GetString(SessionKeys.LoggedInUser) != null)
                        {
                            @if (Context.Session.GetString(SessionKeys.UserRole) == "1")
                            {
                                <li class="nav-item">
                                    <a class="nav-link" asp-page="/InsightPages/Index">Insights</a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link" asp-page="/CategoryPages/Index">Categories</a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link" asp-page="/ShowoffPages/Reports">Reports</a>
                                </li>
                            }
                            <li class="nav-item">
                                    <a class="nav-link" asp-page="/ShowoffPages/Index">Showoffs</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" asp-page="/CollectionItemPages/Index">Collection Items</a>
                            </li>
                        }
                        </ul> 
                     <!-- Right-side login/logout link changes based on session state. --> 
                     <ul class="navbar-nav ms-auto align-items-center">
                        @if (Context.Session.GetString(SessionKeys.LoggedInUser) != null)
                        {
                            var navUserJson = Context.Session.GetString(SessionKeys.LoggedInUser);
                            var navUser     = System.Text.Json.JsonSerializer.Deserialize<ArcaneVaultRP.Models.ArcaneVaultUser>(navUserJson);
                            var navInitial  = navUser?.UserName?.Length > 0 ? navUser.UserName[0].ToString().ToUpper() : "?";
 
                            <!-- Logout link -->
                            <li class="nav-item">
                                <a class="nav-link" asp-page="/Login"
                                   asp-page-handler="Logout">Logout</a>
                            </li>
 
                            <!-- Avatar circle → Settings -->
                            <li class="nav-item ms-2">
                                <a asp-page="/Settings"
                                   style="display:inline-flex;align-items:center;justify-content:center;
                                          width:34px;height:34px;border-radius:50%;overflow:hidden;
                                          background:linear-gradient(135deg, var(--color-indigo-dark), var(--color-periwinkle));
                                          border: 2px solid rgba(244, 238, 255, 0.4);
                                          text-decoration:none; transition: all 0.2s ease;"
                                   title="Settings"
                                   class="avatar-link">
                                    @if (!string.IsNullOrEmpty(navUser?.AvatarUrl))
                                    {
                                        <img src="@navUser.AvatarUrl"
                                             style="width:100%;height:100%;object-fit:cover;" />
                                    }
                                    else
                                    {
                                        <span style="font-size:13px;font-weight:700;color:var(--color-light);">@navInitial</span>
                                    }
                                </a>
                            </li>
                        }
                        else if (Context.Request.Path != "/Login" && Context.Request.Path != "/Registration")
                        {
                            <li class="nav-item">
                                <a class="nav-link" asp-page="/Login">Login</a>
                            </li>
                        }
                    </ul>
                </div>
            </div>
        </nav>
    </header>
    <div class="container">
        <main role="main" class="pb-5">
            @RenderBody()
        </main>
    </div>

    <footer class="footer position-absolute bottom-0 w-100 text-center py-3">
        <div class="container d-flex flex-column flex-md-row justify-content-between align-items-center gap-2">
            <div>
                <span class="small">&copy; 2026 - Arcane Vault. All rights reserved.</span>
            </div>
            <div class="d-flex gap-3 small">
                <a asp-area="" asp-page="/Index">Home</a>
                <span>·</span>
                <a asp-area="" asp-page="/Privacy">Privacy Policy</a>
            </div>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/cropperjs/1.5.13/cropper.min.js"></script>

    @await RenderSectionAsync("Scripts", required: false)
    <!-- API base for shared JS — hidden -->
    <input type="hidden" id="apiBaseInput" value="https://localhost:7040/api" />
</body>
</html>
