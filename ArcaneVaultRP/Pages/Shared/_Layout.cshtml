<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - ArcaneVaultRP</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css" />
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-light bg-white border-bottom box-shadow mb-3">
            <div class="container">
                <a class="navbar-brand" asp-area="" asp-page="/Index">ArcaneVaultRP</a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                     <ul class="navbar-nav flex-grow-1">
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-area="" asp-page="/Index">Home</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-area="" asp-page="/Privacy">Privacy</a>
                        </li>
                        @if (Context.Session.GetString(SessionKeys.LoggedInUser) != null)
                        {
                            @if (Context.Session.GetString(SessionKeys.UserRole) == "1")
                            {
                                <li class="nav-item">
                                    <a class="nav-link text-dark" asp-page="/InsightPages/Index">Insights</a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link text-dark" asp-page="/CategoryPages/Index">Categories</a>
                                </li>
                            }
                            <li class="nav-item">
                                <a class="nav-link text-dark" asp-page="/ShowoffPages/Index">Showoffs</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link text-dark" asp-page="/CollectionItemPages/Index">Collection Items</a>
                            </li>
                        }
                        </ul> 
                     <!-- Right-side login/logout link changes based on session state. --> 
                     <ul class="navbar-nav ms-auto align-items-center">
                        @if (Context.Session.GetString(SessionKeys.LoggedInUser) != null)
                        {
                            var navUserJson = Context.Session.GetString(SessionKeys.LoggedInUser);
                            var navUser     = System.Text.Json.JsonSerializer.Deserialize<ArcaneVaultRP.Models.ArcaneVaultUser>(navUserJson);
                            var navInitial  = navUser?.UserName?.Length > 0 ? navUser.UserName[0].ToString().ToUpper() : "?";

                            <!-- Logout link -->
                            <li class="nav-item">
                                <a class="nav-link text-dark" asp-page="/Login"
                                   asp-page-handler="Logout">Logout</a>
                            </li>

                            <!-- Avatar circle → Settings -->
                            <li class="nav-item ms-2">
                                <a asp-page="/Settings"
                                   style="display:inline-flex;align-items:center;justify-content:center;
                                          width:32px;height:32px;border-radius:50%;overflow:hidden;
                                          background:linear-gradient(135deg,#4e79a7,#76b7b2);
                                          text-decoration:none;"
                                   title="Settings">
                                    @if (!string.IsNullOrEmpty(navUser?.AvatarUrl))
                                    {
                                        <img src="@navUser.AvatarUrl"
                                             style="width:100%;height:100%;object-fit:cover;" />
                                    }
                                    else
                                    {
                                        <span style="font-size:13px;font-weight:600;color:#fff;">@navInitial</span>
                                    }
                                </a>
                            </li>
                        }
                        else if (Context.Request.Path != "/Login" && Context.Request.Path != "/Registration")
                        {
                            <li class="nav-item">
                                <a class="nav-link text-dark" asp-page="/Login">Login</a>
                            </li>
                        }
                    </ul>
                </div>
            </div>
        </nav>
    </header>
    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted">
        <div class="container">
            &copy; 2026 - Arcane Vault - <a asp-area="" asp-page="/Privacy">Privacy</a>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
