@{
    string NavActiveClass(string pagePath) =>
        Context.Request.Path.Equals(pagePath, StringComparison.OrdinalIgnoreCase)
            ? "active-glow"
            : "";
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - ArcaneVault</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/cropperjs/1.5.13/cropper.min.css" />
</head>
<body class="d-flex flex-column min-vh-100">
    <!-- Background ambient glows -->
    <div class="position-fixed top-0 start-0 w-100 h-100 overflow-hidden" style="pointer-events: none; z-index: -1;">
        <div class="glow glow-indigo" style="width: 500px; height: 500px; top: -150px; left: -100px; opacity: 0.2;"></div>
        <div class="glow glow-periwinkle" style="width: 600px; height: 600px; top: 35%; right: -150px; opacity: 0.12;"></div>
        <div class="glow glow-lavender" style="width: 500px; height: 500px; bottom: -100px; left: 10%; opacity: 0.15;"></div>
    </div>

    <header class="position-relative" style="z-index: 10;">
        <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-dark mb-4">
            <div class="container">
                <a class="navbar-brand d-flex align-items-center gap-2" asp-area="" asp-page="/Index">
                    <i class="bi bi-magic text-light"></i>
                    <span>Arcane Vault</span>
                </a>
                <button class="navbar-toggler border-0" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    <ul class="navbar-nav flex-grow-1">
                        <li class="nav-item">
                            <a class="nav-link @NavActiveClass("/")" asp-area="" asp-page="/Index">Home</a>
                        </li>
                        @if (Context.Session.GetString(SessionKeys.LoggedInUser) != null)
                        {
                            @if (Context.Session.GetString(SessionKeys.UserRole) == "1")
                            {
                                <li class="nav-item">
                                    <a class="nav-link @NavActiveClass("/InsightPages")" asp-page="/InsightPages/Index">Insights</a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link @NavActiveClass("/CategoryPages")" asp-page="/CategoryPages/Index">Categories</a>
                                </li>
                                <li class="nav-item dropdown">
                                    <a class="nav-link dropdown-toggle no-caret @(NavActiveClass("/ShowoffPages/Reports") + NavActiveClass("/SupportPages/Staff"))"
                                       href="#"
                                       id="ticketsDropdownToggle"
                                       role="button"
                                       data-bs-toggle="dropdown"
                                       aria-expanded="false">
                                        Tickets
                                        <i class="bi bi-chevron-down dropdown-caret-icon"></i>
                                    </a>
                                    <ul class="dropdown-menu profile-dropdown-menu" aria-labelledby="ticketsDropdownToggle">
                                        <li>
                                            <a class="dropdown-item d-flex align-items-center gap-2" asp-page="/ShowoffPages/Reports">
                                                <i class="bi bi-flag"></i> Report
                                            </a>
                                        </li>
                                        <li>
                                            <a class="dropdown-item d-flex align-items-center gap-2" asp-page="/SupportPages/Staff">
                                                <i class="bi bi-headset"></i> Support
                                            </a>
                                        </li>
                                    </ul>
                                </li>
                            }
                            else
                            {
                                <li class="nav-item">
                                    <a class="nav-link @NavActiveClass("/SupportPages")" asp-page="/SupportPages/Index">User Support</a>
                                </li>
                            }
                            @if (Context.Session.GetString(SessionKeys.UserRole) == "1")
                            {
                                <li class="nav-item dropdown">
                                    <a class="nav-link dropdown-toggle no-caret @(NavActiveClass("/ShowoffPages/Index") + NavActiveClass("/ShowoffPages/Cosmetics/ManageShop") + NavActiveClass("/ShowoffPages/CosmeticLog") + NavActiveClass("/ShowoffPages/PaymentLog"))"
                                       href="#"
                                       id="showoffsDropdownToggle"
                                       role="button"
                                       data-bs-toggle="dropdown"
                                       aria-expanded="false">
                                        Showoffs
                                        <i class="bi bi-chevron-down dropdown-caret-icon"></i>
                                    </a>
                                    <ul class="dropdown-menu profile-dropdown-menu" aria-labelledby="showoffsDropdownToggle">
                                        <li>
                                            <a class="dropdown-item d-flex align-items-center gap-2" asp-page="/ShowoffPages/Index">
                                                <i class="bi bi-eye"></i> Public View
                                            </a>
                                        </li>
                                        <li>
                                            <a class="dropdown-item d-flex align-items-center gap-2" asp-page="/ShowoffPages/Cosmetics/ManageShop">
                                                <i class="bi bi-shop"></i> Manage Shop
                                            </a>
                                        </li>
                                        <li>
                                            <a class="dropdown-item d-flex align-items-center gap-2" asp-page="/ShowoffPages/CosmeticLog">
                                                <i class="bi bi-journal-text"></i> Cosmetic Log
                                            </a>
                                        </li>
                                        <li>
                                            <a class="dropdown-item d-flex align-items-center gap-2" asp-page="/ShowoffPages/PaymentLog">
                                                <i class="bi bi-receipt"></i> Payment Log
                                            </a>
                                        </li>
                                    </ul>
                                </li>
                            }
                            else
                            {
                                <li class="nav-item">
                                    <a class="nav-link @NavActiveClass("/ShowoffPages")" asp-page="/ShowoffPages/Index">Showoffs</a>
                                </li>
                            }
                            <li class="nav-item">
                                <a class="nav-link @NavActiveClass("/CollectionItemPages")" asp-page="/CollectionItemPages/Index">Collection Items</a>
                            </li>
                        }
                    </ul>
                    <!-- Right-side login/logout link changes based on session state. -->
                    <ul class="navbar-nav ms-auto align-items-center">
                        @if (Context.Session.GetString(SessionKeys.LoggedInUser) != null)
                        {
                            var navUserJson = Context.Session.GetString(SessionKeys.LoggedInUser);
                            var navUser = System.Text.Json.JsonSerializer.Deserialize<ArcaneVaultRP.Models.ArcaneVaultUser>(navUserJson);
                            var navInitial = navUser?.UserName?.Length > 0 ? navUser.UserName[0].ToString().ToUpper() : "?";

                            <!-- Notification bell → likes/comments/moderation/ticket-reply/appeal sections, staff gets a pending-count toggle -->
                            <li class="nav-item ms-2 dropdown" id="notificationBellItem">
                                <a href="#"
                                   id="notificationBellToggle"
                                   class="nav-link dropdown-toggle no-caret position-relative"
                                   role="button"
                                   data-bs-toggle="dropdown"
                                   data-bs-auto-close="outside"
                                   aria-expanded="false"
                                   style="font-size:18px; padding-right:1.25rem;"
                                   title="Notifications">
                                    <i class="bi bi-bell"></i>
                                    <span id="notificationDot" style="display:none; position:absolute; top:4px; right:14px; width:8px; height:8px; border-radius:50%; background:#e74c3c; border:1px solid var(--bg-card);"></span>
                                </a>
                                <ul class="dropdown-menu dropdown-menu-end profile-dropdown-menu notification-dropdown-menu" aria-labelledby="notificationBellToggle">
                                    <li class="d-flex justify-content-between align-items-center px-3 pt-1 pb-2">
                                        <span class="fw-bold small">Notifications</span>
                                        @if (Context.Session.GetString(SessionKeys.UserRole) == "1")
                                        {
                                            <div class="btn-group btn-group-sm" role="group">
                                                <button type="button" class="btn notif-tab-btn active" id="notifTabPersonal" onclick="switchNotifTab('personal')">Personal</button>
                                                <button type="button" class="btn notif-tab-btn" id="notifTabStaff" onclick="switchNotifTab('staff')">Staff</button>
                                            </div>
                                        }
                                    </li>
                                    <li><hr class="dropdown-divider" /></li>
                                    <li class="px-3" style="max-height:380px; overflow-y:auto;">
                                        <div id="notificationPanelBody">
                                            <div class="text-muted small text-center py-3">Loading…</div>
                                        </div>
                                    </li>
                                </ul>
                            </li>

                            <!-- Avatar dropdown → Settings / Inventory / Trades / Logout -->
                            <li class="nav-item ms-2 dropdown">
                                <a href="#"
                                   id="profileDropdownToggle"
                                   class="avatar-link dropdown-toggle no-caret"
                                   role="button"
                                   data-bs-toggle="dropdown"
                                   aria-expanded="false"
                                   style="display:inline-flex;align-items:center;justify-content:center;
                                    width:34px;height:34px;border-radius:50%;overflow:hidden;
                                    background:linear-gradient(135deg, var(--color-indigo-dark), var(--color-periwinkle));
                                    border: 2px solid rgba(244, 238, 255, 0.4);
                                    text-decoration:none; transition: all 0.2s ease;"
                                   title="Account">
                                    @if (!string.IsNullOrEmpty(navUser?.AvatarUrl))
                                    {
                                        <img src="@navUser.AvatarUrl"
                                             style="width:100%;height:100%;object-fit:cover;" />
                                    }
                                    else
                                    {
                                        <span style="font-size:13px;font-weight:700;color:var(--color-light);">@navInitial</span>
                                    }
                                </a>

                                <ul class="dropdown-menu dropdown-menu-end profile-dropdown-menu" aria-labelledby="profileDropdownToggle">
                                    <li>
                                        <a class="dropdown-item d-flex align-items-center gap-2" asp-page="/Settings">
                                            <i class="bi bi-gear"></i> Settings
                                        </a>
                                    </li>
                                    <li>
                                        <a class="dropdown-item d-flex align-items-center gap-2" asp-page="/InventoryPages/Index">
                                            <i class="bi bi-box-seam"></i> Inventory
                                        </a>
                                    </li>
                                    <li>
                                        <a class="dropdown-item d-flex align-items-center gap-2" asp-page="/Login" asp-page-handler="Logout">
                                            <i class="bi bi-box-arrow-right"></i> Logout
                                        </a>
                                    </li>
                                </ul>
                            </li>
                        }
                        else if (Context.Request.Path != "/Login" && Context.Request.Path != "/Registration")
                        {
                            <li class="nav-item">
                                <a class="nav-link" asp-page="/Login">Login</a>
                            </li>
                        }
                    </ul>
                </div>
            </div>
        </nav>
    </header>
    <div class="container flex-grow-1">
        <main role="main" class="pb-5">
            @RenderBody()
        </main>
    </div>

    <footer class="footer w-100 text-center py-3 mt-auto">
        <div class="container d-flex flex-column flex-md-row justify-content-between align-items-center gap-2">
            <div>
                <span class="small">&copy; 2026 - Arcane Vault. All rights reserved.</span>
            </div>
            <div class="d-flex gap-3 small">
                <a asp-area="" asp-page="/Index">Home</a>
                <span>·</span>
                <a asp-area="" asp-page="/Privacy">Privacy Policy</a>
            </div>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/showoffCanvas.js" asp-append-version="true"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/cropperjs/1.5.13/cropper.min.js"></script>

    @await RenderSectionAsync("Scripts", required: false)
    <!-- API base for shared JS — hidden -->
    <input type="hidden" id="apiBaseInput" value="https://localhost:7040/api" />
    <!-- Session JWT for client-side fetch calls to [Authorize]'d API endpoints — hidden -->
    <input type="hidden" id="jwtTokenInput" value="@Context.Session.GetString(SessionKeys.JwtToken)" />

    @if (Context.Session.GetString(SessionKeys.LoggedInUser) != null)
    {
        <script>
            (function () {
                const apiBase = document.getElementById('apiBaseInput')?.value || 'https://localhost:7040/api';
                const jwtToken = document.getElementById('jwtTokenInput')?.value || '';
                const authHeaders = { 'Authorization': `Bearer ${jwtToken}` };

                function escapeHtml(str) {
                    const div = document.createElement('div');
                    div.textContent = str ?? '';
                    return div.innerHTML;
                }

                function formatWhen(iso) {
                    try { return new Date(iso).toLocaleString(); } catch { return ''; }
                }

                async function refreshNotificationDot() {
                    try {
                        const res = await fetch(`${apiBase}/Notification/unread`, { headers: authHeaders });
                        if (!res.ok) return;
                        const data = await res.json();
                        const hasUnread = data.hasUnread ?? data.HasUnread ?? false;
                        document.getElementById('notificationDot').style.display = hasUnread ? 'block' : 'none';
                    } catch { /* best-effort — dot just won't light up */ }
                }

                function section(title, items, renderItem) {
                    if (!items || items.length === 0) {
                        return `<div class="mb-3"><div class="fw-semibold small mb-1">${title}</div><div class="text-muted small">Nothing new</div></div>`;
                    }
                    return `<div class="mb-3"><div class="fw-semibold small mb-1">${title}</div>${items.map(renderItem).join('')}</div>`;
                }

                function renderPersonalPanel(data) {
                    const likes = data.likes ?? data.Likes ?? [];
                    const comments = data.comments ?? data.Comments ?? [];
                    const moderationEvents = data.moderationEvents ?? data.ModerationEvents ?? [];
                    const ticketReplies = data.ticketReplies ?? data.TicketReplies ?? [];
                    const appealDecisions = data.appealDecisions ?? data.AppealDecisions ?? [];

                    let html = '';
                    html += section('Likes on your showoffs', likes, l =>
                        `<div class="small mb-1">${escapeHtml(l.showoffName ?? l.ShowoffName)} — ${l.likeCount ?? l.LikeCount} like(s)</div>`);
                    html += section('New comments', comments, c =>
                        `<div class="small mb-1"><strong>${escapeHtml(c.commenterUserName ?? c.CommenterUserName)}</strong> on ${escapeHtml(c.showoffName ?? c.ShowoffName)}: "${escapeHtml(c.text ?? c.Text)}"</div>`);
                    html += section('Showoff moderation', moderationEvents, m =>
                        `<div class="small mb-1">${escapeHtml(m.showoffName ?? m.ShowoffName)} was ${(m.eventType ?? m.EventType ?? '').toLowerCase()}</div>`);
                    html += section('Support ticket replies', ticketReplies, t =>
                        `<div class="small mb-1">${escapeHtml(t.ticketUid ?? t.TicketUid)} — ${escapeHtml(t.subject ?? t.Subject)} was replied to</div>`);
                    html += section('Appeal decisions', appealDecisions, a =>
                        `<div class="small mb-1">${escapeHtml(a.showoffName ?? a.ShowoffName)} appeal was <strong>${escapeHtml(a.status ?? a.Status)}</strong></div>`);
                    return html;
                }

                function renderStaffPanel(data) {
                    const pendingTickets = data.pendingTicketCount ?? data.PendingTicketCount ?? 0;
                    const pendingReports = data.pendingReportCount ?? data.PendingReportCount ?? 0;
                    return `
                        <div class="small mb-2">Pending tickets assigned to you: <strong>${pendingTickets}</strong></div>
                        <div class="small mb-2">Pending reports assigned to you: <strong>${pendingReports}</strong></div>`;
                }

                let lastPanelData = null;
                let activeNotifTab = 'personal';

                function renderActiveTab() {
                    if (!lastPanelData) return;
                    document.getElementById('notificationPanelBody').innerHTML =
                        activeNotifTab === 'staff' ? renderStaffPanel(lastPanelData) : renderPersonalPanel(lastPanelData);
                }

                function switchNotifTab(tab) {
                    activeNotifTab = tab;
                    document.getElementById('notifTabPersonal')?.classList.toggle('active', tab === 'personal');
                    document.getElementById('notifTabStaff')?.classList.toggle('active', tab === 'staff');
                    renderActiveTab();
                }
                window.switchNotifTab = switchNotifTab;

                async function loadNotificationPanel() {
                    const bodyEl = document.getElementById('notificationPanelBody');
                    activeNotifTab = 'personal';
                    document.getElementById('notifTabPersonal')?.classList.add('active');
                    document.getElementById('notifTabStaff')?.classList.remove('active');
                    bodyEl.innerHTML = '<div class="text-muted small text-center py-3">Loading…</div>';
                    try {
                        const res = await fetch(`${apiBase}/Notification/panel`, { headers: authHeaders });
                        if (!res.ok) {
                            bodyEl.innerHTML = '<div class="text-muted small text-center py-3">Couldn\'t load notifications</div>';
                            return;
                        }
                        lastPanelData = await res.json();
                        renderActiveTab();
                        document.getElementById('notificationDot').style.display = 'none';
                    } catch {
                        bodyEl.innerHTML = '<div class="text-muted small text-center py-3">Couldn\'t load notifications</div>';
                    }
                }

                refreshNotificationDot();
                document.getElementById('notificationBellItem')?.addEventListener('shown.bs.dropdown', loadNotificationPanel);
            })();
        </script>
    }
</body>
</html>